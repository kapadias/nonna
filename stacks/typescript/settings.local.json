{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm test --silent)",
      "Bash(npm run test)",
      "Bash(pnpm test)",
      "Bash(vitest run)",
      "Bash(tsc --noEmit)",
      "Bash(eslint .)",
      "Bash(eslint . --max-warnings 0)",
      "Bash(prettier --check .)",
      "Bash(prettier --write .)"
    ]
  }
}
