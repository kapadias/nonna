{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(go test ./...)",
      "Bash(go test -race -coverprofile=coverage.out -covermode=atomic ./...)",
      "Bash(go vet ./...)",
      "Bash(golangci-lint run ./...)",
      "Bash(gofmt -l .)",
      "Bash(gofmt -w .)",
      "Bash(goimports -l .)",
      "Bash(goimports -w .)"
    ]
  }
}
