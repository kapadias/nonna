{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo test)",
      "Bash(cargo test --quiet)",
      "Bash(cargo check)",
      "Bash(cargo check --all-targets --all-features)",
      "Bash(cargo clippy)",
      "Bash(cargo clippy --all-targets --all-features -- -D warnings)",
      "Bash(cargo fmt)",
      "Bash(cargo fmt --check)",
      "Bash(cargo fmt -- --check)"
    ]
  }
}
