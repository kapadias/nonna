{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "NONNA_HOST=codex \"${PLUGIN_ROOT}\"/hooks/guard-branch.sh"
          },
          {
            "type": "command",
            "command": "NONNA_HOST=codex \"${PLUGIN_ROOT}\"/hooks/secret-scan.sh"
          }
        ]
      },
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "NONNA_HOST=codex \"${PLUGIN_ROOT}\"/hooks/guard-branch.sh"
          },
          {
            "type": "command",
            "command": "NONNA_HOST=codex \"${PLUGIN_ROOT}\"/hooks/secret-scan.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "NONNA_HOST=codex \"${PLUGIN_ROOT}\"/hooks/session-start.sh \"${PLUGIN_DATA}\"",
            "statusMessage": "Nonna is setting the table"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "NONNA_HOST=codex \"${PLUGIN_ROOT}\"/hooks/stop-dod.sh",
            "timeout": 300,
            "statusMessage": "Nonna is tasting it: running your tests"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "NONNA_HOST=codex \"${PLUGIN_ROOT}\"/hooks/subagent-start.sh"
          }
        ]
      }
    ]
  }
}
