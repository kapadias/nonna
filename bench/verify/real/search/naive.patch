+@router.get("/search", response_model=ItemsPublic)
+def search_items(session: SessionDep, current_user: CurrentUser, q: str) -> Any:
+    """
+    Search items by title, ignoring case.
+    """
+    statement = select(Item).where(col(Item.title).icontains(q, autoescape=True))
+    items = session.exec(statement.order_by(col(Item.created_at).desc())).all()
+    return ItemsPublic(
+        data=[ItemPublic.model_validate(item) for item in items], count=len(items)
+    )
