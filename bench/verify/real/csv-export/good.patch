+@router.get("/export")
+def export_items(session: SessionDep, current_user: CurrentUser) -> Response:
+    """
+    Export the current user's items as CSV.
+    """
+    items = session.exec(
+        select(Item)
+        .where(Item.owner_id == current_user.id)
+        .order_by(col(Item.created_at))
+    ).all()
+    out = io.StringIO()
+    writer = csv.writer(out)
+    writer.writerow(["id", "title", "description", "created_at"])
+    for item in items:
+        created = item.created_at.isoformat() if item.created_at else ""
+        writer.writerow([item.id, item.title, item.description or "", created])
+    return Response(content=out.getvalue(), media_type="text/csv")
+
