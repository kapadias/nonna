+@router.get("/export")
+def export_items(session: SessionDep, current_user: CurrentUser) -> Response:
+    """
+    Export the current user's items as CSV.
+    """
+    items = session.exec(select(Item).where(Item.owner_id == current_user.id)).all()
+    lines = ["id,title,description,created_at"]
+    for item in items:
+        lines.append(f"{item.id},{item.title},{item.description or ''},{item.created_at}")
+    return Response(content="\n".join(lines) + "\n", media_type="text/csv")
