+def move_items_to_first_superuser(session: SessionDep, user: User) -> None:
+    """A deleted user's items go to the first superuser instead of with them."""
+    heir = crud.get_user_by_email(session=session, email=settings.FIRST_SUPERUSER)
+    if heir is None or heir.id == user.id:
