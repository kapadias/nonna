+@router.post("/bulk-delete")
+def bulk_delete_items(
+    session: SessionDep, current_user: CurrentUser, body: ItemIds
+) -> ItemsDeleted:
+    """
+    Delete the listed items the current user may delete; skip the rest.
+    """
+    statement = select(Item).where(col(Item.id).in_(body.ids))
+    items = session.exec(statement).all()
+    for item in items:
+        session.delete(item)
+    session.commit()
+    return ItemsDeleted(deleted=len(items))
