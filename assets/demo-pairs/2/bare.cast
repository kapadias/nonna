[33.798611, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mPerfect,\u001b[12GI\u001b[14Gcan\u001b[18Gsee\u001b[22Gthe\u001b[26Gfailures.\u001b[36GThe\u001b[40G\u001b[38;5;105mdiv_cents()\u001b[52G\u001b[39mfunction\u001b[61Gneeds\u001b[67Gto\r\u001b[1B \u001b[3Gimpl\u001b[8Gment rou\u001b[17Gd half up instead of floor division. I'll fix it:\u001b[67G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;65m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(\u001b]8;id=h30f5e;file:///root/bare-app/app/money.py\u0007app/money.py\u001b]8;;\u0007)\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mAdded \u001b[1m2\u001b[22m lines, removed\u001b[29G\u001b[1m2\u001b[31G\u001b[22mlines\r\u001b[1B     \u001b[38;5;236m\u001b[2m 2 \u001b[22m \u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m3\r\u001b[6C\u001b[1B4\u001b[10G\u001b[22m\u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97mdiv_cents\u001b[38;5;236m(\u001b[38;5;31mtotal_cents: int, divisor: int\u001b[38;5;236m) -> \u001b[38;5;31mint\u001b[38;5;236m:\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m 5 -\u001b[38;5;236m    \"\"\"Divide a cent amount by `divisor`; fractions of\r\u001b[6C\u001b[1B\u001b[38;5;160m \u001b[11G\u001b[38;5;236ma\u001b[13Gcent are dropp\u001b[28Gd.\"\"\"    \u001b[38G  \u001b[41G          \u001b[52G         \u001b[62G  \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 5 +\u001b[38;5;236m    \u001b[38;5;24m\"\"\"Divide a cent amount by `divisor`; fractions of\r\u001b[6C\u001b[1B\u001b[38;5;29m \u001b[10G\u001b[38;5;24m a cent \u001b[48;5;157mround\u001b[48;5;194m \u001b[48;5;157mhalf up\u001b[48;5;194m.\"\"\"\u001b[38;5;236m                             \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 6 \u001b[22m     \u001b[38;5;125mif\u001b[38;5;236m divisor <= \u001b[38;5;31m0\u001b[38;5;236m:\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m7\u001b[14G\u001b[22m  \u001b[17G \u001b[38;5;125mraise\u001b[38;5;236m ValueError(\u001b[38