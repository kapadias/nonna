[36.704628, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[22BI\u001b[5Gsee\u001b[9Gthe\u001b[13Gissue—there\u001b[25Gare\u001b[29Gfailing\u001b[37Gtests\u001b[43Gin\u001b[46Gthe\u001b[50Gsplit\u001b[56Gmodule.\u001b[64GLet\u001b[68Gme\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[36.785155, "o", "\u001b[?25l\u001b[H     \u001b[38;5;236m\u001b[2m 4 \u001b[22m \u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97mdiv_cents\u001b[38;5;236m(\u001b[38;5;31mtotal_cents: int, divisor: int\u001b[38;5;236m) -> \u001b[38;5;31mint\u001b[38;5;236m:\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m 5 -\u001b[38;5;236m    \"\"\"Divide a cent amount by `divisor`; fractions of\r\u001b[5C\u001b[1B\u001b[38;5;160m   -\u001b[38;5;236m a cent are dropped.\"\"\"                               \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 5 +\u001b[38;5;236m    \u001b[38;5;24m\"\"\"Divide a cent amount by `divisor`; fractions of\r\u001b[5C\u001b[1B\u001b[38;5;29m   +\u001b[38;5;24m a cent \u001b[48;5;157mround\u001b[48;5;194m \u001b[48;5;157mhalf up\u001b[48;5;194m.\"\"\"\u001b[38;5;236m                             \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 6 \u001b[22m     \u001b[38;5;125mif\u001b[38;5;236m divisor <= \u001b[38;5;31m0\u001b[38;5;236m:\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 7 \u001b[22m         \u001b[38;5;125mraise\u001b[38;5;236m ValueError(\u001b[38;5;24m\"divisor must be positive\"\u001b[38;5;236m)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m 8 -\u001b[38;5;236m    return total_cents // divisor                     \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 8 +\u001b[38;5;236m    \u001b[38;5;125mreturn\u001b[38;5;236m \u001b[48;5;157m(\u001b[48;5;194mtotal_cents \u001b[48;5;157m+ divisor \u001b[48;5;194m// \u001b[38;5;31m\u001b[48;5;157m2\u001b[38;5;236m) // \u001b[48;5;194mdivisor    \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow let me run the tests to verify the fix:\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mPerfect!\u001b[12GThe\u001b[16Gmoney\u001b[22Gtests\u001b[28Gall\u001b[32Gpass.\u001b[38GLet\u001b[42Gme\u001b[45Grun\u001b[49Gthe\u001b[53Gfull\u001b[58Gtest\u001b[63Gsuite\u001b[69Gto\r\u001b[2C\u001b[1Bensure I haven't broken\u001b[27Ganything:\r\u001b[2B \u001b[3G\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mI\u001b[5Gsee\u001b[9Gthe\u001b[13Gissue—there\u001b[25Gare\u001b[29Gfailing\u001b[37Gtests\u001b[43Gin\u001b[46Gthe\u001b[50Gsplit\u001b[56Gmodule.\u001b[64GLet\u001b[68Gme\r\u001b[2C\u001b[1Bexamine that code:\u001b[K\r\u001b[2B\u001b[38;5;241m \u001b[3G\u001b[39mReading \u001b[1m1\u001b[13G\u001b[22mfile…\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[36.814569, "o", "\u001b[?25l\u001b[H\r\u001b[24B\u001b[38;5;174m✻\u001b[3G\u001b[38;5;216mC\u001b[6G\u001b[38;5;174ma\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
