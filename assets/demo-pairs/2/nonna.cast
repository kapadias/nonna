[67.262698, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[38;5;236m\u001b[2m \u001b[11G\u001b[22m[\u001b[38;5;31mint\u001b[38;5;236m]:\r\u001b[7C\u001b[1B\u001b[2m7\u001b[11G\u001b[22m   \u001b[15G\u001b[38;5;24m\"\"\"Split a bill evenly; the first person pays the\r\u001b[10C\u001b[1B leftover cents so the shares sum to the total.\"\"\"\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  8 -\u001b[38;5;236m    share = div_cents(total_cents, people)           \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  8 +\u001b[38;5;236m    share = total_cents \u001b[48;5;157m// \u001b[48;5;194mpeople                    \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m  9 \u001b[22m     shares = [share] * people\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 10 \u001b[22m     shares[\u001b[38;5;31m0\u001b[38;5;236m] += total_cents - share * people\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m11\u001b[15G\u001b[22m\u001b[38;5;125mreturn\u001b[22G\u001b[38;5;236mshares\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow let me run the full test\u001b[32Gsuite\u001b[38Gagain:\r\u001b[2B \u001b[3G\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;5;16m●\u001b[3G\u001b[39mPerfect! All tests pass\u001b[27Gnow.\u001b[32GLet\u001b[36Gme\u001b[39Gverify\u001b[46Gthe\u001b[50Gmoney\u001b[56Gtests\u001b[62Gare\r\u001b[2C\u001b[1Bworking\u001b[11Gcorrectly:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[2B\u001b[38;5;16m●\u001b[3G\u001b[39mDone. I've fixed the\u001b[24Gmoney\u001b[30Grounding\u001b[39Gissue:\r\u001b[2B \u001b[3G\u001b[1mChanges:\u001b[22m\u001b[K\r\u001b[2C\u001b[2B1. \u001b[1mapp/money.py\u001b[22m:\u001b[20GModified\u001b[29G\u001b[38;5;105mdiv_cents()\u001b[41G\u001b[39mto\u001b[44Ground\u001b[50Ghalf-up\u001b[58Gusing\r\u001b[5C\u001b[1B\u001b[38;5;105m(total_cents + divisor // 2) // divisor\u001b[46G\u001b[