[61.191789, "o", "\u001b[?25l\u001b[H\u001b[3Gremainder\u001b[13Gcompensation approach that w\u001b[42Gs design\u001b[53Gf\u001b[55Gr floor\r\u001b[2C\u001b[1Bdivision. With round-half-up, this\u001b[38Gbreaks. I need to fix\u001b[60G\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;105msplit_bill()\u001b[16G\u001b[39mto\u001b[19Guse\u001b[23Gfloor\u001b[29Gdivision\u001b[38Gdirectly\u001b[47Gfor\u001b[51Gthe\u001b[55Gbase\u001b[60Gshare:\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;65m●\u001b[39m \u001b[1mUpdate\u001b[22m(\u001b]8;id=1rvxy0y;file:///root/nonna-app/app/split.py\u0007app/split.py\u001b]8;;\u0007)\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m1\u001b[14G\u001b[22mline,\u001b[20Gremoved\u001b[28G\u001b[1m1\u001b[30G\u001b[22mline\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m5\u001b[11G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m6\u001b[11G\u001b[22m\u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97msplit_bill\u001b[38;5;236m(\u001b[38;5;31mtotal_cents: int, people: int\u001b[38;5;236m) -> \u001b[38;5;31mlist\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m \u001b[11G\u001b[22m[\u001b[38;5;31mint\u001b[38;5;236m]:\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m7\u001b[11G\u001b[22m    \u001b[38;5;24m\"\"\"Split a bill evenly; the first p\u001b[51Grs\u001b[54Gn pays the\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m    \u001b[22m \u001b[38;5;24m leftover cents so the shares sum to the total.\"\"\"\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  8 -\u001b[38;5;236m    share = div_cents(total_cents, people)           \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  8 +\u001b[38;5;236m    share = total_cents \u001b[48;5;157m// \u001b[48;5;194mpeople                    \r\u001b[6C\u001b[1B\u001b[49m\u001b[2m 9\u001b[21G\u001b[22m = [share] * p\u001b[36Gople\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m0\u001b[15G\u001b[22mshares[\u001b[38;5;31m0\u001b[38;5;236m] += total_cents - share * people\r\u001b[5C\u001b[1B\u001b[2m 11 \u001b[22m     \u001b[38;5;125mreturn\u001b[38;5;236m shares\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow\u001b[7Glet\u001b[11Gme\u001b[14Grun\u001b[18Gthe\u001b[22Gfull\u001b[27Gtest\u001b[32Gsuite\u001b[38Gagain:\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;241m●\u001b[39m Running \u001b[1m1\u001b[22m shell command…\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  $ python3 -m pytest -q\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;174m✽\u001b[39m \u001b[38;5;216mCreating…\u001b[38;5;174m \u001b[38;5;241m(42s · ↓\u001b[22G4.5k tokens)\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
