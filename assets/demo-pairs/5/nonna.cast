[36.544102, "o", "\u001b[?25l\u001b[H\u001b[7G\u001b[38;5;160m\u001b[48;5;224m \u001b[11G\u001b[38;5;236ma\u001b[13Gcent are dropp\u001b[28Gd.\"\"\"    \u001b[38G  \u001b[41G          \u001b[52G         \u001b[62G  \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 5 +\u001b[38;5;236m    \u001b[38;5;24m\"\"\"Divide a cent amount by `divisor`; fractions of\r\u001b[6C\u001b[1B\u001b[38;5;29m \u001b[10G\u001b[38;5;24m a cent \u001b[48;5;157mround\u001b[48;5;194m \u001b[48;5;157mhalf up\u001b[48;5;194m.\"\"\"\u001b[38;5;236m                             \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 6 \u001b[22m     \u001b[38;5;125mif\u001b[38;5;236m divisor <= \u001b[38;5;31m0\u001b[38;5;236m:\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m7\u001b[14G\u001b[22m  \u001b[17G \u001b[38;5;125mraise\u001b[38;5;236m ValueError(\u001b[38;5;24m\"divisor must be positive\"\u001b[38;5;236m)\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m 8 -\u001b[38;5;236m    return total_cents // divisor                     \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 8 +\u001b[38;5;236m    \u001b[38;5;125mreturn\u001b[38;5;236m \u001b[48;5;157m(\u001b[48;5;194mtotal_cents \u001b[48;5;157m+ divisor \u001b[48;5;194m// \u001b[38;5;31m\u001b[48;5;157m2\u001b[38;5;236m) // \u001b[48;5;194mdivisor    \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow\u001b[7GI'll\u001b[12Grun\u001b[16Gthe\u001b[20Gmoney\u001b[26Gtests\u001b[32Gto\u001b[35Gverify\u001b[42Gthe\u001b[46Gfix:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mPerfect!\u001b[12GNow\u001b[16Glet\u001b[20Gme\u001b[23Grun\u001b[27Gthe\u001b[31Gfull\u001b[36Gtest\u001b[41Gsuite\u001b[47Gto\u001b[50Gensure\u001b[57GI\u001b[59Gdidn't\u001b[66Gbreak\r\u001b[1B \u001b[3Ganything:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u