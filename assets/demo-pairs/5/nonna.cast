[53.12247, "o", "\u001b[?25l\u001b[H \u001b[3Gleav\u001b[9Ga remainder for distribution), but\u001b[44G\u001b[38;5;105mdiv_cents()\u001b[56G\u001b[39mnow rou\u001b[64Gds. The\r\u001b[2C\u001b[1Bsplit\u001b[9Gfunctio\u001b[17G shouldn't use \u001b[38;5;105mdiv_cents()\u001b[44G\u001b[39mfor this purp\u001b[58Gse. Let me\u001b[K\r\u001b[2C\u001b[1Bfix \u001b[8Ghe spl\u001b[15Gt functio\u001b[25G:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;65m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(\u001b]8;id=1rvxy0y;file:///root/nonna-app/app/split.py\u0007app/split.py\u001b]8;;\u0007)\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mAdded \u001b[1m1\u001b[22m line, removed\u001b[28G\u001b[1m1\u001b[30G\u001b[22mline\r\u001b[1B     \u001b[38;5;236m\u001b[2m  5 \u001b[22m \u001b[12G\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m6\u001b[11G\u001b[22m\u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97msplit_bill\u001b[38;5;236m(\u001b[38;5;31mtotal_cents: int, people: int\u001b[38;5;236m) -> \u001b[38;5;31mlist\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m \u001b[11G\u001b[22m[\u001b[38;5;31mint\u001b[38;5;236m]:\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m7\u001b[11G\u001b[22m    \u001b[38;5;24m\"\"\"Split a bill evenly; the first person pays the\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m \u001b[11G\u001b[22m\u001b[38;5;24m leftover cents so the shares sum to th\u001b[51G t\u001b[54Gtal.\"\"\"\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  8 -\u001b[38;5;236m    share = div_cents(total_cents, people)           \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  8 +\u001b[38;5;236m    share = total_cents \u001b[48;5;157m// \u001b[48;5;194mpeople                    \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m  9 \u001b[22m     shares = [share] * people\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m10\u001b[21G\u001b[22m[\u001b[38;5;31m0\u001b[38;5;236m] += total_c\u001b[36Gnts - share * people\r\u001b[7C\u