[52.372324, "o", "\u001b[?25l\u001b[H\r\u001b[2B\u001b[38;5;16m●\u001b[3G\u001b[39mI see the issue.\u001b[20GThe\u001b[24G\u001b[38;5;105msplit_bill\u001b[35G\u001b[39mfunction\u001b[44Gneeds\u001b[50Gfloor\u001b[56Gdivision\u001b[65G(to\r\u001b[2C\u001b[1Bleave\u001b[9Ga\u001b[11Gremainder\u001b[21Gfor\u001b[25Gdistribution),\u001b[40Gbut\u001b[44G\u001b[38;5;105mdiv_cents()\u001b[56G\u001b[39mnow\u001b[60Grounds.\u001b[68GThe\r\u001b[1B \u001b[3Gsplit\u001b[9Gfunction shouldn't use \u001b[38;5;105mdiv_cents()\u001b[44G\u001b[39mfor this purpose. Let me\r\u001b[2C\u001b[1Bfix the\u001b[11Gsplit function:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;65m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(\u001b]8;id=1rvxy0y;file:///root/nonna-app/app/split.py\u0007app/split.py\u001b]8;;\u0007)\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m1\u001b[14G\u001b[22mline,\u001b[20Gremoved\u001b[28G\u001b[1m1\u001b[30G\u001b[22mline\r\u001b[1B \u001b[3G   \u001b[38;5;236m\u001b[2m  5 \u001b[22m \u001b[39m\u001b[K\r\u001b[1B     \u001b[38;5;236m\u001b[2m  6 \u001b[22m \u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97msplit_bill\u001b[38;5;236m(\u001b[38;5;31mtotal_cents: int, people: int\u001b[38;5;236m) -> \u001b[38;5;31mlist\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m \u001b[11G\u001b[22m[\u001b[38;5;31mint\u001b[38;5;236m]:\r\u001b[7C\u001b[1B\u001b[2m7\u001b[11G\u001b[22m   \u001b[15G\u001b[38;5;24m\"\"\"Split a bill evenly; the first person pays the\r\u001b[10C\u001b[1B leftover cents so the shares sum to the total.\"\"\"\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  8 -\u001b[38;5;236m    share = div_cents(total_cents, people)           \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  8 +\u001b[38;5;236m    share = total_cents \u001b[48;5;157m// \u001b[48;5;194mpeople                    \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m  9 \u001b[22m     shares = [share] * people\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u