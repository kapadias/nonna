[50.771097, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRead \u001b[1m2\u001b[22m files \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mI\u001b[5Gsee\u001b[9Gthe\u001b[13Gissue.\u001b[20GThe\u001b[24G\u001b[38;5;105msplit_bill\u001b[35G\u001b[39mfunction\u001b[44Gneeds\u001b[50Gfloor\u001b[56Gdivision\u001b[65G(to\r\u001b[1B \u001b[3Gl\u001b[5Gav\u001b[8G a remainder fo\u001b[24G distrib\u001b[33Gtion), but \u001b[38;5;105mdiv_cents()\u001b[39m now rounds. The\r\u001b[2C\u001b[1Bsplit function\u001b[18Gshouldn't\u001b[28Guse\u001b[32G\u001b[38;5;105mdiv_cents()\u001b[44G\u001b[39mfor\u001b[48Gthis\u001b[53Gpurpose.\u001b[62GLet\u001b[66Gme\r\u001b[2C\u001b[1Bfix\u001b[7Gthe\u001b[11Gsplit\u001b[17Gfunction:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;65m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(\u001b]8;id=1rvxy0y;file:///root/nonna-app/app/split.py\u0007app/split.py\u001b]8;;\u0007)\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mAdded \u001b[1m1\u001b[22m l\u001b[16Gne, removed \u001b[1m1\u001b[22m line\u001b[35G\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;236m\u001b[2m  5 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  6 \u001b[22m \u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97msplit_bill\u001b[38;5;236m(\u001b[38;5;31mtotal_cents: int, people: int\u001b[38;5;236m) -> \u001b[38;5;31mlist\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;5;236m\u001b[2m    \u001b[22m [\u001b[38;5;31mint\u001b[38;5;236m]:\r\u001b[5C\u001b[1B\u001b[2m  7 \u001b[22m     \u001b[38;5;24m\"\"\"Split a bill evenly; the first person pays the\r\u001b[1B\u001b[39m \u001b[3G \u001b[5G \u001b[38;5;236m\u001b[2m    \u001b[22m \u001b[38;5;24m leftover cents so the shares sum to the total.\"\"\"\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;160m\u001b[48;5;224m  8 -\u001b[38;5;236m    share = div_cents(total_cents, people)           \u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5