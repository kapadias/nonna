[66.765779, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[38;5;236m\u001b[2m \u001b[11G\u001b[22m[\u001b[38;5;31mint\u001b[38;5;236m]:\r\u001b[5C\u001b[1B\u001b[2m  5 \u001b[22m     \u001b[38;5;24m\"\"\"Split a bill evenly; the first person pays the\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m \u001b[11G\u001b[22m\u001b[38;5;24m leftover cents so the shares sum to the total.\"\"\"\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  8 -\u001b[38;5;236m    share = div_cents(total_cents, people)           \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  6 +\u001b[38;5;236m    share = total_cents \u001b[48;5;157m// \u001b[48;5;194mpeople                    \r\u001b[7C\u001b[1B\u001b[49m\u001b[2m7\u001b[11G\u001b[22m    shares = [share] * people\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  8 \u001b[22m     shares[\u001b[38;5;31m0\u001b[38;5;236m] += total_cents - share * people\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  9 \u001b[22m     \u001b[38;5;125mreturn\u001b[38;5;236m shares\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow let me run the full test suite again:\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mPerfect!\u001b[12GAll\u001b[16Gtests\u001b[22Gpass.\u001b[28GLet\u001b[32Gme\u001b[35Gverify\u001b[42Gthe\u001b[46Gmoney\u001b[52Gtests\u001b[58Gspecifically\r\u001b[2C\u001b[1Bto confirm the rounding\u001b[27Gfix\u001b[31Gis\u001b[34Gworking\u001b[42Gcorrectly:\r\u001b[2B \u001b[3G\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mDone!\u001b[9GAll\u001b[13G9\u001b[15Gtests\u001b[21Gpass.\u001b[27GHere's\u001b[34Gwhat\u001b[39GI\u001b[41Gfixed:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mModified \u001b[38;5;105mdiv_cents()\u001b[27G\u001b[22m\u001b[39min\u001b[30G\u001b[38;5;105mapp/money.py\u001b[43G\u001b[39mto\u001b[46Ground\u001b[52Ghalf\u001b[57Gup\u001b[60Gusing\r\u001b[1B \u001b[3G   Python's\u001b[15G\u001b[38;5;105mDecimal\u001b[39m modul\u001b[29G with \u001b[38;5;105mROUND_HALF_UP\u001b[39m.\u001b[50GThis\u001b[55Gensures\u001b[63Gthat\u001b[68Gtax\r\u001b[5C\u001b[1Bcalculations\u001b[19Glike\u001b[24G7%\u001b[27Gof\u001b[30G1050\u001b[35Gcents\u001b[41Gcorrectly\u001b[51Ground\u001b[57G73.5\u001b[62Gcents\u001b[68Gto\r\u001b[2C\u001b[1B  \u001b[6G74 cents.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
