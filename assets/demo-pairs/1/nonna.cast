[30.19444, "o", "\u001b[?25l\u001b[H\r\u001b[6C\u001b[24B\u001b[38;5;216mt\u001b[10G\u001b[38;5;174mg\u001b[36G\u001b[38;5;247mthinking\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[30.270823, "o", "\u001b[?25l\u001b[H\u001b[3GI'll fix this\u001b[17Gby using Python's \u001b[38;5;105mDecimal\u001b[39m module with \u001b[38;5;105mROUND_HALF_UP\r\u001b[2C\u001b[1B\u001b[39mrounding:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;65m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(\u001b]8;id=j806qk;file:///root/nonna-app/app/money.py\u0007app/money.py\u001b]8;;\u0007)\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m5\u001b[14G\u001b[22mlines,\u001b[21Gremoved\u001b[29G\u001b[1m2\u001b[31G\u001b[22mlines\r\u001b[1B \u001b[3G   \u001b[38;5;236m\u001b[2m  1 \u001b[22m \u001b[38;5;24m\"\"\"Integer-cent arithmetic shared by billing code.\"\"\"\r\u001b[1B\u001b[39m     \u001b[38;5;236m\u001b[2m  2 \u001b[22m \u001b[12G\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  3 +\u001b[38;5;125mfrom\u001b[38;5;236m decimal \u001b[38;5;125mimport\u001b[38;5;236m Decimal, ROUND_HALF_UP           \r\u001b[7C\u001b[1B\u001b[49m\u001b[2m4\r\u001b[7C\u001b[1B\u001b[22m\u001b[38;5;29m\u001b[48;5;194m5\u001b[11G\u001b[38;5;236m                                                     \r\u001b[7C\u001b[1B\u001b[49m\u001b[2m6\u001b[11G\u001b[22m\u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97mdiv_cents\u001b[38;5;236m(\u001b[38;5;31mtotal_cents: int, divisor: int\u001b[38;5;236m) -> \u001b[38;5;31mint\u001b[38;5;236m:\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  5 -\u001b[38;5;236m    \"\"\"Divide a cent amount by `divisor`; fractions o\r\u001b[5C\u001b[1B\u001b[38;5;160m    -\u001b[38;5;236mf a cent are dropped.\"\"\"                             \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  7 +\u001b[38;5;236m    \u001b[38;5;24m\"\"\"Divide a cent amount by `divisor`; fractions o\r\u001b[5C\u001b[1B\u001b[38;5;29m    +\u001b[38;5;24mf a cent \u001b[48;5;157mround\u001b[48;5;194m \u001b[48;5;157mhalf up\u001b[48;5;194m.\"\"\"\u001b[38;5;236m                           \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m  8 \u001b[22m     \u001b[38;5;125mif\u001b[38;5;236m divisor <= \u001b[38;5;31m0\u001b[38;5;236m:\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  9 \u001b[22m         \u001b[38;5;125mraise\u001b[38;5;236m ValueError(\u001b[38;5;24m\"divisor must be positive\"\u001b[38;5;236m)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  8 -\u001b[38;5;236m    return total_cents // divisor                    \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 10 +\u001b[38;5;236m    \u001b[48;5;157mresult\u001b[48;5;194m \u001b[48;5;157m= Decimal(\u001b[48;5;194mtotal_cents\u001b[48;5;157m)\u001b[48;5;194m / \u001b[48;5;157mDecimal(\u001b[48;5;194mdivisor\u001b[48;5;157m)\u001b[48;5;194m \r\u001b[5C\u001b[1B\u001b[38;5;29m 11 +\u001b[38;5;236m    \u001b[38;5;125mreturn\u001b[38;5;236m \u001b[38;5;31mint\u001b[38;5;236m(result.quantize(Decimal(\u001b[38;5;24m'1'\u001b[38;5;236m), rounding\r\u001b[6C\u001b[1B\u001b[38;5;29m  \u001b[11G\u001b[38;5;236m=ROUND_HALF_UP))                 \u001b[45G \u001b[47G                \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[6G\u001b[39m\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
