"\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  8 -\u001b[38;5;236m    share = div_cents(total_cents, people)           \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;5;29m\u001b[48;5;194m  6 +\u001b[38;5;236m    share = total_cents \u001b[48;5;157m// \u001b[48;5;194mpeople                    \u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;236m\u001b[2m  7 \u001b[22m     shares = [share] * people\r\u001b[5C\u001b[1B\u001b[2m  8 \u001b[22m     shares[\u001b[38;5;31m0\u001b[38;5;236m] += total_cents - share * people\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;236m\u001b[2m  9 \u001b[22m     \u001b[38;5;125mreturn\u001b[38;5;236m shares\r\u001b[13C\u001b[2B\u001b[38;5;241m40s · ↓\u001b[39m \u001b[38;5;241m4.9k t\u001b[29Gkens)\u001b[39m\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
