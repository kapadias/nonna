[61.11639, "o", "\u001b[?25l\u001b[H\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mAdded \u001b[1m1\u001b[22m line, removed \u001b[1m3\u001b[22m lines\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m1\u001b[11G\u001b[22m\u001b[38;5;24m\"\"\"Splitting a bill between people.\"\"\"\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  2 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  3 -\u001b[38;5;236mfrom app.money import div_cents                      \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m  3 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  5 -\u001b[38;5;236m                                                     \r\u001b[7C\u001b[1B\u001b[49m\u001b[2m4\u001b[11G\u001b[22m\u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97msplit_bill\u001b[38;5;236m(\u001b[38;5;31mtotal_cents: int, people: int\u001b[38;5;236m) -> \u001b[38;5;31mlist\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m \u001b[11G\u001b[22m[\u001b[38;5;31mint\u001b[38;5;236m]:\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m5\u001b[11G\u001b[22m    \u001b[38;5;24m\"\"\"Split a bill evenly; the first p\u001b[51Grs\u001b[54Gn pays the\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m    \u001b[22m \u001b[38;5;24m leftover cents so the shares sum to the total.\"\"\"\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  8 -\u001b[38;5;236m    share = div_cents(total_cents, people)           \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  6 +\u001b[38;5;236m    share = total_cents \u001b[48;5;157m// \u001b[48;5;194mpeople                    \r\u001b[7C\u001b[1B\u001b[49m\u001b[2m7\u001b[21G\u001b[22m = [share] * p\u001b[36Gople\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m8\u001b[15G\u001b[22mshares[\u001b[38;5;31m0\u001b[38;5;236m] += total_cents - share * people\r\u001b[5C\u001b[1B\u001b[2m  9 \u001b[22m     \u001b[38;5;125mreturn\u001b[38;5;236m shares\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[3