[66.98247, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[38;5;236m\u001b[2m5\u001b[11G\u001b[22m    \u001b[38;5;24m\"\"\"Split a bill evenly; the first person pays the\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m \u001b[11G\u001b[22m\u001b[38;5;24m leftover cents so the shares sum to th\u001b[51G t\u001b[54Gtal.\"\"\"\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  8 -\u001b[38;5;236m    share = div_cents(total_cents, people)           \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  6 +\u001b[38;5;236m    share = total_cents \u001b[48;5;157m// \u001b[48;5;194mpeople                    \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m  7 \u001b[22m     shares = [share] * people\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m8\u001b[21G\u001b[22m[\u001b[38;5;31m0\u001b[38;5;236m] += total_c\u001b[36Gnts - share * people\r\u001b[7C\u001b[1B\u001b[2m9\u001b[15G\u001b[22m\u001b[38;5;125mreturn\u001b[38;5;236m shares\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow\u001b[7Glet\u001b[11Gme\u001b[14Grun\u001b[18Gthe\u001b[22Gfull\u001b[27Gtest\u001b[32Gsuite\u001b[38Gagain:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mPerfect!\u001b[12GAll\u001b[16Gtests\u001b[22Gpass.\u001b[28GLet\u001b[32Gme\u001b[35Gverify\u001b[42Gthe\u001b[46Gmoney\u001b[52Gtests\u001b[58Gspecifically\r\u001b[1B \u001b[3Gto confirm the rounding fix is work\u001b[39Gng\u001b[42Gcorrectl\u001b[51G:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mDone!\u001b[9GAll\u001b[13G9\u001b[15Gtests\u001b[21Gpass.\u001b[27GHere's\u001b[34Gwhat\u001b[39GI\u001b[41Gfixed:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mModified \u001b[38;5;105mdiv_cents()\u001b[27G\u001b[22m\u001b[39min\u001b[30G\u001b[38;5;105mapp/money.py\u001b[43G\u001b[39mto\u001b[46Ground\u001b[52Ghalf\u001b[57Gup\u001b[60Gusing\r\u001b[2C\u001b[1B  \u001b[6GPython's \u001b[38;5;105mDecimal\u001b[39m module\u001b[30Gwith \u001b[38;5;105mROUND_HALF_UP\u001b[39m. This ensure\u001b[62G that\u001b[68Gtax\r\u001b[5C\u001b[1Bcalculations like 7% of\u001b[30G1050\u001b[35Gcents correctly round 73.5 cents\u001b[69Go\u001b[K\r\u001b[5C\u001b[1B74 \u001b[10Gents.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mModified \u001b[38;5;105msplit_bill()\u001b[28G\u001b[22m\u001b[39min\u001b[31G\u001b[38;5;105mapp/split.py\u001b[44G\u001b[39mto\u001b[47Guse\u001b[51Gfloor\u001b[57Gdivision\r\u001b[2C\u001b[1B  \u001b[6Gdirectly instead of \u001b[38;5;105mdiv_cents()\u001b[39m. The split algorithm requires\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[67.084349, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;5;29m\u001b[48;5;194m  6 +\u001b[38;5;236m    share = total_cents \u001b[48;5;157m// \u001b[48;5;194mpeople                    \r\u001b[7C\u001b[1B\u001b[49m\u001b[2m7\u001b[11G\u001b[22m    shares = [share] * people\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  8 \u001b[22m     shares[\u001b[38;5;31m0\u001b[38;5;236m] += total_cents - share * people\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  9 \u001b[22m     \u001b[38;5;125mreturn\u001b[38;5;236m shares\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow let me run the full test suite again:\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mPerfect!\u001b[12GAll\u001b[16Gtests\u001b[22Gpass.\u001b[28GLet\u001b[32Gme\u001b[35Gverify\u001b[42Gthe\u001b[46Gmoney\u001b[52Gtests\u001b[58Gspecifically\r\u001b[2C\u001b[1Bto confirm the rounding\u001b[27Gfix\u001b[31Gis\u001b[34Gworking\u001b[42Gcorrectly:\r\u001b[2B \u001b[3G\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mDone!\u001b[9GAll\u001b[13G9\u001b[15Gtests\u001b[21Gpass.\u001b[27GHere's\u001b[34Gwhat\u001b[39GI\u001b[41Gfixed:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mModified \u001b[38;5;105mdiv_cents()\u001b[27G\u001b[22m\u001b[39min\u001b[30G\u001b[38;5;105mapp/money.py\u001b[43G\u001b[39mto\u001b[46Ground\u001b[52Ghalf\u001b[57Gup\u001b[60Gusing\r\u001b[1B \u001b[3G   Python's\u001b[15G\u001b[38;5;105mDecimal\u001b[39m modul\u001b[29G with \u001b[38;5;105mROUND_HALF_UP\u001b[39m.\u001b[50GThis\u001b[55Gensures\u001b[63Gthat\u001b[68Gtax\r\u001b[5C\u001b[1Bcalculations\u001b[19Glike\u001b[24G7%\u001b[27Gof\u001b[30G1050\u001b[35Gcents\u001b[41Gcorrectly\u001b[51Ground\u001b[57G73.5\u001b[62Gcents\u001b[68Gto\r\u001b[2C\u001b[1B  \u001b[6G74 cents.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mModified \u001b[38;5;105msplit_bill()\u001b[22m\u001b[39m in \u001b[38;5;105mapp/split.py\u001b[39m to use floor divi\u001b[62Gion\u001b[K\r\u001b[5C\u001b[1Bdirectly i\u001b[18Gtead of \u001b[38;5;105mdiv_cents()\u001b[39m. The spli\u001b[48G alg\u001b[53Grithm require\u001b[68G\u001b[K\r\u001b[5C\u001b[1Bfloor division\u001b[21Gsemantics\u001b[31Gso\u001b[34Git\u001b[37Gcan\u001b[41Gadd\u001b[45Gleftover\u001b[54Gcents\u001b[60Gto\u001b[63Gthe\r\u001b[2C\u001b[1B  \u001b[6Gfirst person's share.\u001b[28G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[67.196137, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow let me run the full test suite again:\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mPerfect!\u001b[12GAll\u001b[16Gtests\u001b[22Gpass.\u001b[28GLet\u001b[32Gme\u001b[35Gverify\u001b[42Gthe\u001b[46Gmoney\u001b[52Gtests\u001b[58Gspecifically\r\u001b[2C\u001b[1Bto confirm the rounding\u001b[27Gfix\u001b[31Gis\u001b[34Gworking\u001b[42Gcorrectly:\r\u001b[2B \u001b[3G\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mDone!\u001b[9GAll\u001b[13G9\u001b[15Gtests\u001b[21Gpass.\u001b[27GHere's\u001b[34Gwhat\u001b[39GI\u001b[41Gfixed:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mModified \u001b[38;5;105mdiv_cents()\u001b[27G\u001b[22m\u001b[39min\u001b[30G\u001b[38;5;105mapp/money.py\u001b[43G\u001b[39mto\u001b[46Ground\u001b[52Ghalf\u001b[57Gup\u001b[60Gusing\r\u001b[1B \u001b[3G   Python's\u001b[15G\u001b[38;5;105mDecimal\u001b[39m modul\u001b[29G with \u001b[38;5;105mROUND_HALF_UP\u001b[39m.\u001b[50GThis\u001b[55Gensures\u001b[63Gthat\u001b[68Gtax\r\u001b[5C\u001b[1Bcalculations\u001b[19Glike\u001b[24G7%\u001b[27Gof\u001b[30G1050\u001b[35Gcents\u001b[41Gcorrectly\u001b[51Ground\u001b[57G73.5\u001b[62Gcents\u001b[68Gto\r\u001b[2C\u001b[1B  \u001b[6G74 cents.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mModified \u001b[38;5;105msplit_bill()\u001b[22m\u001b[39m in \u001b[38;5;105mapp/split.py\u001b[39m to use floor divi\u001b[62Gion\u001b[K\r\u001b[5C\u001b[1Bdirectly i\u001b[18Gtead of \u001b[38;5;105mdiv_cents()\u001b[39m. The spli\u001b[48G alg\u001b[53Grithm require\u001b[68G\u001b[K\r\u001b[5C\u001b[1Bfloor division\u001b[21Gsemantics\u001b[31Gso\u001b[34Git\u001b[37Gcan\u001b[41Gadd\u001b[45Gleftover\u001b[54Gcents\u001b[60Gto\u001b[63Gthe\r\u001b[2C\u001b[1B  \u001b[6Gfirst person's share.\u001b[28G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe full\u001b[12Gtest suite p\u001b[25Gsses,\u001b[31Gincluding:\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[67.426647, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow\u001b[7Glet\u001b[11Gme\u001b[14Grun\u001b[18Gthe\u001b[22Gfull\u001b[27Gtest\u001b[32Gsuite\u001b[38Gagain:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mPerfect!\u001b[12GAll\u001b[16Gtests\u001b[22Gpass.\u001b[28GLet\u001b[32Gme\u001b[35Gverify\u001b[42Gthe\u001b[46Gmoney\u001b[52Gtests\u001b[58Gspecifically\r\u001b[1B \u001b[3Gto confirm the rounding fix is work\u001b[39Gng\u001b[42Gcorrectl\u001b[51G:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mDone!\u001b[9GAll\u001b[13G9\u001b[15Gtests\u001b[21Gpass.\u001b[27GHere's\u001b[34Gwhat\u001b[39GI\u001b[41Gfixed:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mModified \u001b[38;5;105mdiv_cents()\u001b[27G\u001b[22m\u001b[39min\u001b[30G\u001b[38;5;105mapp/money.py\u001b[43G\u001b[39mto\u001b[46Ground\u001b[52Ghalf\u001b[57Gup\u001b[60Gusing\r\u001b[2C\u001b[1B  \u001b[6GPython's \u001b[38;5;105mDecimal\u001b[39m module\u001b[30Gwith \u001b[38;5;105mROUND_HALF_UP\u001b[39m. This ensure\u001b[62G that\u001b[68Gtax\r\u001b[5C\u001b[1Bcalculations like 7% of\u001b[30G1050\u001b[35Gcents correctly round 73.5 cents\u001b[69Go\u001b[K\r\u001b[5C\u001b[1B74 \u001b[10Gents.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mModified \u001b[38;5;105msplit_bill()\u001b[28G\u001b[22m\u001b[39min\u001b[31G\u001b[38;5;105mapp/split.py\u001b[44G\u001b[39mto\u001b[47Guse\u001b[51Gfloor\u001b[57Gdivision\r\u001b[2C\u001b[1B  \u001b[6Gdirectly instead of \u001b[38;5;105mdiv_cents()\u001b[39m. The split algorithm requires\r\u001b[5C\u001b[1Bfloor div\u001b[16Gsion semantics so it can add \u001b[46Geftover cents to th\u001b[66G\u001b[K\r\u001b[6C\u001b[1Birst\u001b[12Gperson's\u001b[22Ghare.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gfull\u001b[12Gtest\u001b[17Gsuite\u001b[23Gpasses,\u001b[31Gincluding:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;5;105mtest_half_cent_rounds_up\u001b[39m:\u001b[31GVerifies\u001b[40G7350\u001b[45G÷\u001b[47G100\u001b[51G=\u001b[53G74\u001b[56G(not 73)\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[67.641941, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mPerfect!\u001b[12GAll\u001b[16Gtests\u001b[22Gpass.\u001b[28GLet\u001b[32Gme\u001b[35Gverify\u001b[42Gthe\u001b[46Gmoney\u001b[52Gtests\u001b[58Gspecifically\r\u001b[1B \u001b[3Gto confirm the rounding fix is work\u001b[39Gng\u001b[42Gcorrectl\u001b[51G:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mDone!\u001b[9GAll\u001b[13G9\u001b[15Gtests\u001b[21Gpass.\u001b[27GHere's\u001b[34Gwhat\u001b[39GI\u001b[41Gfixed:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mModified \u001b[38;5;105mdiv_cents()\u001b[27G\u001b[22m\u001b[39min\u001b[30G\u001b[38;5;105mapp/money.py\u001b[43G\u001b[39mto\u001b[46Ground\u001b[52Ghalf\u001b[57Gup\u001b[60Gusing\r\u001b[2C\u001b[1B  \u001b[6GPython's \u001b[38;5;105mDecimal\u001b[39m module\u001b[30Gwith \u001b[38;5;105mROUND_HALF_UP\u001b[39m. This ensure\u001b[62G that\u001b[68Gtax\r\u001b[5C\u001b[1Bcalculations like 7% of\u001b[30G1050\u001b[35Gcents correctly round 73.5 cents\u001b[69Go\u001b[K\r\u001b[5C\u001b[1B74 \u001b[10Gents.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mModified \u001b[38;5;105msplit_bill()\u001b[28G\u001b[22m\u001b[39min\u001b[31G\u001b[38;5;105mapp/split.py\u001b[44G\u001b[39mto\u001b[47Guse\u001b[51Gfloor\u001b[57Gdivision\r\u001b[2C\u001b[1B  \u001b[6Gdirectly instead of \u001b[38;5;105mdiv_cents()\u001b[39m. The split algorithm requires\r\u001b[5C\u001b[1Bfloor div\u001b[16Gsion semantics so it can add \u001b[46Geftover cents to th\u001b[66G\u001b[K\r\u001b[6C\u001b[1Birst\u001b[12Gperson's\u001b[22Ghare.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gfull\u001b[12Gtest\u001b[17Gsuite\u001b[23Gpasses,\u001b[31Gincluding:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;5;105mtest_half_cent_rounds_up\u001b[39m:\u001b[31GVerifies\u001b[40G7350\u001b[45G÷\u001b[47G100\u001b[51G=\u001b[53G74\u001b[56G(not 73)\r\u001b[9C\u001b[1B\u001b[38;5;105mt\u001b[12Gx_rou\u001b[18Gds_half_up\u001b[39m: Verifies 7% tax on 1050 cents = 74\u001b[65Gcents\u001b[30;1H\u001b[28;3H\u001b[?25h"]
