[32.879229, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;5;236m\u001b[2m  4 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  5 +\u001b[38;5;236m                                                     \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m  6 \u001b[22m \u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97mdiv_cents\u001b[38;5;236m(\u001b[38;5;31mtotal_cents: int, divisor: int\u001b[38;5;236m) -> \u001b[38;5;31mint\u001b[38;5;236m:\r\u001b[7C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m5\u001b[11G\u001b[38;5;236m \u001b[13G \u001b[15G\"\"\"Divide a cent amount\u001b[39Gby\u001b[42G`divisor`;\u001b[53Gfractions\u001b[63Go\r\u001b[5C\u001b[1B\u001b[38;5;160m    -\u001b[38;5;236mf a cent are dropped.\"\"\"                             \r\u001b[7C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m7\u001b[11G\u001b[38;5;236m    \u001b[38;5;24m\"\"\"Divide a cent amount by `divisor`; fractions o\r\u001b[5C\u001b[1B\u001b[38;5;29m    +\u001b[38;5;24mf a cent \u001b[48;5;157mround\u001b[48;5;194m \u001b[48;5;157mhalf up\u001b[48;5;194m.\"\"\"\u001b[38;5;236m                           \r\u001b[7C\u001b[1B\u001b[49m\u001b[2m8\u001b[15G\u001b[22m\u001b[38;5;125mif\u001b[18G\u001b[38;5;236mdivisor <= \u001b[38;5;31m0\u001b[38;5;236m:\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  9 \u001b[22m         \u001b[38;5;125mraise\u001b[38;5;236m ValueError(\u001b[38;5;24m\"divisor must be positive\"\u001b[38;5;236m)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  8 -\u001b[38;5;236m    return total_cents // divisor                    \r\u001b[7C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m0\u001b[15G\u001b[38;5;236m\u001b[48;5;157mresult\u001b[48;5;194m \u001b[48;5;157m= Decimal(\u001b[48;5;194mtotal_cents\u001b[48;5;157m)\u001b[48;5;194m / \u001b[48;5;157mDecimal(\u001b[48;5;194mdivisor\u001b[48;5;157m)\u001b[48;5;194m \r\u001b[6C\u001b[1B\u001b[38;5;29m11\u001b[11G\u001b[38;5;236m    \u001b[38;5;125mreturn\u001b[38;5;236m \u001b[38;5;31mint\u001b[38;5;236m(result.quantize(Decimal(\u001b[38;5;24m'1'\u001b[38;5;236m), rounding\r\u001b[5C\u001b[1B\u001b[38;5;29m    +\u001b[38;5;236m=ROUND_HALF_UP))                                     \r\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow\u001b[7Glet\u001b[11Gme\u001b[14Grun\u001b[18Gthe\u001b[22Gmoney\u001b[28Gtests\u001b[34Gto\u001b[37Gverify\u001b[44Gthe\u001b[48Gfix\u001b[52Gworks:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mPerfect! T\u001b[14Ge money te\u001b[25Gts pass.\u001b[34GNow\u001b[38Glet\u001b[42Gme\u001b[45Grun\u001b[49Gthe\u001b[53Gfull\u001b[58Gtest\u001b[63Gsuite\u001b[69Gto\r\u001b[2C\u001b[1Bensure\u001b[10Gnothing\u001b[18Gelse\u001b[23Gis\u001b[26Gbroken:\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B Running \u001b[1m1\u001b[22m shell command…\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  $ python3 -m pytest -q\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;174m✻\u001b[39m \u001b[38;5;216mTwisting…\u001b[38;5;174m \u001b[38;5;241m(14s · ↓\u001b[22G1.8k tokens)\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
