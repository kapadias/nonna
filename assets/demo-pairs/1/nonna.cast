[74.219136, "o", "\u001b[?25l\u001b[H\u001b[3G  \u001b[6Gcalculations like 7%\u001b[27Gof\u001b[30G1050 cents correctly round\u001b[57G73.5 cents\u001b[68Gto\r\u001b[5C\u001b[1B74 ce\u001b[12Gt\u001b[14G.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mModified \u001b[38;5;105msplit_bill()\u001b[22m\u001b[39m in \u001b[38;5;105mapp/split.py\u001b[39m to use\u001b[51Gfloor\u001b[57Gdivisio\u001b[65G\u001b[K\r\u001b[5C\u001b[1Bdirectly instead\u001b[23Gof\u001b[26G\u001b[38;5;105mdiv_cents()\u001b[39m.\u001b[39GThe\u001b[43Gsplit\u001b[49Galgorithm\u001b[59Grequires\r\u001b[2C\u001b[1B  \u001b[6Gfloor division semantics\u001b[31Gso it can add leftover cents to the\r\u001b[5C\u001b[1Bf\u001b[9Gst person's share.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe full\u001b[12Gt\u001b[14Gst suite passes,\u001b[31Gincluding:\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;5;105mtest_half_cent_rounds_up\u001b[39m:\u001b[31GVerifies\u001b[40G7350\u001b[45G÷\u001b[47G100\u001b[51G=\u001b[53G74\u001b[56G(not 73)\r\u001b[2C\u001b[1B- \u001b[38;5;105mtest_tax_rounds_half_up\u001b[39m: Verifies 7%\u001b[42Gtax\u001b[46Gon\u001b[49G1050\u001b[54Gcents\u001b[60G=\u001b[62G74\u001b[65Gcents\r\u001b[9C\u001b[1B\u001b[38;5;105mfirst_person_pays_leftover_cents\u001b[39m: Verifies\u001b[53Gbill split works\r\u001b[2C\u001b[1B \u001b[5Gcorrectly\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B●\u001b[3GRan \u001b[1m1\u001b[22m stop hook\r\u001b[2C\u001b[1B\u001b[38;5;241m⎿  \u001b[39mStop\u001b[11Ghook\u001b[16Gerror:\u001b[23G✗\u001b[25GNonna:\u001b[32Gwhere's\u001b[40Gthe\u001b[44Gtest?\u001b[50G(stop:\u001b[57Gcode\r\u001b[1B \u001b[3Gchanged, no test\u001b[20Gchanged)\r\u001b[2C\u001b[1BAdd a test that fails\u001b[25Gwithout your change and pa\u001b[52Gses with\u001b[K\r\u001b[2C\u001b[1Bit, or tell\u001b[16Ghe user plainly\u001b[32Gwhy\u001b[36Gthis\u001b[41Gchange\u001b[48Gneeds\u001b[54Gnone.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[39