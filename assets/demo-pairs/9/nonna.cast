[64.118406, "o", "\u001b[?25l\u001b[H\u001b[38;5;241m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m1\u001b[14G\u001b[22mline,\u001b[20Gremoved\u001b[28G\u001b[1m3\u001b[30G\u001b[22mlines\r\u001b[1B     \u001b[38;5;236m\u001b[2m  1 \u001b[22m \u001b[38;5;24m\"\"\"Splitting a bill between people.\"\"\"\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m2\u001b[11G\u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  3 -\u001b[38;5;236mfrom app.money import div_cents                      \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m  3 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  5 -\u001b[38;5;236m                                                     \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m  4 \u001b[22m \u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97msplit_bill\u001b[38;5;236m(\u001b[38;5;31mtotal_cents: int, people: int\u001b[38;5;236m) -> \u001b[38;5;31mlist\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m \u001b[11G\u001b[22m[\u001b[38;5;31mint\u001b[38;5;236m]:\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m5\u001b[11G\u001b[22m    \u001b[38;5;24m\"\"\"Split a bill evenly; the first person pays the\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m \u001b[11G\u001b[22m\u001b[38;5;24m leftover cents so the shares sum to th\u001b[51G t\u001b[54Gtal.\"\"\"\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  8 -\u001b[38;5;236m    share = div_cents(total_cents, people)           \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  6 +\u001b[38;5;236m    share = total_cents \u001b[48;5;157m// \u001b[48;5;194mpeople                    \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m  7 \u001b[22m     shares = [share] * people\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m8\u001b[21G\u001b[22m[\u001b[38;5;31m0\u001b[38;5;236m] += total_c\u001b[36Gnts - share * people\r\u001b[7C\u001b[1B\u001b[2m9\u001b[15G\u001b[22m\u001b[38;5;125mreturn\u001b[38;5;236m shares\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mPerfect!\u001b[12GAll\u001b[16Gtests\u001b[22Gpass.\u001b[28GHere's\u001b[35Gwhat\u001b[40GI\u001b[42Gfixed:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[38;5;105m\u001b[1mapp/money.py\u001b[22m\u001b[39m:\u001b[20GChanged\u001b[28G\u001b[38;5;105mdiv_cents()\u001b[40G\u001b[39mto\u001b[43Ground\u001b[49Ghalf\u001b[54Gup\u001b[57Gusing\u001b[63G\u001b[38;5;105mDecimal\r\u001b[2C\u001b[1B\u001b[39m  \u001b[6Gwith \u001b[38;5;105mROUND_HALF_UP\u001b[39m instead of truncating. Now 7350\u001b[57G÷ 100\u001b[63G= 73.50\r\u001b[5C\u001b[1Bcorrectly rounds to 74.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[38;5;105m\u001b[1mapp/split.py\u001b[22m\u001b[39m: Changed \u001b[38;5;105msplit_bill()\u001b[41G\u001b[39mto\u001b[44Guse\u001b[48Gfloor\u001b[54Gdivision\u001b[63G(\u001b[38;5;105m//\u001b[39m)\r\u001b[2C\u001b[1B  \u001b[6Gdirectly instead of calling \u001b[38;5;105md\u001b[36Gv_cents()\u001b[39m. Bi\u001b[50Gl spl\u001b[56Gtting needs\u001b[30;1H\u001b[28;3H\u001b[?25h"]
