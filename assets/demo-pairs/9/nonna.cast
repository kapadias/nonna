[64.337357, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;5;160m\u001b[48;5;224m  3 -\u001b[38;5;236mfrom app.money import div_cents                      \r\u001b[7C\u001b[1B\u001b[49m\u001b[2m3\r\u001b[7C\u001b[1B\u001b[22m\u001b[38;5;160m\u001b[48;5;224m5\u001b[11G\u001b[38;5;236m    \u001b[16G         \u001b[26G      \u001b[33G         \r\u001b[7C\u001b[1B\u001b[49m\u001b[2m4\u001b[11G\u001b[22m\u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97msplit_bill\u001b[38;5;236m(\u001b[38;5;31mtotal_cents: int, people: int\u001b[38;5;236m) -> \u001b[38;5;31mlist\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m    \u001b[22m [\u001b[38;5;31mint\u001b[38;5;236m]:\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m5\u001b[11G\u001b[22m   \u001b[15G\u001b[38;5;24m\"\"\"Split a bill evenly; the first person pays the\r\u001b[10C\u001b[1B leftover cents so the shares sum to the total.\"\"\"\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  8 -\u001b[38;5;236m    share = div_cents(total_cents, people)           \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  6 +\u001b[38;5;236m    share = total_cents \u001b[48;5;157m// \u001b[48;5;194mpeople                    \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m  7 \u001b[22m     shares = [share] * people\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  8 \u001b[22m     shares[\u001b[38;5;31m0\u001b[38;5;236m] += total_cents - share * people\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m9\u001b[15G\u001b[22m\u001b[38;5;125mreturn\u001b[22G\u001b[38;5;236mshares\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;5;16m●\u001b[3G\u001b[39mPerfect! All tests pass.\u001b[28GHere's\u001b[35Gwhat\u001b[40GI\u001b[42Gfixed:\r\u001b[2B \u001b[3G1. \u001b[38;5;105m\u001b[1mapp/money.py\u001b[22m\u001b[39m: Changed\u001b[28G\u001b[38;5;105mdiv_cents()\u001b[40G\u001b[39mto round\u001b[49Ghalf\u001b[54Gup\u001b[57Gusing\u001b[63G\u001b[38;5;105mDecimal\r\u001b[5C\u001b[1B\u001b[39mwith\u001b[11G\u001b[38;5;105mROUND_HALF_UP\u001b[25G\u001b[39minstead\u001b[33Gof\u001b[36Gtruncating.\u001b[48GNow\u001b[52G7350\u001b[57G÷\u001b[59G100\u001b[63G=\u001b[65G73.50\r\u001b[2C\u001b[1B  \u001b[6Gcorrectly rounds to 74.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[38;5;105m\u001b[1mapp/split.py\u001b[22m\u001b[39m: Changed \u001b[38;5;105msplit_bill()\u001b[39m to use\u001b[48Gfloor division\u001b[63G(\u001b[38;5;105m//\u001b[39m)\u001b[K\r\u001b[5C\u001b[1Bdi\u001b[9Gectly instead\u001b[23Gof calling\u001b[34G\u001b[38;5;105mdiv_cents()\u001b[39m.\u001b[47GBill\u001b[52Gsplitting\u001b[62Gneeds\r\u001b[2C\u001b[1B  \u001b[6Gtruncation to\u001b[20Gcalculate the base per-person share, wh\u001b[60Gle\u001b[63Gtax\u001b[K\r\u001b[5C\u001b[1Bcalculatio\u001b[18G need rounding.\u001b[34G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
