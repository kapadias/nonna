[63.468918, "o", "\u001b[?25l\u001b[H\u001b[3Gits\u001b[7Gcalculation,\u001b[20Gbut\u001b[24G\u001b[38;5;105mdiv_cents()\u001b[36G\u001b[39mshould\u001b[43Ground\u001b[49Gfor\u001b[53Gtax\u001b[57Gcalculations.\r\u001b[1B \u001b[3GLet me fix \u001b[38;5;105msplit_bill\u001b[25G\u001b[39mto\u001b[28Guse\u001b[32Gfloor\u001b[38Gdivision\u001b[47Gdirectly:\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;65m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(\u001b]8;id=1rvxy0y;file:///root/nonna-app/app/split.py\u0007app/split.py\u001b]8;;\u0007)\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m1\u001b[14G\u001b[22mline,\u001b[20Gremoved\u001b[28G\u001b[1m3\u001b[30G\u001b[22mlines\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  1 \u001b[22m \u001b[38;5;24m\"\"\"Splitting a bill between people.\"\"\"\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m2\r\u001b[7C\u001b[1B\u001b[22m\u001b[38;5;160m\u001b[48;5;224m3\u001b[11G\u001b[38;5;236mfrom\u001b[16Gapp.money\u001b[26Gimport\u001b[33Gdiv_cents\r\u001b[7C\u001b[1B\u001b[49m\u001b[2m3\u001b[11G\u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  5 -\u001b[38;5;236m                                                     \r\u001b[7C\u001b[1B\u001b[49m\u001b[2m4\u001b[11G\u001b[22m\u001b[38;5;125mdef\u001b[15G\u001b[38;5;97msplit_bill\u001b[38;5;236m(\u001b[38;5;31mtotal_cents: int, people: int\u001b[38;5;236m) -> \u001b[38;5;31mlist\r\u001b[10C\u001b[1B\u001b[38;5;236m[\u001b[38;5;31mint\u001b[38;5;236m]:\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  5 \u001b[22m     \u001b[38;5;24m\"\"\"Split a bill evenly; the first person pays the\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m    \u001b[22m \u001b[38;5;24m leftover cents so the shares sum to the total.\"\"\"\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  8 -\u001b[38;5;236m    share = div_cents(total_cents, people)           \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  6 +\u