[48.479881, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;5;160m\u001b[48;5;224m  5 -\u001b[38;5;236m    \"\"\"Divide a cent amount by `divisor`; fractions o\r\u001b[7C\u001b[1B\u001b[38;5;160m \u001b[11G\u001b[38;5;236mf\u001b[13Ga\u001b[15Gcent are dropped.\"\"\"   \u001b[39G  \u001b[42G          \u001b[53G         \u001b[63G \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  7 +\u001b[38;5;236m    \u001b[38;5;24m\"\"\"Divide a cent amount by `divisor`; fractions o\r\u001b[7C\u001b[1B\u001b[38;5;29m \u001b[11G\u001b[38;5;24mf a cent \u001b[48;5;157mround\u001b[48;5;194m \u001b[48;5;157mhalf up\u001b[48;5;194m.\"\"\"\u001b[38;5;236m                           \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m  8 \u001b[22m     \u001b[38;5;125mif\u001b[38;5;236m divisor <= \u001b[38;5;31m0\u001b[38;5;236m:\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m9\u001b[15G\u001b[22m  \u001b[18G \u001b[38;5;125mraise\u001b[38;5;236m ValueError(\u001b[38;5;24m\"divisor must be positive\"\u001b[38;5;236m)\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  8 -\u001b[38;5;236m    return total_cents // divisor                    \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 10 +\u001b[38;5;236m    \u001b[38;5;125mreturn\u001b[38;5;236m \u001b[38;5;31mint\u001b[38;5;236m((Decimal(total_cents) / Decimal(diviso\r\u001b[6C\u001b[1B\u001b[38;5;29m  \u001b[11G\u001b[38;5;236mr)).quantize(Decimal(\u001b[38;5;24m'1'\u001b[38;5;236m), rounding=ROUND_HALF_UP))  \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mExcellent!\u001b[14GNow\u001b[18Glet\u001b[22Gme\u001b[25Grun\u001b[29Gthe\u001b[33Gfull\u001b[38Gtest\u001b[43Gsuite\u001b[49Gto\u001b[52Gmake\u001b[57Gsure\u001b[62Gnothing\r\u001b[1B \u001b[3Gels\u001b[7G broke:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell comm