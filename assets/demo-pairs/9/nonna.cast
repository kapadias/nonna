[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mPerfect!\u001b[12GAll\u001b[16Gtests\u001b[22Gpass.\u001b[28GHere's\u001b[35Gwhat\u001b[40GI\u001b[42Gfixed:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[38;5;105m\u001b[1mapp/money.py\u001b[22m\u001b[39m:\u001b[20GChanged\u001b[28G\u001b[38;5;105mdiv_cents()\u001b[40G\u001b[39mto\u001b[43Ground\u001b[49Ghalf\u001b[54Gup\u001b[57Gusing\u001b[63G\u001b[38;5;105mDecimal\r\u001b[1B\u001b[39m \u001b[3G   with \u001b[38;5;105mROUND_HALF_UP\u001b[39m inst\u001b[30Gad of truncat\u001b[44Gng. Now\u001b[52G7350\u001b[57G÷\u001b[59G100\u001b[63G=\u001b[65G73.50\r\u001b[5C\u001b[1Bcorrectly\u001b[16Grounds\u001b[23Gto 74.\r\u001b[2C\u001b[1B2\u001b[6G\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
