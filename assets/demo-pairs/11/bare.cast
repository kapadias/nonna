4m 8 -\u001b[38;5;236m    return total_cents // divisor                     \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 8 +\u001b[38;5;236m    \u001b[38;5;125mreturn\u001b[38;5;236m \u001b[48;5;157m(\u001b[48;5;194mtotal_cents \u001b[48;5;157m+ divisor \u001b[48;5;194m// \u001b[38;5;31m\u001b[48;5;157m2\u001b[38;5;236m) // \u001b[48;5;194mdivisor    \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow\u001b[7Glet\u001b[11Gme\u001b[14Grun\u001b[18Gthe\u001b[22Gtests\u001b[28Gto\u001b[31Gverify\u001b[38Gthe\u001b[42Gfix:\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;241m●\u001b[3G\u001b[39mRunning\u001b[11G\u001b[1m1\u001b[13G\u001b[22mshell\u001b[19Gcommand…\r\u001b[1B\u001b[38;5;241m  ⎿  $ python3 -m pytest tests/test_money.py -v\r\u001b[36C\u001b[2B)\u001b[39m\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
