[65.001375, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[38;5;241mRead \u001b[1m1\u001b[22m file \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;65m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(\u001b]8;id=1rvxy0y;file:///root/nonna-app/app/split.py\u0007app/split.py\u001b]8;;\u0007)\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mAdded \u001b[1m3\u001b[22m l\u001b[16Gnes,\u001b[21Gr\u001b[23Gmoved \u001b[1m4\u001b[22m lines\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;236m\u001b[2m  1 \u001b[22m \u001b[38;5;24m\"\"\"Splitting a bill between people.\"\"\"\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  2 \u001b[22m \r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;5;160m\u001b[48;5;224m  3 -\u001b[38;5;236mfrom app.money import div_cents                      \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m  3 \u001b[22m \r\u001b[1B\u001b[39m \u001b[3G \u001b[5G \u001b[38;5;160m\u001b[48;5;224m  5 -\u001b[38;5;236m                                                     \u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;236m\u001b[2m  4 \u001b[22m \u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97msplit_bill\u001b[38;5;236m(\u001b[38;5;31mtotal_cents: int, people: int\u001b[38;5;236m) -> \u001b[38;5;31mlist\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;236m\u001b[2m    \u001b[22m [\u001b[38;5;31mint\u001b[38;5;236m]:\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;236m\u001b[2m  5 \u001b[22m     \u001b[38;5;24m\"\"\"Split a bill evenly; the first person pays the\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m    \u001b[22m \u001b[38;5;24m leftover cents so the shares sum to the total.\"\"\"\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;5;160m\u001b[48;5;224m  8 -\u001b[38;5;236m    share = div_cents(total_cents, people)           \u001b[65G\u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;29m\u001b[48;5;194m  6 +\u001b[38;5;236m    share = total_cents \u001b[48;5;157m// \u001b[48;5;194mpeople                    \u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;29m\u001b[48;5;194m  7 +\u001b[38;5;236m    remainder = total_cents % people                 \u001b[49m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  8 \u001b[22m     shares = [share] * people\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;5;160m\u001b[48;5;224m 10 -\u001b[38;5;236m    shares[0] += total_cents - share * people        \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  9 +\u001b[38;5;236m    shares[\u001b[38;5;31m0\u001b[38;5;236m] += remainder                           \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[38;5;236m\u001b[2m 10 \u001b[22m     \u001b[38;5;125mreturn\u001b[38;5;236m shares\r\u001b[11C\u001b[2B\u001b[38;5;241m46s · ↓\u001b[39m \u001b[38;5;241m5.6k t\u001b[27Gkens\u001b[32G· \u001b[38;5;246mthinking\u001b[38;5;241m)\u001b[39m\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
