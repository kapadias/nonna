01b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mPerfect!\u001b[12GAll\u001b[16Gtests\u001b[22Gpass.\u001b[28GHere's\u001b[35Gwhat\u001b[40GI\u001b[42Gfixed:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[38;5;105m\u001b[1mapp/money.py\u001b[22m\u001b[39m:\u001b[20GChanged\u001b[28G\u001b[38;5;105mdiv_cents()\u001b[40G\u001b[39mto\u001b[43Ground\u001b[49Ghalf\u001b[54Gup\u001b[57Ginstead\u001b[65Gof\r\u001b[1B \u001b[3G   dropping frac\u001b[20Gions. Now \u001b[38;5;105mdiv_cents(7350, 100)\u001b[51G\u001b[39mreturns\u001b[59G74\u001b[62Ginstead\r\u001b[5C\u001b[1Bof\u001b[9G73,\u001b[13Gwhich\u001b[19Gfixes\u001b[25Gthe\u001b[29Gtax\u001b[33Grounding\u001b[42Gissue\u001b[48G(7%\u001b[52Gtax\u001b[56Gon\u001b[59G1050\u001b[64Gcents\u001b[70G=\r\u001b[2C\u001b[1B  \u001b[6G74 cents).\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
