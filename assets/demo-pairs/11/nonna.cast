[69.293324, "o", "\u001b[?25l\u001b[H\u001b[38;5;241m  ⎿  \u001b[39mAdded \u001b[1m3\u001b[22m lines, removed \u001b[1m4\u001b[22m lines\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m1\u001b[11G\u001b[22m\u001b[38;5;24m\"\"\"Splitting a bill between people.\"\"\"\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  2 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  3 -\u001b[38;5;236mfrom app.money import div_cents                      \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m  3 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  5 -\u001b[38;5;236m                                                     \r\u001b[7C\u001b[1B\u001b[49m\u001b[2m4\u001b[11G\u001b[22m\u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97msplit_bill\u001b[38;5;236m(\u001b[38;5;31mtotal_cents: int, people: int\u001b[38;5;236m) -> \u001b[38;5;31mlist\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m \u001b[11G\u001b[22m[\u001b[38;5;31mint\u001b[38;5;236m]:\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m5\u001b[11G\u001b[22m    \u001b[38;5;24m\"\"\"Split a bill evenly; the first p\u001b[51Grs\u001b[54Gn pays the\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m    \u001b[22m \u001b[38;5;24m leftover cents so the shares sum to the total.\"\"\"\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  8 -\u001b[38;5;236m    share = div_cents(total_cents, people)           \r\u001b[7C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m6\u001b[15G\u001b[38;5;236mshare = total_cents \u001b[48;5;157m// \u001b[48;5;194mpeo\u001b[42Gle   \r\u001b[5C\u001b[1B\u001b[38;5;29m  7 +\u001b[38;5;236m    remainder = total_cents % people                 \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m  8 \u001b[22m     shares = [share] * people\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m 10 -\u001b[38;5;236m    shares[0] += total_cents - share * people        \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  9 +\u001b[38;5;236m    shares[\u001b[38;5;31m0\u001b[38;5;236m] += remainder                           \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 10 \u001b[22m     \u001b[38;5;125mreturn\u001b[38;5;236m shares\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow\u001b[7Glet\u001b[11Gme\u001b[14Grun\u001b[18Gall\u001b[22Gtests\u001b[28Gagain\u001b[34Gto\u001b[37Gverify\u001b[44Geverything\u001b[55Gpasses:\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;5;241mRan \u001b[1m1\u001b[22m shell co\u001b[18Gmand \u001b[39m\u001b[K\r\u001b[2B\u001b[38;5;16m●\u001b[3G\u001b[39mPerfect! All tests pass. Here's what I fixed:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
