d \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mPerfect!\u001b[12GAll\u001b[16Gtests\u001b[22Gpass.\u001b[28GHere's\u001b[35Gwhat\u001b[40GI\u001b[42Gfixed:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[38;5;105m\u001b[1mapp/money.py\u001b[22m\u001b[39m:\u001b[20GChanged\u001b[28G\u001b[38;5;105mdiv_cents()\u001b[40G\u001b[39mto\u001b[43Ground\u001b[49Ghalf\u001b[54Gup\u001b[57Ginstead\u001b[65Gof\r\u001b[2C\u001b[1B  \u001b[6Gdropping fractions. Now \u001b[38;5;105mdiv_cents(7350, 100)\u001b[39m ret\u001b[55Grns 74 instead\r\u001b[5C\u001b[1Bof 73, which f\u001b[21Gxe\u001b[24G the tax rounding issue (7% tax on\u001b[59G1050 cents\u001b[70G=\r\u001b[5C\u001b[1B74\u001b[9Gcents).\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[38;5;105m\u001b[1mapp/split.py\u001b[22m\u001b[39m:\u001b[20GUpdated\u001b[28G\u001b[38;5;105msplit_bill()\u001b[41G\u001b[39mto\u001b[44Guse\u001b[48Gfloor\u001b[54Gdivision\u001b[63G(\u001b[38;5;105m//\u001b[39m)\u001b[68Gand\r\u001b[2C\u001b[1B  \u001b[6Gmodulo (\u001b[38;5;105m%\u001b[39m) directly instead of calling \u001b[38;5;105mdiv_cents()\u001b[39m. This\u001b[63Gensures\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
