[40.390682, "o", "\u001b[?25l\u001b[H     \u001b[38;5;236m\u001b[2m 4 \u001b[22m \u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97mdiv_cents\u001b[38;5;236m(\u001b[38;5;31mtotal_cents: int, divisor: int\u001b[38;5;236m) -> \u001b[38;5;31mint\u001b[38;5;236m:\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m 5 -\u001b[38;5;236m    \"\"\"Divide a cent amount by `divisor`; fractions of\r\u001b[5C\u001b[1B\u001b[38;5;160m   -\u001b[38;5;236m a cent are dropped.\"\"\"                               \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 5 +\u001b[38;5;236m    \u001b[38;5;24m\"\"\"Divide a cent amount by `divisor`; fractions of\r\u001b[5C\u001b[1B\u001b[38;5;29m   +\u001b[38;5;24m a cent are \u001b[48;5;157mrounded half up\u001b[48;5;194m.\"\"\"\u001b[38;5;236m                       \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 6 \u001b[22m     \u001b[38;5;125mif\u001b[38;5;236m divisor <= \u001b[38;5;31m0\u001b[38;5;236m:\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 7 \u001b[22m         \u001b[38;5;125mraise\u001b[38;5;236m ValueError(\u001b[38;5;24m\"divisor must be positive\"\u001b[38;5;236m)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m 8 -\u001b[38;5;236m    return total_cents // divisor                     \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 8 +\u001b[38;5;236m    \u001b[38;5;125mreturn\u001b[38;5;236m \u001b[48;5;157m(\u001b[48;5;194mtotal_cents \u001b[48;5;157m+ divisor \u001b[48;5;194m// \u001b[38;5;31m\u001b[48;5;157m2\u001b[38;5;236m) // \u001b[48;5;194mdivisor    \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow let me run the money tests to verify the fix:\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mPerfect!\u001b[12GThe\u001b[16Gmoney\u001b[22Gtests\u001b[28Gpass.\u001b[34GNow\u001b[38Glet\u001b[42Gme\u001b[45Grun\u001b[49Gthe\u001b[53Gfull\u001b[58Gtest\u001b[63Gsuite\u001b[69Gto\r\u001b[2C\u001b[1Bensure nothing else broke:\r\u001b[2B \u001b[3G\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mThere\u001b[9Gare\u001b[13Gfailing\u001b[21Gtests\u001b[27Gin\u001b[30Gthe\u001b[34Gsplit\u001b[40Gmodule.\u001b[48GLet\u001b[52Gme\u001b[55Gcheck\u001b[61Ghow\r\u001b[2C\u001b[1B\u001b[38;5;105msplit_bill()\u001b[39m works:\u001b[K\r\u001b[2B\u001b[38;5;241m \u001b[3G\u001b[39mReading \u001b[1m1\u001b[14G\u001b[22mile…\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[40.489633, "o", "\u001b[?25l\u001b[H\r\u001b[24B\u001b[38;5;174m*\u001b[6G\u001b[38;5;216mn\u001b[9G\u001b[38;5;174mg\u001b[14G\u001b[38;5;241m2\u001b[23G9\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
