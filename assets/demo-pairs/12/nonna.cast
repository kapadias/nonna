[58.66255, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;5;236m\u001b[2m    \u001b[22m [\u001b[38;5;31mint\u001b[38;5;236m]:\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m5\u001b[11G\u001b[22m   \u001b[15G\u001b[38;5;24m\"\"\"Split a bill evenly; the first person pays the\r\u001b[10C\u001b[1B leftover cents so the shares sum to the total.\"\"\"\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  8 -\u001b[38;5;236m    share = div_cents(total_cents, people)           \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  6 +\u001b[38;5;236m    share = total_cents \u001b[48;5;157m// \u001b[48;5;194mpeople                    \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m  7 \u001b[22m     shares = [share] * people\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  8 \u001b[22m     shares[\u001b[38;5;31m0\u001b[38;5;236m] += total_cents - share * people\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m9\u001b[15G\u001b[22m\u001b[38;5;125mreturn\u001b[22G\u001b[38;5;236mshares\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow let me run the full test\u001b[32Gsuite\u001b[38Gagain:\r\u001b[2B \u001b[3G\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;5;16m●\u001b[3G\u001b[39mDone! All tests pass.\u001b[25GHere's\u001b[32Gwhat\u001b[37GI\u001b[39Gfixed:\r\u001b[2B \u001b[3G1. \u001b[1mUpdated \u001b[38;5;105mdiv_cents()\u001b[39m to use round-half-up\u001b[22m:\u001b[48GChanged\u001b[56Gfrom\u001b[61Gfloor\r\u001b[5C\u001b[1Bdivision\u001b[15G(\u001b[38;5;105m//\u001b[39m)\u001b[20Gto\u001b[23Gthe\u001b[27Gformula\u001b[35G\u001b[38;5;105m(total_cents + divisor // 2) // \r\u001b[2C\u001b[1B\u001b[39m  \u001b[6G\u001b[38;5;105mdivisor\u001b[39m, which rounds fractions of a cent\u001b[48Gup at the 0.5 b\u001b[64Gundary.\r\u001b[5C\u001b[1BThis fixes the tax rounding:\u001b[35G7% of 1050 cents now correctly\u001b[K\r\u001b[5C\u001b[1Bcalculates to 74 cents ins\u001b[33Gead of 73.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mUpdated \u001b[38;5;105msplit_bill()\u001b[39m to use floor division directly\u001b[22m: Since\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;105msplit_bill()\u001b[39m has\u001b[23Gits own logic\u001b[37Gfor handling\u001b[50Gremainders\u001b[61G(giving\r\u001b[2C\u001b[1B  \u001b[6Gthe first person the leftover cents), it doesn't need the\u001b[K\r\u001b[5C\u001b[1Brounding behavior from \u001b[38;5;105mdiv_cents()\u001b[39m. It now us\u001b[52Gs \u001b[38;5;105m//\u001b[39m directly.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
