[33.027678, "o", "\u001b[?25l\u001b[H\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m2\u001b[14G\u001b[22mlines,\u001b[21Gremoved\u001b[29G\u001b[1m2\u001b[31G\u001b[22mlines\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m2\r\u001b[6C\u001b[1B3\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 4 \u001b[22m \u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97mdiv_cents\u001b[38;5;236m(\u001b[38;5;31mtotal_cents: int, divisor: int\u001b[38;5;236m) -> \u001b[38;5;31mint\u001b[38;5;236m:\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m5\u001b[11G\u001b[38;5;236m \u001b[13G \"\"\"Divide a c\u001b[28Gnt amount\u001b[38Gby\u001b[41G`divisor`;\u001b[52Gfractions\u001b[62Gof\r\u001b[5C\u001b[1B\u001b[38;5;160m   -\u001b[38;5;236m a cent are dropped.\"\"\"                               \r\u001b[6C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m5\u001b[10G\u001b[38;5;236m    \u001b[38;5;24m\"\"\"Divide a cent amount by `divisor`; fractions of\r\u001b[5C\u001b[1B\u001b[38;5;29m   +\u001b[38;5;24m a cent \u001b[48;5;157mround\u001b[48;5;194m \u001b[48;5;157mhalf up\u001b[48;5;194m.\"\"\"\u001b[38;5;236m                             \r\u001b[6C\u001b[1B\u001b[49m\u001b[2m6\u001b[14G\u001b[22m\u001b[38;5;125mif\u001b[17G\u001b[38;5;236mdivisor <= \u001b[38;5;31m0\u001b[38;5;236m:\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 7 \u001b[22m         \u001b[38;5;125mraise\u001b[38;5;236m ValueError(\u001b[38;5;24m\"divisor must be positive\"\u001b[38;5;236m)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m 8 -\u001b[38;5;236m    return total_cents // divisor                     \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 8 +\u001b[38;5;236m    \u001b[38;5;125mreturn\u001b[38;5;236m \u001b[48;5;157m(\u001b[48;5;194mtotal_cents \u001b[48;5;157m+ divisor \u001b[48;5;194m// \u001b[38;5;31m\u001b[48;5;157m2\u001b[38;5;236m) // \u001b[48;5;194mdivisor    \r\u001b[1B\u001b[49m\u001b