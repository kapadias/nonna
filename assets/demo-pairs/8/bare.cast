[28.899166, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[21Breturn\u001b[10G74\u001b[13G(rounding\u001b[23G73.5\u001b[28Gup),\u001b[33Gbut\u001b[37Gthe\u001b[41Gcurrent\u001b[49Gimplementation\u001b[64Guses\u001b[30;1H\u001b[28;3H\u001b[?25h"]
