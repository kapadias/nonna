nts()\u001b[30G\u001b[39mfunction:\r\u001b[2B\u001b[38;5;241m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(\u001b]8;id=h30f5e;file:///root/bare-app/app/money.py\u0007app/money.py\u001b]8;;\u0007)\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
