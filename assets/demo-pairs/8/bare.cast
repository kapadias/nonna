[31.280442, "o", "\u001b[?25l\u001b[H\u001b[3Greturn\u001b[10G74\u001b[13G(rounding\u001b[23G73.5\u001b[28Gup),\u001b[33Gbut\u001b[37Gthe\u001b[41Gcurrent\u001b[49Gimplementation\u001b[64Guses\r\u001b[1B \u001b[3Gfloor\u001b[9Gdivi\u001b[14Gion which r\u001b[26Gturns\u001b[32G73. I ne\u001b[41Gd to implement half-up\u001b[K\r\u001b[3C\u001b[1Bounding instea\u001b[19G.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BLet me fix th\u001b[17G \u001b[38;5;105mdiv_cents()\u001b[30G\u001b[39mfunction:\r\u001b[2B\u001b[38;5;65m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(\u001b]8;id=h30f5e;file:///root/bare-app/app/money.py\u0007app/money.py\u001b]8;;\u0007)\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m2\u001b[14G\u001b[22mlines,\u001b[21Gremoved\u001b[29G\u001b[1m2\u001b[31G\u001b[22mlines\r\u001b[1B \u001b[3G   \u001b[38;5;236m\u001b[2m 2 \u001b[22m \u001b[39m\u001b[K\r\u001b[1B     \u001b[38;5;236m\u001b[2m 3 \u001b[22m \u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m4\u001b[10G\u001b[22m\u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97mdiv_cents\u001b[38;5;236m(\u001b[38;5;31mtotal_cents: int, divisor: int\u001b[38;5;236m) -> \u001b[38;5;31mint\u001b[38;5;236m:\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m 5 -\u001b[38;5;236m    \"\"\"Divide a cent amount by `divisor`; fractions of\r\u001b[5C\u001b[1B\u001b[38;5;160m   -\u001b[38;5;236m a cent are dropped.\"\"\"                               \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 5 +\u001b[38;5;236m    \u001b[38;5;24m\"\"\"Divide a cent amount by `divisor`; fractions of\r\u001b[5C\u001b[1B\u001b[38;5;29m   +\u001b[38;5;24m a cent \u001b[48;5;157mround\u001b[48;5;194m \u001b[48;5;157mhalf up\u001b[48;5;194m.\"\"\"\u001b[38;5;236m                             \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 6 \u001b[22m     \u001b[38;5;125mif\u001b[38;5;236m divisor <= \u001b[38;5;31m0\u001b[38;5;236m:\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[