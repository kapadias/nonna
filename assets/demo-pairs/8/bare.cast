[28.792402, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[20BNow\u001b[7GI\u001b[9Gcan\u001b[13Gsee\u001b[17Gthe\u001b[21Gissue.\u001b[28GThe\u001b[32Gtest\u001b[37Gexpects\u001b[45G\u001b[38;5;105mdiv_cents(7350, 100)\u001b[66G\u001b[39mto\u001b[30;1H\u001b[28;3H\u001b[?25h"]
