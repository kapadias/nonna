38;5;16m●\u001b[3G\u001b[39mNow\u001b[7Glet\u001b[11Gme\u001b[14Grun\u001b[18Gthe\u001b[22Gfull\u001b[27Gtest\u001b[32Gsuite\u001b[38Gagain:\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;241m●\u001b[39m Running \u001b[1m1\u001b[22m shell command…\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  $ python3 -m pytest -q\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;174m✢\u001b[39m \u001b[38;5;216mScurrying…\u001b[38;5;174m \u001b[38;5;241m(46s · ↓\u001b[23G5.1k tokens)\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
