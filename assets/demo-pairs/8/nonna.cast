[39.279944, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;5;236m\u001b[2m  4 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  5 +\u001b[38;5;236m                                                     \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m  6 \u001b[22m \u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97mdiv_cents\u001b[38;5;236m(\u001b[38;5;31mtotal_cents: int, divisor: int\u001b[38;5;236m) -> \u001b[38;5;31mint\u001b[38;5;236m:\r\u001b[7C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m5\u001b[11G\u001b[38;5;236m \u001b[13G \u001b[15G\"\"\"Divide a cent amount\u001b[39Gby\u001b[42G`divisor`;\u001b[53Gfractions\u001b[63Go\r\u001b[5C\u001b[1B\u001b[38;5;160m    -\u001b[38;5;236mf a cent are dropped.\"\"\"                             \r\u001b[7C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m7\u001b[11G\u001b[38;5;236m    \u001b[38;5;24m\"\"\"Divide a cent amount by `divisor`; fractions o\r\u001b[5C\u001b[1B\u001b[38;5;29m    +\u001b[38;5;24mf a cent are \u001b[48;5;157mrounded half up\u001b[48;5;194m.\"\"\"\u001b[38;5;236m                     \r\u001b[7C\u001b[1B\u001b[49m\u001b[2m8\u001b[15G\u001b[22m\u001b[38;5;125mif\u001b[18G\u001b[38;5;236mdivisor <= \u001b[38;5;31m0\u001b[38;5;236m:\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  9 \u001b[22m         \u001b[38;5;125mraise\u001b[38;5;236m ValueError(\u001b[38;5;24m\"divisor must be positive\"\u001b[38;5;236m)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  8 -\u001b[38;5;236m    return total_cents // divisor                    \r\u001b[7C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m0\u001b[15G\u001b[38;5;236m\u001b[48;5;157mresult\u001b[48;5;194m \u001b[48;5;157m= Decimal(\u001b[48;5;194mtotal_cents\u001b[48;5;157m)\u001b[48;5;194m / \u001b[48;5;157mDecimal(\u001b[48;5;194mdivisor\u001b[48;5;157m)\u001b[48;5;194m \r\u001b[6C\u001b[1B\u001b[38;5;29m11\u001b[11G\u001b[38;5;236m    \u001b[38;5;125mreturn\u001b[38;5;236m \u001b[38;5;31mint\u001b[38;5;236m(result.quantize(Decimal(\u001b[38;5;31m1\u001b[38;5;236m), rounding=R\r\u001b[5C\u001b[1B\u001b[38;5;29m    +\u001b[38;5;236mOUND_HALF_UP))                                       \r\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow\u001b[7Glet\u001b[11Gme\u001b[14Grun\u001b[18Gthe\u001b[22Gmoney\u001b[28Gtests\u001b[34Gto\u001b[37Gverify\u001b[44Gthe\u001b[48Gfix:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow let me\u001b[14Grun\u001b[18Gthe\u001b[22Gfull\u001b[27Gtest\u001b[32Gsuite\u001b[38Gto\u001b[41Gensure\u001b[48GI\u001b[50Gdidn't\u001b[57Gbreak\r\u001b[2C\u001b[1Banything:\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B Running python3 -m pytest\u001b[29G-q\r\u001b[1B\u001b[38;5;241m  ⎿  $ python3 -m pytest -q\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;174m✽\u001b[39m \u001b[38;5;180mScurrying…\u001b[38;5;174m \u001b[38;5;241m(20s · ↓\u001b[23G2.1k tokens)\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
