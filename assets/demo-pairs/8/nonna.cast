b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mDone!\u001b[9GI've\u001b[14Gfixed\u001b[20Gthe\u001b[24Grounding\u001b[33Gissue:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mChanges made:\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[38;5;105m\u001b[1mapp/money.py\u001b[22m\u001b[39m:\u001b[20GUpdated\u001b[28G\u001b[38;5;105mdiv_cents()\u001b[40G\u001b[39mto\u001b[43Guse\u001b[47Ground-half-up\u001b[61Gbehavior\r\u001b[2C\u001b[1B  \u001b[6G(via Python's\u001b[20G\u001b[38;5;105mDecimal\u001b[28G\u001b[39mmodule) instead of\u001b[47Gfloor division. Now 7350\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[70.227213, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;5;236m\u001b[2m    \u001b[22m [\u001b[38;5;31mint\u001b[38;5;236m]:\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m5\u001b[11G\u001b[22m   \u001b[15G\u001b[38;5;24m\"\"\"Split a bill evenly; the first person pays the\r\u001b[10C\u001b[1B leftover cents so the shares sum to the total.\"\"\"\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  8 -\u001b[38;5;236m    share = div_cents(total_cents, people)           \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  6 +\u001b[38;5;236m    share = total_cents \u001b[48;5;157m// \u001b[48;5;194mpeople                    \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m  7 \u001b[22m     shares = [share] * people\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  8 \u001b[22m     shares[\u001b[38;5;31m0\u001b[38;5;236m] += total_cents - share * people\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m9\u001b[15G\u001b[22m\u001b[38;5;125mreturn\u001b[22G\u001b[38;5;236mshares\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow let me run the full test\u001b[32Gsuite\u001b[38Gagain:\r\u001b[2B \u001b[3G\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;5;16m●\u001b[3G\u001b[39mPerfect! All tests pass.\u001b[28GLet\u001b[32Gme\u001b[35Gverify\u001b[42Gthe\u001b[46Gmoney\u001b[52Gtests\u001b[58Gspecifically:\r\u001b[2B \u001b[3G\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;5;16m●\u001b[3G\u001b[39mDone! I've fixed the\u001b[24Grounding\u001b[33Gissue:\r\u001b[2B \u001b[3G\u001b[1mChanges made:\u001b[22m\u001b[K\r\u001b[2C\u001b[2B1. \u001b[38;5;105m\u001b[1mapp/money.py\u001b[22m\u001b[39m:\u001b[20GUpdated\u001b[28G\u001b[38;5;105mdiv_cents()\u001b[40G\u001b[39mto\u001b[43Guse\u001b[47Ground-half-up\u001b[61Gbehavior\r\u001b[5C\u001b[1B(via\u001b[11GPython's\u001b[20G\u001b[38;5;105mDecimal\u001b[28G\u001b[39mmodule)\u001b[36Ginstead\u001b[44Gof\u001b[47Gfloor\u001b[53Gdivision.\u001b[63GNow\u001b[67G7350\r\u001b[2C\u001b[1B  \u001b[6G÷ 100 correctly roun\u001b[27Gs to 74 cents.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[38;5;105m\u001b[1mapp/split.py\u001b[22m\u001b[39m:\u001b[20GUpdated\u001b[28G\u001b[38;5;105msplit_bill()\u001b[39m to\u001b[44Guse fl\u001b[51Gor division\u001b[63G\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
