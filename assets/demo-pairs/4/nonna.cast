[69.883097, "o", "\u001b[?25l\u001b[H\u001b[3G1.\u001b[6G\u001b[38;5;105m\u001b[1mapp/money.py\u001b[22m\u001b[39m:\u001b[20GUpdated\u001b[28G\u001b[38;5;105mdiv_cents()\u001b[40G\u001b[39mto\u001b[43Guse\u001b[47Ghalf-up\u001b[55Grounding\u001b[64Gvia\r\u001b[2C\u001b[1B  \u001b[6GPython's \u001b[38;5;105mDecimal\u001b[39m module with \u001b[38;5;105mROUND_HALF_UP\u001b[39m. Now 7350 ÷ 100\u001b[K\r\u001b[5C\u001b[1Bcorrectly rounds\u001b[23Gt\u001b[25G 74 (no\u001b[33G 73), and 7% tax\u001b[50Gon 1050 cents is\r\u001b[5C\u001b[1Bprop\u001b[11Grly calculated\u001b[26Gas\u001b[29G74 cents.\u001b[39G\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[38;5;105m\u001b[1mapp/split.py\u001b[22m\u001b[39m: Changed \u001b[38;5;105msplit_bill()\u001b[41G\u001b[39mto\u001b[44Guse\u001b[48Gfloor\u001b[54Gdivision\u001b[63G(\u001b[38;5;105m//\u001b[39m)\r\u001b[2C\u001b[1B  \u001b[6Gdirectly instead of calling \u001b[38;5;105md\u001b[36Gv_cents()\u001b[39m. Bi\u001b[50Gl spl\u001b[56Gtting and tax\r\u001b[5C\u001b[1Bcalculatio\u001b[18G need differe\u001b[32Gt\u001b[34Grounding strategie\u001b[53G—splitting uses\u001b[K\r\u001b[5C\u001b[1Bfloor divisio\u001b[20G with th\u001b[29G first person\u001b[43Gabsorbing leftover cents.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BAll\u001b[7G9\u001b[9Gtests\u001b[15Gpass,\u001b[21Gincluding\u001b[31Gthe\u001b[35Gthree\u001b[41Gmoney\u001b[47Gtests\u001b[53Gthat\u001b[58Gwere\u001b[63Gfailing\r\u001b[2C\u001b[1Bbefore.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B●\u001b[3GRan\u001b[7G\u001b[1m1\u001b[9G\u001b[22mstop\u001b[14Ghook\r\u001b[1B \u001b[3G\u001b[38;5;241m⎿  \u001b[39mStop hook error:\u001b[23G✗\u001b[25GNonna:\u001b[32Gwhere's\u001b[40Gthe\u001b[44Gtest?\u001b[50G(stop:\u001b[57Gcode\r\u001b[2C\u001b[1Bchanged, n\u001b[14G t\u001b[17Gst changed)\u001b[K\r\u001b[2C\u001b[1BAdd a test that fails without\u001b[33Gyour\u001b[38Gchange\u001b[45Gand\u001b[49Gpasses\u001b[56Gwith\r\u001b[2C\u001b[1Bit,\u001b[7Gor tell the\u001b[19Guser plainly why this change need\u001b[53G none.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2B\u001b[38;5;16m●\u001b[3G\u001b[39mThe\u001b[7Gtests\u001b[13Gthat\u001b[18Gvalidate\u001b[27Gmy\u001b[30Gfixes\u001b[36Gwere\u001b[41Galready\u001b[49Gwritten\u001b[57Gand\u001b[61Gpinned\u001b[68Gthe\r\u001b[1B \u001b[3Grequired be\u001b[16Gvior—th\u001b[25G's what the us\u001b[40Gr meant by\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
