[30.543363, "o", "\u001b[?25l\u001b[H\u001b[3G(\u001b[38;5;105m//\u001b[39m), which drops fracti\u001b[28Gns.\u001b[32GIt needs to round half\u001b[55Gup\u001b[58Ginstead.\u001b[67GFor\r\u001b[2C\u001b[1B7350\u001b[8G÷\u001b[10G100\u001b[14G=\u001b[16G73.5,\u001b[22Git\u001b[25Gshould\u001b[32Greturn\u001b[39G74,\u001b[43Gnot\u001b[47G73.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI'll\u001b[8Gfix\u001b[12Git\u001b[15Gusing\u001b[21Gthe\u001b[25Gstandard\u001b[34Ground-half-up\u001b[48Gformula:\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;65m●\u001b[39m \u001b[1mUpdate\u001b[22m(\u001b]8;id=j806qk;file:///root/nonna-app/app/money.py\u0007app/money.py\u001b]8;;\u0007)\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m2\u001b[14G\u001b[22mlines,\u001b[21Gremoved\u001b[29G\u001b[1m2\u001b[31G\u001b[22mlines\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m2\r\u001b[6C\u001b[1B3\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 4 \u001b[22m \u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97mdiv_cents\u001b[38;5;236m(\u001b[38;5;31mtotal_cents: int, divisor: int\u001b[38;5;236m) -> \u001b[38;5;31mint\u001b[38;5;236m:\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m5\u001b[11G\u001b[38;5;236m \u001b[13G \"\"\"Divide a c\u001b[28Gnt amount\u001b[38Gby\u001b[41G`divisor`;\u001b[52Gfractions\u001b[62Gof\r\u001b[5C\u001b[1B\u001b[38;5;160m   -\u001b[38;5;236m a cent are dropped.\"\"\"                               \r\u001b[6C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m5\u001b[10G\u001b[38;5;236m    \u001b[38;5;24m\"\"\"Divide a cent amount by `divisor`; fractions of\r\u001b[5C\u001b[1B\u001b[38;5;29m   +\u001b[38;5;24m a cent \u001b[48;5;157mround\u001b[48;5;194m \u001b[48;5;157mhalf up\u001b[48;5;194m.\"\"\"\u001b[38;5;236m                             \r\u001b[6C\u001b[1B\u001b[49m\u001b[2m6\u001b[14G\u001b[22m\u001b[38;5;125mif\u001b[17G\u001b[38;5;236mdivisor <= \u001b[38;5;31m0\u001b[38;5;236m:\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 7 \u001b[22m         \u001b[38;5;125mraise\u001b[38;5;236m ValueError(\u001b[38;5;24m\"divisor must be positive\"\u001b[38;5;236m)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m 8 -\u001b[38;5;236m    return total_cents // divisor                     \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 8 +\u001b[38;5;236m    \u001b[38;5;125mreturn\u001b[38;5;236m \u001b[48;5;157m(\u001b[48;5;194mtotal_cents \u001b[48;5;157m+ divisor \u001b[48;5;194m// \u001b[38;5;31m\u001b[48;5;157m2\u001b[38;5;236m) // \u001b[48;5;194mdivisor    \r\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow\u001b[7Glet\u001b[11Gme\u001b[14Grun\u001b[18Gthe\u001b[22Gtests\u001b[28Gto\u001b[31Gverify\u001b[38Gthe\u001b[42Gfix:\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B Running \u001b[1m1\u001b[22m shell command…\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  $ python3 -m pytest tests/test_money.py -v\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;174m✢\u001b[39m \u001b[38;5;216mNesting…\u001b[38;5;174m \u001b[38;5;241m(12s · ↓\u001b[21G1.3k tokens)\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
