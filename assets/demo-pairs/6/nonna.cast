[61.226812, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mI\u001b[5Gsee\u001b[9Gthe\u001b[13Gissue.\u001b[20GMy\u001b[23Gchange\u001b[30Gto\u001b[33G\u001b[38;5;105mdiv_cents\u001b[43G\u001b[39maffects\u001b[51G\u001b[38;5;105msplit_bill\u001b[39m,\u001b[63Gwhich\r\u001b[1B \u001b[3Gr\u001b[5Gli\u001b[8Gs on floor division\u001b[28Gto distribute\u001b[42Gthe exact tota\u001b[57G. Bill\u001b[K\r\u001b[2C\u001b[1Bsplitti\u001b[11Gg should use floor\u001b[30Gdivision\u001b[39G(to\u001b[43Gensure\u001b[50Gthe\u001b[54Gtotal\u001b[60Gisn't\r\u001b[2C\u001b[1Bexceeded),\u001b[14Gwhile\u001b[20Gtax\u001b[24Gshould\u001b[31Ground\u001b[37Ghalf\u001b[42Gup.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BLet\u001b[7Gme\u001b[10Glook\u001b[15Gat\u001b[18Gwhich\u001b[24Gfunction\u001b[33Gshould\u001b[40Guse\u001b[44Gwhich\u001b[50Grounding:\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;65m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(\u001b]8;id=1rvxy0y;file:///root/nonna-app/app/split.py\u0007app/split.py\u001b]8;;\u0007)\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m1\u001b[14G\u001b[22mline,\u001b[20Gremoved\u001b[28G\u001b[1m1\u001b[30G\u001b[22mline\r\u001b[2C\u001b[1B   \u001b[38;5;236m\u001b[2m  5 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  6 \u001b[22m \u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97msplit_bill\u001b[38;5;236m(\u001b[38;5;31mtotal_cents: int, people: int\u001b[38;5;236m) -> \u001b[38;5;31mlist\r\u001b[1B\u001b[39m \u001b[3G \u001b[5G \u001b[38;5;236m\u001b[2m    \u001b[22m [\u001b[38;5;31mint\u001b[38;5;236m]:\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;236m\u001b[2m  7 \u001b[22m     \u001b[38;5;24m\"\"\"Split a bill evenly; the first person pays the\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;5;236m\u001b[2m    \u001b[22m \u001b[38;5;24m leftover cents so the shares sum to the total.\"\"\"\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;160m\u001b[48;5;224m  8 -\u001b[38;5;236m    share = div_cents(total_cents, people)           \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  8 +\u001b[38;5;236m    share = total_cents \u001b[48;5;157m// \u001b[48;5;194mpeople                    \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;5;236m\u001b[2m  9 \u001b[22m     shares = [share] * people\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 10 \u001b[22m     shares[\u001b[38;5;31m0\u001b[38;5;236m] += total_cents - share * people\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;236m\u001b[2m 11 \u001b[22m     \u001b[38;5;125mreturn\u001b[38;5;236m shares\r\u001b[12C\u001b[2B\u001b[38;5;241m42s · ↓\u001b[39m \u001b[38;5;241m4.6k t\u001b[28Gkens)\u001b[39m\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
