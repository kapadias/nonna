eople                    \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m  9 \u001b[22m     shares = [share] * people\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 10 \u001b[22m     shares[\u001b[38;5;31m0\u001b[38;5;236m] += total_cents - share * people\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m11\u001b[15G\u001b[22m\u001b[38;5;125mreturn\u001b[22G\u001b[38;5;236mshares\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[6G\u001b[39m\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
