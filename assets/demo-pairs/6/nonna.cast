[69.103227, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[38;5;236m\u001b[2m6\u001b[11G\u001b[22m\u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97msplit_bill\u001b[38;5;236m(\u001b[38;5;31mtotal_cents: int, people: int\u001b[38;5;236m) -> \u001b[38;5;31mlist\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m \u001b[11G\u001b[22m[\u001b[38;5;31mint\u001b[38;5;236m]:\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m7\u001b[11G\u001b[22m    \u001b[38;5;24m\"\"\"Split a bill evenly; the first person pays the\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m \u001b[11G\u001b[22m\u001b[38;5;24m leftover cents so the shares sum to th\u001b[51G t\u001b[54Gtal.\"\"\"\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  8 -\u001b[38;5;236m    share = div_cents(total_cents, people)           \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  8 +\u001b[38;5;236m    share = total_cents \u001b[48;5;157m// \u001b[48;5;194mpeople                    \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m  9 \u001b[22m     shares = [share] * people\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m10\u001b[21G\u001b[22m[\u001b[38;5;31m0\u001b[38;5;236m] += total_c\u001b[36Gnts - share * people\r\u001b[7C\u001b[1B\u001b[2m1\u001b[15G\u001b[22m\u001b[38;5;125mreturn\u001b[38;5;236m shares\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow\u001b[7Glet\u001b[11Gme\u001b[14Grun\u001b[18Gthe\u001b[22Gfull\u001b[27Gtest\u001b[32Gsuite\u001b[38Gagain:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mPerfect!\u001b[12GAll\u001b[16Gtests\u001b[22Gpass.\u001b[28GLet\u001b[32Gme\u001b[35Gverify\u001b[42Gonce\u001b[47Gmore\u001b[52Gthat\u001b[57Gthe\u001b[61Gmoney\r\u001b[1B \u001b[3Gt\u001b[5Gsts specifically\u001b[22Gare working cor\u001b[38Gectly:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mDone!\u001b[9GThe\u001b[13Grounding\u001b[22Gfix\u001b[26Gis\u001b[29Gcomplete\u001b[38Gand\u001b[42Gall\u001b[46Gtests\u001b[52Gpass.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSummary of changes:\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[38;5;105m\u001b[1mapp/money.py\u001b[22m\u001b[39m:\u001b[20GChanged\u001b[28G\u001b[38;5;105mdiv_cents()\u001b[40G\u001b[39mto\u001b[43Ground\u001b[49Gfractions\u001b[59Gof\u001b[62Ga\u001b[64Gcent\r\u001b[2C\u001b[1B  \u001b[6Ghalf up using\u001b[20G\u001b[38;5;105m(total_cents + divisor // 2) // divisor\u001b[39m instead of\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[69.20945, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[38;5;236m\u001b[2m \u001b[11G\u001b[22m[\u001b[38;5;31mint\u001b[38;5;236m]:\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m7\u001b[11G\u001b[22m    \u001b[38;5;24m\"\"\"Split a bill evenly; the first person pays the\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m \u001b[11G\u001b[22m\u001b[38;5;24m leftover cents so the shares sum to th\u001b[51G t\u001b[54Gtal.\"\"\"\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  8 -\u001b[38;5;236m    share = div_cents(total_cents, people)           \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  8 +\u001b[38;5;236m    share = total_cents \u001b[48;5;157m// \u001b[48;5;194mpeople                    \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m  9 \u001b[22m     shares = [share] * people\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m10\u001b[21G\u001b[22m[\u001b[38;5;31m0\u001b[38;5;236m] += total_c\u001b[36Gnts - share * people\r\u001b[7C\u001b[1B\u001b[2m1\u001b[15G\u001b[22m\u001b[38;5;125mreturn\u001b[38;5;236m shares\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow\u001b[7Glet\u001b[11Gme\u001b[14Grun\u001b[18Gthe\u001b[22Gfull\u001b[27Gtest\u001b[32Gsuite\u001b[38Gagain:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mPerfect!\u001b[12GAll\u001b[16Gtests\u001b[22Gpass.\u001b[28GLet\u001b[32Gme\u001b[35Gverify\u001b[42Gonce\u001b[47Gmore\u001b[52Gthat\u001b[57Gthe\u001b[61Gmoney\r\u001b[1B \u001b[3Gt\u001b[5Gsts specifically\u001b[22Gare working cor\u001b[38Gectly:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mDone!\u001b[9GThe\u001b[13Grounding\u001b[22Gfix\u001b[26Gis\u001b[29Gcomplete\u001b[38Gand\u001b[42Gall\u001b[46Gtests\u001b[52Gpass.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSummary of changes:\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[38;5;105m\u001b[1mapp/money.py\u001b[22m\u001b[39m:\u001b[20GChanged\u001b[28G\u001b[38;5;105mdiv_cents()\u001b[40G\u001b[39mto\u001b[43Ground\u001b[49Gfractions\u001b[59Gof\u001b[62Ga\u001b[64Gcent\r\u001b[2C\u001b[1B  \u001b[6Ghalf up using\u001b[20G\u001b[38;5;105m(total_cents + divisor // 2) // divisor\u001b[39m instead of\r\u001b[5C\u001b[1Bfloor division. This makes tax calculations correct: 7% of 1050\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[69.323168, "o", "\u001b[?25l\u001b[H\u001b[11G\u001b[38;5;24m leftover cents so the shares sum to the total.\"\"\"\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  8 -\u001b[38;5;236m    share = div_cents(total_cents, people)           \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  8 +\u001b[38;5;236m    share = total_cents \u001b[48;5;157m// \u001b[48;5;194mpeople                    \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m  9 \u001b[22m     shares = [share] * people\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 10 \u001b[22m     shares[\u001b[38;5;31m0\u001b[38;5;236m] += total_cents - share * people\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m11\u001b[15G\u001b[22m\u001b[38;5;125mreturn\u001b[22G\u001b[38;5;236mshares\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow let me run the full test\u001b[32Gsuite\u001b[38Gagain:\r\u001b[2B \u001b[3G\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;5;16m●\u001b[3G\u001b[39mPerfect! All tests pass.\u001b[28GLet\u001b[32Gme\u001b[35Gverify\u001b[42Gonce\u001b[47Gmore\u001b[52Gthat\u001b[57Gthe\u001b[61Gmoney\r\u001b[2C\u001b[1Btests\u001b[9Gspecifically\u001b[22Gare\u001b[26Gworking\u001b[34Gcorrectly:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;5;16m●\u001b[3G\u001b[39mDone! The rounding fix\u001b[26Gis\u001b[29Gcomplete\u001b[38Gand\u001b[42Gall\u001b[46Gtests\u001b[52Gpass.\r\u001b[2B \u001b[3G\u001b[1mSummary of changes:\u001b[22m\u001b[K\r\u001b[2C\u001b[2B1. \u001b[38;5;105m\u001b[1mapp/money.py\u001b[22m\u001b[39m: Changed\u001b[28G\u001b[38;5;105mdiv_cents()\u001b[40G\u001b[39mto\u001b[43Ground\u001b[49Gfractions\u001b[59Gof\u001b[62Ga\u001b[64Gcent\r\u001b[5C\u001b[1Bhalf\u001b[11Gup\u001b[14Gusing\u001b[20G\u001b[38;5;105m(total_cents + divisor // 2) // divisor\u001b[60G\u001b[39minstead\u001b[68Gof\r\u001b[2C\u001b[1B  \u001b[6Gfloor division. This makes tax calculations correct:\u001b[59G7%\u001b[62Gof 1050\r\u001b[5C\u001b[1Bcents =\u001b[14G73.5 cents → 74 cents.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[69.436183, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[24B\u001b[38;5;105m\u001b[1mapp/split.py\u001b[22m\u001b[39m:\u001b[20GUpdated\u001b[28G\u001b[38;5;105msplit_bill()\u001b[41G\u001b[39mto\u001b[44Guse\u001b[48Gfloor\u001b[54Gdivision\u001b[63Gdirectly\u001b[30;1H\u001b[28;3H\u001b[?25h"]
