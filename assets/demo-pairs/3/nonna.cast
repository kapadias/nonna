es[\u001b[38;5;31m0\u001b[38;5;236m] += total_cents - share * people\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  9 \u001b[22m     \u001b[38;5;125mreturn\u001b[38;5;236m shares\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow let me run the full test suite again:\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;241m●\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command…\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
