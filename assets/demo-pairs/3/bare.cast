[91.03102, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[38;5;236m\u001b[2m6\u001b[11G\u001b[22m\u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97mdiv_cents\u001b[38;5;236m(\u001b[38;5;31mtotal_cents: int, divisor: int\u001b[38;5;236m) -> \u001b[38;5;31mint\u001b[38;5;236m:\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  5 -\u001b[38;5;236m    \"\"\"Divide a cent amount by `divisor`; fractions o\r\u001b[5C\u001b[1B\u001b[38;5;160m    -\u001b[38;5;236mf a cent are dropped.\"\"\"                             \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  7 +\u001b[38;5;236m    \u001b[38;5;24m\"\"\"Divide a cent amount by `divisor`; fractions o\r\u001b[7C\u001b[1B\u001b[38;5;29m \u001b[11G\u001b[38;5;24mf a cent are \u001b[48;5;157mrounded half up\u001b[48;5;194m.\"\"\"\u001b[38;5;236m                     \r\u001b[7C\u001b[1B\u001b[49m\u001b[2m8\u001b[11G\u001b[22m   \u001b[15G\u001b[38;5;125mif\u001b[38;5;236m divisor <= \u001b[38;5;31m0\u001b[38;5;236m:\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  9 \u001b[22m         \u001b[38;5;125mraise\u001b[38;5;236m ValueError(\u001b[38;5;24m\"divisor must be positive\"\u001b[38;5;236m)\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m8\u001b[11G\u001b[38;5;236m \u001b[13G \u001b[15Gr\u001b[17Gturn total_c\u001b[30Gnts //\u001b[37Gdivisor\r\u001b[6C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m10\u001b[15G\u001b[38;5;236m\u001b[48;5;157mresult\u001b[48;5;194m \u001b[48;5;157m= Decimal(\u001b[48;5;194mtotal_cents\u001b[48;5;157m)\u001b[48;5;194m / \u001b[48;5;157mDecimal(\u001b[48;5;194mdivisor\u001b[48;5;157m)\u001b[48;5;194m \r\u001b[6C\u001b[1B\u001b[38;5;29m11\u001b[11G\u001b[38;5;236m    \u001b[38;5;125mreturn\u001b[38;5;236m \u001b[38;5;31mint\u001b[38;5;236m(result.quantize(Decimal(\u001b[38;5;24m'1'\u001b[38;5;236m),\u001b[56Grounding\r\u001b[5C\u001b[1B\u001b[38;5;29m    +\u001b[38;5;236m=ROUND_HALF_UP))                                     \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mDone! All tests pass. The fix changes \u001b[38;5;105mdiv_cents()\u001b[39m to use proper\r\u001b[2C\u001b[1B\"round half up\" rounding via \u001b[38;5;105mDecimal.quantize()\u001b[39m instead of floor\r\u001b[2C\u001b[1Bdivision.\u001b[13GNow\u001b[17G7350\u001b[22Gcents\u001b[28G÷\u001b[30G100\u001b[34Gcorrectly\u001b[44Greturns\u001b[52G74\u001b[55Gcents\u001b[61G(73.5\r\u001b[2C\u001b[1Brounded up) instead of\u001b[26G73.\r\u001b[2B\u001b[38;5;241m✻\u001b[3GBaked for 14s · done 4:30 PM\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;5;255m\u001b[38;5;248m❯ \u001b[38;5;241m/cost\u001b[39m                                                               \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;5;174"]
