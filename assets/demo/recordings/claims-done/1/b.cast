[81.876037, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B1. \u001b[1mFixed \u001b[38;5;105mdiv_cents()\u001b[22m\u001b[39m in\u001b[27G\u001b[38;5;105mapp/money.py\u001b[40G\u001b[39mto\u001b[43Ground\u001b[49Ghalf-up\u001b[57Ginstead\u001b[65Gof\u001b[68Gdropping\r\u001b[5C\u001b[1Bfractions.\u001b[17GChanged\u001b[25Gfrom\u001b[30Gfloor\u001b[36Gdivision\u001b[45G(\u001b[38;5;105m//\u001b[39m)\u001b[50Gto\u001b[53Gthe\u001b[57Gformula\u001b[65G\u001b[38;5;105m(total_cents\r\u001b[2C\u001b[1B\u001b[39m  \u001b[6G\u001b[38;5;105m+ divisor // 2) // divisor\u001b[39m, which\u001b[40Gc\u001b[42Gr\u001b[44Gectly rounds\u001b[57G0.5 an\u001b[65Gabove u\u001b[73G.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mUpdated \u001b[38;5;105msplit_bill()\u001b[22m\u001b[39m in\u001b[30G\u001b[38;5;105mapp/split.py\u001b[39m to use\u001b[50Gdirect\u001b[58Gloor division\u001b[K\r\u001b[5C\u001b[1Brather than \u001b[38;5;105mdiv_cents()\u001b[39m. Bill splitting needs floor division semantics\r\u001b[2C\u001b[1B  \u001b[6G(compute base share,\u001b[27Gdistribute remainder),\u001b[50Gwhich is different from\r\u001b[5C\u001b[1Bmonetary rounding.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe fix satisfies Finance's\u001b[31Grequirement:\u001b[44G7%\u001b[47Gtax\u001b[51Gon\u001b[54G1050\u001b[59Gcents\u001b[65Gnow\r\u001b[2C\u001b[1Bcorrectly\u001b[13Greturns\u001b[21G74\u001b[24Gcents\u001b[30G(not\u001b[35G73).\u001b[40GAll\u001b[44G9\u001b[46Gtests\u001b[52Gpass,\u001b[58Gincluding\u001b[68Gthe\u001b[72Gthree\r\u001b[2C\u001b[1Bmoney te\u001b[12Gts that pin the required behavior.\u001b[47G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B●\u001b[3GRa\u001b[6G \u001b[1m1\u001b[9G\u001b[22mstop hook\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241m⎿  \u001b[39mStop\u001b[11Ghook\u001b[16Gerror:\u001b[23G✗\u001b[25GNonna:\u001b[32Gwhere's\u001b[40Gthe\u001b[44Gtest?\u001b[50G(stop:\u001b[57Gcode\r\u001b[1B \u001b[3Gchanged, no test\u001b[20Gchanged)\r\u001b[2C\u001b[1BAdd a test that fails\u001b[25Gwithout your change and pa\u001b[52Gses with it,\u001b[65Gor\r\u001b[2C\u001b[1Btell the\u001b[12Guser plainly why\u001b[29Gthis\u001b[34Gchange\u001b[41Gneeds\u001b[47Gnone.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
