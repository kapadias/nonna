[54.375054, "o", "\u001b[?25l\u001b[H\u001b[38;5;16m●\u001b[3G\u001b[39mThe\u001b[7Gissue\u001b[13Gis\u001b[16Gthat\u001b[21G\u001b[38;5;105msplit_bill\u001b[32G\u001b[39mwas\u001b[36Grelying\u001b[44Gon\u001b[47Gthe\u001b[51Gfloor\u001b[57Gdivision\u001b[66Gbehavior\u001b[75Gof\r\u001b[1B \u001b[3G\u001b[38;5;105mdiv_cents\u001b[39m,\u001b[14Gb\u001b[16Gt\u001b[18Gnow\u001b[23Gha\u001b[26G I've changed it to round\u001b[52Ghalf-up\u001b[60G(for\u001b[65GFinance's\r\u001b[2C\u001b[1Brequirement),\u001b[17Gthe\u001b[21Gsplit\u001b[27Glogic\u001b[33Gbreaks.\u001b[41GThe\u001b[45G\u001b[38;5;105msplit_bill\u001b[56G\u001b[39mfunction\u001b[65Gshouldn't\r\u001b[2C\u001b[1Buse \u001b[38;5;105mdiv_cents\u001b[39m here—it\u001b[25Gneeds\u001b[31Gfloor\u001b[37Gdivision\u001b[46Gto\u001b[49Gcompute\u001b[57Gthe\u001b[61Gbase\u001b[66Gshare,\u001b[73Gthen\r\u001b[2C\u001b[1Bdistribute\u001b[14Gthe\u001b[18Gremainder.\u001b[29GLet\u001b[33Gme\u001b[36Gfix\u001b[40Git:\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;65m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(\u001b]8;id=jepqtk;file:///root/b/billing/app/split.py\u0007app/split.py\u001b]8;;\u0007)\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mAdded \u001b[1m1\u001b[22m line, removed\u001b[28G\u001b[1m3\u001b[30G\u001b[22mlines\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  1 \u001b[22m \u001b[38;5;24m\"\"\"Splitting a bill between people.\"\"\"\r\u001b[1B\u001b[39m \u001b[3G \u001b[5G \u001b[38;5;236m\u001b[2m  2 \u001b[22m \u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;160m\u001b[48;5;224m  3 -\u001b[38;5;236mfrom app.money import div_cents                            \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m  3 \u001b[22m \r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;5;160m\u001b[48;5;224m  5 -\u001b[38;5;236m                                                           \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m  4 \u001b[22m \u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97msplit_bill\u001b[38;5;236m(\u001b[38;5;31mtotal_cents: int, people: int\u001b[38;5;236m) -> \u001b[38;5;31mlist\u001b[38;5;236m[\u001b[38;5;31mint\u001b[38;5;236m]:\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;236m\u001b[2m  5 \u001b[22m     \u001b[38;5;24m\"\"\"Split a bill evenly; the first person pays the lefto\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;236m\u001b[2m    \u001b[22m \u001b[38;5;24mver cents so the shares sum to the total.\"\"\"\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;160m\u001b[48;5;224m  8 -\u001b[38;5;236m    share = div_cents(total_cents, people)                 \u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;29m\u001b[48;5;194m  6 +\u001b[38;5;236m    share = total_cents \u001b[48;5;157m// \u001b[48;5;194mpeople                          \u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;236m\u001b[2m  7 \u001b[22m     shares = [share] * people\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  8 \u001b[22m     shares[\u001b[38;5;31m0\u001b[38;5;236m] += total_cents - share * people\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;236m\u001b[2m  9 \u001b[22m     \u001b[38;5;125mreturn\u001b[38;5;236m shares\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
