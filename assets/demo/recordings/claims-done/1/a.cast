[27.564432, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1BLet\u001b[7Gme\u001b[10Gfix\u001b[14Gthe\u001b[18G\u001b[38;5;105mdiv_cents()\u001b[30G\u001b[39mfunction\u001b[39Gto\u001b[42Guse\u001b[46Gproper\u001b[53Grounding:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;65m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(\u001b]8;id=8g6ltv;file:///root/a/billing/app/money.py\u0007app/money.py\u001b]8;;\u0007)\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mAdded \u001b[1m2\u001b[22m lines, removed\u001b[29G\u001b[1m2\u001b[31G\u001b[22mlines\r\u001b[1B     \u001b[38;5;236m\u001b[2m 2 \u001b[22m \u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m3\r\u001b[6C\u001b[1B4\u001b[10G\u001b[22m\u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97mdiv_cents\u001b[38;5;236m(\u001b[38;5;31mtotal_cents: int, divisor: int\u001b[38;5;236m) -> \u001b[38;5;31mint\u001b[38;5;236m:\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m 5 -\u001b[38;5;236m    \"\"\"Divide a cent amount by `divisor`; fractions of a cen\r\u001b[6C\u001b[1B\u001b[38;5;160m \u001b[10G\u001b[38;5;236mt\u001b[12Gare dropped.\"\"\"   \u001b[31G      \u001b[38G  \u001b[41G          \u001b[52G         \u001b[62G  \u001b[65G \u001b[67G   \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 5 +\u001b[38;5;236m    \u001b[38;5;24m\"\"\"Divide a cent amount by `divisor`; fractions of a cen\r\u001b[6C\u001b[1B\u001b[38;5;29m \u001b[10G\u001b[38;5;24mt \u001b[48;5;157mround\u001b[48;5;194m \u001b[48;5;157mhalf up\u001b[48;5;194m.\"\"\"\u001b[38;5;236m                                         \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 6 \u001b[22m     \u001b[38;5;125mif\u001b[38;5;236m divisor <= \u001b[38;5;31m0\u001b[38;5;236m:\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m7\u001b[14G\u001b[22m  \u001b[17G \u001b[38;5;125mraise\u001b[38;5;236m ValueError(\u001b[38;5;24m\"divisor must be positive\"\u001b[38;5;236m)\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m 8 -\u001b[38;5;236m    return total_cents // divisor                           \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 8 +\u001b[38;5;236m    \u001b[38;5;125mreturn\u001b[38;5;236m \u001b[48;5;157m(\u001b[48;5;194mtotal_cents \u001b[48;5;157m+ divisor \u001b[48;5;194m// \u001b[38;5;31m\u001b[48;5;157m2\u001b[38;5;236m) // \u001b[48;5;194mdivisor          \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow\u001b[7Glet\u001b[11Gme\u001b[14Grun\u001b[18Gthe\u001b[22Gtests\u001b[28Gto\u001b[31Gverify\u001b[38Gthe\u001b[42Gfix:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mDone!\u001b[9GAll\u001b[13Gtests\u001b[19Gpass.\u001b[25GThe\u001b[29Gfix\u001b[33Gchanges\u001b[41G\u001b[38;5;105mdiv_cents()\u001b[53G\u001b[39mfrom\u001b[58Gfloor\u001b[64Gdivision\u001b[73Gto\r\u001b[1B \u001b[3Gr\u001b[5Gund-ha\u001b[12Gf-up by \u001b[21Gdding \u001b[38;5;105mdivisor // 2\u001b[39m before dividing. This ensure\u001b[69G:\u001b[K\r\u001b[2B \u001b[3G-\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
