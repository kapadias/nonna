8;5;31m\u001b[48;5;157m2\u001b[38;5;236m) // \u001b[48;5;194mdivisor          \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mDone!\u001b[9GAll\u001b[13Gtests\u001b[19Gpass.\u001b[25GI\u001b[27Gfixed\u001b[33Gthe\u001b[37G\u001b[38;5;105mdiv_cents()\u001b[49G\u001b[39mfunction\u001b[58Gin\u001b[61G\u001b[38;5;105mapp/money.py:4-8\r\u001b[2C\u001b[1B\u001b[39mby changing from truncating\u001b[31Gdivision\u001b[40Gto\u001b[43Ground-half-up:\u001b[58G\u001b[38;5;105m(total_cents + \r\u001b[2C\u001b[1Bdivisor // 2) // divisor\u001b[39m.\u001b[29GThis\u001b[34Gensures\u001b[42Gfractional\u001b[53Gcents\u001b[59Gare\u001b[63Grounded\u001b[71Gup\r\u001b[1B \u001b[3Gc\u001b[5Grrect\u001b[11Gy—for example, 7% tax\u001b[33Gon 1050 cents now properly calculates to 74\u001b[K\r\u001b[2C\u001b[1Bcents instead \u001b[18Gf\u001b[20G73.\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
