[63.900361, "o", "\u001b[?25l\u001b[H\u001b[3Gbehavior,\u001b[13Gbut\u001b[17G\u001b[38;5;105mdiv_cents()\u001b[29G\u001b[39mnow\u001b[33Gcorrectly\u001b[43Grounds\u001b[50Ghalf\u001b[55Gup.\u001b[59GFor\u001b[63Gbill\r\u001b[1B \u001b[3Gsplitting, we need to use floor division to calcu\u001b[53Gate the\u001b[61Gbase share,\u001b[73Gthen\r\u001b[2C\u001b[1Bgive the first person any\u001b[29Gleftove\u001b[37G \u001b[39Gents. Let me fix that:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;65m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(\u001b]8;id=jepqtk;file:///root/b/billing/app/split.py\u0007app/split.py\u001b]8;;\u0007)\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m1\u001b[14G\u001b[22mline,\u001b[20Gremoved\u001b[28G\u001b[1m3\u001b[30G\u001b[22mlines\r\u001b[1B \u001b[3G   \u001b[38;5;236m\u001b[2m  1 \u001b[22m \u001b[38;5;24m\"\"\"Splitting a bill between people.\"\"\"\r\u001b[1B\u001b[39m     \u001b[38;5;236m\u001b[2m  2 \u001b[22m \u001b[12G\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  3 -\u001b[38;5;236mfrom app.money import div_cents                            \r\u001b[7C\u001b[1B\u001b[49m\u001b[2m3\r\u001b[7C\u001b[1B\u001b[22m\u001b[38;5;160m\u001b[48;5;224m5\u001b[11G\u001b[38;5;236m    \u001b[16G         \u001b[26G      \u001b[33G         \r\u001b[7C\u001b[1B\u001b[49m\u001b[2m4\u001b[11G\u001b[22m\u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97msplit_bill\u001b[38;5;236m(\u001b[38;5;31mtotal_cents: int, people: int\u001b[38;5;236m) -> \u001b[38;5;31mlist\u001b[38;5;236m[\u001b[38;5;31mint\u001b[38;5;236m]:\r\u001b[5C\u001b[1B\u001b[2m  5 \u001b[22m     \u001b[38;5;24m\"\"\"Split a bill evenly; the first person pays the lefto\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m \u001b[11G\u001b[22m\u001b[38;5;24mver cents so the shares sum to the total.\"\"\"\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  8 -\u001b[38;5;236m    share = div_cents(total_cents, people)                 \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  6 +\u001b[38;5;236m    share = total_cents \u001b[48;5;157m// \u001b[48;5;194mpeople                          \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m  7 \u001b[22m     shares = [share] * people\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  8 \u001b[22m     shares[\u001b[38;5;31m0\u001b[38;5;236m] += total_cents - share * people\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m9\u001b[15G\u001b[22m\u001b[38;5;125mreturn\u001b[22G\u001b[38;5;236mshares\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[6G\u001b[39m\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
