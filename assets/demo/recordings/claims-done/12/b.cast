[76.482467, "o", "\u001b[?25l\u001b[H\u001b[3Gcorrectly returns 74 instead of 73.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mapp/split.py:\u001b[22m Changed \u001b[38;5;105msplit_bill()\u001b[39m to\u001b[41Guse\u001b[45Gfloor\u001b[51Gdivision\u001b[60G(\u001b[38;5;105m//\u001b[39m)\u001b[65Gdirectly\r\u001b[2C\u001b[1Binstead\u001b[11Gof\u001b[14Gcalling\u001b[22G\u001b[38;5;105mdiv_cents()\u001b[39m.\u001b[35GBill\u001b[40Gsplitting\u001b[50Gneeds\u001b[56Gtruncation\u001b[67Gsemantics\r\u001b[2C\u001b[1B(floor division) so the first person can abs\u001b[48Grb\u001b[51Gall leftover cents and\r\u001b[2C\u001b[1Bamounts\u001b[11Gsum correctly.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BAll 9 te\u001b[12Gts\u001b[15Gpass, including\u001b[31Gthe\u001b[35Gthree\u001b[41Gmoney\u001b[47Gtests\u001b[53Gthat\u001b[58Gpin\u001b[62Gthe\u001b[66Grequired\r\u001b[2C\u001b[1Brounding\u001b[12Gbehavior:\r\u001b[2C\u001b[1B- ✓\u001b[7G\u001b[38;5;105mtest_exact_division\u001b[39m: 700 / 100 = 7\u001b[K\r\u001b[2C\u001b[1B- ✓ \u001b[38;5;105mtest_half_cent_rounds_up\u001b[39m:\u001b[33G7350\u001b[38G/\u001b[40G100\u001b[44G=\u001b[46G74\u001b[49G(the\u001b[54Gcore\u001b[59Gfix)\r\u001b[11C\u001b[1B\u001b[38;5;105mtax_rounds_half_up\u001b[39m:\u001b[32G7% tax on\u001b[42G1050\u001b[47Gcents\u001b[53G=\u001b[55G74\u001b[58Gcents\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B●\u001b[3GRan\u001b[7G\u001b[1m1\u001b[22m stop hook\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241m⎿  \u001b[39mStop\u001b[11Ghook\u001b[16Gerror:\u001b[23G✗\u001b[25GNonna:\u001b[32Gwhere's\u001b[40Gthe\u001b[44Gtest?\u001b[50G(stop:\u001b[57Gcode\r\u001b[1B \u001b[3Gchanged, no test\u001b[20Gchanged)\r\u001b[2C\u001b[1BAdd a test that fails\u001b[25Gwithout your change and pa\u001b[52Gses with it,\u001b[65Gor\r\u001b[2C\u001b[1Btell the\u001b[12Guser plainly why\u001b[29Gthis\u001b[34Gchange\u001b[41Gneeds\u001b[47Gnone.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u