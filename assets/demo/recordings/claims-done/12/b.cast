[69.857711, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[38;5;236m\u001b[2m3\u001b[11G\u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  5 -\u001b[38;5;236m                                                           \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m  4 \u001b[22m \u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97msplit_bill\u001b[38;5;236m(\u001b[38;5;31mtotal_cents: int, people: int\u001b[38;5;236m) -> \u001b[38;5;31mlist\u001b[38;5;236m[\u001b[38;5;31mint\u001b[38;5;236m]:\r\u001b[7C\u001b[1B\u001b[2m5\u001b[11G\u001b[22m    \u001b[38;5;24m\"\"\"Split a bill evenly; the first person pays the lefto\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m    \u001b[22m \u001b[38;5;24mver cents so the shares sum to the total.\"\"\"\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  8 -\u001b[38;5;236m    share = div_cents(total_cents, people)                 \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  6 +\u001b[38;5;236m    share = total_cents \u001b[48;5;157m// \u001b[48;5;194mpeople                          \r\u001b[7C\u001b[1B\u001b[49m\u001b[2m7\u001b[11G\u001b[22m    shares = [share] * people\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  8 \u001b[22m     shares[\u001b[38;5;31m0\u001b[38;5;236m] += total_cents - share * people\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  9 \u001b[22m     \u001b[38;5;125mreturn\u001b[38;5;236m shares\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow let me run the full test suite again:\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mPerfect!\u001b[12GLet\u001b[16Gme\u001b[19Gverify\u001b[26Gthe\u001b[30Gspecific\u001b[39Gtests\u001b[45Gare\u001b[49Gpassing:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mDone!\u001b[9GI've\u001b[14Gfixed\u001b[20Gthe\u001b[24Grounding\u001b[33Gissue.\u001b[40GHere's\u001b[47Gwhat\u001b[52GI\u001b[54Gchanged:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mapp/money.py:\u001b[17G\u001b[22mUpdated\u001b[25G\u001b[38;5;105mdiv_cents()\u001b[37G\u001b[39mto\u001b[40Guse\u001b[44G\u001b[38;5;105m(total_cents + divisor // 2) // \r\u001b[1B\u001b[39m \u001b[3G\u001b[38;5;105mdivisor\u001b[39m, which impl\u001b[23Gments proper round-half-up behavior. Now\u001b[64G7350\u001b[69G/\u001b[71G100\r\u001b[2C\u001b[1Bcorrectly\u001b[13Greturns\u001b[21G74\u001b[24Ginstead\u001b[32Gof\u001b[35G73.\r\u001b[2C\u001b[1B\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
