[26.225926, "o", "\u001b[?25l\u001b[H\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;5;241mRead \u001b[1m1\u001b[22m file \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[39m Let me run the tests to see the current failures:\u001b[K\r\u001b[2B \u001b[3G\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow\u001b[7GI'll\u001b[12Gfix\u001b[16Gthe\u001b[20G\u001b[38;5;105mdiv_cents()\u001b[32G\u001b[39mfunction\u001b[41Gto\u001b[44Guse\u001b[48Ground-half-up\u001b[62Ginstead\u001b[70Gof\r\u001b[2C\u001b[1Bfloor division:\r\u001b[2B\u001b[38;5;65m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(\u001b]8;id=8g6ltv;file:///root/a/billing/app/money.py\u0007app/money.py\u001b]8;;\u0007)\u001b[24G\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m2\u001b[14G\u001b[22mlines,\u001b[21Gremoved\u001b[29G\u001b[1m2\u001b[31G\u001b[22mlines\r\u001b[2C\u001b[1B   \u001b[38;5;236m\u001b[2m 2 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 3 \u001b[22m \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;236m\u001b[2m 4 \u001b[22m \u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97mdiv_cents\u001b[38;5;236m(\u001b[38;5;31mtotal_cents: int, divisor: int\u001b[38;5;236m) -> \u001b[38;5;31mint\u001b[38;5;236m:\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m 5 -\u001b[38;5;236m    \"\"\"Divide a cent amount by `divisor`; fractions of a cen\r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;5;160m\u001b[48;5;224m   -\u001b[38;5;236mt are dropped.\"\"\"                                           \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 5 +\u001b[38;5;236m    \u001b[38;5;24m\"\"\"Divide a cent amount by `divisor`; \u001b[48;5;157mrounds\u001b[48;5;194m \u001b[48;5;157mhalf\u001b[48;5;194m \u001b[48;5;157mup\u001b[48;5;194m.\"\"\"\r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;5;236m\u001b[2m 6 \u001b[22m     \u001b[38;5;125mif\u001b[38;5;236m divisor <= \u001b[38;5;31m0\u001b[38;5;236m:\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;236m\u001b[2m 7 \u001b[22m         \u001b[38;5;125mraise\u001b[38;5;236m ValueError(\u001b[38;5;24m\"divisor must be positive\"\u001b[38;5;236m)\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m 8 -\u001b[38;5;236m    return total_cents // divisor                           \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;5;29m\u001b[48;5;194m 8 +\u001b[38;5;236m    \u001b[38;5;125mreturn\u001b[38;5;236m \u001b[48;5;157m(\u001b[48;5;194mtotal_cents \u001b[48;5;157m+ divisor \u001b[48;5;194m// \u001b[38;5;31m\u001b[48;5;157m2\u001b[38;5;236m) // \u001b[48;5;194mdivisor          \u001b[49m\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
