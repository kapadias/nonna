[38;5;24m\"divisor must be positive\"\u001b[38;5;236m)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m 8 -\u001b[38;5;236m    return total_cents // divisor                           \r\u001b[6C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m8\u001b[10G\u001b[38;5;236m    \u001b[38;5;125mreturn\u001b[38;5;236m \u001b[48;5;157m(\u001b[48;5;194mtotal_cents \u001b[48;5;157m+ divisor \u001b[48;5;194m// \u001b[38;5;31m\u001b[48;5;157m2\u001b[38;5;236m) // \u001b[48;5;194mdivisor          \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow let's run the tests again to verify the fix:\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;241m \u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command…\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
