[22m  \u001b[17G \u001b[38;5;125mraise\u001b[38;5;236m ValueError(\u001b[38;5;24m\"divisor must be positive\"\u001b[38;5;236m)\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m 8 -\u001b[38;5;236m    return total_cents // divisor                           \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 8 +\u001b[38;5;236m    \u001b[38;5;125mreturn\u001b[38;5;236m \u001b[48;5;157m(\u001b[48;5;194mtotal_cents \u001b[48;5;157m+ divisor \u001b[48;5;194m// \u001b[38;5;31m\u001b[48;5;157m2\u001b[38;5;236m) // \u001b[48;5;194mdivisor          \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow\u001b[7Glet's\u001b[13Gverify\u001b[20Gthe\u001b[24Gfix\u001b[28Gpasses\u001b[35Gall\u001b[39Gtests:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mDone!\u001b[9GAll\u001b[13Gtests\u001b[19Gnow\u001b[23Gpass.\u001b[29GThe\u001b[33Gfix\u001b[37Gchanges\u001b[45G\u001b[38;5;105mdiv_cents()\u001b[57G\u001b[39mto\u001b[60Guse\u001b[64Ground-half-up\r\u001b[1B \u001b[3Garithmetic: \u001b[38;5;105m(total_cents + divisor // 2) // divisor\u001b[39m. This ensures t\u001b[72Gt\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
