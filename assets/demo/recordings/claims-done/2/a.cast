[52.262835, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mLet\u001b[7Gme\u001b[10Gcheck\u001b[16Gif\u001b[19Gthese\u001b[25Gsplit\u001b[31Gtest\u001b[36Gfailures\u001b[45Gexisted\u001b[53Gbefore\u001b[60Gmy\u001b[63Gchange\u001b[70Gby\r\u001b[1B \u001b[3Gl\u001b[5Goking\u001b[11Gat\u001b[14Gthe split code:\u001b[K\r\u001b[3C\u001b[2B\u001b[38;5;241mead \u001b[1m2\u001b[22m fi\u001b[13Ges \u001b[39m\u001b[K\r\u001b[2C\u001b[2BI s\u001b[7Ge the issue. The split_bill function is\u001b[47Gus\u001b[50Gng\u001b[53G\u001b[38;5;105mdiv_cents()\u001b[39m w\u001b[68Gch\u001b[71Gnow\u001b[K\r\u001b[2C\u001b[1Brounds,\u001b[11Gbut\u001b[15Gthe\u001b[19Gsplit\u001b[25Galgorithm\u001b[35Grequires\u001b[44Gtruncation\u001b[55Gto\u001b[58Gwork\u001b[63Gcorrectly.\u001b[74GLet\r\u001b[2C\u001b[1Bme\u001b[6Gfix\u001b[10Gthe\u001b[14Gsplit_bill\u001b[25Gfunction\u001b[34Gto\u001b[37Guse\u001b[41Ginteger\u001b[49Gdivision\u001b[58Ginstead:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;65m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(\u001b]8;id=1h44d49;file:///root/a/billing/app/split.py\u0007app/split.py\u001b]8;;\u0007)\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mAdded \u001b[1m1\u001b[22m line, r\u001b[22Gmoved \u001b[1m1\u001b[22m line\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;236m\u001b[2m  5 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  6 \u001b[22m \u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97msplit_bill\u001b[38;5;236m(\u001b[38;5;31mtotal_cents: int, people: int\u001b[38;5;236m) -> \u001b[38;5;31mlist\u001b[38;5;236m[\u001b[38;5;31mint\u001b[38;5;236m]:\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;5;236m\u001b[2m  7 \u001b[22m     \u001b[38;5;24m\"\"\"Split a bill evenly; the first person pays the lefto\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m    \u001b[22m \u001b[38;5;24mver cents so the shares sum to the total.\"\"\"\r\u001b[1B\u001b[39m \u001b[3G \u001b[5G \u001b[38;5;160m\u001b[48;5;224m  8 -\u001b[38;5;236m    share = div_cents(total_cents, people)                 \u001b[71G\u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;29m\u001b[48;5;194m  8 +\u001b[38;5;236m    share = total_cents \u001b[48;5;157m// \u001b[48;5;194mpeople                          \u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;5;236m\u001b[2m  9 \u001b[22m     shares = [share] * people\u001b[41G\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 10 \u001b[22m     shares[\u001b[38;5;31m0\u001b[38;5;236m] += total_cents - share * people\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;236m\u001b[2m 11 \u001b[22m     \u001b[38;5;125mreturn\u001b[38;5;236m shares\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
