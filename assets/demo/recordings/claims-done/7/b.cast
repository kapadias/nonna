[55.216976, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mLet\u001b[7Gme\u001b[10Gcheck\u001b[16Gthe\u001b[20Gtax\u001b[24Gfunction\u001b[33Gto\u001b[36Gunderstand\u001b[47Gits\u001b[51Grelationship\u001b[64Gwith\r\u001b[1B \u001b[3Gdiv_c\u001b[9Gnts:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRead \u001b[1m1\u001b[22m file \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mI\u001b[5Gsee\u001b[9Gthe\u001b[13Gissue.\u001b[20GThe\u001b[24G\u001b[38;5;105msplit_bill\u001b[35G\u001b[39mtests\u001b[41Gwere\u001b[46Gwritten\u001b[54Gfor\u001b[58Gthe\u001b[62Gold\r\u001b[1B \u001b[3Gfloor-division behavior, but now that\u001b[41G\u001b[38;5;105mdiv_cents()\u001b[39m cor\u001b[57Gectly rounds\u001b[70Ghalf\r\u001b[2C\u001b[1Bup, the te\u001b[14Gt exp\u001b[20Gctations need to be updated. Let\u001b[53Gme v\u001b[58Grif\u001b[63Gthe correct\r\u001b[2C\u001b[1Bvalues:\u001b[11G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BFor\u001b[7G\u001b[38;5;105msplit_bill(200, 3)\u001b[26G\u001b[39mwith\u001b[31Ground-half-up:\r\u001b[2C\u001b[1B- 200 / 3 = 66.67 → rounds to 67\u001b[K\r\u001b[4C\u001b[1BEveryone gets 67,\u001b[23Gbut 67×3 = 201\u001b[38G(1\u001b[41Gcent\u001b[46Gover)\r\u001b[4C\u001b[1BSo first\u001b[14Gp\u001b[16Gr\u001b[18Gon: 67 -\u001b[27G1 = 66, others: 67\u001b[46G\u001b[K\r\u001b[4C\u001b[1BResult: [66, 67,\u001b[24G] (sums to 200)\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BFor\u001b[7G\u001b[38;5;105msplit_bill(1001, 2)\u001b[27G\u001b[39mwith\u001b[32Ground-half-up:\r\u001b[2C\u001b[1B- 1001 / 2 = 500.5 → rounds to 501\u001b[K\r\u001b[4C\u001b[1BEveryone\u001b[14Ggets 501,\u001b[24Gbut 501×2\u001b[34G= \u001b[37G002\u001b[41G(1\u001b[44Gcent\u001b[49Gover)\r\u001b[4C\u001b[1BSo first\u001b[14Gp\u001b[16Gr\u001b[18Gon: 501 -\u001b[28G1 = 500, others: 501\u001b[49G\u001b[K\r\u001b[4C\u001b[1BResult: [500, 501] (sums\u001b[30Gto 1\u001b[35G01)\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThese\u001b[9Gnew\u001b[13Gvalues\u001b[20Gare\u001b[24Gmathematically\u001b[39Gcorrect.\u001b[48GI'll\u001b[53Gupdate\u001b[60Gthe\u001b[64Gtest\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[55.299848, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[2BI see the issue.\u001b[20GThe\u001b[24G\u001b[38;5;105msplit_bill\u001b[39m tests were written for the old\u001b[K\r\u001b[2C\u001b[1Bfloor-division\u001b[18Gbehavior,\u001b[28Gbut\u001b[32Gnow\u001b[36Gthat\u001b[41G\u001b[38;5;105mdiv_cents()\u001b[53G\u001b[39mcorrectly\u001b[63Grounds\u001b[70Ghalf\r\u001b[2C\u001b[1Bup,\u001b[7Gthe\u001b[11Gtest\u001b[16Gexpectations\u001b[29Gneed\u001b[34Gto\u001b[37Gbe\u001b[40Gupdated.\u001b[49GLet\u001b[53Gme\u001b[56Gverify\u001b[63Gthe\u001b[67Gcorrect\r\u001b[2C\u001b[1Bvalues:\u001b[K\r\u001b[2B \u001b[3GFor \u001b[38;5;105msplit_bill(200, 3)\u001b[39m with round-half-up:\u001b[46G\u001b[K\r\u001b[2C\u001b[1B- 200 / 3 = 66.67 → r\u001b[25Gunds \u001b[31Go 67\u001b[36G\u001b[K\r\u001b[2C\u001b[1B- Everyon\u001b[13G gets 67, but 67×3 =\u001b[34G201 (1 cen\u001b[45G over)\u001b[K\r\u001b[2C\u001b[1B- So first\u001b[14Gperson:\u001b[22G67\u001b[25G-\u001b[27G1\u001b[29G=\u001b[31G66,\u001b[35Gothers:\u001b[43G67\r\u001b[2C\u001b[1B-\u001b[5GResult:\u001b[13G[66,\u001b[18G67,\u001b[22G67]\u001b[26G(sums\u001b[32Gto 200)\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BFor \u001b[38;5;105msplit_bill(1001, 2)\u001b[39m with round-half-up:\r\u001b[4C\u001b[1B1001 / 2\u001b[14G= 500.5 → rounds to\u001b[34G5\u001b[38G\u001b[K\r\u001b[4C\u001b[1BEveryone\u001b[14Gg\u001b[16Gt\u001b[18G 501, but 501×2 = 1002 (1 cent\u001b[49Gover)\r\u001b[4C\u001b[1BSo first person:\u001b[22G501\u001b[26G- 1 =\u001b[32G500, others:\u001b[45G501\r\u001b[2C\u001b[1B-\u001b[5GResult:\u001b[13G[500,\u001b[19G501]\u001b[24G(sums\u001b[30Gto 1001)\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThese new values are\u001b[24Gmathema\u001b[32Gically\u001b[39Gcorrect.\u001b[48GI'll\u001b[53Gupdate\u001b[60Gthe\u001b[64Gtest\r\u001b[2C\u001b[1Bexpectations:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;174m✽\u001b[3GEbbi\u001b[38;5;216mng…\u001b[38;5;174m \u001b[38;5;241m(41s · ↓\u001b[39m \u0