s \u001b[48;5;157m+ divisor \u001b[48;5;194m// \u001b[38;5;31m\u001b[48;5;157m2\u001b[38;5;236m) // \u001b[48;5;194mdivisor          \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow\u001b[7Glet\u001b[11Gme\u001b[14Gverify\u001b[21Gthe\u001b[25Gfix:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mDone!\u001b[9GI've\u001b[14Gfixed\u001b[20Gthe\u001b[24G\u001b[38;5;105mdiv_cents()\u001b[36G\u001b[39mfunction\u001b[45Gto\u001b[48Guse\u001b[52Ground-half-up\u001b[66Ginstead\u001b[74Gof\r\u001b[1B \u001b[3Gtruncating\u001b[15Gractions. The change\u001b[36Gwas s\u001b[42Gmple:\u001b[48Ginstead of \u001b[38;5;105mtotal_cents // \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;105mdivisor\u001b[39m, it now use\u001b[23G \u001b[38;5;105m(total_cents + divisor // 2) // divisor\u001b[39m, which\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
