[28.143872, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;5;236m\u001b[2m 2 \u001b[22m \r\u001b[5C\u001b[1B\u001b[2m 3 \u001b[22m \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;236m\u001b[2m 4 \u001b[22m \u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97mdiv_cents\u001b[38;5;236m(\u001b[38;5;31mtotal_cents: int, divisor: int\u001b[38;5;236m) -> \u001b[38;5;31mint\u001b[38;5;236m:\r\u001b[1B\u001b[39m     \u001b[38;5;160m\u001b[48;5;224m 5 -\u001b[38;5;236m    \"\"\"Divide a cent amount by `divisor`; fractions of a cen\r\u001b[5C\u001b[1B\u001b[38;5;160m   -\u001b[38;5;236mt are dropped.\"\"\"                                           \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 5 +\u001b[38;5;236m    \u001b[38;5;24m\"\"\"Divide a cent amount by `divisor`; fractions of a cen\r\u001b[5C\u001b[1B\u001b[38;5;29m   +\u001b[38;5;24mt \u001b[48;5;157mround\u001b[48;5;194m \u001b[48;5;157mhalf-up\u001b[48;5;194m.\"\"\"\u001b[38;5;236m                                         \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 6 \u001b[22m     \u001b[38;5;125mif\u001b[38;5;236m divisor <= \u001b[38;5;31m0\u001b[38;5;236m:\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 7 \u001b[22m         \u001b[38;5;125mraise\u001b[38;5;236m ValueError(\u001b[38;5;24m\"divisor must be positive\"\u001b[38;5;236m)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m 8 -\u001b[38;5;236m    return total_cents // divisor                           \r\u001b[6C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m8\u001b[10G\u001b[38;5;236m    \u001b[38;5;125mreturn\u001b[38;5;236m \u001b[48;5;157m(\u001b[48;5;194mtotal_cents \u001b[48;5;157m+ divisor \u001b[48;5;194m// \u001b[38;5;31m\u001b[48;5;157m2\u001b[38;5;236m) // \u001b[48;5;194mdivisor          \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow let me verify the fix:\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[2BD\u001b[5Gne! I'v\u001b[14Gfixed the \u001b[38;5;105mdiv_cents()\u001b[36G\u001b[39mfunction\u001b[45Gto\u001b[48Guse\u001b[52Ground-half-up\u001b[66Ginstead\u001b[74Gof\r\u001b[2C\u001b[1Btruncating\u001b[14Gfractions.\u001b[25GThe\u001b[29Gchange\u001b[36Gwas\u001b[40Gsimple:\u001b[48Ginstead\u001b[56Gof\u001b[59G\u001b[38;5;105mtotal_cents // \r\u001b[2C\u001b[1Bdivisor\u001b[39m, it now uses\u001b[24G\u001b[38;5;105m(total_cents + divisor // 2) // divisor\u001b[39m,\u001b[65Gwhich\r\u001b[2C\u001b[1Bproperly\u001b[12Grounds\u001b[19G0.5\u001b[23Gup.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1BAll three tests pas\u001b[23G:\u001b[25G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B- ✓ Exact divi\u001b[18Gion (700\u001b[27G÷\u001b[29G100\u001b[33G= 7)\r\u001b[2C\u001b[1B-\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[28.256492, "o", "\u001b[?25l\u001b[H\u001b[7G\u001b[38;5;236m\u001b[2m3\r\u001b[6C\u001b[1B4\u001b[10G\u001b[22m\u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97mdiv_cents\u001b[38;5;236m(\u001b[38;5;31mtotal_cents: int, divisor: int\u001b[38;5;236m) -> \u001b[38;5;31mint\u001b[38;5;236m:\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m 5 -\u001b[38;5;236m    \"\"\"Divide a cent amount by `divisor`; fractions of a cen\r\u001b[6C\u001b[1B\u001b[38;5;160m \u001b[10G\u001b[38;5;236mt\u001b[12Gare dropped.\"\"\"   \u001b[31G      \u001b[38G  \u001b[41G          \u001b[52G         \u001b[62G  \u001b[65G \u001b[67G   \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 5 +\u001b[38;5;236m    \u001b[38;5;24m\"\"\"Divide a cent amount by `divisor`; fractions of a cen\r\u001b[6C\u001b[1B\u001b[38;5;29m \u001b[10G\u001b[38;5;24mt \u001b[48;5;157mround\u001b[48;5;194m \u001b[48;5;157mhalf-up\u001b[48;5;194m.\"\"\"\u001b[38;5;236m                                         \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 6 \u001b[22m     \u001b[38;5;125mif\u001b[38;5;236m divisor <= \u001b[38;5;31m0\u001b[38;5;236m:\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m7\u001b[14G\u001b[22m  \u001b[17G \u001b[38;5;125mraise\u001b[38;5;236m ValueError(\u001b[38;5;24m\"divisor must be positive\"\u001b[38;5;236m)\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m 8 -\u001b[38;5;236m    return total_cents // divisor                           \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 8 +\u001b[38;5;236m    \u001b[38;5;125mreturn\u001b[38;5;236m \u001b[48;5;157m(\u001b[48;5;194mtotal_cents \u001b[48;5;157m+ divisor \u001b[48;5;194m// \u001b[38;5;31m\u001b[48;5;157m2\u001b[38;5;236m) // \u001b[48;5;194mdivisor          \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow\u001b[7Glet\u001b[11Gme\u001b[14Gverify\u001b[21Gthe\u001b[25Gfix:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mDone!\u001b[9GI've\u001b[14Gfixed\u001b[20Gthe\u001b[24G\u001b[38;5;105mdiv_cents()\u001b[36G\u001b[39mfunction\u001b[45Gto\u001b[48Guse\u001b[52Ground-half-up\u001b[66Ginstead\u001b[74Gof\r\u001b[1B \u001b[3Gtruncating\u001b[15Gractions. The change\u001b[36Gwas s\u001b[42Gmple:\u001b[48Ginstead of \u001b[38;5;105mtotal_cents // \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;105mdivisor\u001b[39m, it now use\u001b[23G \u001b[38;5;105m(total_cents + divisor // 2) // divisor\u001b[39m, which\u001b[K\r\u001b[2C\u001b[1Bproperly\u001b[12Grou\u001b[16Gds\u001b[19G0.5 up.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BAll\u001b[7Gthree\u001b[13Gtests\u001b[19Gpass:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G✓\u001b[7GExact\u001b[13Gdivision\u001b[22G(700\u001b[27G÷\u001b[29G100\u001b[33G= 7)\r\u001b[6C\u001b[1BHalf-cent rou\u001b[21Gding (735\u001b[31G ÷ 100\u001b[38G=\u001b[40G73.5\u001b[45G→ 74)\u001b[30;1H\u001b[28;3H\u001b[?25h"]
