[28.757594, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[22BThere\u001b[9Gare\u001b[13Gtest\u001b[18Gfailures\u001b[27Gin\u001b[30G\u001b[38;5;105mtest_split.py\u001b[39m.\u001b[45GLet\u001b[49Gme\u001b[52Gcheck\u001b[58Gwhat\u001b[63G\u001b[38;5;105msplit_bill()\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[28.814205, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;5;160m\u001b[48;5;224m    -\u001b[38;5;236mnt are dropped.\"\"\"                                         \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  7 +\u001b[38;5;236m    \u001b[38;5;24m\"\"\"Divide a cent amount by `divisor`; fractions of a ce\r\u001b[5C\u001b[1B\u001b[38;5;29m    +\u001b[38;5;24mnt \u001b[48;5;157mround\u001b[48;5;194m \u001b[48;5;157mhalf up\u001b[48;5;194m.\"\"\"\u001b[38;5;236m                                       \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m  8 \u001b[22m     \u001b[38;5;125mif\u001b[38;5;236m divisor <= \u001b[38;5;31m0\u001b[38;5;236m:\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  9 \u001b[22m         \u001b[38;5;125mraise\u001b[38;5;236m ValueError(\u001b[38;5;24m\"divisor must be positive\"\u001b[38;5;236m)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  8 -\u001b[38;5;236m    return total_cents // divisor                          \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 10 +\u001b[38;5;236m    \u001b[48;5;157mresult\u001b[48;5;194m \u001b[48;5;157m= Decimal(\u001b[48;5;194mtotal_cents\u001b[48;5;157m)\u001b[48;5;194m / \u001b[48;5;157mDecimal(\u001b[48;5;194mdivisor\u001b[48;5;157m)\u001b[48;5;194m       \r\u001b[5C\u001b[1B\u001b[38;5;29m 11 +\u001b[38;5;236m    \u001b[38;5;125mreturn\u001b[38;5;236m \u001b[38;5;31mint\u001b[38;5;236m(result.quantize(Decimal(\u001b[38;5;24m'1'\u001b[38;5;236m), rounding=ROUND\r\u001b[5C\u001b[1B\u001b[38;5;29m    +\u001b[38;5;236m_HALF_UP))                                                 \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow let me run the money tests to verify the fix:\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mPerfect!\u001b[12GThe\u001b[16Gmoney\u001b[22Gtests\u001b[28Gpass.\u001b[34GNow\u001b[38Glet\u001b[42Gme\u001b[45Grun\u001b[49Gthe\u001b[53Gfull\u001b[58Gtest\u001b[63Gsuite\u001b[69Gto\r\u001b[2C\u001b[1Bconfirm nothing else\u001b[24Gbroke:\r\u001b[2B \u001b[3G\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mThere\u001b[9Gare\u001b[13Gtest\u001b[18Gfailures\u001b[27Gin\u001b[30G\u001b[38;5;105mtest_split.py\u001b[39m.\u001b[45GLet\u001b[49Gme\u001b[52Gcheck\u001b[58Gwhat\u001b[63G\u001b[38;5;105msplit_bill()\r\u001b[2C\u001b[1B\u001b[39mdoes:\u001b[K\r\u001b[2B\u001b[38;5;241m●\u001b[3G\u001b[39mReading \u001b[1m1\u001b[13G\u001b[22mfile…\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
