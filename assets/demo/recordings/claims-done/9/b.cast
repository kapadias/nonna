mThe\u001b[7Gissue\u001b[13Gis\u001b[16Gthat\u001b[21G\u001b[38;5;105msplit_bill\u001b[32G\u001b[39mneeds\u001b[38Gtruncation\u001b[49G(floor\u001b[56Gdivision)\u001b[66Gfor\u001b[70Gits\r\u001b[1B \u001b[3Galgorithm\u001b[13Gto\u001b[16Gwork\u001b[21Gcorrectly,\u001b[32Gwhile\u001b[38G\u001b[38;5;105mdiv_cents\u001b[39m needs \u001b[55Gound\u001b[60Gng for tax\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
