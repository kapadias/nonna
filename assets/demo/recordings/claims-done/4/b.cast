ct!\u001b[12GNow\u001b[16Glet\u001b[20Gme\u001b[23Grun\u001b[27Gthe\u001b[31Gfull\u001b[36Gtest\u001b[41Gsuite\u001b[47Gto\u001b[50Gensure\u001b[57Gnothing\u001b[65Gelse\u001b[70Gbroke:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mI\u001b[5Gsee\u001b[9Gthere\u001b[15Gare\u001b[19Gfailures\u001b[28Gin\u001b[31Ga\u001b[33Gdifferent\u001b[43Gtest\u001b[48Gfile.\u001b[54GLet\u001b[58Gme\u001b[61Gexamine\u001b[69Gthe\r\u001b[2C\u001b[1Bsplit_bill function and\u001b[27Gthe\u001b[31Gfailing\u001b[39Gtests:\r\u001b[2B\u001b[38;5;241m \u001b[3G\u001b[39mReading \u001b[1m1\u001b[22m file…\u001b[19G\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
