e\u001b[24Gissue.\u001b[31GThe\u001b[35Gcurrent\u001b[43G\u001b[38;5;105mdiv_cents()\u001b[55G\u001b[39muses\u001b[60Ginteger\u001b[68Gdivision\r\u001b[1B \u001b[3Gwhich\u001b[9Gtrunca\u001b[16Ges,\u001b[20Gbut\u001b[25Gt n\u001b[29Geds to round half up. I'll fix\u001b[61Gt using the\u001b[K\r\u001b[2C\u001b[1Bstandard rounding formula: \u001b[38;5;105m(total_cents + divisor // 2) // divisor\u001b[39m.\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
