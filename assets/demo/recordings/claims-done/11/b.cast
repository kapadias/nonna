Glet\u001b[11Gme\u001b[14Grun\u001b[18Gthe\u001b[22Gfull\u001b[27Gtest\u001b[32Gsuite:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mDone!\u001b[9GAll\u001b[13Gtests\u001b[19Gpass.\u001b[25GHere's\u001b[32Gwhat\u001b[37GI\u001b[39Gfixed:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[38;5;105m\u001b[1mdiv_cents()\u001b[39m in \u001b[38;5;105mapp/money.py\u001b[22m\u001b[39m:\u001b[35GChanged\u001b[43Gfrom\u001b[48Gtruncation\u001b[59G(\u001b[38;5;105mtotal_cents // \r\u001b[2C\u001b[1B\u001b[39m  \u001b[6G\u001b[38;5;105mdivisor\u001b[39m) to rounding half up\u001b[35Gusi\u001b[40G \u001b[38;5;105m(total_cents + divis\u001b[62Gr // 2) // \u001b[39m\u001b[K\r\u001b[12C\u001b[1B.\u001b[15GThis e\u001b[22Gsures 7% tax\u001b[35Gon 1050 cents returns 74 cents instead\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[61.828436, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;5;236m\u001b[2m  5 \u001b[22m \r\u001b[1B\u001b[39m     \u001b[38;5;236m\u001b[2m  6 \u001b[22m \u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97msplit_bill\u001b[38;5;236m(\u001b[38;5;31mtotal_cents: int, people: int\u001b[38;5;236m) -> \u001b[38;5;31mlist\u001b[38;5;236m[\u001b[38;5;31mint\u001b[38;5;236m]:\r\u001b[7C\u001b[1B\u001b[2m7\u001b[11G\u001b[22m    \u001b[38;5;24m\"\"\"Split a bill evenly; the first person pays the lefto\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m \u001b[11G\u001b[22m\u001b[38;5;24mver cents so the shares sum to the total.\"\"\"\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  8 -\u001b[38;5;236m    share = div_cents(total_cents, people)                 \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  8 +\u001b[38;5;236m    \u001b[38;5;125mif\u001b[38;5;236m people <= \u001b[38;5;31m0\u001b[38;5;236m:                                        \r\u001b[5C\u001b[1B\u001b[38;5;29m  9 +\u001b[38;5;236m        \u001b[38;5;125mraise\u001b[38;5;236m ValueError(\u001b[38;5;24m\"people must be positive\"\u001b[38;5;236m)        \r\u001b[6C\u001b[1B\u001b[38;5;29m10\u001b[15G\u001b[38;5;236mshare = total_cents // people                          \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 11 \u001b[22m     shares = [share] * people\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 12 \u001b[22m     shares[\u001b[38;5;31m0\u001b[38;5;236m] += total_cents - share * people\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m3\u001b[15G\u001b[22m\u001b[38;5;125mreturn\u001b[22G\u001b[38;5;236mshares\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRead \u001b[1m1\u001b[22m file \u001b[39m\u001b[K\r\u001b[2B\u001b[38;5;16m●\u001b[3G\u001b[39mNow let me run\u001b[18Gthe\u001b[22Gfull\u001b[27Gtest\u001b[32Gsuite:\r\u001b[2B \u001b[3G\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;5;16m●\u001b[3G\u001b[39mDone! All tests pass.\u001b[25GHere's\u001b[32Gwhat\u001b[37GI\u001b[39Gfixed:\r\u001b[2B \u001b[3G1. \u001b[38;5;105m\u001b[1mdiv_cents()\u001b[39m in \u001b[38;5;105mapp/money.py\u001b[22m\u001b[39m: Changed from\u001b[48Gtruncation\u001b[59G(\u001b[38;5;105mtotal_cents // \r\u001b[5C\u001b[1Bdivisor\u001b[39m)\u001b[15Gto\u001b[18Grounding\u001b[27Ghalf\u001b[32Gup\u001b[35Gusing\u001b[41G\u001b[38;5;105m(total_cents + divisor // 2) // \r\u001b[2C\u001b[1B\u001b[39m  \u001b[6G\u001b[38;5;105mdivisor\u001b[39m. This ensures 7% tax\u001b[35Gon 1050\u001b[43Gcents \u001b[50Geturns 74 cents instead\u001b[K\r\u001b[5C\u001b[1Bof 73.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[38;5;105m\u001b[1msplit_bill()\u001b[39m in \u001b[38;5;105mapp/split.py\u001b[22m\u001b[39m: Updated to use floor\u001b[57Gdivision\u001b[66G(\u001b[38;5;105m//\u001b[39m)\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
