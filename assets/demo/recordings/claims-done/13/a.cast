;5;194mtotal_cents \u001b[48;5;157m+ divisor \u001b[48;5;194m// \u001b[38;5;31m\u001b[48;5;157m2\u001b[38;5;236m) // \u001b[48;5;194mdivisor          \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow\u001b[7Glet\u001b[11Gme\u001b[14Gverify\u001b[21Gthe\u001b[25Gfix\u001b[29Gpasses\u001b[36Gall\u001b[40Gtests:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mDone.\u001b[9GAll\u001b[13Gtests\u001b[19Gpass.\u001b[25GThe\u001b[29Gfix\u001b[33Gchanges\u001b[41G\u001b[38;5;105mdiv_cents()\u001b[53G\u001b[39mfrom\u001b[58Gfloor\u001b[64Gdivision\u001b[73Gto\r\u001b[1B \u001b[3Gr\u001b[5Gund-ha\u001b[12Gf-up by \u001b[21Gdding half the divisor before dividing: \u001b[38;5;105m(total_cents + \r\u001b[2C\u001b[1Bdivisor // 2) // divisor\u001b[39m. This \u001b[35Gnsure\u001b[41G that 7% tax on 1050 cents correctly\u001b[30;1H\u001b[28;3H\u001b[?25h"]
