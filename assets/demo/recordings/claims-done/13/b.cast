[50.737007, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;5;160m\u001b[48;5;224m  3 -\u001b[38;5;236mfrom app.money import div_cents                            \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m  3 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  5 -\u001b[38;5;236m                                                           \r\u001b[7C\u001b[1B\u001b[49m\u001b[2m4\u001b[11G\u001b[22m\u001b[38;5;125mdef\u001b[15G\u001b[38;5;97msplit_bill\u001b[38;5;236m(\u001b[38;5;31mtotal_cents: int, people: int\u001b[38;5;236m) -> \u001b[38;5;31mlist\u001b[38;5;236m[\u001b[38;5;31mint\u001b[38;5;236m]:\r\u001b[7C\u001b[1B\u001b[2m5\u001b[11G\u001b[22m    \u001b[38;5;24m\"\"\"Split\u001b[24Ga bill evenly;\u001b[40Ghe first person pays the lefto\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m    \u001b[22m \u001b[38;5;24mver cents so the shares sum to the total.\"\"\"\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  8 -\u001b[38;5;236m    share = div_cents(total_cents, people)                 \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  6 +\u001b[38;5;236m    share = total_cents \u001b[48;5;157m// \u001b[48;5;194mpeople                          \r\u001b[7C\u001b[1B\u001b[49m\u001b[2m7\u001b[21G\u001b[22m = [share] * p\u001b[36Gople\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m8\u001b[15G\u001b[22mshares[\u001b[38;5;31m0\u001b[38;5;236m] += total_cents - share * people\r\u001b[5C\u001b[1B\u001b[2m  9 \u001b[22m     \u001b[38;5;125mreturn\u001b[38;5;236m shares\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow\u001b[7Glet\u001b[11Gme\u001b[14Grun\u001b[18Gthe\u001b[22Gfull\u001b[27Gtest\u001b[32Gsuite\u001b[38Gagain:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mPer\u001b[7Gect! All test\u001b[22Gpass. Let\u001b[32Gme\u001b[35Gverify\u001b[42Gthe\u00