[39m \u001b[3G \u001b[5G \u001b[38;5;236m\u001b[2m  5 \u001b[22m     \u001b[38;5;24m\"\"\"Split a bill evenly; the first person pays the lefto\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;236m\u001b[2m    \u001b[22m \u001b[38;5;24mver cents so the shares sum to the total.\"\"\"\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;160m\u001b[48;5;224m  8 -\u001b[38;5;236m    share = div_cents(total_cents, people)                 \u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;5;29m\u001b[48;5;194m  6 +\u001b[38;5;236m    share = total_cents \u001b[48;5;157m// \u001b[48;5;194mpeople                          \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m  7 \u001b[22m     shares = [share] * people\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;236m\u001b[2m  8 \u001b[22m     shares[\u001b[38;5;31m0\u001b[38;5;236m] += total_cents - share * people\r\u001b[5C\u001b[1B\u001b[2m  9 \u001b[22m     \u001b[38;5;125mreturn\u001b[38;5;236m shares\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;174m·\u001b[39m \u001b[38;5;216mPollinating…\u001b[38;5;174m \u001b[38;5;241m(32s · ↓\u001b[25G3.5k tokens · thought for 8s)\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
