[27.329957, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow I see the\u001b[17Gissue.\u001b[24GThe\u001b[28Gcurrent\u001b[36Gimplementation\u001b[51Guses\u001b[56Gfloor\u001b[62Gdivision\u001b[71G(\u001b[38;5;105m//\u001b[39m),\r\u001b[2C\u001b[1Bwhich\u001b[9Gtruncates.\u001b[20GFor\u001b[24Gexample,\u001b[33G\u001b[38;5;105m7350 // 100 = 73\u001b[39m,\u001b[51Gbut\u001b[55Gwe\u001b[58Gneed\u001b[63Gto\u001b[66Ground\u001b[72G73.5\r\u001b[1B \u001b[3Gup to\u001b[9G74.\u001b[13G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI'll fix \u001b[38;5;105mdiv_cents()\u001b[24G\u001b[39mto\u001b[27Ground\u001b[33Ghalf\u001b[38Gup\u001b[41Gusing\u001b[47Ginteger\u001b[55Garithmetic:\r\u001b[2B\u001b[38;5;65m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(\u001b]8;id=19rw1ia;file:///root/b/billing/app/money.py\u0007app/money.py\u001b]8;;\u0007)\u001b[24G\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m2\u001b[14G\u001b[22mlines,\u001b[21Gremoved\u001b[29G\u001b[1m2\u001b[31G\u001b[22mlines\r\u001b[1B \u001b[3G   \u001b[38;5;236m\u001b[2m 2 \u001b[22m \u001b[39m\u001b[K\r\u001b[1B     \u001b[38;5;236m\u001b[2m 3 \u001b[22m \u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m4\u001b[10G\u001b[22m\u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97mdiv_cents\u001b[38;5;236m(\u001b[38;5;31mtotal_cents: int, divisor: int\u001b[38;5;236m) -> \u001b[38;5;31mint\u001b[38;5;236m:\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m 5 -\u001b[38;5;236m    \"\"\"Divide a cent amount by `divisor`; fractions of a cen\r\u001b[5C\u001b[1B\u001b[38;5;160m   -\u001b[38;5;236mt are dropped.\"\"\"                                           \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 5 +\u001b[38;5;236m    \u001b[38;5;24m\"\"\"Divide a cent amount by `divisor`; \u001b[48;5;157mround\u001b[48;5;194m \u001b[48;5;157mhalf\u001b[48;5;194m \u001b[48;5;157mup\u001b[48;5;194m.\"\"\"\u001b[38;5;236m \r\u001b[5C\u001b[1B\u001b[49m\