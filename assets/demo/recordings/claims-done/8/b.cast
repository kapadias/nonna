[44.104681, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mI\u001b[5Gsee\u001b[9Gthe\u001b[13Gissue.\u001b[20GThe\u001b[24G\u001b[38;5;105msplit_bill\u001b[35G\u001b[39mfunction\u001b[44Gwas\u001b[48Gusing\u001b[54G\u001b[38;5;105mdiv_cents\u001b[64G\u001b[39mexpecting\u001b[74Git\r\u001b[1B \u001b[3Gto r\u001b[8Gturn the floor\u001b[23Gvalue, but now that \u001b[38;5;105mdiv_cents\u001b[39m do\u001b[56Gs rounding, the\u001b[72Gsplit\r\u001b[2C\u001b[1Blogic break\u001b[15G. I\u001b[19Gneed\u001b[24Gto\u001b[27Gfix\u001b[31G\u001b[38;5;105msplit_bill\u001b[42G\u001b[39mto\u001b[45Guse\u001b[49Gfloor\u001b[55Gdivision\u001b[64Gand\u001b[68Gthe\r\u001b[2C\u001b[1Bmodulo\u001b[10Goperator\u001b[19Gdirectly:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;65m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(\u001b]8;id=jepqtk;file:///root/b/billing/app/split.py\u0007app/split.py\u001b]8;;\u0007)\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mAdded \u001b[1m3\u001b[22m li\u001b[17Ges, removed\u001b[29G\u001b[1m4\u001b[22m lines\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;236m\u001b[2m  1 \u001b[22m \u001b[38;5;24m\"\"\"Splitting a bill between people.\"\"\"\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  2 \u001b[22m \r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;5;160m\u001b[48;5;224m  3 -\u001b[38;5;236mfrom app.money import div_cents                            \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m  3 \u001b[22m \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;160m\u001b[48;5;224m  5 -\u001b[38;5;236m                                                           \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;5;236m\u001b[2m  4 \u001b[22m \u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97msplit_bill\u001b[38;5;236m(\u001b[38;5;31mtotal_cents: int, people: int\u001b[38;5;236m) -> \u001b[38;5;31mlist\u001b[38;5;236m[\u001b[38;5;31mint\u001b[38;5;236m]:\r\u001b[5C\u001b[1B\u001b[2m  5 \u001b[22m     \u001b[38;5;24m\"\"\"Split a bill evenly; the first person pays the lefto\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;5;236m\u001b[2m    \u001b[22m \u001b[38;5;24mver cents so the shares sum to the total.\"\"\"\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  8 -\u001b[38;5;236m    share = div_cents(total_cents, people)                 \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G \u001b[5G \u001b[38;5;29m\u001b[48;5;194m  6 +\u001b[38;5;236m    share = total_cents \u001b[48;5;157m// \u001b[48;5;194mpeople                          \u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;5;29m\u001b[48;5;194m  7 +\u001b[38;5;236m    remainder = total_cents % people                       \u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;236m\u001b[2m  8 \u001b[22m     shares = [share] * people\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;160m\u001b[48;5;224m 10 -\u001b[38;5;236m    shares[0] += total_cents - share * people              \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  9 +\u001b[38;5;236m    shares[\u001b[38;5;31m0\u001b[38;5;236m] += remainder                                 \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[38;5;236m\u001b[2m 10 \u001b[22m     \u001b[38;5;125mreturn\u001b[38;5;236m shares\r\u001b[12C\u001b[2B\u001b[38;5;241m29s · ↓\u001b[39m \u001b[38;5;241m3.2k t\u001b[28Gkens\u001b[33G· thought for 4s)\u001b[39m\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
