;5;194mtotal_cents \u001b[48;5;157m+ divisor \u001b[48;5;194m// \u001b[38;5;31m\u001b[48;5;157m2\u001b[38;5;236m) // \u001b[48;5;194mdivisor          \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow\u001b[7Glet\u001b[11Gme\u001b[14Grun\u001b[18Gthe\u001b[22Gtests\u001b[28Gto\u001b[31Gverify\u001b[38Gthe\u001b[42Gfix\u001b[46Gworks:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mDone!\u001b[9GI\u001b[11Gfixed\u001b[17Gthe\u001b[21G\u001b[38;5;105mdiv_cents()\u001b[33G\u001b[39mfunction\u001b[42Gin\u001b[45G\u001b[38;5;105mapp/money.py\u001b[58G\u001b[39mto\u001b[61Guse\r\u001b[1B \u001b[3Gr\u001b[5Gund-half-up\u001b[17Ginstead of dropping fract\u001b[43Gons. The change replaces\u001b[68Gfloor\r\u001b[2C\u001b[1Bdivision (\u001b[38;5;105m//\u001b[39m)\u001b[17Gwith the \u001b[27Gormula \u001b[38;5;105m(total_cents + divisor // 2) // divisor\u001b[39m,\u001b[30;1H\u001b[28;3H\u001b[?25h"]
