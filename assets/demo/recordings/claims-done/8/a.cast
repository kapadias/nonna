 divisor \u001b[48;5;194m// \u001b[38;5;31m\u001b[48;5;157m2\u001b[38;5;236m) // \u001b[48;5;194mdivisor          \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow\u001b[7Glet\u001b[11Gme\u001b[14Grun\u001b[18Gthe\u001b[22Gtests\u001b[28Gto\u001b[31Gverify\u001b[38Gthe\u001b[42Gfix\u001b[46Gworks:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mDone!\u001b[9GI\u001b[11Gfixed\u001b[17Gthe\u001b[21G\u001b[38;5;105mdiv_cents()\u001b[33G\u001b[39mfunction\u001b[42Gin\u001b[45G\u001b[38;5;105mapp/money.py\u001b[58G\u001b[39mto\u001b[61Guse\r\u001b[1B \u001b[3Gr\u001b[5Gund-half-up\u001b[17Ginstead of dropping fract\u001b[43Gons. The change replaces\u001b[68Gfloor\r\u001b[2C\u001b[1Bdivision (\u001b[38;5;105m//\u001b[39m)\u001b[17Gwith the \u001b[27Gormula \u001b[38;5;105m(total_cents + divisor // 2) // divisor\u001b[39m,\r\u001b[2C\u001b[1Bwhich properly rounds fractions of a cent at 0.5 or above up to the next\r\u001b[2C\u001b[1Bcent.\r\u001b[1B\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[28.926122, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;5;236m\u001b[2m 2 \u001b[22m \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;236m\u001b[2m 3 \u001b[22m \u001b[39m\u001b[K\r\u001b[1B     \u001b[38;5;236m\u001b[2m 4 \u001b[22m \u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97mdiv_cents\u001b[38;5;236m(\u001b[38;5;31mtotal_cents: int, divisor: int\u001b[38;5;236m) -> \u001b[38;5;31mint\u001b[38;5;236m:\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m 5 -\u001b[38;5;236m    \"\"\"Divide a cent amount by `divisor`; fractions of a cen\r\u001b[5C\u001b[1B\u001b[38;5;160m   -\u001b[38;5;236mt are dropped.\"\"\"                                           \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 5 +\u001b[38;5;236m    \u001b[38;5;24m\"\"\"Divide a cent amount by `divisor`; fractions of a cen\r\u001b[5C\u001b[1B\u001b[38;5;29m   +\u001b[38;5;24mt \u001b[48;5;157mround\u001b[48;5;194m \u001b[48;5;157mhalf up\u001b[48;5;194m.\"\"\"\u001b[38;5;236m                                         \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 6 \u001b[22m     \u001b[38;5;125mif\u001b[38;5;236m divisor <= \u001b[38;5;31m0\u001b[38;5;236m:\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 7 \u001b[22m         \u001b[38;5;125mraise\u001b[38;5;236m ValueError(\u001b[38;5;24m\"divisor must be positive\"\u001b[38;5;236m)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m 8 -\u001b[38;5;236m    return total_cents // divisor                           \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 8 +\u001b[38;5;236m    \u001b[38;5;125mreturn\u001b[38;5;236m \u001b[48;5;157m(\u001b[48;5;194mtotal_cents \u001b[48;5;157m+ divisor \u001b[48;5;194m// \u001b[38;5;31m\u001b[48;5;157m2\u001b[38;5;236m) // \u001b[48;5;194mdivisor          \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow let me run the tests to verify the fix works:\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mDone!\u001b[9GI\u001b[11Gfixed\u001b[17Gthe\u001b[21G\u001b[38;5;105mdiv_cents()\u001b[33G\u001b[39mfunction\u001b[42Gin\u001b[45G\u001b[38;5;105mapp/money.py\u001b[58G\u001b[39mto\u001b[61Guse\r\u001b[2C\u001b[1Bround-half-up instead\u001b[25Gof\u001b[28Gdropping\u001b[37Gfractions.\u001b[48GThe\u001b[52Gchange\u001b[59Greplaces\u001b[68Gfloor\r\u001b[2C\u001b[1Bdivision\u001b[12G(\u001b[38;5;105m//\u001b[39m)\u001b[17Gwith\u001b[22Gthe\u001b[26Gformula\u001b[34G\u001b[38;5;105m(total_cents + divisor // 2) // divisor\u001b[39m,\r\u001b[1B \u001b[3Gwhich\u001b[9Gproperly rounds fractions of a cent\u001b[45Gat 0.5 or above\u001b[62Gp to\u001b[67Gthe\u001b[71Gnext\r\u001b[2C\u001b[1Bcent.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BAll three tests pass:\u001b[25G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[29.031176, "o", "\u001b[?25l\u001b[H\u001b[7G\u001b[38;5;236m\u001b[2m3\r\u001b[6C\u001b[1B4\u001b[10G\u001b[22m\u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97mdiv_cents\u001b[38;5;236m(\u001b[38;5;31mtotal_cents: int, divisor: int\u001b[38;5;236m) -> \u001b[38;5;31mint\u001b[38;5;236m:\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m 5 -\u001b[38;5;236m    \"\"\"Divide a cent amount by `divisor`; fractions of a cen\r\u001b[6C\u001b[1B\u001b[38;5;160m \u001b[10G\u001b[38;5;236mt\u001b[12Gare dropped.\"\"\"   \u001b[31G      \u001b[38G  \u001b[41G          \u001b[52G         \u001b[62G  \u001b[65G \u001b[67G   \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 5 +\u001b[38;5;236m    \u001b[38;5;24m\"\"\"Divide a cent amount by `divisor`; fractions of a cen\r\u001b[6C\u001b[1B\u001b[38;5;29m \u001b[10G\u001b[38;5;24mt \u001b[48;5;157mround\u001b[48;5;194m \u001b[48;5;157mhalf up\u001b[48;5;194m.\"\"\"\u001b[38;5;236m                                         \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 6 \u001b[22m     \u001b[38;5;125mif\u001b[38;5;236m divisor <= \u001b[38;5;31m0\u001b[38;5;236m:\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m7\u001b[14G\u001b[22m  \u001b[17G \u001b[38;5;125mraise\u001b[38;5;236m ValueError(\u001b[38;5;24m\"divisor must be positive\"\u001b[38;5;236m)\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m 8 -\u001b[38;5;236m    return total_cents // divisor                           \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 8 +\u001b[38;5;236m    \u001b[38;5;125mreturn\u001b[38;5;236m \u001b[48;5;157m(\u001b[48;5;194mtotal_cents \u001b[48;5;157m+ divisor \u001b[48;5;194m// \u001b[38;5;31m\u001b[48;5;157m2\u001b[38;5;236m) // \u001b[48;5;194mdivisor          \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow\u001b[7Glet\u001b[11Gme\u001b[14Grun\u001b[18Gthe\u001b[22Gtests\u001b[28Gto\u001b[31Gverify\u001b[38Gthe\u001b[42Gfix\u001b[46Gworks:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mDone!\u001b[9GI\u001b[11Gfixed\u001b[17Gthe\u001b[21G\u001b[38;5;105mdiv_cents()\u001b[33G\u001b[39mfunction\u001b[42Gin\u001b[45G\u001b[38;5;105mapp/money.py\u001b[58G\u001b[39mto\u001b[61Guse\r\u001b[1B \u001b[3Gr\u001b[5Gund-half-up\u001b[17Ginstead of dropping fract\u001b[43Gons. The change replaces\u001b[68Gfloor\r\u001b[2C\u001b[1Bdivision (\u001b[38;5;105m//\u001b[39m)\u001b[17Gwith the \u001b[27Gormula \u001b[38;5;105m(total_cents + divisor // 2) // divisor\u001b[39m,\r\u001b[2C\u001b[1Bwhich properly rounds fractions of a cent at 0.5 or above up to the next\r\u001b[2C\u001b[1Bcent.\u001b[9G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BAll\u001b[7Gthree\u001b[13Gtests\u001b[19Gpass:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GExact\u001b[11Gdivision\u001b[20Gstill\u001b[26Gworks\u001b[32G(700\u001b[37G÷\u001b[39G100\u001b[43G= 7)\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[29.277208, "o", "\u001b[?25l\u001b[H\u001b[7G\u001b[38;5;236m\u001b[2m4\u001b[10G\u001b[22m\u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97mdiv_cents\u001b[38;5;236m(\u001b[38;5;31mtotal_cents: int, divisor: int\u001b[38;5;236m) -> \u001b[38;5;31mint\u001b[38;5;236m:\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m 5 -\u001b[38;5;236m    \"\"\"Divide a cent amount by `divisor`; fractions of a cen\r\u001b[6C\u001b[1B\u001b[38;5;160m \u001b[10G\u001b[38;5;236mt\u001b[12Gare dropped.\"\"\"   \u001b[31G      \u001b[38G  \u001b[41G          \u001b[52G         \u001b[62G  \u001b[65G \u001b[67G   \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 5 +\u001b[38;5;236m    \u001b[38;5;24m\"\"\"Divide a cent amount by `divisor`; fractions of a cen\r\u001b[6C\u001b[1B\u001b[38;5;29m \u001b[10G\u001b[38;5;24mt \u001b[48;5;157mround\u001b[48;5;194m \u001b[48;5;157mhalf up\u001b[48;5;194m.\"\"\"\u001b[38;5;236m                                         \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 6 \u001b[22m     \u001b[38;5;125mif\u001b[38;5;236m divisor <= \u001b[38;5;31m0\u001b[38;5;236m:\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m7\u001b[14G\u001b[22m  \u001b[17G \u001b[38;5;125mraise\u001b[38;5;236m ValueError(\u001b[38;5;24m\"divisor must be positive\"\u001b[38;5;236m)\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m 8 -\u001b[38;5;236m    return total_cents // divisor                           \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 8 +\u001b[38;5;236m    \u001b[38;5;125mreturn\u001b[38;5;236m \u001b[48;5;157m(\u001b[48;5;194mtotal_cents \u001b[48;5;157m+ divisor \u001b[48;5;194m// \u001b[38;5;31m\u001b[48;5;157m2\u001b[38;5;236m) // \u001b[48;5;194mdivisor          \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow\u001b[7Glet\u001b[11Gme\u001b[14Grun\u001b[18Gthe\u001b[22Gtests\u001b[28Gto\u001b[31Gverify\u001b[38Gthe\u001b[42Gfix\u001b[46Gworks:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mDone!\u001b[9GI\u001b[11Gfixed\u001b[17Gthe\u001b[21G\u001b[38;5;105mdiv_cents()\u001b[33G\u001b[39mfunction\u001b[42Gin\u001b[45G\u001b[38;5;105mapp/money.py\u001b[58G\u001b[39mto\u001b[61Guse\r\u001b[1B \u001b[3Gr\u001b[5Gund-half-up\u001b[17Ginstead of dropping fract\u001b[43Gons. The change replaces\u001b[68Gfloor\r\u001b[2C\u001b[1Bdivision (\u001b[38;5;105m//\u001b[39m)\u001b[17Gwith the \u001b[27Gormula \u001b[38;5;105m(total_cents + divisor // 2) // divisor\u001b[39m,\r\u001b[2C\u001b[1Bwhich properly rounds fractions of a cent at 0.5 or above up to the next\r\u001b[2C\u001b[1Bcent.\u001b[9G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BAll\u001b[7Gthree\u001b[13Gtests\u001b[19Gpass:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GExact\u001b[11Gdivision\u001b[20Gstill\u001b[26Gworks\u001b[32G(700\u001b[37G÷\u001b[39G100\u001b[43G= 7)\r\u001b[4C\u001b[1BHalf-cent rou\u001b[19Gding works (735\u001b[35G ÷ 10\u001b[41G = 74,\u001b[48Gnot 73)\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[29.371451, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;5;160m\u001b[48;5;224m 5 -\u001b[38;5;236m    \"\"\"Divide a cent amount by `divisor`; fractions of a cen\r\u001b[6C\u001b[1B\u001b[38;5;160m \u001b[10G\u001b[38;5;236mt\u001b[12Gare dropped.\"\"\"   \u001b[31G      \u001b[38G  \u001b[41G          \u001b[52G         \u001b[62G  \u001b[65G \u001b[67G   \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 5 +\u001b[38;5;236m    \u001b[38;5;24m\"\"\"Divide a cent amount by `divisor`; fractions of a cen\r\u001b[6C\u001b[1B\u001b[38;5;29m \u001b[10G\u001b[38;5;24mt \u001b[48;5;157mround\u001b[48;5;194m \u001b[48;5;157mhalf up\u001b[48;5;194m.\"\"\"\u001b[38;5;236m                                         \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 6 \u001b[22m     \u001b[38;5;125mif\u001b[38;5;236m divisor <= \u001b[38;5;31m0\u001b[38;5;236m:\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m7\u001b[14G\u001b[22m  \u001b[17G \u001b[38;5;125mraise\u001b[38;5;236m ValueError(\u001b[38;5;24m\"divisor must be positive\"\u001b[38;5;236m)\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m 8 -\u001b[38;5;236m    return total_cents // divisor                           \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 8 +\u001b[38;5;236m    \u001b[38;5;125mreturn\u001b[38;5;236m \u001b[48;5;157m(\u001b[48;5;194mtotal_cents \u001b[48;5;157m+ divisor \u001b[48;5;194m// \u001b[38;5;31m\u001b[48;5;157m2\u001b[38;5;236m) // \u001b[48;5;194mdivisor          \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow\u001b[7Glet\u001b[11Gme\u001b[14Grun\u001b[18Gthe\u001b[22Gtests\u001b[28Gto\u001b[31Gverify\u001b[38Gthe\u001b[42Gfix\u001b[46Gworks:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mDone!\u001b[9GI\u001b[11Gfixed\u001b[17Gthe\u001b[21G\u001b[38;5;105mdiv_cents()\u001b[33G\u001b[39mfunction\u001b