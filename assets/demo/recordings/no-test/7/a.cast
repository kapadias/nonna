[29.114739, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[22BFixed!\u001b[10GThe\u001b[14G\u001b[38;5;105madd_months\u001b[25G\u001b[39mfunction\u001b[34Gnow\u001b[38Gclamps\u001b[45Gthe\u001b[49Gday\u001b[53Gto\u001b[56Gthe\u001b[60Glast\u001b[65Gvalid\u001b[71Gday\u001b[75Gof\r\u001b[2C\u001b[1Bthe\u001b[7Gtarget\u001b[14Gmonth\u001b[20Gwhen\u001b[25Gneeded.\r\u001b[1B\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[29.454949, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mAdded \u001b[1m7\u001b[22m lines, removed\u001b[29G\u001b[1m2\u001b[31G\u001b[22mlines\r\u001b[1B     \u001b[38;5;236m\u001b[2m  5 \u001b[22m \u001b[12G\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m6\r\u001b[7C\u001b[1B7\u001b[11G\u001b[22m\u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97madd_months\u001b[38;5;236m(\u001b[38;5;31md: date, months: int\u001b[38;5;236m) -> date:\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  8 -\u001b[38;5;236m    \"\"\"Return the date `months` calendar months after `d` (\r\u001b[7C\u001b[1B\u001b[38;5;160m \u001b[11G\u001b[38;5;236mnegative goes\u001b[25Gback), same day of month.\"\"\"     \u001b[59G     \u001b[65G   \u001b[69G \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  8 +\u001b[38;5;236m    \u001b[38;5;24m\"\"\"Return the date `months` calendar months after `d` (\r\u001b[7C\u001b[1B\u001b[38;5;29m \u001b[11G\u001b[38;5;24mnegative goes back), same day of month.\u001b[38;5;236m                    \r\u001b[7C\u001b[1B\u001b[38;5;29m9\u001b[11G\u001b[38;5;236m                                                           \r\u001b[6C\u001b[1B\u001b[38;5;29m10\u001b[15G\u001b[38;5;236mIf\u001b[18Gthe\u001b[22Gtarget\u001b[29Gmonth\u001b[35Ghas\u001b[39Gfewer\u001b[45Gdays,\u001b[51Gclamps\u001b[58Gto\u001b[61Gthe\u001b[65Glast\r\u001b[6C\u001b[1B\u001b[38;5;29m  \u001b[11G\u001b[38;5;236mday\u001b[15Go\u001b[20Gat month.     \u001b[35G   \u001b[39G     \u001b[45G     \u001b[51G      \u001b[58G  \u001b[61G   \u001b[65G    \r\u001b[6C\u001b[1B\u001b[38;5;29m11\u001b[11G\u001b[38;5;236m   \u001b[15G\u001b[38;5;24m\"\"\"\u001b[38;5;236m                                                    \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 12 \u001b[22m     y, m = \u001b[38;5;31mdivmod\u001b[38;5;236m(d.month - \u001b[38;5;31m1\u001b[38;5;236m + months, \u001b[38;5;31m12\u001b[38;5;236m)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m 10 -\u001b[38;5;236m    return d.replace(year=d.year + y, month=m + 1)         \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 13 +\u001b[38;5;236m    last_day = calendar.monthrange(d.year + y, m + \u001b[38;5;31m1\u001b[38;5;236m)[\u001b[38;5;31m1\u001b[38;5;236m]   \r\u001b[7C\u001b[1B\u001b[38;5;29m4\u001b[15G\u001b[38;5;236md\u001b[17Gy = \u001b[38;5;31mmin\u001b[38;5;236m(d.day, last_day)                          \r\u001b[7C\u001b[1B\u001b[38;5;29m5\u001b[15G\u001b[38;5;125mreturn\u001b[38;5;236m d.repl\u001b[29Gce(year=\u001b[38G.\u001b[40Gear\u001b[44G+\u001b[46Gy,\u001b[49Gmonth=m\u001b[57G+\u001b[59G\u001b[38;5;31m1\u001b[38;5;236m,\u001b[62Gday=day)\r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mFixed!\u001b[10GThe\u001b[14G\u001b[38;5;105madd_months\u001b[25G\u001b[39mfunction\u001b[34Gnow\u001b[38Gclamps\u001b[45Gthe\u001b[49Gday\u001b[53Gto\u001b[56Gthe\u001b[60Glast\u001b[65Gvalid\u001b[71Gday\u001b[75Gof\r\u001b[1B \u001b[3Gthe target\u001b[14Gmonth when\u001b[25Gneeded.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gissue\u001b[13Gwas\u001b[17Gthat\u001b[22G\u001b[38;5;105md.replace()\u001b[34G\u001b[39mwas\u001b[38Gtrying\u001b[45Gto\u001b[48Gcreate\u001b[55Gan\u001b[58Ginvalid\u001b[66Gdate\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[29.589933, "o", "\u001b[?25l\u001b[H\u001b[38;5;241m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m7\u001b[14G\u001b[22mlines,\u001b[21Gremoved\u001b[29G\u001b[1m2\u001b[31G\u001b[22mlines\r\u001b[1B     \u001b[38;5;236m\u001b[2m  5 \u001b[22m \u001b[12G\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m6\r\u001b[7C\u001b[1B7\u001b[11G\u001b[22m\u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97madd_months\u001b[38;5;236m(\u001b[38;5;31md: date, months: int\u001b[38;5;236m) -> date:\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  8 -\u001b[38;5;236m    \"\"\"Return the date `months` calendar months after `d` (\r\u001b[7C\u001b[1B\u001b[38;5;160m \u001b[11G\u001b[38;5;236mnegative goes\u001b[25Gback), same day of month.\"\"\"     \u001b[59G     \u001b[65G   \u001b[69G \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  8 +\u001b[38;5;236m    \u001b[38;5;24m\"\"\"Return the date `months` calendar months after `d` (\r\u001b[7C\u001b[1B\u001b[38;5;29m \u001b[11G\u001b[38;5;24mnegative goes back), same day of month.\u001b[38;5;236m                    \r\u001b[7C\u001b[1B\u001b[38;5;29m9\u001b[11G\u001b[38;5;236m                                                           \r\u001b[6C\u001b[1B\u001b[38;5;29m10\u001b[15G\u001b[38;5;236mIf\u001b[18Gthe\u001b[22Gtarget\u001b[29Gmonth\u001b[35Ghas\u001b[39Gfewer\u001b[45Gdays,\u001b[51Gclamps\u001b[58Gto\u001b[61Gthe\u001b[65Glast\r\u001b[6C\u001b[1B\u001b[38;5;29m  \u001b[11G\u001b[38;5;236mday\u001b[15Go\u001b[20Gat month.     \u001b[35G   \u001b[39G     \u001b[45G     \u001b[51G      \u001b[58G  \u001b[61G   \u001b[65G    \r\u001b[6C\u001b[1B\u001b[38;5;29m11\u001b[11G\u001b[38;5;236m   \u001b[15G\u001b[38;5;24m\"\"\"\u001b[38;5;236m                                                    \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 12 \u001b[22m     y, m = \u001b[38;5;31mdivmod\u001b[38;5;236m(d.month - \u001b[38;5;31m1\u001b[38;5;236m + months, \u001b[38;5;31m12\u001b[38;5;236m)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m 10 -\u001b[38;5;236m    return d.replace(year=d.year + y, month=m + 1)         \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 13 +\u001b[38;5;236m    last_day = calendar.monthrange(d.year + y, m + \u001b[38;5;31m1\u001b[38;5;236m)[\u001b[38;5;31m1\u001b[38;5;236m]   \r\u001b[7C\u001b[1B\u001b[38;5;29m4\u001b[15G\u001b[38;5;236md\u001b[17Gy = \u001b[38;5;31mmin\u001b[38;5;236m(d.day, last_day)                          \r\u001b[7C\u001b[1B\u001b[38;5;29m5\u001b[15G\u001b[38;5;125mreturn\u001b[38;5;236m d.repl\u001b[29Gce(year=\u001b[38G.\u001b[40Gear\u001b[44G+\u001b[46Gy,\u001b[49Gmonth=m\u001b[57G+\u001b[59G\u001b[38;5;31m1\u001b[38;5;236m,\u001b[62Gday=day)\r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mFixed!\u001b[10GThe\u001b[14G\u001b[38;5;105madd_months\u001b[25G\u001b[39mfunction\u001b[34Gnow\u001b[38Gclamps\u001b[45Gthe\u001b[49Gday\u001b[53Gto\u001b[56Gthe\u001b[60Glast\u001b[65Gvalid\u001b[71Gday\u001b[75Gof\r\u001b[1B \u001b[3Gthe target\u001b[14Gmonth when\u001b[25Gneeded.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gissue\u001b[13Gwas\u001b[17Gthat\u001b[22G\u001b[38;5;105md.replace()\u001b[34G\u001b[39mwas\u001b[38Gtrying\u001b[45Gto\u001b[48Gcreate\u001b[55Gan\u001b[58Ginvalid\u001b[66Gdate\r\u001b[2C\u001b[1B(F\u001b[6Gbruary\u001b[13G31\u001b[16Gt). The fix uses \u001b[38;5;105mcalendar.monthrange()\u001b[55G\u001b[39mto\u001b[58Gfind the last\u001b[72Gday\u001b[30;1H\u001b[28;3H\u001b[?25h"]
