[K\r\u001b[2C\u001b[1BT\u001b[7Gspecific case you\u001b[25Gm\u001b[27Gntioned\u001b[35Gnow\u001b[39Gworks\u001b[45Gcorrectly:\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;5;105madd_months(date(2024, 1, 31), 1)\u001b[38G\u001b[39m→\u001b[40G\u001b[38;5;105mdate(2024, 2, 29)\u001b[58G\u001b[39m✓\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;241m✻\u001b[3GSautéed for 16s · done 6:03 PM\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;5;255m\u001b[38;5;248m❯ \u001b[38;5;241m/exit\u001b[39m                                                                     \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;5;174m✢\u001b[3GHyperspacin\u001b[38;5;216mg…\u001b[38;5;174m \u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  Tip: Hit shift+tab to cycle between manual mode, auto-accept edit mode,\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;241mand plan\u001b[15Gmode\u001b[39m\u001b[K\r\u001b[3B\u001b[38;5;241m❯ \r\u001b[44C\u001b[2Besc to interrupt · ← for agen…\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
