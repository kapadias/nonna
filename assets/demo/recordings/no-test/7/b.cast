[32.29446, "o", "\u001b[?25l\u001b[H\u001b[7G\u001b[38;5;29m\u001b[48;5;194m 8\u001b[15G\u001b[38;5;24m\"\"\"Return the date `months` calendar months after `d` (\r\u001b[10C\u001b[1Bnegative goes back), same day of month.\r\u001b[6C\u001b[1B\u001b[38;5;29m 9\u001b[15G\u001b[38;5;236m                                                       \r\u001b[5C\u001b[1B\u001b[38;5;29m 10 +\u001b[38;5;236m    Clamps to the last day of the target month \u001b[38;5;125mif\u001b[38;5;236m the day d\r\u001b[5C\u001b[1B\u001b[38;5;29m    +\u001b[38;5;236moesn\u001b[38;5;24m't exist in that month.\u001b[38;5;236m                                \r\u001b[7C\u001b[1B\u001b[38;5;29m1\u001b[15G\u001b[38;5;24m\"\"\"\u001b[38;5;236m                                                    \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 12 \u001b[22m     y, m = \u001b[38;5;31mdivmod\u001b[38;5;236m(d.month - \u001b[38;5;31m1\u001b[38;5;236m + months, \u001b[38;5;31m12\u001b[38;5;236m)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  9 -\u001b[38;5;236m    return d.replace(year=d.year + y, month=m + 1)         \r\u001b[7C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m3\u001b[15G\u001b[38;5;236mt\u001b[17Grget_year = d.year + y                               \r\u001b[7C\u001b[1B\u001b[38;5;29m4\u001b[15G\u001b[38;5;236mtarget_month = m + \u001b[38;5;31m1\u001b[38;5;236m    \u001b[40G             \u001b[54G    \r\u001b[5C\u001b[1B\u001b[38;5;29m 15 +\u001b[38;5;236m    last_day = monthrange(target_year, target_month)[\u001b[38;5;31m1\u001b[38;5;236m]    \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[38;5;29m\u001b[48;5;194m 16 +\u001b[38;5;236m    day = \u001b[38;5;31mmin\u001b[38;5;236m(d.day, last_day)                             \r\u001b[5C\u001b[1B\u001b[38;5;29m 17 +\u001b[38;5;236m    \u001b[38;5;125mreturn\u001b[38;5;236m date(target_year, target_month, day)            \r\u001b[2C\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow\u001b[7Glet\u001b[11