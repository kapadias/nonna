01b[39m\u001b[49m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow\u001b[7Glet\u001b[11Gme\u001b[14Gverify\u001b[21Gthe\u001b[25Gtests\u001b[31Gpass:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mLet\u001b[7Gme verify these\u001b[23Gtests\u001b[29Gwould\u001b[35Gcatch\u001b[41Gthe\u001b[45Gbug\u001b[49Gby\u001b[52Gchecking\u001b[61Gthey\u001b[66Gfail\u001b[71Gwith\r\u001b[2C\u001b[1Bthe\u001b[7Goriginal\u001b[16Gbroken\u001b[23Gcode:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mDone.\u001b[9GI've\u001b[14Gadded\u001b[20Gthree\u001b[26Gtest\u001b[31Gcases\u001b[37Gthat\u001b[42Gverify\u001b[49Gthe\u001b[53Gmonth-end\u001b[63Gclamping\r\u001b[1B \u001b[3Gbehavior:\u001b[K\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[6G\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
