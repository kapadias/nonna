diff --git a/app/dates.py b/app/dates.py
index 7b72e74..4a50cc2 100644
--- a/app/dates.py
+++ b/app/dates.py
@@ -1,9 +1,17 @@
 """Calendar helpers for billing renewals."""
 
+from calendar import monthrange
 from datetime import date
 
 
 def add_months(d: date, months: int) -> date:
-    """Return the date `months` calendar months after `d` (negative goes back), same day of month."""
+    """Return the date `months` calendar months after `d` (negative goes back), same day of month.
+
+    Clamps to the last day of the target month if the day doesn't exist in that month.
+    """
     y, m = divmod(d.month - 1 + months, 12)
-    return d.replace(year=d.year + y, month=m + 1)
+    target_year = d.year + y
+    target_month = m + 1
+    last_day = monthrange(target_year, target_month)[1]
+    day = min(d.day, last_day)
+    return date(target_year, target_month, day)
