[30.523092, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;65m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(\u001b]8;id=1ne69l2;file:///root/b/renewals/tests/test_dates.py\u0007tests/test_dates.py\u001b]8;;\u0007)\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mAdded \u001b[1m8\u001b[22m lines\u001b[K\r\u001b[1B     \u001b[38;5;236m\u001b[2m  9 \u001b[22m \u001b[12G\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m10\u001b[11G\u001b[22m\u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97mtest_rolls_over_the_year\u001b[38;5;236m():\r\u001b[7C\u001b[1B\u001b[2m1\u001b[11G\u001b[22m   \u001b[15G\u001b[38;5;125massert\u001b[38;5;236m add_months(date(\u001b[38;5;31m2024\u001b[38;5;236m, \u001b[38;5;31m11\u001b[38;5;236m, \u001b[38;5;31m15\u001b[38;5;236m), \u001b[38;5;31m3\u001b[38;5;236m) == date(\u001b[38;5;31m2025\u001b[38;5;236m, \r\u001b[6C\u001b[1B\u001b[2m  \u001b[11G\u001b[22m\u001b[38;5;31m2\u001b[38;5;236m,\u001b[14G\u001b[38;5;31m15\u001b[38;5;236m)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 12 +\u001b[38;5;236m                                                           \r\u001b[7C\u001b[1B\u001b[38;5;29m3\r\u001b[7C\u001b[1B4\u001b[11G\u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97mtest_clamps_to_last_day_of_month\u001b[38;5;236m():                    \r\u001b[7C\u001b[1B\u001b[38;5;29m5\u001b[11G\u001b[38;5;236m    \u001b[38;5;125massert\u001b[38;5;236m add_months(date(\u001b[38;5;31m2024\u001b[38;5;236m, \u001b[38;5;31m1\u001b[38;5;236m, \u001b[38;5;31m31\u001b[38;5;236m),\u001b[52G\u001b[38;5;31m1\u001b[38;5;236m)\u001b[55G==\u001b[58Gdate(\u001b[38;5;31m2024\u001b[38;5;236m,\u001b[69G\u001b[38;5;31m2\r\u001b[6C\u001b[1B\u001b[38;5;29m  \u001b[11G\u001b[38;5;236m,\u001b[13G\u001b[38;5;31m29\u001b[38;5;236m)     \u001b[22G                     \u001b[44G  \u001b[47G    \u001b[52G  \u001b[55G  \u001b[58G          \u001b[69G \r\u001b[6C\u001b[1B\u001b[38;5;29m16\u001b[11G\u001b[38;5;236m \u001b[13G                                                         \r\u001b[7C\u001b[1B\u001b[38;5;29m7\r\u001b[7C\u001b[1B8\u001b[11G\u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97mtest_clamps_day_to_shorter_month\u001b[38;5;236m():                    \r\u001b[7C\u001b[1B\u001b[38;5;29m9\u001b[11G\u001b[38;5;236m    \u001b[38;5;125massert\u001b[38;5;236m add_months(date(\u001b[38;5;31m2024\u001b[38;5;236m, \u001b[38;5;31m3\u001b[38;5;236m, \u001b[38;5;31m31\u001b[38;5;236m),\u001b[52G\u001b[38;5;31m1\u001b[38;5;236m)\u001b[55G==\u001b[58Gdate(\u001b[38;5;31m2024\u001b[38;5;236m,\u001b[69G\u001b[38;5;31m4\r\u001b[6C\u001b[1B\u001b[38;5;29m  \u001b[11G\u001b[38;5;236m,\u001b[13G\u001b[38;5;31m30\u001b[38;5;236m)     \u001b[22G                     \u001b[44G  \u001b[47G    \u001b[52G  \u001b[55G  \u001b[58G          \u001b[69G \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;241m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(\u001b]8;id=81owi3;file:///root/b/renewals/app/dates.py\u0007app/dates.py\u001b]8;;\u0007)\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;174m·\u001b[3G\u001b[38;5;216mFinagling…\u001b[38;5;174m \u001b[38;5;241m(running PostToolUse hook · 15s · ↓\u001b[50G1.6k tokens · \r\u001b[1Bthought for 1s)\u001b[39m\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
