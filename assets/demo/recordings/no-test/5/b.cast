[11G\u001b[38;5;236month)[\u001b[38;5;31m1\u001b[38;5;236m]             \r\u001b[7C\u001b[1B\u001b[38;5;29m3\u001b[15G\u001b[38;5;236mnew_day = \u001b[38;5;31mmin\u001b[38;5;236m(d.day, days_in_new_month)                \r\u001b[6C\u001b[1B\u001b[38;5;29m14\u001b[11G\u001b[38;5;236m    \u001b[38;5;125mreturn\u001b[22G\u001b[38;5;236md.replace(year=new_year,\u001b[47Gmonth=new_month,\u001b[64Gday=ne\r\u001b[6C\u001b[1B\u001b[38;5;29m  \u001b[11G\u001b[38;5;236mw_day)     \u001b[23G \u001b[25G                                             \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;241m●\u001b[3G\u001b[39mRunning \u001b[1m3\u001b[22m shell commands…\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  $ python3 -c \"from datetime import date; from app.dates import \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;241madd_months; result = add_months(date(2024, 1, 31), 1); \r\u001b[1B\u001b[39m     \u001b[38;5;241mprin\u001b[11G(f'add_mon\u001b[22Gh\u001b[24G(date(2024, 1, 31), 1) = {result}')\"\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
