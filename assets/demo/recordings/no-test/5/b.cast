[30.639808, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;5;65m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(\u001b]8;id=81owi3;file:///root/b/renewals/app/dates.py\u0007app/dates.py\u001b]8;;\u0007)\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mAdded \u001b[1m7\u001b[22m lines, removed \u001b[1m2\u001b[31G\u001b[22mlines\r\u001b[1B     \u001b[38;5;236m\u001b[2m  1 \u001b[22m \u001b[38;5;24m\"\"\"Calendar helpers for billing renewals.\"\"\"\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m2\r\u001b[5C\u001b[1B\u001b[22m\u001b[38;5;29m\u001b[48;5;194m  3 +\u001b[38;5;125mimport\u001b[38;5;236m calendar                                            \r\u001b[6C\u001b[1B\u001b[49m\u001b[2m 4\u001b[11G\u001b[22m\u001b[38;5;125mfrom\u001b[38;5;236m datetime \u001b[38;5;125mimport\u001b[38;5;236m date\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m5\u001b[11G\u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  6 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  7 \u001b[22m \u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97madd_months\u001b[38;5;236m(\u001b[38;5;31md: date, months: int\u001b[38;5;236m) -> date:\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  7 -\u001b[38;5;236m    \"\"\"Return the date `months` calendar months after `d` (\r\u001b[5C\u001b[1B\u001b[38;5;160m    -\u001b[38;5;236mnegative goes back), same day of month.\"\"\"                 \r\u001b[7C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m8\u001b[11G\u001b[38;5;236m \u001b[13G  \u001b[38;5;24m\"\"\"Return the date `months` calendar months after `d` (\r\u001b[6C\u001b[1B\u001b[38;5;29m  \u001b[11G\u001b[38;5;24mnegative goes back), \u001b[48;5;157mclamped\u001b[48;5;194m \u001b[48;5;157mto the last \u001b[48;5;194mday \u001b[48;5;157mif\u001b[48;5;194m \u001b[48;5;157mneeded\u001b[48;5;194m.\"\"\"\u001b[38;5;236m \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m  9 \u001b[22m     y, m = \u001b[38;5;31mdivmod\u001b[38;5;236m(d.month - \u001b[38;5;31m1\u001b[38;5;236m + months, \u001b[38;5;31m12\u001b[38;5;236m)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  9 -\u001b[38;5;236m    return d.replace(year=d.year + y, month=m + 1)         \r\u001b[7C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m0\u001b[15G\u001b[38;5;236mnew_year = d.year + y                                  \r\u001b[6C\u001b[1B\u001b[38;5;29m11\u001b[11G\u001b[38;5;236m \u001b[13G  new_month = m + \u001b[38;5;31m1\r\u001b[5C\u001b[1B\u001b[38;5;29m 12 +\u001b[38;5;236m    days_in_new_month = calendar.monthrange(new_year, new_m\r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;5;29m\u001b[48;5;194m    +\u001b[38;5;236month)[\u001b[38;5;31m1\u001b[38;5;236m]                                                   \r\u001b[5C\u001b[1B\u001b[38;5;29m 13 +\u001b[38;5;236m    new_day = \u001b[38;5;31mmin\u001b[38;5;236m(d.day, days_in_new_month)                \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[38;5;29m\u001b[48;5;194m 14 +\u001b[38;5;236m    \u001b[38;5;125mreturn\u001b[38;5;236m d.replace(year=new_year, month=new_month, day=ne\r\u001b[5C\u001b[1B\u001b[38;5;29m    +\u001b[38;5;236mw_day)                                                     \r\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;174m·\u001b[39m \u001b[38;5;216mFinagling…\u001b[38;5;174m \u001b[38;5;241m(16s · ↓\u001b[23G1.6k tokens · thought for 1s)\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
