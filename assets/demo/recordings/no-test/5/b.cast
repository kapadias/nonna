[34.203344, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[38;5;236m\u001b[2m2\u001b[11G\u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  3 +\u001b[38;5;125mimport\u001b[38;5;236m calendar                                            \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m  4 \u001b[22m \u001b[38;5;125mfrom\u001b[38;5;236m datetime \u001b[38;5;125mimport\u001b[38;5;236m date\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m5\u001b[11G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m6\r\u001b[7C\u001b[1B7\u001b[11G\u001b[22m\u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97madd_months\u001b[38;5;236m(\u001b[38;5;31md: date, months: int\u001b[38;5;236m) -> date:\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  7 -\u001b[38;5;236m    \"\"\"Return the date `months` calendar months after `d` (\r\u001b[7C\u001b[1B\u001b[38;5;160m \u001b[11G\u001b[38;5;236mnegative goes\u001b[25Gback), same day of month.\"\"\"     \u001b[59G     \u001b[65G   \u001b[69G \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  8 +\u001b[38;5;236m    \u001b[38;5;24m\"\"\"Return the date `months` calendar months after `d` (\r\u001b[7C\u001b[1B\u001b[38;5;29m \u001b[11G\u001b[38;5;24mnegative goes back), \u001b[48;5;157mclamped\u001b[48;5;194m \u001b[48;5;157mto the last \u001b[48;5;194mday \u001b[48;5;157mif\u001b[48;5;194m \u001b[48;5;157mneeded\u001b[48;5;194m.\"\"\"\u001b[38;5;236m \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m  9 \u001b[22m     y, m = \u001b[38;5;31mdivmod\u001b[38;5;236m(d.month - \u001b[38;5;31m1\u001b[38;5;236m + months, \u001b[38;5;31m12\u001b[38;5;236m)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  9 -\u001b[38;5;236m    return d.replace(year=d.year + y, month=m + 1)         \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 10 +\u001b[38;5;236m    new_year = d.year + y                                  \r\u001b[7C\u001b[1B\u001b[38;5;29m1\u001b[19G\u001b[38;5;236mmonth = m + \u001b[38;5;31m1\u001b[38;5;236m                                      \r\u001b[7C\u001b[1B\u001b[38;5;29m2\u001b[15G\u001b[38;5;236mdays_i\u001b[22G_new_\u001b[28Gonth = calendar.monthrange(new_year, new_m\r\u001b[6C\u001b[1B\u001b[38;5;29m  \u001b[11G\u001b[38;5;236month)[\u001b[38;5;31m1\u001b[38;5;236m]                                                   \r\u001b[6C\u001b[1B\u001b[38;5;29m13\u001b[11G\u001b[38;5;236m    new_day = \u001b[38;5;31mmin\u001b[38;5;236m(d.day,\u001b[36Gdays_in_new_month)\r\u001b[7C\u001b[1B\u001b[38;5;29m4\u001b[15G\u001b[38;5;125mreturn\u001b[38;5;236m d.replace(year=new\u001b[41Gyear, month=new_month,\u001b[64Gday=ne\r\u001b[6C\u001b[1B\u001b[38;5;29m  \u001b[11G\u001b[38;5;236mw_day)                                                     \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;241m●\u001b[3G\u001b[39mRunning\u001b[11G\u001b[1m2\u001b[13G\u001b[22mshell\u001b[19Gcommands…\r\u001b[1B\u001b[38;5;241m  ⎿  $ python3 -m pytest tests/test_dates.py -xvs\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;174m✢\u001b[3GFinagling… \u001b[38;5;241m(running PreToolUse hooks… 0/2 · 19s · ↓\u001b[55G1.9k tokens · \u001b[38;5;249mthinking\r\u001b[1B\u001b[38;5;241m)\u001b[3G\u001b[39m\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
