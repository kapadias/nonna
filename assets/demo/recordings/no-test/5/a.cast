29m\u001b[48;5;194m 10 +\u001b[38;5;236m    target_year = d.year + y                               \r\u001b[5C\u001b[1B\u001b[38;5;29m 11 +\u001b[38;5;236m    target_month = m + \u001b[38;5;31m1\u001b[38;5;236m                                   \r\u001b[7C\u001b[1B\u001b[38;5;29m2\u001b[15G\u001b[38;5;236ml\u001b[17Gst_da\u001b[23G = monthrange(target_year,\u001b[50Gtarget_month)[\u001b[38;5;31m1\u001b[38;5;236m]    \r\u001b[7C\u001b[1B\u001b[38;5;29m3\u001b[15G\u001b[38;5;236md\u001b[17Gy = \u001b[38;5;31mmin\u001b[38;5;236m(d.day, last_day)\r\u001b[7C\u001b[1B\u001b[38;5;29m4\u001b[15G\u001b[38;5;125mreturn\u001b[38;5;236m date(target_year, target_month, day)        \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[1B\u001b[38;5;241m●\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command…\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
