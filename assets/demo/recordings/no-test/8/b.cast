return d.replace(year=d.year + y, month=m + 1)         \r\u001b[7C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m0\u001b[15G\u001b[38;5;236myear = d.year + y                                      \r\u001b[7C\u001b[1B\u001b[38;5;29m1\u001b[15G\u001b[38;5;236mmonth = m + \u001b[38;5;31m1\u001b[38;5;236m                                      \r\u001b[7C\u001b[1B\u001b[38;5;29m2\u001b[15G\u001b[38;5;246m# Clamp the day to the last day of the target month\r\u001b[7C\u001b[1B\u001b[38;5;29m3\u001b[15G\u001b[38;5;236mday = \u001b[38;5;31mmin\u001b[38;5;236m(d.day, monthrange(year,\u001b[49Gmonth)[\u001b[38;5;31m1\u001b[38;5;236m])\r\u001b[5C\u001b[1B\u001b[38;5;29m 14 +\u001b[38;5;236m    \u001b[38;5;125mreturn\u001b[38;5;236m date(year, month, day)                          \r\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[1B\u001b[38;5;241m●\u001b[39m Running \u001b[1m1\u001b[22m shell command…\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  $ python3 -m pytest tests/test_dates.py -v\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;174m✶\u001b[39m \u001b[38;5;216mPropagating…\u001b[38;5;174m \u001b[38;5;241m(26s · ↓\u001b[25G2.6k tokens)\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
