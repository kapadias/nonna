uld clamp to Feb 28\u001b[48;5;157m,\u001b[48;5;194m \u001b[48;5;157m2025 \u001b[48;5;194m(non-\r\u001b[5C\u001b[1B\u001b[38;5;29m    +\u001b[38;5;246mleap year)\u001b[38;5;236m                                                 \r\u001b[7C\u001b[1B\u001b[38;5;29m1\u001b[15G\u001b[38;5;125massert\u001b[38;5;236m add_months(date(\u001b[38;5;31m2024\u001b[38;5;236m, \u001b[38;5;31m1\u001b[38;5;236m, \u001b[38;5;31m31\u001b[38;5;236m), \u001b[38;5;31m\u001b[48;5;157m13\u001b[38;5;236m\u001b[48;5;194m) == date(\u001b[38;5;31m2025\u001b[38;5;236m, \r\u001b[10C\u001b[1B\u001b[38;5;31m\u001b[48;5;157m2\u001b[38;5;236m\u001b[48;5;194m, \u001b[38;5;31m\u001b[48;5;157m28\u001b[38;5;236m\u001b[48;5;194m)                                                     \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;241m●\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command…\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  $ python3 -m pytest tests/test_dates.py -v\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;241m●\u001b[39m \u001b[1mUpdate\u001b[22m(\u001b]8;id=81owi3;file:///root/b/renewals/app/dates.py\u0007app/dates.py\u001b]8;;\u0007)\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
