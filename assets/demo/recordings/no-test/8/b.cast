[42.356968, "o", "\u001b[?25l\u001b[H     \u001b[38;5;236m\u001b[2m  1 \u001b[22m \u001b[38;5;24m\"\"\"Calendar helpers for billing renewals.\"\"\"\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m2\u001b[11G\u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  3 +\u001b[38;5;125mfrom\u001b[38;5;236m calendar \u001b[38;5;125mimport\u001b[38;5;236m monthrange                            \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m  4 \u001b[22m \u001b[38;5;125mfrom\u001b[38;5;236m datetime \u001b[38;5;125mimport\u001b[38;5;236m date\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m5\u001b[11G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m6\r\u001b[7C\u001b[1B7\u001b[11G\u001b[22m\u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97madd_months\u001b[38;5;236m(\u001b[38;5;31md: date, months: int\u001b[38;5;236m) -> date:\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  7 -\u001b[38;5;236m    \"\"\"Return the date `months` calendar months after `d` (\r\u001b[7C\u001b[1B\u001b[38;5;160m \u001b[11G\u001b[38;5;236mnegative goes\u001b[25Gback), same day of month.\"\"\"     \u001b[59G     \u001b[65G   \u001b[69G \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  8 +\u001b[38;5;236m    \u001b[38;5;24m\"\"\"Return the date `months` calendar months after `d` (\r\u001b[7C\u001b[1B\u001b[38;5;29m \u001b[11G\u001b[38;5;24mnegative goes back), same day of month\u001b[48;5;157m, clamped to month le\r\u001b[10C\u001b[1Bngth\u001b[48;5;194m.\"\"\"\u001b[38;5;236m                                                   \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m  9 \u001b[22m     y, m = \u001b[38;5;31mdivmod\u001b[38;5;236m(d.month - \u001b[38;5;31m1\u001b[38;5;236m + months, \u001b[38;5;31m12\u001b[38;5;236m)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  9 -\u001b[38;5;236m    return d.replace(year=d.year + y, month=m + 1)         \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 10 +\u001b[38;5;236m    year = d.year + y                                      \r\u001b[7C\u001b[1B\u001b[38;5;29m1\u001b[15G\u001b[38;5;236mmonth = m + \u001b[38;5;31m1\u001b[38;5;236m                                          \r\u001b[7C\u001b[1B\u001b[38;5;29m2\u001b[15G\u001b[38;5;246m# Clamp the day to the last day of the target month\r\u001b[7C\u001b[1B\u001b[38;5;29m3\u001b[15G\u001b[38;5;236mday = \u001b[38;5;31mmin\u001b[38;5;236m(d.day, monthrange(year, month)[\u001b[38;5;31m1\u001b[38;5;236m])       \r\u001b[7C\u001b[1B\u001b[38;5;29m4\u001b[15G\u001b[38;5;125mreturn\u001b[38;5;236m date(year, month, day)    \u001b[49G          \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[1B\u001b[38;5;241m●\u001b[3G\u001b[39mRunning\u001b[11G\u001b[1m2\u001b[13G\u001b[22mshell\u001b[19Gcommands…\r\u001b[1B\u001b[38;5;241m  ⎿  $ python3 -m pytest tests/test_dates.py -v\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;174m·\u001b[3GPropagating… \u001b[38;5;241m(running PreToolUse hooks… 0/2 · 27s · ↓\u001b[57G2.7k tokens · \r\u001b[1B\u001b[38;5;248mthinking\u001b[38;5;241m)\u001b[39m\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
