[21.679979, "o", "\u001b[?25l\u001b[H\u001b[38;5;16m●\u001b[3G\u001b[39mI'll\u001b[8Gfix\u001b[12Gthe\u001b[16G\u001b[38;5;105madd_months\u001b[27G\u001b[39mfunction\u001b[36Gto\u001b[39Gclamp\u001b[45Gthe\u001b[49Gday\u001b[53Gto\u001b[56Gthe\u001b[60Glast\u001b[65Gday\u001b[69Gof\u001b[72Gthe\r\u001b[1B  target\u001b[10Gmonth when needed.\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;5;241mRead \u001b[1m1\u001b[22m file \u001b[39m\u001b[K\r\u001b[2B\u001b[38;5;65m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(\u001b]8;id=1mhpc22;file:///root/a/renewals/app/dates.py\u0007app/dates.py\u001b]8;;\u0007)\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mAdded \u001b[1m6\u001b[22m lines, removed \u001b[1m1\u001b[22m line\u001b[K\r\u001b[1B     \u001b[38;5;236m\u001b[2m  1 \u001b[22m \u001b[38;5;24m\"\"\"Calendar helpers for billing renewals.\"\"\"\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;5;236m\u001b[2m  2 \u001b[22m \u001b[39m\u001b[K\r\u001b[1B     \u001b[38;5;29m\u001b[48;5;194m  3 +\u001b[38;5;125mimport\u001b[38;5;236m calendar                                            \u001b[39m\u001b[49m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  4 \u001b[22m \u001b[38;5;125mfrom\u001b[38;5;236m datetime \u001b[38;5;125mimport\u001b[38;5;236m date\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;236m\u001b[2m  5 \u001b[22m \u001b[12G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;236m\u001b[2m  6 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  7 \u001b[22m \u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97madd_months\u001b[38;5;236m(\u001b[38;5;31md: date, months: int\u001b[38;5;236m) -> date:\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;236m\u001b[2m  8 \u001b[22m     \u001b[38;5;24m\"\"\"Return the date `months` calendar months after `d` (\r\u001b[1B\u001b[39m     \u001b[38;5;236m\u001b[2m    \u001b[22m \u001b[38;5;24mnegative goes back), same day of month.\"\"\"\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  9 \u001b[22m     y, m = \u001b[38;5;31mdivmod\u001b[38;5;236m(d.month - \u001b[38;5;31m1\u001b[38;5;236m + months, \u001b[38;5;31m12\u001b[38;5;236m)\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;160m\u001b[48;5;224m  9 -\u001b[38;5;236m    return d.replace(year=d.year + y, month=m + 1)         \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 10 +\u001b[38;5;236m    new_year = d.year + y                                  \r\u001b[5C\u001b[1B\u001b[38;5;29m 11 +\u001b[38;5;236m    new_month = m + \u001b[38;5;31m1\u001b[38;5;236m                                      \r\u001b[5C\u001b[1B\u001b[38;5;29m 12 +\u001b[38;5;236m    max_day = calendar.monthrange(new_year, new_month)[\u001b[38;5;31m1\u001b[38;5;236m]  \r\u001b[5C\u001b[1B\u001b[38;5;29m 13 +\u001b[38;5;236m    new_day = \u001b[38;5;31mmin\u001b[38;5;236m(d.day, max_day)                          \r\u001b[5C\u001b[1B\u001b[38;5;29m 14 +\u001b[38;5;236m    \u001b[38;5;125mreturn\u001b[38;5;236m date(new_year, new_month, new_day)              \r\u001b[2B\u001b[49m\u001b[38;5;174m✻\u001b[3G\u001b[38;5;216mTra\u001b[9Guting…\u001b[25G\u001b[38;5;241m48\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
