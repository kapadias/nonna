[29.829142, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[38;5;236m\u001b[2m2\u001b[11G\u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  3 +\u001b[38;5;125mimport\u001b[38;5;236m calendar                                            \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m  4 \u001b[22m \u001b[38;5;125mfrom\u001b[38;5;236m datetime \u001b[38;5;125mimport\u001b[38;5;236m date\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m5\u001b[11G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m6\r\u001b[7C\u001b[1B7\u001b[11G\u001b[22m\u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97madd_months\u001b[38;5;236m(\u001b[38;5;31md: date, months: int\u001b[38;5;236m) -> date:\r\u001b[7C\u001b[1B\u001b[2m8\u001b[11G\u001b[22m   \u001b[15G\u001b[38;5;24m\"\"\"Return the date `months` calendar months after `d` (\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m \u001b[11G\u001b[22m\u001b[38;5;24mnegative goes\u001b[25Gback), same day of month.\"\"\"\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m9\u001b[11G\u001b[22m    y, m = \u001b[38;5;31mdivmod\u001b[38;5;236m(d.month - \u001b[38;5;31m1\u001b[38;5;236m + months, \u001b[38;5;31m12\u001b[38;5;236m)\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  9 -\u001b[38;5;236m    return d.replace(year=d.year + y, month=m + 1)         \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 10 +\u001b[38;5;236m    new_year = d.year + y                                  \r\u001b[7C\u001b[1B\u001b[38;5;29m1\u001b[19G\u001b[38;5;236mmonth = m + \u001b[38;5;31m1\u001b[38;5;236m                                      \r\u001b[7C\u001b[1B\u001b[38;5;29m2\u001b[15G\u001b[38;5;236mmax\u001b[19Gday =\u001b[25Gcalendar.monthrange(new_year, new_month)[\u001b[38;5;31m1\u001b[38;5;236m]\r\u001b[7C\u001b[1B\u001b[38;5;29m3\u001b[15G\u001b[38;5;236mnew\u001b[25G\u001b[38;5;31mmin\u001b[38;5;236m(d.day, max_day)                        \r\u001b[7C\u001b[1B\u001b[38;5;29m4\u001b[15G\u001b[38;5;125mreturn\u001b[38;5;236m date(new_year, new_month,\u001b[48Gnew_day)\r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow\u001b[7Glet\u001b[11Gme\u001b[14Gverify\u001b[21Gthe\u001b[25Gfix\u001b[29Gworks\u001b[35Gwith\u001b[40Gthe\u001b[44Gfailing\u001b[52Gcase:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mFixed!\u001b[10GThe\u001b[14G\u001b[38;5;105madd_months\u001b[25G\u001b[39mfunction\u001b[34Gnow\u001b[38Gclamps\u001b[45Gthe\u001b[49Gday\u001b[53Gto\u001b[56Gthe\u001b[60Glast\u001b[65Gday\u001b[69Gof\u001b[72Gthe\r\u001b[1B \u001b[3Gtarget\u001b[10Gmonth. The issue was that it tried\u001b[46Go create invalid dates\u001b[69Glike\u001b[K\r\u001b[2C\u001b[1BFebruary 31st. Now it uses \u001b[38;5;105mcalendar.monthrange()\u001b[39m \u001b[53Go\u001b[55Gget the\u001b[63Gm\u001b[65Gximum day\u001b[75Gin\r\u001b[2C\u001b[1Bthe\u001b[7Gtarget\u001b[14Gmonth\u001b[20Gand\u001b[24Gclamps\u001b[31Gaccordingly.\r\u001b[1B\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[29.926981, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[38;5;236m\u001b[2m5\r\u001b[5C\u001b[1B  6 \u001b[22m \u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m7\u001b[11G\u001b[22m\u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97madd_months\u001b[38;5;236m(\u001b[38;5;31md: date, months: int\u001b[38;5;236m) -> date:\r\u001b[7C\u001b[1B\u001b[2m8\u001b[11G\u001b[22m    \u001b[38;5;24m\"\"\"Return the date `months` calendar months after `d` (\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m \u001b[11G\u001b[22m\u001b[38;5;24mnegative goes back), same day of month.\"\"\"\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m9\u001b[11G\u001b[22m   \u001b[15Gy, m = \u001b[38;5;31mdivmod\u001b[38;5;236m(d.month - \u001b[38;5;31m1\u001b[38;5;236m + months,\u001b[51G\u001b[38;5;31m12\u001b[38;5;236m)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  9 -\u001b[38;5;236m    return d.replace(year=d.year + y, month=m + 1)         \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 10 +\u001b[38;5;236m    new_year = d.year + y                                  \r\u001b[5C\u001b[1B\u001b[38;5;29m 11 +\u001b[38;5;236m    new_month = m + \u001b[38;5;31m1\u001b[38;5;236m                                      \r\u001b[5C\u001b[1B\u001b[38;5;29m 12 +\u001b[38;5;236m    max_day = calendar.monthrange(new_year, new_month)[\u001b[38;5;31m1\u001b[38;5;236m]  \r\u001b[7C\u001b[1B\u001b[38;5;29m3\u001b[19G\u001b[38;5;236mday = \u001b[38;5;31mmin\u001b[38;5;236m(d.day, max_day)                          \r\u001b[7C\u001b[1B\u001b[38;5;29m4\u001b[15G\u001b[38;5;125mreturn\u001b[38;5;236m date(new_year,\u001b[37Gnew_month,\u001b[48Gnew_day)\r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow let me verify the fix works with the failing case:\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mFixed!\u001b[10GThe\u001b[14G\u001b[38;5;105madd_months\u001b[25G\u001b[39mfunction\u001b[34Gnow\u001b[38Gclamps\u001b[45Gthe\u001b[49Gday\u001b[53Gto\u001b[56Gthe\u001b[60Glast\u001b[65Gday\u001b[69Gof\u001b[72Gthe\r\u001b[2C\u001b[1Btarget month. The issue\u001b[27Gwas\u001b[31Gthat\u001b[36Git\u001b[39Gtried\u001b[45Gto\u001b[48Gcreate\u001b[55Ginvalid\u001b[63Gdates\u001b[69Glike\r\u001b[2C\u001b[1BFebruary\u001b[12G31st.\u001b[18GNow\u001b[22Git\u001b[25Guses\u001b[30G\u001b[38;5;105mcalendar.monthrange()\u001b[52G\u001b[39mto\u001b[55Gget\u001b[59Gthe\u001b[63Gmaximum\u001b[71Gday\u001b[75Gin\r\u001b[1B \u001b[3Gthe target\u001b[14Gmonth and clamps accordingly.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BAll test\u001b[12Gca\u001b[15Ges\u001b[18Gpass:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[30.036137, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[38;5;236m\u001b[2m6\r\u001b[7C\u001b[1B7\u001b[11G\u001b[22m\u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97madd_months\u001b[38;5;236m(\u001b[38;5;31md: date, months: int\u001b[38;5;236m) -> date:\r\u001b[7C\u001b[1B\u001b[2m8\u001b[11G\u001b[22m   \u001b[15G\u001b[38;5;24m\"\"\"Return the date `months` calendar months after `d` (\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m \u001b[11G\u001b[22m\u001b[38;5;24mnegative goes\u001b[25Gback), same day of month.\"\"\"\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m9\u001b[11G\u001b[22m    y, m = \u001b[38;5;31mdivmod\u001b[38;5;236m(d.month - \u001b[38;5;31m1\u001b[38;5;236m + months, \u001b[38;5;31m12\u001b[38;5;236m)\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  9 -\u001b[38;5;236m    return d.replace(year=d.year + y, month=m + 1)         \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 10 +\u001b[38;5;236m    new_year = d.year + y                                  \r\u001b[7C\u001b[1B\u001b[38;5;29m1\u001b[19G\u001b[38;5;236mmonth = m + \u001b[38;5;31m1\u001b[38;5;236m                                      \r\u001b[7C\u001b[1B\u001b[38;5;29m2\u001b[15G\u001b[38;5;236mmax\u001b[19Gday =\u001b[25Gcalendar.monthrange(new_year, new_month)[\u001b[38;5;31m1\u001b[38;5;236m]\r\u001b[7C\u001b[1B\u001b[38;5;29m3\u001b[15G\u001b[38;5;236mnew\u001b[25G\u001b[38;5;31mmin\u001b[38;5;236m(d.day, max_day)                        \r\u001b[7C\u001b[1B\u001b[38;5;29m4\u001b[15G\u001b[38;5;125mreturn\u001b[38;5;236m date(new_year, new_month,\u001b[48Gnew_day)\r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow\u001b[7Glet\u001b[11Gme\u001b[14Gverify\u001b[21Gthe\u001b[25Gfix\u001b[29Gworks\u001b[35Gwith\u001b[40Gthe\u001b[44Gfailing\u001b[52Gcase:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mFixed!\u001b[10GThe\u001b[14G\u001b[38;5;105madd_months\u001b[25G\u001b[39mfunction\u001b[34Gnow\u001b[38Gclamps\u001b[45Gthe\u001b[49Gday\u001b[53Gto\u001b[56Gthe\u001b[60Glast\u001b[65Gday\u001b[69Gof\u001b[72Gthe\r\u001b[1B \u001b[3Gtarget\u001b[10Gmonth. The issue was that it tried\u001b[46Go create invalid dates\u001b[69Glike\u001b[K\r\u001b[2C\u001b[1BFebruary 31st. Now it uses \u001b[38;5;105mcalendar.monthrange()\u001b[39m \u001b[53Go\u001b[55Gget the\u001b[63Gm\u001b[65Gximum day\u001b[75Gin\r\u001b[2C\u001b[1Bthe t\u001b[10Gget month and clamps accordingly.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BAll\u001b[7Gtest\u001b[12Gcases\u001b[18Gpass:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;5;105madd_months(date(2024, 1, 31), 1)\u001b[38G\u001b[39m→\u001b[40G\u001b[38;5;105m2024-02-29\u001b[51G\u001b[39m✓\u001b[30;1H\u001b[28;3H\u001b[?25h"]
