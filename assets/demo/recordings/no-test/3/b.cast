[29.752316, "o", "\u001b[?25l\u001b[H     \u001b[38;5;236m\u001b[2m  2 \u001b[22m \u001b[12G\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  3 +\u001b[38;5;125mfrom\u001b[38;5;236m calendar \u001b[38;5;125mimport\u001b[38;5;236m monthrange                            \r\u001b[7C\u001b[1B\u001b[49m\u001b[2m4\u001b[11G\u001b[22m\u001b[38;5;125mfrom\u001b[38;5;236m datetime \u001b[38;5;125mimport\u001b[38;5;236m date\r\u001b[5C\u001b[1B\u001b[2m  5 \u001b[22m \u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m6\u001b[11G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m7\u001b[11G\u001b[22m\u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97madd_months\u001b[38;5;236m(\u001b[38;5;31md: date, months: int\u001b[38;5;236m) -> date:\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  7 -\u001b[38;5;236m    \"\"\"Return the date `months` calendar months after `d` (\r\u001b[5C\u001b[1B\u001b[38;5;160m    -\u001b[38;5;236mnegative goes back), same day of month.\"\"\"                 \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  8 +\u001b[38;5;236m    \u001b[38;5;24m\"\"\"Return the date `months` calendar months after `d` (\r\u001b[5C\u001b[1B\u001b[38;5;29m    +\u001b[38;5;24mnegative goes back), same day of month.\u001b[38;5;236m                    \r\u001b[7C\u001b[1B\u001b[38;5;29m9\u001b[15G\u001b[38;5;236m                                                       \r\u001b[6C\u001b[1B\u001b[38;5;29m10\u001b[11G\u001b[38;5;236m    Clamps the day to the last valid day of the target mont\r\u001b[7C\u001b[1B\u001b[38;5;29m \u001b[11G\u001b[38;5;236mh\u001b[13G\u001b[38;5;125mif\u001b[38;5;236m necessary.                                            \r\u001b[7C\u001b[1B\u001b[38;5;29m1\u001b[15G\u001b[38;5;24m\"\"\"\u001b[38;5;236m                                                    \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 12 \u001b[22m     y, m = \u001b[38;5;31mdivmod\u001b[38;5;236m(d.month - \u001b[38;5;31m1\u001b[38;5;236m + months, \u001b[38;5;31m12\u001b[38;5;236m)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  9 -\u001b[38;5;236m    return d.replace(year=d.year + y, month=m + 1)         \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 13 +\u001b[38;5;236m    new_year = d.year + y                                  \r\u001b[5C\u001b[1B\u001b[38;5;29m 14 +\u001b[38;5;236m    new_month = m + \u001b[38;5;31m1\u001b[38;5;236m                                      \r\u001b[7C\u001b[1B\u001b[38;5;29m5\u001b[19G\u001b[38;5;236mday = \u001b[38;5;31mmin\u001b[38;5;236m(d.day, monthrange(new_year, new_month)[\u001b[38;5;31m1\u001b[38;5;236m]\r\u001b[6C\u001b[1B\u001b[38;5;29m  \u001b[11G\u001b[38;5;236m)\u001b[15G         \u001b[25G \u001b[27G \u001b[29G \u001b[31G                                       \r\u001b[7C\u001b[1B\u001b[38;5;29m6\u001b[15G\u001b[38;5;125mreturn\u001b[38;5;236m date(new_year, new_mo\u001b[44Gth, new_d\u001b[54Gy)\u001b[57G             \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[6G\u001b[39m\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
