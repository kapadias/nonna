01b[38;5;236m    new_year = d.year + y                                  \r\u001b[5C\u001b[1B\u001b[38;5;29m 14 +\u001b[38;5;236m    new_month = m + \u001b[38;5;31m1\u001b[38;5;236m                                      \r\u001b[7C\u001b[1B\u001b[38;5;29m5\u001b[19G\u001b[38;5;236mday = \u001b[38;5;31mmin\u001b[38;5;236m(d.day, monthrange(new_year, new_month)[\u001b[38;5;31m1\u001b[38;5;236m]\r\u001b[6C\u001b[1B\u001b[38;5;29m  \u001b[11G\u001b[38;5;236m)\u001b[15G         \u001b[25G \u001b[27G \u001b[29G \u001b[31G                                       \r\u001b[7C\u001b[1B\u001b[38;5;29m6\u001b[15G\u001b[38;5;125mreturn\u001b[38;5;236m date(new_year, new_mo\u001b[44Gth, new_d\u001b[54Gy)\u001b[57G             \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow let me run the tests to verify the fix works:\u001b[K\r\u001b[2B\u001b[38;5;241m●\u001b[3G\u001b[39mRunning\u001b[11G\u001b[1m1\u001b[13G\u001b[22mshell\u001b[19Gcommand…\u001b[30;1H\u001b[28;3H\u001b[?25h"]
