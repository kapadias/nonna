[34.897386, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[38;5;29m\u001b[48;5;194m9\u001b[11G\u001b[38;5;236m                                                           \r\u001b[6C\u001b[1B\u001b[38;5;29m10\u001b[15G\u001b[38;5;236mClamps\u001b[22Gthe\u001b[26Gday\u001b[30Gto\u001b[33Gthe\u001b[37Glast\u001b[42Gvalid\u001b[48Gday\u001b[52Gof\u001b[55Gthe\u001b[59Gtarget\u001b[66Gmont\r\u001b[6C\u001b[1B\u001b[38;5;29m  \u001b[11G\u001b[38;5;236mh\u001b[13G\u001b[38;5;125mif\u001b[38;5;236m necessary.                                            \r\u001b[6C\u001b[1B\u001b[38;5;29m11\u001b[11G\u001b[38;5;236m \u001b[13G  \u001b[38;5;24m\"\"\"\u001b[38;5;236m        \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 12 \u001b[22m     y, m = \u001b[38;5;31mdivmod\u001b[38;5;236m(d.month - \u001b[38;5;31m1\u001b[38;5;236m + months, \u001b[38;5;31m12\u001b[38;5;236m)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  9 -\u001b[38;5;236m    return d.replace(year=d.year + y, month=m + 1)         \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 13 +\u001b[38;5;236m    new_year = d.year + y                                  \r\u001b[7C\u001b[1B\u001b[38;5;29m4\u001b[19G\u001b[38;5;236mmonth = m + \u001b[38;5;31m1\u001b[38;5;236m                                      \r\u001b[7C\u001b[1B\u001b[38;5;29m5\u001b[19G\u001b[38;5;236mday =\u001b[25G\u001b[38;5;31mmin\u001b[38;5;236m(d.day,\u001b[36Gmonthrange(new_year,\u001b[57Gnew_month)[\u001b[38;5;31m1\u001b[38;5;236m]\r\u001b[6C\u001b[1B\u001b[38;5;29m  \u001b[11G\u001b[38;5;236m)\u001b[15G       \u001b[23G \u001b[25G                                             \r\u001b[6C\u001b[1B\u001b[38;5;29m16\u001b[11G\u001b[38;5;236m \u001b[15G\u001b[38;5;125mreturn\u001b[38;5;236m date(new_year, new_month, new_day)              \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow\u001b[7Glet\u001b[11Gme\u001b[14Grun\u001b[18Gthe\u001b[22Gtests\u001b[28Gto\u001b[31Gverify\u001b[38Gthe\u001b[4