[28.552464, "o", "\u001b[?25l\u001b[H\u001b[38;5;241m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m9\u001b[22m lines, removed\u001b[29G\u001b[1m2\u001b[31G\u001b[22mlines\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  1 \u001b[22m \u001b[38;5;24m\"\"\"Calendar helpers for billing renewals.\"\"\"\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;5;236m\u001b[2m  2 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  3 +\u001b[38;5;125mfrom\u001b[38;5;236m calendar \u001b[38;5;125mimport\u001b[38;5;236m monthrange                            \r\u001b[1B\u001b[39m\u001b[49m     \u001b[38;5;236m\u001b[2m  4 \u001b[22m \u001b[38;5;125mfrom\u001b[38;5;236m datetime \u001b[38;5;125mimport\u001b[38;5;236m date\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;5;236m\u001b[2m  5 \u001b[22m \u001b[39m\u001b[K\r\u001b[1B     \u001b[38;5;236m\u001b[2m  6 \u001b[22m \u001b[39m\u001b[K\r\u001b[1B     \u001b[38;5;236m\u001b[2m  7 \u001b[22m \u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97madd_months\u001b[38;5;236m(\u001b[38;5;31md: date, months: int\u001b[38;5;236m) -> date:\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  7 -\u001b[38;5;236m    \"\"\"Return the date `months` calendar months after `d` (\r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;5;160m\u001b[48;5;224m    -\u001b[38;5;236mnegative goes back), same day of month.\"\"\"                 \u001b[71G\u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;29m\u001b[48;5;194m  8 +\u001b[38;5;236m    \u001b[38;5;24m\"\"\"Return the date `months` calendar months after `d` (\r\u001b[5C\u001b[1B\u001b[38;5;29m    +\u001b[38;5;24mnegative goes back), same day of month.\u001b[38;5;236m                    \r\u001b[2C\u001b[1B\u001b[39m\u001b[49m   \u001b[38;5;29m\u001b[48;5;194m  9 +\u001b[38;5;236m                                                           \r\u001b[5C\u001b[1B\u001b[38;5;29m 10 +\u001b[38;5;236m    Clamps the day to the last valid day of the target mont\r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;5;29m\u001b[48;5;194m    +\u001b[38;5;236mh \u001b[38;5;125mif\u001b[38;5;236m necessary.                                            \r\u001b[5C\u001b[1B\u001b[38;5;29m 11 +\u001b[38;5;236m    \u001b[38;5;24m\"\"\"\u001b[38;5;236m                                                    \r\u001b[2C\u001b[1B\u001b[39m\u001b[49m   \u001b[38;5;236m\u001b[2m 12 \u001b[22m     y, m = \u001b[38;5;31mdivmod\u001b[38;5;236m(d.month - \u001b[38;5;31m1\u001b[38;5;236m + months, \u001b[38;5;31m12\u001b[38;5;236m)\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  9 -\u001b[38;5;236m    return d.replace(year=d.year + y, month=m + 1)         \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;5;29m\u001b[48;5;194m 13 +\u001b[38;5;236m    new_year = d.year + y                                  \u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;29m\u001b[48;5;194m 14 +\u001b[38;5;236m    new_month = m + \u001b[38;5;31m1\u001b[38;5;236m                                      \r\u001b[5C\u001b[1B\u001b[38;5;29m 15 +\u001b[38;5;236m    new_day = \u001b[38;5;31mmin\u001b[38;5;236m(d.day, monthrange(new_year, new_month)[\u001b[38;5;31m1\u001b[38;5;236m]\r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[38;5;29m\u001b[48;5;194m    +\u001b[38;5;236m)                                                          \r\u001b[5C\u001b[1B\u001b[38;5;29m 16 +\u001b[38;5;236m    \u001b[38;5;125mreturn\u001b[38;5;236m date(new_year, new_month, new_day)              \r\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[1B\u001b[38;5;174m✢\u001b[39m \u001b[38;5;216mFiddle-faddling…\u001b[38;5;174m \u001b[38;5;241m(14s · ↓\u001b[29G1.7k tokens · thought for 1s)\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
