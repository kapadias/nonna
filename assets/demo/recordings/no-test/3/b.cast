[41.553448, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mAd\u001b[9Ged \u001b[1m10\u001b[22m lines\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;236m\u001b[2m  9 \u001b[22m \u001b[12G\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 10 \u001b[22m \u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97mtest_rolls_over_the_year\u001b[38;5;236m():\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;236m\u001b[2m 11 \u001b[22m     \u001b[38;5;125massert\u001b[38;5;236m add_months(date(\u001b[38;5;31m2024\u001b[38;5;236m, \u001b[38;5;31m11\u001b[38;5;236m, \u001b[38;5;31m15\u001b[38;5;236m), \u001b[38;5;31m3\u001b[38;5;236m) == date(\u001b[38;5;31m2025\u001b[38;5;236m, \r\u001b[1B\u001b[39m     \u001b[38;5;236m\u001b[2m    \u001b[22m \u001b[38;5;31m2\u001b[38;5;236m, \u001b[38;5;31m15\u001b[38;5;236m)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 12 +\u001b[38;5;236m                                                           \r\u001b[5C\u001b[1B\u001b[38;5;29m 13 +\u001b[38;5;236m                                                           \r\u001b[5C\u001b[1B\u001b[38;5;29m 14 +\u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97mtest_clamps_day_to_last_day_of_month\u001b[38;5;236m():                \r\u001b[5C\u001b[1B\u001b[38;5;29m 15 +\u001b[38;5;236m    \u001b[38;5;24m\"\"\"When target month has fewer days, clamp to the last \r\u001b[6C\u001b[1B\u001b[38;5;29m  \u001b[11G\u001b[38;5;24mday.\"\"\"\u001b[38;5;236m                                                    \r\u001b[7C\u001b[1B\u001b[38;5;29m6\u001b[15G\u001b[38;5;125massert\u001b[38;5;236m add_months(date(\u001b[38;5;31m2024\u001b[38;5;236m, \u001b[38;5;31m1\u001b[38;5;236m, \u001b[38;5;31m31\u001b[38;5;236m), \u001b[38;5;31m1\u001b[38;5;236m) == date(\u001b[38;5;31m2024\u001b[38;5;236m, \u001b[38;5;31m2\r\u001b[6C\u001b[1B\u001b[38;5;29m  \u001b[11G\u001b[38;5;236m, \u001b[38;5;31m29\u001b[38;5;236m)                                      \r\u001b[7C\u001b[1B\u001b[38;5;29m7\u001b[15G\u001b[38;5;236m                                                       \r\u001b[6C\u001b[1B\u001b[38;5;29m18\u001b[11G\u001b[38;5;236m                                                           \r\u001b[7C\u001b[1B\u001b[38;5;29m9\u001b[11G\u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97mtest_clamps_day_to_last_day_of_month_non_leap_year\u001b[38;5;236m():\u001b[69G \r\u001b[6C\u001b[1B\u001b[38;5;29m20\u001b[11G\u001b[38;5;236m \u001b[13G  \u001b[38;5;24m\"\"\"Clamp to Feb 28 in non-leap years.\"\"\"\r\u001b[6C\u001b[1B\u001b[38;5;29m21\u001b[15G\u001b[38;5;125massert\u001b[38;5;236m add_months(date(\u001b[38;5;31m2023\u001b[38;5;236m, \u001b[38;5;31m1\u001b[38;5;236m, \u001b[38;5;31m31\u001b[38;5;236m), \u001b[38;5;31m1\u001b[38;5;236m) == date(\u001b[38;5;31m2023\u001b[38;5;236m, \u001b[38;5;31m2\r\u001b[6C\u001b[1B\u001b[38;5;29m  \u001b[11G\u001b[38;5;236m,\u001b[13G\u001b[38;5;31m28\u001b[38;5;236m)                                                      \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow let me verify the tests pass with the fix:\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;241m \u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command…\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
