[24.005609, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;65m●\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(\u001b]8;id=1mhpc22;file:///root/a/renewals/app/dates.py\u0007app/dates.py\u001b]8;;\u0007)\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mAdded \u001b[1m7\u001b[22m lines, removed \u001b[1m3\u001b[22m lines\u001b[K\r\u001b[1B     \u001b[38;5;236m\u001b[2m  1 \u001b[22m \u001b[38;5;24m\"\"\"Calendar helpers for billing renewals.\"\"\"\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;5;236m\u001b[2m  2 \u001b[22m \u001b[39m\u001b[K\r\u001b[1B     \u001b[38;5;29m\u001b[48;5;194m  3 +\u001b[38;5;125mfrom\u001b[38;5;236m calendar \u001b[38;5;125mimport\u001b[38;5;236m monthrange                            \u001b[39m\u001b[49m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  4 \u001b[22m \u001b[38;5;125mfrom\u001b[38;5;236m datetime \u001b[38;5;125mimport\u001b[38;5;236m date\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;236m\u001b[2m  5 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  6 \u001b[22m \r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;5;236m\u001b[2m  7 \u001b[22m \u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97madd_months\u001b[38;5;236m(\u001b[38;5;31md: date, months: int\u001b[38;5;236m) -> date:\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  7 -\u001b[38;5;236m    \"\"\"Return the date `months` calendar months after `d` (\r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;5;160m\u001b[48;5;224m    -\u001b[38;5;236mnegative goes back), same day of month.\"\"\"                 \u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;160m\u001b[48;5;224m  8 -\u001b[38;5;236m    y, m = divmod(d.month - 1 + months, 12)                \u001b[71G\u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;160m\u001b[48;5;224m  9 -\u001b[38;5;236m    return d.replace(year=d.year + y, month=m + 1)         \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  8 +\u001b[38;5;236m\u001b[48;5;157m  \u001b[38;5;24m\u001b[48;5;194m\"\"\"Return the date `months` calendar months after `d` (ne\r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;5;29m\u001b[48;5;194m    +\u001b[38;5;24mgative goes back), same day of month.\"\"\"\u001b[38;5;236m                   \r\u001b[1B\u001b[39m\u001b[49m     \u001b[38;5;29m\u001b[48;5;194m  9 +\u001b[38;5;236m\u001b[48;5;157m  \u001b[48;5;194my, m = \u001b[38;5;31mdivmod\u001b[38;5;236m(d.month - \u001b[38;5;31m1\u001b[38;5;236m + months, \u001b[38;5;31m12\u001b[38;5;236m)                  \r\u001b[5C\u001b[1B\u001b[38;5;29m 10 +\u001b[38;5;236m  target_year, target_month = d.year + y, m + \u001b[38;5;31m1\u001b[38;5;236m            \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[38;5;29m\u001b[48;5;194m 11 +\u001b[38;5;236m  max_day = monthrange(target_year, target_month)[\u001b[38;5;31m1\u001b[38;5;236m]       \r\u001b[1B\u001b"]
[24.006244, "o", "[39m\u001b[49m     \u001b[38;5;29m\u001b[48;5;194m 12 +\u001b[38;5;236m  day = \u001b[38;5;31mmin\u001b[38;5;236m(d.day, max_day)                                \r\u001b[5C\u001b[1B\u001b[38;5;29m 13 +\u001b[38;5;236m  \u001b[38;5;125mreturn\u001b[38;5;236m d.replace(year=target_year, month=target_month, da\r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[38;5;29m\u001b[48;5;194m    +\u001b[38;5;236my=day)                                                     \r\u001b[32C\u001b[2B\u001b[49m\u001b[38;5;241m · \u001b[38;5;248mthinking\u001b[38;5;241m)\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
