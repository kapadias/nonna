[25.03885, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m7\u001b[14G\u001b[22mlines,\u001b[21Gremoved\u001b[29G\u001b[1m3\u001b[31G\u001b[22mlines\r\u001b[1B \u001b[3G   \u001b[38;5;236m\u001b[2m  1 \u001b[22m \u001b[38;5;24m\"\"\"Calendar helpers for billing renewals.\"\"\"\r\u001b[1B\u001b[39m     \u001b[38;5;236m\u001b[2m  2 \u001b[22m \u001b[12G\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  3 +\u001b[38;5;125mfrom\u001b[38;5;236m calendar \u001b[38;5;125mimport\u001b[38;5;236m monthrange                            \r\u001b[7C\u001b[1B\u001b[49m\u001b[2m4\u001b[11G\u001b[22m\u001b[38;5;125mfrom\u001b[38;5;236m datetime \u001b[38;5;125mimport\u001b[38;5;236m date\r\u001b[5C\u001b[1B\u001b[2m  5 \u001b[22m \u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m6\u001b[11G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m7\u001b[11G\u001b[22m\u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97madd_months\u001b[38;5;236m(\u001b[38;5;31md: date, months: int\u001b[38;5;236m) -> date:\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  7 -\u001b[38;5;236m    \"\"\"Return the date `months` calendar months after `d` (\r\u001b[5C\u001b[1B\u001b[38;5;160m    -\u001b[38;5;236mnegative goes back), same day of month.\"\"\"                 \r\u001b[7C\u001b[1B\u001b[38;5;160m8\u001b[15G\u001b[38;5;236my, m = divmod(\u001b[30G.month - 1 +\u001b[43Gmonths, 12)    \u001b[59G     \u001b[65G   \u001b[69G \r\u001b[7C\u001b[1B\u001b[38;5;160m9\u001b[11G\u001b[38;5;236m    return d.replace(year=\u001b[38G.\u001b[40Gear\u001b[44G+ y, month=m\u001b[57G+\u001b[59G1)\r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  8 +\u001b[38;5;236m\u001b[48;5;157m  \u001b[38;5;24m\u001b[48;5;194m\"\"\"Return the date `months` calendar months after `d` (ne\r\u001b[5C\u001b[1B\u001b[38;5;29m    +\u001b[38;5;24mgative goes back), same day of month.\"\"\"\u001b[38;5;236m                   \r\u001b[7C\u001b[1B\u001b[38;5;29m9\u001b[13G\u001b[38;5;236my, m = \u001b[38;5;31mdivmod\u001b[38;5;236m(d.month - \u001b[38;5;31m1\u001b[38;5;236m + months, \u001b[38;5;31m12\u001b[38;5;236m)                  \r\u001b[6C\u001b[1B\u001b[38;5;29m10\u001b[11G\u001b[38;5;236m  target_year, target_month = d.year + y, m + \u001b[38;5;31m1\r\u001b[6C\u001b[1B\u001b[38;5;29m11\u001b[11G\u001b[38;5;236m  max_day = monthrange(target_year, target_month)[\u001b[38;5;31m1\u001b[38;5;236m]\r\u001b[7C\u001b[1B\u001b[38;5;29m2\u001b[13G\u001b[38;5;236md\u001b[15Gy = \u001b[38;5;31mmin\u001b[38;5;236m(d.day, max_day)                    \r\u001b[7C\u001b[1B\u001b[38;5;29m3\u001b[13G\u001b[38;5;125mreturn\u001b[38;5;236m d.replace(year=target_year, month=target_month,\u001b[68Gda\r\u001b[6C\u001b[1B\u001b[38;5;29m  \u001b[11G\u001b[38;5;236my=\u001b[16G) \u001b[19G                                                   \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[6G\u001b[39m\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
