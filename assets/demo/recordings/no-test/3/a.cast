[28.431076, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[38;5;236m\u001b[2m7\u001b[11G\u001b[22m\u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97madd_months\u001b[38;5;236m(\u001b[38;5;31md: date, months: int\u001b[38;5;236m) -> date:\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  7 -\u001b[38;5;236m    \"\"\"Return the date `months` calendar months after `d` (\r\u001b[5C\u001b[1B\u001b[38;5;160m    -\u001b[38;5;236mnegative goes back), same day of month.\"\"\"                 \r\u001b[7C\u001b[1B\u001b[38;5;160m8\u001b[15G\u001b[38;5;236my, m = divmod(\u001b[30G.month - 1 +\u001b[43Gmonths, 12)    \u001b[59G     \u001b[65G   \u001b[69G \r\u001b[7C\u001b[1B\u001b[38;5;160m9\u001b[11G\u001b[38;5;236m    return d.replace(year=\u001b[38G.\u001b[40Gear\u001b[44G+ y, month=m\u001b[57G+\u001b[59G1)\r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  8 +\u001b[38;5;236m\u001b[48;5;157m  \u001b[38;5;24m\u001b[48;5;194m\"\"\"Return the date `months` calendar months after `d` (ne\r\u001b[5C\u001b[1B\u001b[38;5;29m    +\u001b[38;5;24mgative goes back), same day of month.\"\"\"\u001b[38;5;236m                   \r\u001b[7C\u001b[1B\u001b[38;5;29m9\u001b[13G\u001b[38;5;236my, m = \u001b[38;5;31mdivmod\u001b[38;5;236m(d.month - \u001b[38;5;31m1\u001b[38;5;236m + months, \u001b[38;5;31m12\u001b[38;5;236m)                  \r\u001b[6C\u001b[1B\u001b[38;5;29m10\u001b[11G\u001b[38;5;236m  target_year, target_month = d.year + y, m + \u001b[38;5;31m1\r\u001b[6C\u001b[1B\u001b[38;5;29m11\u001b[11G\u001b[38;5;236m  max_day = monthrange(target_year, target_month)[\u001b[38;5;31m1\u001b[38;5;236m]\r\u001b[7C\u001b[1B\u001b[38;5;29m2\u001b[13G\u001b[38;5;236md\u001b[15Gy = \u001b[38;5;31mmin\u001b[38;5;236m(d.day, max_day)                    \r\u001b[7C\u001b[1B\u001b[38;5;29m3\u001b[13G\u001b[38;5;125mreturn\u001b[38;5;236m d.replace(year=target_year, month=target_month,\u001b[68Gda\r\u001b[6C\u001b[1B\u001b[38;5;29m  \u001b[11G\u001b[38;5;236my=\u001b[16G) \u001b[19G                                                   \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow let me verify the fix works with the example from your bug report:\r\u001b[2B \u001b[3G\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;5;16m●\u001b[3G\u001b[39mPerfect! The fix works.\u001b[27GThe\u001b[31Gfunction\u001b[40Gnow\u001b[44Gcorrectly\u001b[54Gclamps\u001b[61Gthe\u001b[65Gday\u001b[69Gto\u001b[72Gthe\r\u001b[2C\u001b[1Blast\u001b[8Gvalid\u001b[14Gday\u001b[18Gof\u001b[21Gthe\u001b[25Gtarget\u001b[32Gmonth.\u001b[39GWhen\u001b[44Gadding\u001b[51G1\u001b[53Gmonth\u001b[59Gto\u001b[62GJanuary\u001b[70G31,\r\u001b[1B \u001b[3G2024, it\u001b[12Greturns\u001b[20GFebruary 29, 2024 (the last day of February in a\u001b[69Gleap\u001b[K\r\u001b[2C\u001b[1Byear) instead of crashing.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe solution uses \u001b[38;5;105mcalendar.monthrange()\u001b[43G\u001b[39mto\u001b[46Gdetermine\u001b[56Ghow\u001b[60Gmany\u001b[65Gdays\u001b[70Gexist\r\u001b[2C\u001b[1Bin\u001b[6Gthe\u001b[10Gtarget\u001b[17Gmonth,\u001b[24Gthen\u001b[29Gtakes\u001b[35Gthe\u001b[39Gminimum\u001b[47Gof\u001b[50Gthe\u001b[54Goriginal\u001b[63Gday\u001b[67Gand\u001b[71Gthe\u001b[30;1H\u001b[28;3H\u001b[?25h"]
