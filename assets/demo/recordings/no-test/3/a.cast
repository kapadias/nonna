[27.952801, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;5;29m\u001b[48;5;194m  3 +\u001b[38;5;125mfrom\u001b[38;5;236m calendar \u001b[38;5;125mimport\u001b[38;5;236m monthrange                            \r\u001b[7C\u001b[1B\u001b[49m\u001b[2m4\u001b[11G\u001b[22m\u001b[38;5;125mfrom\u001b[38;5;236m datetime \u001b[38;5;125mimport\u001b[38;5;236m date\r\u001b[7C\u001b[1B\u001b[2m5\r\u001b[7C\u001b[1B6\u001b[11G\u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  7 \u001b[22m \u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97madd_months\u001b[38;5;236m(\u001b[38;5;31md: date, months: int\u001b[38;5;236m) -> date:\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m7\u001b[11G\u001b[38;5;236m    \"\"\"Return\u001b[25Gthe date `months` calendar months\u001b[59Gafter\u001b[65G`d`\u001b[69G(\r\u001b[7C\u001b[1B\u001b[38;5;160m \u001b[11G\u001b[38;5;236mnegative\u001b[20Ggoes back), same\u001b[37Gday\u001b[41Gof month.\"\"\" \r\u001b[7C\u001b[1B\u001b[38;5;160m8\u001b[15G\u001b[38;5;236my, m =\u001b[23Givmod(d.month - 1 + months, 12)  \u001b[57G \u001b[59G  \r\u001b[5C\u001b[1B\u001b[38;5;160m  9 -\u001b[38;5;236m    return d.replace(year=d.year + y, month=m + 1)         \r\u001b[7C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m8\u001b[11G\u001b[38;5;236m\u001b[48;5;157m  \u001b[38;5;24m\u001b[48;5;194m\"\"\"Return\u001b[23Gthe date `months` calendar months after `d` (ne\r\u001b[7C\u001b[1B\u001b[38;5;29m \u001b[11G\u001b[38;5;24mgative goes back), same day of month.\"\"\"\u001b[38;5;236m \r\u001b[6C\u001b[1B\u001b[38;5;29m 9\u001b[11G\u001b[38;5;236m\u001b[48;5;157m  \u001b[48;5;194my, m = \u001b[38;5;31mdivmod\u001b[38;5;236m(d.month - \u001b[38;5;31m1\u001b[38;5;236m + months, \u001b[38;5;31m12\u001b[38;5;236m)      \r\u001b[7C\u001b[1B\u001b[38;5;29m0\u001b[13G\u001b[38;5;236mt\u001b[15Grget_year, \u001b[27Ga\u001b[29Gget_month = d.year + y, m + \u001b[38;5;31m1\u001b[38;5;236m     \r\u001b[7C\u001b[1B\u001b[38;5;29m1\u001b[13G\u001b[38;5;236mm\u001b[15Gx_day = monthrange(target_year, target_month)[\u001b[38;5;31m1\u001b[38;5;236m]\r\u001b[7C\u001b[1B\u001b[38;5;29m2\u001b[13G\u001b[38;5;236mday = \u001b[38;5;31mmin\u001b[38;5;236m(d.d\u001b[27Gy, max_day)         \u001b[48G                   \u001b[68G  \r\u001b[6C\u001b[1B\u001b[38;5;29m13\u001b[11G\u001b[38;5;236m  \u001b[38;5;125mreturn\u001b[38;5;236m d.replace(year=target_year, month=target_month, da\r\u001b[5C\u001b[1B\u001b[38;5;29m    +\u001b[38;5;236my=day)                                                     \r\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow\u001b[7Glet\u001b[11Gme\u001b[14Gverify\u001b[21Gthe\u001b[25Gfix\u001b[29Gworks\u001b[35Gwith\u001b[40Gthe\u001b[44Gexample\u001b[52Gfrom\u001b[57Gyour\u001b[62Gbug\u001b[66Greport:\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mPerfect! The fix works. The function now correctly clamps\u001b[61Gthe\u001b[65Gday\u001b[69Gto\u001b[72Gthe\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[28.07165, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;5;236m\u001b[2m  4 \u001b[22m \u001b[38;5;125mfrom\u001b[38;5;236m datetime \u001b[38;5;125mimport\u001b[38;5;236m date\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m5\u001b[11G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m6\r\u001b[7C\u001b[1B7\u001b[11G\u001b[22m\u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97madd_months\u001b[38;5;236m(\u001b[38;5;31md: date, months: int\u001b[38;5;236m) -> date:\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  7 -\u001b[38;5;236m    \"\"\"Return the date `months` calendar months after `d` (\r\u001b[7C\u001b[1B\u001b[38;5;160m \u001b[11G\u001b[38;5;236mnegative goes\u001b[25Gback), same day of month.\"\"\"     \u001b[59G     \u001b[65G   \u001b[69G \r\u001b[7C\u001b[1B\u001b[38;5;160m8\u001b[11G\u001b[38;5;236m    y, m\u001b[20G= divmod(d.month\u001b[37G- 1\u001b[41G+ months, 12)\r\u001b[7C\u001b[1B\u001b[38;5;160m9\u001b[15G\u001b[38;5;236mreturn\u001b[23G.replace(year=d.year + y, month=m\u001b[57G+\u001b[59G1)\r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  8 +\u001b[38;5;236m\u001b[48;5;157m  \u001b[38;5;24m\u001b[48;5;194m\"\"\"Return the date `months` calendar months after `d` (ne\r\u001b[7C\u001b[1B\u001b[38;5;29m \u001b[11G\u001b[38;5;24mgative goes\u001b[23Gback), same day of month.\"\"\"\u001b[38;5;236m                   \r\u001b[7C\u001b[1B\u001b[38;5;29m9\u001b[11G\u001b[38;5;236m\u001b[48;5;157m  \u001b[48;5;194my, m = \u001b[38;5;31mdivmod\u001b[38;5;236m(d.month - \u001b[38;5;31m1\u001b[38;5;236m + months, \u001b[38;5;31m12\u001b[38;5;236m)\r\u001b[6C\u001b[1B\u001b[38;5;29m10\u001b[11G\u001b[38;5;236m  target_year, target_month = d.year + y, m + \u001b[38;5;31m1\r\u001b[7C\u001b[1B\u001b[38;5;29m1\u001b[13G\u001b[38;5;236mm\u001b[15Gx_day = mon\u001b[27Gh\u001b[29Gange(target_year, target_month)[\u001b[38;5;31m1\u001b[38;5;236m]\r\u001b[7C\u001b[1B\u001b[38;5;29m2\u001b[13G\u001b[38;5;236md\u001b[15Gy = \u001b[38;5;31mmin\u001b[38;5;236m(d.day, max_day)                         \r\u001b[7C\u001b[1B\u001b[38;5;29m3\u001b[13G\u001b[38;5;125mreturn\u001b[38;5;236m d.repl\u001b[27Gce(year=target_year,\u001b[48Gmonth=target_month,\u001b[68Gda\r\u001b[6C\u001b[1B\u001b[38;5;29m  \u001b[11G\u001b[38;5;236my=day)                                                     \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow\u001b[7Glet\u001b[11Gme\u001b[14Gverify\u001b[21Gthe\u001b[25Gfix\u001b[29Gworks\u001b[35Gwith\u001b[40Gthe\u001b[44Gexample\u001b[52Gfrom\u001b[57Gyour\u001b[62Gbug\u001b[66Greport:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mPerfect!\u001b[12GThe\u001b[16Gfix\u001b[20Gworks.\u001b[27GThe\u001b[31Gfunction\u001b[40Gnow\u001b[44Gcorrectly\u001b[54Gclamps\u001b[61Gthe\u001b[65Gday\u001b[69Gto\u001b[72Gthe\r\u001b[1B \u001b[3Glast valid day of the targ\u001b[30Gt mon\u001b[36Gh. When\u001b[44Gadding 1 month to Janu\u001b[67Gry 31,\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
