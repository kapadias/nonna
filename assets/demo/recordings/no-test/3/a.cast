;236m)                  \r\u001b[6C\u001b[1B\u001b[38;5;29m10\u001b[11G\u001b[38;5;236m  target_year, target_month = d.year + y, m + \u001b[38;5;31m1\r\u001b[6C\u001b[1B\u001b[38;5;29m11\u001b[11G\u001b[38;5;236m  max_day = monthrange(target_year, target_month)[\u001b[38;5;31m1\u001b[38;5;236m]\r\u001b[7C\u001b[1B\u001b[38;5;29m2\u001b[13G\u001b[38;5;236md\u001b[15Gy = \u001b[38;5;31mmin\u001b[38;5;236m(d.day, max_day)                    \r\u001b[7C\u001b[1B\u001b[38;5;29m3\u001b[13G\u001b[38;5;125mreturn\u001b[38;5;236m d.replace(year=target_year, month=target_month,\u001b[68Gda\r\u001b[6C\u001b[1B\u001b[38;5;29m  \u001b[11G\u001b[38;5;236my=\u001b[16G) \u001b[19G                                                   \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow let me verify the fix works with the example from your bug report:\r\u001b[2B\u001b[38;5;241m●\u001b[3G\u001b[39mRunning\u001b[11G\u001b[1m1\u001b[13G\u001b[22mshell\u001b[19Gcommand…\u001b[30;1H\u001b[28;3H\u001b[?25h"]
