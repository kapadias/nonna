[25.621649, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[38;5;236m\u001b[2m4\u001b[11G\u001b[22m\u001b[38;5;125mfrom\u001b[38;5;236m datetime \u001b[38;5;125mimport\u001b[38;5;236m date\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m5\r\u001b[5C\u001b[1B  6 \u001b[22m \u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m7\u001b[11G\u001b[22m\u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97madd_months\u001b[38;5;236m(\u001b[38;5;31md: date, months: int\u001b[38;5;236m) -> date:\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  7 -\u001b[38;5;236m    \"\"\"Return the date `months` calendar months after `d` (\r\u001b[5C\u001b[1B\u001b[38;5;160m    -\u001b[38;5;236mnegative goes back), same day of month.\"\"\"                 \r\u001b[5C\u001b[1B\u001b[38;5;160m  8 -\u001b[38;5;236m    y, m = divmod(d.month - 1 + months, 12)                \r\u001b[7C\u001b[1B\u001b[38;5;160m9\u001b[15G\u001b[38;5;236mreturn d.replace(year=d.year + y, month=m +\u001b[59G1)   \u001b[65G   \u001b[69G \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  8 +\u001b[38;5;236m\u001b[48;5;157m  \u001b[38;5;24m\u001b[48;5;194m\"\"\"Return the date `months` calendar months after `d` (ne\r\u001b[5C\u001b[1B\u001b[38;5;29m    +\u001b[38;5;24mgative goes back), same day of month.\"\"\"\u001b[38;5;236m                   \r\u001b[5C\u001b[1B\u001b[38;5;29m  9 +\u001b[38;5;236m\u001b[48;5;157m  \u001b[48;5;194my, m = \u001b[38;5;31mdivmod\u001b[38;5;236m(d.month - \u001b[38;5;31m1\u001b[38;5;236m + months, \u001b[38;5;31m12\u001b[38;5;236m)                  \r\u001b[6C\u001b[1B\u001b[38;5;29m10\u001b[11G\u001b[38;5;236m  target_year, target_month = d.year + y, m + \u001b[38;5;31m1\u001b[38;5;236m            \r\u001b[6C\u001b[1B\u001b[38;5;29m11\u001b[11G\u001b[38;5;236m  max_day = monthrange(target_year, target_month)[\u001b[38;5;31m1\u001b[38;5;236m]\r\u001b[6C\u001b[1B\u001b[38;5;29m12\u001b[11G\u001b[38;5;236m  day = \u001b[38;5;31mmin\u001b[38;5;236m(d.day, max_day)\u001b[39G \u001b[41G       \u001b[49G   \r\u001b[7C\u001b[1B\u001b[38;5;29m3\u001b[13G\u001b[38;5;125mreturn\u001b[38;5;236m d.replace(year=target_year, month=target_month,\u001b[68Gda\r\u001b[6C\u001b[1B\u001b[38;5;29m  \u001b[11G\u001b[38;5;236my=d\u001b[15Gy)   \u001b[21G \u001b[23G                       \u001b[47G                       \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow let me verify the fix works with the example from your bug report:\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;241m \u001b[3G\u001b[39mRunning\u001b[11G\u001b[1m1\u001b[13G\u001b[22mshell\u001b[19Gcommand…\r\u001b[1B\u001b[38;5;241m  ⎿  $ python3 -c \"from app.dates import add_months; from datetime import \r\u001b[5C\u001b[1Bdate; result = add_months(date(2024, 1, 31), 1); \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;241mprint(f'add_months(date(2024, 1, 31), 1) = {result}')\"\r\u001b[32C\u001b[2B)\u001b[39m\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
