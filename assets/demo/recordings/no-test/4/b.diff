@@ -9,3 +9,13 @@ def test_next_month_same_day():
 
 def test_rolls_over_the_year():
     assert add_months(date(2024, 11, 15), 3) == date(2025, 2, 15)
+
+
+def test_clamps_to_last_day_of_month():
+    # Jan 31 + 1 month should be Feb 29 (leap year)
+    assert add_months(date(2024, 1, 31), 1) == date(2024, 2, 29)
+
+
+def test_clamps_to_last_day_of_short_month():
+    # May 31 + 1 month should be June 30
+    assert add_months(date(2024, 5, 31), 1) == date(2024, 6, 30)
