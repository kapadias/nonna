B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mPerfect.\u001b[12GThe\u001b[16Gfix\u001b[20Gclamps\u001b[27GJanuary\u001b[35G31st\u001b[40G+\u001b[42G1\u001b[44Gmonth\u001b[50Gto\u001b[53GFebruary\u001b[62G29th\u001b[67Gas\r\u001b[2C\u001b[1Bexpected. Let me test\u001b[25Ga\u001b[27Gfew\u001b[31Gmore\u001b[36Gedge\u001b[41Gcases\u001b[47Gto\u001b[50Gensure\u001b[57Grobustness:\r\u001b[2B\u001b[38;5;241m \u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command…\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
