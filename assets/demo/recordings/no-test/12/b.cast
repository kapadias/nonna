C\u001b[1B\u001b[38;5;29m6\u001b[22G\u001b[38;5;236mday = \u001b[38;5;31mmin\u001b[38;5;236m(d.day, last_day)                      \r\u001b[7C\u001b[1B\u001b[38;5;29m7\u001b[15G\u001b[38;5;125mreturn\u001b[38;5;236m date(target_year,\u001b[40Gtarget_month,\u001b[54Gtarget_day)\r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mDone.\u001b[9GThe\u001b[13G\u001b[38;5;105madd_months\u001b[24G\u001b[39mfunction\u001b[33Gnow\u001b[37Gclamps\u001b[44Gto\u001b[47Gthe\u001b[51Glast\u001b[56Gday\u001b[60Gof\u001b[63Gthe\u001b[67Gtarget\r\u001b[2C\u001b[1Bmonth when the source\u001b[25Gday\u001b[29Gdoesn't\u001b[37Gexist\u001b[43Gin\u001b[46Gthat\u001b[51Gmonth.\r\u001b[2B \u001b[3GThe fix:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[37.638027, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;5;160m\u001b[48;5;224m    -\u001b[38;5;236mnegative goes back), same day of month.\"\"\"                 \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  8 +\u001b[38;5;236m    \u001b[38;5;24m\"\"\"Return the date `months` calendar months after `d` (\r\u001b[5C\u001b[1B\u001b[38;5;29m    +\u001b[38;5;24mnegative goes back), same day of month.\u001b[38;5;236m                    \r\u001b[7C\u001b[1B\u001b[38;5;29m9\u001b[15G\u001b[38;5;236m                                                       \r\u001b[6C\u001b[1B\u001b[38;5;29m10\u001b[11G\u001b[38;5;236m    Clamps to the last day of the target month \u001b[38;5;125mif\u001b[61G\u001b[38;5;236mthe\u001b[65Gday\u001b[69Gd\r\u001b[7C\u001b[1B\u001b[38;5;29m \u001b[11G\u001b[38;5;236moesn\u001b[38;5;24m't exist.\u001b[38;5;236m                                              \r\u001b[7C\u001b[1B\u001b[38;5;29m1\u001b[15G\u001b[38;5;24m\"\"\"\u001b[38;5;236m                                          \u001b[61G   \u001b[65G   \u001b[69G \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 12 \u001b[22m     y, m = \u001b[38;5;31mdivmod\u001b[38;5;236m(d.month - \u001b[38;5;31m1\u001b[38;5;236m + months, \u001b[38;5;31m12\u001b[38;5;236m)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  9 -\u001b[38;5;236m    return d.replace(year=d.year + y, month=m + 1)         \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 13 +\u001b[38;5;236m    target_year = d.year + y                               \r\u001b[5C\u001b[1B\u001b[38;5;29m 14 +\u001b[38;5;236m    target_month = m + \u001b[38;5;31m1\u001b[38;5;236m                                   \r\u001b[7C\u001b[1B\u001b[38;5;29m5\u001b[15G\u001b[38;5;236m_, last_d\u001b[25Gy\u001b[29Gmonth\u001b[35Gange(target_year,\u001b[53Gtarget_month)\r\u001b[7C\u001b[1B\u001b[38;5;29m6\u001b[22G\u001b[38;5;236mday =\u001b[28G\u001b[38;5;31mmin\u001b[38;5;236m(d.day,\u001b[39Glast_day)\r\u001b[7C\u001b[1B\u001b[38;5;29m7\u001b[15G\u001b[38;5;125mreturn\u001b[38;5;236m date(target_year, target_month, target_day)     \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2B\u001b[38;5;16m●\u001b[3G\u001b[39mDone. The \u001b[38;5;105madd_months\u001b[39m function\u001b[33Gnow\u001b[37Gclamps\u001b[44Gto\u001b[47Gthe\u001b[51Glast\u001b[56Gday\u001b[60Gof\u001b[63Gthe\u001b[67Gtarget\r\u001b[2C\u001b[1Bmonth\u001b[9Gwhen\u001b[14Gthe\u001b[18Gsource\u001b[25Gday\u001b[29Gdoesn't\u001b[37Gexist\u001b[43Gin\u001b[46Gthat\u001b[51Gmonth.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe fix:\u001b[K\r\u001b[2C\u001b[2B- Added a\u001b[13Gtest\u001b[18Gthat\u001b[23Greproduces\u001b[34Gthe\u001b[38Gcrash\u001b[44G(test\u001b[50Gfails\u001b[56Gbefore\u001b[63Gthe\u001b[67Gfix,\r\u001b[4C\u001b[1Bpasses\u001b[12Gafter)\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[37.750936, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;5;29m\u001b[48;5;194m    +\u001b[38;5;24mnegative goes back), same day of month.\u001b[38;5;236m                    \r\u001b[7C\u001b[1B\u001b[38;5;29m9\u001b[15G\u001b[38;5;236m                                                       \r\u001b[6C\u001b[1B\u001b[38;5;29m10\u001b[11G\u001b[38;5;236m    Clamps to the last day of the target month \u001b[38;5;125mif\u001b[61G\u001b[38;5;236mthe\u001b[65Gday\u001b[69Gd\r\u001b[7C\u001b[1B\u001b[38;5;29m \u001b[11G\u001b[38;5;236moesn\u001b[38;5;24m't exist.\u001b[38;5;236m                                              \r\u001b[7C\u001b[1B\u001b[38;5;29m1\u001b[15G\u001b[38;5;24m\"\"\"\u001b[38;5;236m                                          \u001b[61G   \u001b[65G   \u001b[69G \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 12 \u001b[22m     y, m = \u001b[38;5;31mdivmod\u001b[38;5;236m(d.month - \u001b[38;5;31m1\u001b[38;5;236m + months, \u001b[38;5;31m12\u001b[38;5;236m)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  9 -\u001b[38;5;236m    return d.replace(year=d.year + y, month=m + 1)         \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 13 +\u001b[38;5;236m    target_year = d.year + y                               \r\u001b[5C\u001b[1B\u001b[38;5;29m 14 +\u001b[38;5;236m    target_month = m + \u001b[38;5;31m1\u001b[38;5;236m                                   \r\u001b[7C\u001b[1B\u001b[38;5;29m5\u001b[15G\u001b[38;5;236m_, last_d\u001b[25Gy\u001b[29Gmonth\u001b[35Gange(target_year,\u001b[53Gtarget_month)\r\u001b[7C\u001b[1B\u001b[38;5;29m6\u001b[22G\u001b[38;5;236mday =\u001b[28G\u001b[38;5;31mmin\u001b[38;5;236m(d.day,\u001b[39Glast_day)\r\u001b[7C\u001b[1B\u001b[38;5;29m7\u001b[15G\u001b[38;5;125mreturn\u001b[38;5;236m date(target_year, target_month, target_day)     \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2B\u001b[38;5;16m●\u001b[3G\u00