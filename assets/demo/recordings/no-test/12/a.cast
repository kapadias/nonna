ck), same day of month.\"\"\"\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;236m\u001b[2m  9 \u001b[22m     y, m = \u001b[38;5;31mdivmod\u001b[38;5;236m(d.month - \u001b[38;5;31m1\u001b[38;5;236m + months, \u001b[38;5;31m12\u001b[38;5;236m)\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  9 -\u001b[38;5;236m    return d.replace(year=d.year + y, month=m + 1)         \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;5;29m\u001b[48;5;194m 10 +\u001b[38;5;236m    target_year = d.year + y                               \r\u001b[5C\u001b[1B\u001b[38;5;29m 11 +\u001b[38;5;236m    target_month = m + \u001b[38;5;31m1\u001b[38;5;236m                                   \r\u001b[5C\u001b[1B\u001b[38;5;29m 12 +\u001b[38;5;236m    _, days_in_month = calendar.monthrange(target_year, tar\r\u001b[5C\u001b[1B\u001b[38;5;29m    +\u001b[38;5;236mget_month)                                                 \r\u001b[5C\u001b[1B\u001b[38;5;29m 13 +\u001b[38;5;236m    \u001b[38;5;125mreturn\u001b[38;5;236m date(target_year, target_month, \u001b[38;5;31mmin\u001b[38;5;236m(d.day, days_\r\u001b[5C\u001b[1B\u001b[38;5;29m    +\u001b[38;5;236min_month))                                                 \u001b[49m\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
