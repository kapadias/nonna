[38;5;236m                                   \r\u001b[7C\u001b[1B\u001b[38;5;29m2\u001b[15G\u001b[38;5;236m_, days_i\u001b[25G_month\u001b[32G=\u001b[34Gcalendar.monthrange(target_year, tar\r\u001b[6C\u001b[1B\u001b[38;5;29m  \u001b[11G\u001b[38;5;236mget_month)          \u001b[32G \u001b[34G                                \u001b[67G   \r\u001b[6C\u001b[1B\u001b[38;5;29m13\u001b[11G\u001b[38;5;236m    \u001b[38;5;125mreturn\u001b[38;5;236m date(target_year, target_month, \u001b[38;5;31mmin\u001b[38;5;236m(d.day, days_\r\u001b[6C\u001b[1B\u001b[38;5;29m  \u001b[11G\u001b[38;5;236min_month))                                                 \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mFixed!\u001b[10GThe\u001b[14Gfunction\u001b[23Gnow\u001b[27Gclamps\u001b[34Gthe\u001b[38Gday\u001b[42Gto\u001b[45Gthe\u001b[49Glast\u001b[54Gvalid\u001b[60Gday\u001b[64Gof\u001b[67Gthe\u001b[71Gtarget\r\u001b[1B \u001b[3Gmonth using \u001b[38;5;105mcalendar.monthrange()\u001b[39m.\u001b[38GFor\u001b[42Gy\u001b[44Gur \u001b[48Gxample,\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
