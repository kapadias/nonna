                  \r\u001b[5C\u001b[1B\u001b[38;5;29m 11 +\u001b[38;5;236m    target_month = m + \u001b[38;5;31m1\u001b[38;5;236m                                   \r\u001b[7C\u001b[1B\u001b[38;5;29m2\u001b[15G\u001b[38;5;236m_, days_in_month = calendar.monthrange(target_year,\u001b[67Gtar\r\u001b[6C\u001b[1B\u001b[38;5;29m  \u001b[11G\u001b[38;5;236mget_month)      \u001b[28G \u001b[30G \u001b[32G \u001b[34G                                    \r\u001b[7C\u001b[1B\u001b[38;5;29m3\u001b[15G\u001b[38;5;125mreturn\u001b[38;5;236m date(target_year, target_month, \u001b[38;5;31mmin\u001b[38;5;236m(d.day, days_\r\u001b[10C\u001b[1Bin_month)\r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[6G\u001b[39m\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
