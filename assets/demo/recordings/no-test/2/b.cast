[30.379649, "o", "\u001b[?25l\u001b[H\u001b[38;5;241m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m10\u001b[15G\u001b[22mlines,\u001b[22Gremoved\u001b[30G\u001b[1m2\u001b[32G\u001b[22mlines\r\u001b[1B \u001b[3G   \u001b[38;5;236m\u001b[2m  1 \u001b[22m \u001b[38;5;24m\"\"\"Calendar helpers for billing renewals.\"\"\"\r\u001b[1B\u001b[39m     \u001b[38;5;236m\u001b[2m  2 \u001b[22m \u001b[12G\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m3\u001b[11G\u001b[22m\u001b[38;5;125mfrom\u001b[38;5;236m datetime \u001b[38;5;125mimport\u001b[38;5;236m date\r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  4 +\u001b[38;5;125mfrom\u001b[38;5;236m calendar \u001b[38;5;125mimport\u001b[38;5;236m monthrange                            \r\u001b[6C\u001b[1B\u001b[49m\u001b[2m 5\u001b[11G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m6\u001b[11G\u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  7 \u001b[22m \u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97madd_months\u001b[38;5;236m(\u001b[38;5;31md: date, months: int\u001b[38;5;236m) -> date:\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  7 -\u001b[38;5;236m    \"\"\"Return the date `months` calendar months after `d` (\r\u001b[5C\u001b[1B\u001b[38;5;160m    -\u001b[38;5;236mnegative goes back), same day of month.\"\"\"                 \r\u001b[6C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 8\u001b[15G\u001b[38;5;24m\"\"\"Return the date `months` calendar months after `d` (\r\u001b[10C\u001b[1Bnegative goes back), same day of month.\r\u001b[6C\u001b[1B\u001b[38;5;29m 9\r\u001b[7C\u001b[1B0\u001b[15G\u001b[38;5;236mIf\u001b[18Gthe\u001b[22Gday\u001b[26Gdoesn\u001b[38;5;24m't exist in the target month, clamps to\r\u001b[6C\u001b[1B\u001b[38;5;29m  \u001b[11G\u001b[38;5;24m the last day of that month.\u001b[38;5;236m                      \r\u001b[7C\u001b[1B\u001b[38;5;29m1\u001b[15G\u001b[38;5;24m\"\"\"\u001b[38;5;236m   \u001b[22G                     \u001b[44G  \u001b[47G    \u001b[52G  \u001b[55G  \u001b[58G          \u001b[69G \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 12 \u001b[22m     y, m = \u001b[38;5;31mdivmod\u001b[38;5;236m(d.month - \u001b[38;5;31m1\u001b[38;5;236m + months, \u001b[38;5;31m12\u001b[38;5;236m)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  9 -\u001b[38;5;236m    return d.replace(year=d.year + y, month=m + 1)         \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;5;29m\u001b[48;5;194m 13 +\u001b[38;5;236m    target_year = d.year + y                               \u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;29m\u001b[48;5;194m 14 +\u001b[38;5;236m    target_month = m + \u001b[38;5;31m1\u001b[38;5;236m                                   \r\u001b[5C\u001b[1B\u001b[38;5;29m 15 +\u001b[38;5;236m    max_day = monthrange(target_year, target_month)[\u001b[38;5;31m1\u001b[38;5;236m]     \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[38;5;29m\u001b[48;5;194m 16 +\u001b[38;5;236m    day = \u001b[38;5;31mmin\u001b[38;5;236m(d.day, max_day)                              \r\u001b[5C\u001b[1B\u001b[38;5;29m 17 +\u001b[38;5;236m    \u001b[38;5;125mreturn\u001b[38;5;236m date(target_year, target_month, day)            \r\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[1B\u001b[38;5;174m·\u001b[3G\u001b[38;5;216mProofing…\u001b[38;5;174m \u001b[38;5;241m(16s · ↓\u001b[22G1.6k tokens · thought for 1s)\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
