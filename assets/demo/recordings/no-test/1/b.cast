    \r\u001b[6C\u001b[1B\u001b[38;5;29m15\u001b[11G\u001b[38;5;236m    _, last_day = calendar.monthrange(target_year, target_m\r\u001b[6C\u001b[1B\u001b[38;5;29m  \u001b[11G\u001b[38;5;236month) \u001b[18G        \u001b[27G \u001b[29G                                \u001b[62G        \r\u001b[6C\u001b[1B\u001b[38;5;29m16\u001b[11G\u001b[38;5;236m    target_day\u001b[26G=\u001b[28G\u001b[38;5;31mmin\u001b[38;5;236m(target_day, last_day)                 \r\u001b[7C\u001b[1B\u001b[38;5;29m7\u001b[15G\u001b[38;5;236m          \u001b[26G \u001b[28G                                          \r\u001b[7C\u001b[1B\u001b[38;5;29m8\u001b[15G\u001b[38;5;125mreturn\u001b[38;5;236m date(target_year, target_month, target_day)     \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow"]
