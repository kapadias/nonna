                               \r\u001b[7C\u001b[1B\u001b[38;5;29m4\u001b[15G\u001b[38;5;246m# Clamp day to last day of target month if it doesn't e\r\u001b[6C\u001b[1B\u001b[38;5;29m  \u001b[11G\u001b[38;5;246mxist\u001b[38;5;236m                                                       \r\u001b[7C\u001b[1B\u001b[38;5;29m5\u001b[15G\u001b[38;5;236m_, last_day = calendar.monthrange(target_year, target_m\r\u001b[10C\u001b[1Bonth)                                                      \r\u001b[7C\u001b[1B\u001b[38;5;29m6\u001b[15G\u001b[38;5;236mtarget_day = \u001b[38;5;31mmin\u001b[38;5;236m(target_day, last_day)                 \r\u001b[6C\u001b[1B\u001b[38;5;29m17\u001b[11G\u001b[38;5;236m     \r\u001b[7C\u001b[1B\u001b[38;5;29m8\u001b[15G\u001b[38;5;125mreturn\u001b[38;5;236m date(targe\u001b[33G_year, target_month,\u001b[54Gtarget_day)\r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[6G\u001b[39m\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
