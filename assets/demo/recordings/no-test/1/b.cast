001b[38;5;236m                                                       \r\u001b[7C\u001b[1B\u001b[38;5;29m5\u001b[15G\u001b[38;5;236m_, last_day = calendar.monthrange(target_year, target_m\r\u001b[10C\u001b[1Bonth)                                                      \r\u001b[7C\u001b[1B\u001b[38;5;29m6\u001b[15G\u001b[38;5;236mtarget_day = \u001b[38;5;31mmin\u001b[38;5;236m(target_day, last_day)                 \r\u001b[6C\u001b[1B\u001b[38;5;29m17\u001b[11G\u001b[38;5;236m     \r\u001b[7C\u001b[1B\u001b[38;5;29m8\u001b[15G\u001b[38;5;125mreturn\u001b[38;5;236m date(targe\u001b[33G_year, target_month,\u001b[54Gtarget_day)\r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow I'll add a test for the month-end clamping case:\u001b[K\r\u001b[2B\u001b[38;5;241m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(\u001b]8;id=1ne69l2;file:///root/b/renewals/tests/test_dates.py\u0007tests/test_dates.py\u001b]8;;\u0007)\u001b[31G\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
