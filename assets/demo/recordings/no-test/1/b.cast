[32.777831, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[38;5;236m\u001b[2m6\u001b[11G\u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  7 \u001b[22m \u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97madd_months\u001b[38;5;236m(\u001b[38;5;31md: date, months: int\u001b[38;5;236m) -> date:\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m7\u001b[11G\u001b[38;5;236m    \"\"\"Return\u001b[25Gthe date `months` calendar months\u001b[59Gafter\u001b[65G`d`\u001b[69G(\r\u001b[5C\u001b[1B\u001b[38;5;160m    -\u001b[38;5;236mnegative goes back), same day of month.\"\"\"                 \r\u001b[7C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m8\u001b[11G\u001b[38;5;236m    \u001b[38;5;24m\"\"\"Return the date `months` calendar months after `d` (\r\u001b[5C\u001b[1B\u001b[38;5;29m    +\u001b[38;5;24mnegative goes back), \u001b[48;5;157mclamped\u001b[48;5;194m \u001b[48;5;157mto\u001b[48;5;194m month\u001b[48;5;157m-end\u001b[48;5;194m.\"\"\"\u001b[38;5;236m              \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m  9 \u001b[22m     y, m = \u001b[38;5;31mdivmod\u001b[38;5;236m(d.month - \u001b[38;5;31m1\u001b[38;5;236m + months, \u001b[38;5;31m12\u001b[38;5;236m)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  9 -\u001b[38;5;236m    return d.replace(year=d.year + y, month=m + 1)         \r\u001b[7C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m0\u001b[22G\u001b[38;5;236myear = d.year + y                               \r\u001b[7C\u001b[1B\u001b[38;5;29m1\u001b[22G\u001b[38;5;236mmonth\u001b[28G= m +\u001b[34G\u001b[38;5;31m1\u001b[38;5;236m                                   \r\u001b[7C\u001b[1B\u001b[38;5;29m2\u001b[15G\u001b[38;5;236mtarget_day\u001b[26G=\u001b[28Gd.day\r\u001b[7C\u001b[1B\u001b[38;5;29m3\u001b[15G\u001b[38;5;236m                                                       \r\u001b[6C\u001b[1B\u001b[38;5;29m14\u001b[11G\u001b[38;5;236m    \u001b[38;5;246m# Clamp day to last day of target month if it doesn't e\r\u001b[6C\u001b[1B\u001b[38;5;29m  \u001b[11G\u001b[38;5;246mxist\u001b[38;5;236m                                                       \r\u001b[6C\u001b[1B\u001b[38;5;29m15\u001b[11G\u001b[38;5;236m    _,\u001b[18Glast_day\u001b[27G=\u001b[29Gcalendar.monthrange(target_year,\u001b[62Gtarget_m\r\u001b[6C\u001b[1B\u001b[38;5;29m  \u001b[11G\u001b[38;5;236month)         \u001b[26G \u001b[28G                                          \r\u001b[7C\u001b[1B\u001b[38;5;29m6\u001b[15G\u001b[38;5;236mtarget_day\u001b[26G=\u001b[28G\u001b[38;5;31mmin\u001b[38;5;236m(target_day, last_day)                 \r\u001b[7C\u001b[1B\u001b[38;5;29m7\u001b[15G\u001b[38;5;236m                                                       \r\u001b[5C\u001b[1B\u001b[38;5;29m 18 +\u001b[38;5;236m    \u001b[38;5;125mreturn\u001b[38;5;236m date(target_year, target_month, target_day)     \r\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow\u001b[7GI'll\u001b[12Gadd\u001b[16Ga\u001b[18Gtest\u001b[23Gfor\u001b[27Gthe\u001b[31Gmonth-end\u001b[41Gclamping\u001b[50Gcase:\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;241m \u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(\u001b]8;id=1ne69l2;file:///root/b/renewals/tests/test_dates.py\u0007tests/test_dates.py\u001b]8;;\u0007)\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;174m*\u001b[39m \u001b[38;5;174mPropagating… \u001b[38;5;241m(16s · ↓\u001b[25G1.9k tokens · thought for 1s)\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
