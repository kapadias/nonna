.year + y                               \u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;29m\u001b[48;5;194m 11 +\u001b[38;5;236m    target_month = m + \u001b[38;5;31m1\u001b[38;5;236m                                   \r\u001b[5C\u001b[1B\u001b[38;5;29m 12 +\u001b[38;5;236m    target_day = d.day                                     \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;5;29m\u001b[48;5;194m 13 +\u001b[38;5;236m                                                           \r\u001b[5C\u001b[1B\u001b[38;5;29m 14 +\u001b[38;5;236m    \u001b[38;5;246m# Clamp day to last day of target month if it doesn't e\r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[38;5;29m\u001b[48;5;194m    +\u001b[38;5;246mxist\u001b[38;5;236m                                                       \u001b[39m\u001b[49m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;29m\u001b[48;5;194m 15 +\u001b[38;5;236m    _, last_day = calendar.monthrange(target_year, target_m\r\u001b[5C\u001b[1B\u001b[38;5;29m    +\u001b[38;5;236month)                                                      \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;5;29m\u001b[48;5;194m 16 +\u001b[38;5;236m    target_day = \u001b[38;5;31mmin\u001b[38;5;236m(target_day, last_day)                 \r\u001b[5C\u001b[1B\u001b[38;5;29m 17 +\u001b[38;5;236m                                                           \r\u001b[5C\u001b[1B\u001b[38;5;29m 18 +\u001b[38;5;236m    \u001b[38;5;125mreturn\u001b[38;5;236m date(target_year, target_month, target_day)     \r\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[1B\u001b[38;5;174m✶\u001b[39m \u001b[38;5;216mPropagating…\u001b[38;5;174m \u001b[38;5;241m(13s · ↓\u001b[25G1.6k tokens · thought for 1s)\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
