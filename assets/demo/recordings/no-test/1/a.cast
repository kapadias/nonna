[29.554002, "o", "\u001b[?25l\u001b[H     \u001b[38;5;236m\u001b[2m  6 \u001b[22m \u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97madd_months\u001b[38;5;236m(\u001b[38;5;31md: date, months: int\u001b[38;5;236m) -> date:\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  7 -\u001b[38;5;236m    \"\"\"Return the date `months` calendar months after `d` (\r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;5;160m\u001b[48;5;224m    -\u001b[38;5;236mnegative goes back), same day of month.\"\"\"                 \u001b[49m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  7 +\u001b[38;5;236m    \u001b[38;5;24m\"\"\"Return the date `months` calendar months after `d` (\r\u001b[1B\u001b[39m\u001b[49m     \u001b[38;5;29m\u001b[48;5;194m    +\u001b[38;5;24mnegative goes back), same day of month\u001b[48;5;157m, clamped to last day\u001b[49m\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;5;29m\u001b[48;5;194m    +\u001b[38;5;24m\u001b[48;5;157m of month\u001b[48;5;194m.\"\"\"\u001b[38;5;236m                                              \u001b[39m\u001b[49m\u001b[K\r\u001b[1B     \u001b[38;5;236m\u001b[2m  8 \u001b[22m     y, m = \u001b[38;5;31mdivmod\u001b[38;5;236m(d.month - \u001b[38;5;31m1\u001b[38;5;236m + months, \u001b[38;5;31m12\u001b[38;5;236m)\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;5;160m\u001b[48;5;224m  9 -\u001b[38;5;236m    return d.replace(year=d.year + y, month=m + 1)         \u001b[49m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  9 +\u001b[38;5;236m    target_year = d.year + y                               \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;5;29m\u001b[48;5;194m 10 +\u001b[38;5;236m    target_month = m + \u001b[38;5;31m1\u001b[38;5;236m                                   \r\u001b[2C\u001b[1B\u001b[39m\u001b[49m   \u001b[38;5;29m\u001b[48;5;194m 11 +\u001b[38;5;236m    target_day = d.day                                     \r\u001b[5C\u001b[1B\u001b[38;5;29m 12 +\u001b[38;5;236m                                                           \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;5;29m\u001b[48;5;194m 13 +\u001b[38;5;236m    \u001b[38;5;246m# Clamp day to last day of target month\u001b[38;5;236m                \r\u001b[5C\u001b[1B\u001b[38;5;29m 14 +\u001b[38;5;236m    \u001b[38;5;125mif\u001b[38;5;236m target_month == \u001b[38;5;31m12\u001b[38;5;236m:                                 \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G \u001b[5G \u001b[38;5;29m\u001b[48;5;194m 15 +\u001b[38;5;236m        next_month_first = date(target_year + \u001b[38;5;31m1\u001b[38;5;236m, \u001b[38;5;31m1\u001b[38;5;236m, \u001b[38;5;31m1\u001b[38;5;236m)     \r\u001b[2C\u001b[1B\u001b[39m\u001b[49m   \u001b[38;5;29m\u001b[48;5;194m 16 +\u001b[38;5;236m    \u001b[38;5;125melse\u001b[38;5;236m:                                                  \u001b[39m\u001b[49m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;29m\u001b[48;5;194m 17 +\u001b[38;5;236m        next_month_first = date(target_year, target_month +\u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;29m\u001b[48;5;194m    +\u001b[38;5;236m \u001b[38;5;31m1\u001b[38;5;236m, \u001b[38;5;31m1\u001b[38;5;236m)                                                     \r\u001b[5C\u001b[1B\u001b[38;5;29m 18 +\u001b[38;5;236m    last_day_of_month = (next_month_first - timedelta(days=\r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;5;29m\u001b[48;5;194m    +\u001b[38;5;31m1\u001b[38;5;236m)).day                                                    \u001b[39m\u001b[49m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;29m\u001b[48;5;194m 19 +\u001b[38;5;236m                                                           \r\u001b[5C\u001b[1B\u001b[38;5;29m 20 +\u001b[38;5;236m    target_day = \u001b[38;5;31mmin\u001b[38;5;236m(target_day, last_day_of_month)        \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[38;5;29m\u001b[48;5;194m 21 +\u001b[38;5;236m    \u001b[38;5;125mreturn\u001b[38;5;236m date(target_year, target_month, target_day)     \u001b[39m\u001b[49m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
