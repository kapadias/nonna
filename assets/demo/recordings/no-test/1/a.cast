th = (next_month_first - timedelta(days=\r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;5;29m\u001b[48;5;194m    +\u001b[38;5;31m1\u001b[38;5;236m)).day                                                    \r\u001b[5C\u001b[1B\u001b[38;5;29m 19 +\u001b[38;5;236m                                                           \r\u001b[5C\u001b[1B\u001b[38;5;29m 20 +\u001b[38;5;236m    target_day = \u001b[38;5;31mmin\u001b[38;5;236m(target_day, last_day_of_month)        \r\u001b[5C\u001b[1B\u001b[38;5;29m 21 +\u001b[38;5;236m    \u001b[38;5;125mreturn\u001b[38;5;236m date(target_year, target_month, target_day)     \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow let me verify the fix works with a quick test:\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m \u001b[10Ghell command \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[6G\u001b[39m\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
