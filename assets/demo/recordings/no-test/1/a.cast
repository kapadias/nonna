001b[38;5;236m)\r\u001b[7C\u001b[1B\u001b[38;5;29m6\u001b[15G\u001b[38;5;125melse\u001b[38;5;236m:          \u001b[31G  \u001b[34G   \r\u001b[7C\u001b[1B\u001b[38;5;29m7\u001b[54G\u001b[38;5;236m, target_month +\r\u001b[6C\u001b[1B\u001b[38;5;29m  \u001b[12G\u001b[38;5;31m1\u001b[38;5;236m, \u001b[38;5;31m1\u001b[38;5;236m)   \r\u001b[7C\u001b[1B\u001b[38;5;29m8\u001b[15G\u001b[38;5;236mlast_day\u001b[24Gof_month = (next_month_first - timed\u001b[61Glta(days=\r\u001b[10C\u001b[1B\u001b[38;5;31m1\u001b[38;5;236m)).day\r\u001b[7C\u001b[1B\u001b[38;5;29m9\u001b[15G\u001b[38;5;236m                 \u001b[33G \u001b[35G                 \u001b[53G \u001b[55G               \r\u001b[6C\u001b[1B\u001b[38;5;29m20\u001b[11G\u001b[38;5;236m    target_day = \u001b[38;5;31mmin\u001b[38;5;236m(target_day,\u001b[44Glast_day_of_month)\r\u001b[6C\u001b[1B\u001b[38;5;29m21\u001b[15G\u001b[38;5;125mreturn\u001b[38;5;236m date(target_year, target_month, target_day)     \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[6G\u001b[39m\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
