[31.860576, "o", "\u001b[?25l\u001b[H\u001b[38;5;241m  ⎿  \u001b[39mAdded \u001b[1m8\u001b[22m lines, removed \u001b[1m1\u001b[22m line\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m1\u001b[11G\u001b[22m\u001b[38;5;24m\"\"\"Calendar helpers for billing renewals.\"\"\"\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m2\r\u001b[5C\u001b[1B\u001b[22m\u001b[38;5;29m\u001b[48;5;194m  3 +\u001b[38;5;125mimport\u001b[38;5;236m calendar                                            \r\u001b[7C\u001b[1B\u001b[49m\u001b[2m4\u001b[11G\u001b[22m\u001b[38;5;125mfrom\u001b[38;5;236m datetime \u001b[38;5;125mimport\u001b[38;5;236m date\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m5\u001b[11G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m6\u001b[11G\u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  7 \u001b[22m \u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97madd_months\u001b[38;5;236m(\u001b[38;5;31md: date, months: int\u001b[38;5;236m) -> date:\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  8 \u001b[22m     \u001b[38;5;24m\"\"\"Return the date `months` calendar months after `d` (\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m    \u001b[22m \u001b[38;5;24mnegative goes back), same day of month.\"\"\"\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  9 \u001b[22m     y, m = \u001b[38;5;31mdivmod\u001b[38;5;236m(d.month - \u001b[38;5;31m1\u001b[38;5;236m + months, \u001b[38;5;31m12\u001b[38;5;236m)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  9 -\u001b[38;5;236m    return d.replace(year=d.year + y, month=m + 1)         \r\u001b[6C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m10\u001b[11G\u001b[38;5;236m    target_year\u001b[27G=\u001b[29Gd.year\u001b[36G+\u001b[38Gy\r\u001b[7C\u001b[1B\u001b[38;5;29m1\u001b[22G\u001b[38;5;236mmonth\u001b[28G= m + \u001b[38;5;31m1\u001b[38;5;236m   \u001b[39G         \r\u001b[7C\u001b[1B\u001b[38;5;29m2\r\u001b[7C\u001b[1B3\u001b[15G\u001b[38;5;236m_, last_day = calendar.monthrange(target_year, target_m\r\u001b[5C\u001b[1B\u001b[38;5;29m    +\u001b[38;5;236month)                                                      \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;5;29m\u001b[48;5;194m 14 +\u001b[38;5;236m    target_day = \u001b[38;5;31mmin\u001b[38;5;236m(d.day, last_day)                      \r\u001b[1B\u001b[39m\u001b[49m     \u001b[38;5;29m\u001b[48;5;194m 15 +\u001b[38;5;236m                                                           \u001b[49m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 16 +\u001b[38;5;236m    \u001b[38;5;125mreturn\u001b[38;5;236m date(target_year, target_month, target_day)     \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[1B\u001b[38;5;241m \u001b[3G\u001b[39mRunning python3 -c \"from app.dates import add_months; fro…\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  $ python3\u001b[16G-m pytes\u001b[25G tests/ -v\u001b[39m\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
