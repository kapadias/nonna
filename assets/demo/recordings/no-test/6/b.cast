       \r\u001b[7C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m0\u001b[19G\u001b[38;5;236myear = d.year + y                                  \r\u001b[7C\u001b[1B\u001b[38;5;29m1\u001b[15G\u001b[38;5;236mnew_month = m + \u001b[38;5;31m1\u001b[38;5;236m                            \r\u001b[7C\u001b[1B\u001b[38;5;29m2\u001b[15G\u001b[38;5;236mlast_day = monthrange(new_year, new_month)[\u001b[38;5;31m1\u001b[38;5;236m]\r\u001b[7C\u001b[1B\u001b[38;5;29m3\u001b[15G\u001b[38;5;236mnew_day = \u001b[38;5;31mmin\u001b[38;5;236m(d.day, last\u001b[41Gday)  \u001b[48G        \r\u001b[5C\u001b[1B\u001b[38;5;29m 14 +\u001b[38;5;236m    \u001b[38;5;125mreturn\u001b[38;5;236m date(new_year, new_month, new_day)              \r\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow\u001b[7GI'll\u001b[12Gadd\u001b[16Ga\u001b[18Gtest\u001b[23Gfor\u001b[27Gthe\u001b[31Gmonth-end\u001b[41Gclamping\u001b[50Gcase:\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;241m \u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(\u001b]8;id=1ne69l2;file:///root/b/renewals/tests/test_dates.py\u0007tests/test_dates.py\u001b]8;;\u0007)\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;174m✢\u001b[39m \u001b[38;5;174mMetamorphosing… \u001b[38;5;241m(14s · ↓\u001b[28G1.6k tokens)\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
