[23.828241, "o", "\u001b[?25l\u001b[H\u001b[38;5;16m●\u001b[3G\u001b[39mNow\u001b[7GI'll\u001b[12Gfix\u001b[16Gthe\u001b[20Gfunction\u001b[29Gto\u001b[32Gclamp\u001b[38Gthe\u001b[42Gday\u001b[46Gto\u001b[49Gthe\u001b[53Glast\u001b[58Gvalid\u001b[64Gday\u001b[68Gof\u001b[71Gthe\r\u001b[1B  target\u001b[10Gmonth:\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;65m●\u001b[39m \u001b[1mUpdate\u001b[22m(\u001b]8;id=1mhpc22;file:///root/a/renewals/app/dates.py\u0007app/dates.py\u001b]8;;\u0007)\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m6\u001b[14G\u001b[22mlines,\u001b[21Gremoved\u001b[29G\u001b[1m2\u001b[31G\u001b[22mlines\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  1 \u001b[22m \u001b[38;5;24m\"\"\"Calendar helpers for billing renewals.\"\"\"\r\u001b[1B\u001b[39m     \u001b[38;5;236m\u001b[2m  2 \u001b[22m \u001b[39m\u001b[K\r\u001b[1B     \u001b[38;5;29m\u001b[48;5;194m  3 +\u001b[38;5;125mimport\u001b[38;5;236m calendar                                            \u001b[39m\u001b[49m\u001b[K\r\u001b[1B     \u001b[38;5;236m\u001b[2m  4 \u001b[22m \u001b[38;5;125mfrom\u001b[38;5;236m datetime \u001b[38;5;125mimport\u001b[38;5;236m date\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;5;236m\u001b[2m  5 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  6 \u001b[22m \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;236m\u001b[2m  7 \u001b[22m \u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97madd_months\u001b[38;5;236m(\u001b[38;5;31md: date, months: int\u001b[38;5;236m) -> date:\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;160m\u001b[48;5;224m  7 -\u001b[38;5;236m    \"\"\"Return the date `months` calendar months after `d` (\r\u001b[5C\u001b[1B\u001b[38;5;160m    -\u001b[38;5;236mnegative goes back), same day of month.\"\"\"                 \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;5;29m\u001b[48;5;194m  8 +\u001b[38;5;236m    \u001b[38;5;24m\"\"\"Return the date `months` calendar months after `d` (\r\u001b[5C\u001b[1B\u001b[38;5;29m    +\u001b[38;5;24mnegative goes back), \u001b[48;5;157mclamped\u001b[48;5;194m \u001b[48;5;157mto last valid \u001b[48;5;194mday of \u001b[48;5;157mtarget \u001b[48;5;194mmo\r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;5;29m\u001b[48;5;194m    +\u001b[38;5;24mnth.\"\"\"\u001b[38;5;236m                                                    \u001b[71G\u001b[39m\u001b[49m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;236m\u001b[2m  9 \u001b[22m     y, m = \u001b[38;5;31mdivmod\u001b[38;5;236m(d.month - \u001b[38;5;31m1\u001b[38;5;236m + months, \u001b[38;5;31m12\u001b[38;5;236m)\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  9 -\u001b[38;5;236m    return d.replace(year=d.year + y, month=m + 1)         \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;5;29m\u001b[48;5;194m 10 +\u001b[38;5;236m    year = d.year + y                                      \r\u001b[5C\u001b[1B\u001b[38;5;29m "]
[23.828821, "o", "11 +\u001b[38;5;236m    month = m + \u001b[38;5;31m1\u001b[38;5;236m                                          \r\u001b[5C\u001b[1B\u001b[38;5;29m 12 +\u001b[38;5;236m    day = \u001b[38;5;31mmin\u001b[38;5;236m(d.day, calendar.monthrange(year, month)[\u001b[38;5;31m1\u001b[38;5;236m])  \r\u001b[5C\u001b[1B\u001b[38;5;29m 13 +\u001b[38;5;236m    \u001b[38;5;125mreturn\u001b[38;5;236m date(year, month, day)                          \u001b[39m\u001b[49m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
