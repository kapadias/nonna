1b[1B\u001b[49m\u001b[2m  9 \u001b[22m     y, m = \u001b[38;5;31mdivmod\u001b[38;5;236m(d.month - \u001b[38;5;31m1\u001b[38;5;236m + months, \u001b[38;5;31m12\u001b[38;5;236m)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  9 -\u001b[38;5;236m    return d.replace(year=d.year + y, month=m + 1)         \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 10 +\u001b[38;5;236m    year = d.year + y                                      \r\u001b[5C\u001b[1B\u001b[38;5;29m 11 +\u001b[38;5;236m    month = m + \u001b[38;5;31m1\u001b[38;5;236m                                          \r\u001b[7C\u001b[1B\u001b[38;5;29m2\u001b[15G\u001b[38;5;236mday = \u001b[38;5;31mmin\u001b[38;5;236m(d.day, calendar.monthrange(year, month)[\u001b[38;5;31m1\u001b[38;5;236m])  \r\u001b[7C\u001b[1B\u001b[38;5;29m3\u001b[15G\u001b[38;5;125mreturn\u001b[38;5;236m date(year,\u001b[33Gmonth,\u001b[40Gday)\r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[6G\u001b[39m\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
