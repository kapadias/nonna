[45.236213, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[38;5;29m\u001b[48;5;194m5\u001b[11G\u001b[38;5;236m    \u001b[38;5;24m\"\"\"Jan 31 + 1 month should clamp to Feb 29 in a leap ye\r\u001b[6C\u001b[1B\u001b[38;5;29m  \u001b[11G\u001b[38;5;24mar.\"\"\"\u001b[38;5;236m                                                     \r\u001b[6C\u001b[1B\u001b[38;5;29m16\u001b[11G\u001b[38;5;236m    \u001b[38;5;125massert\u001b[22G\u001b[38;5;236madd_months(date(\u001b[38;5;31m2024\u001b[38;5;236m,\u001b[44G\u001b[38;5;31m1\u001b[38;5;236m,\u001b[47G\u001b[38;5;31m31\u001b[38;5;236m),\u001b[52G\u001b[38;5;31m1\u001b[38;5;236m)\u001b[55G==\u001b[58Gdate(\u001b[38;5;31m2024\u001b[38;5;236m,\u001b[69G\u001b[38;5;31m2\r\u001b[6C\u001b[1B\u001b[38;5;29m  \u001b[11G\u001b[38;5;236m,\u001b[13G\u001b[38;5;31m29\u001b[38;5;236m)     \u001b[22G                     \u001b[44G  \u001b[47G    \u001b[52G  \u001b[55G  \u001b[58G          \u001b[69G \r\u001b[6C\u001b[1B\u001b[38;5;29m17\u001b[11G\u001b[38;5;236m \u001b[13G                                                         \r\u001b[7C\u001b[1B\u001b[38;5;29m8\r\u001b[7C\u001b[1B9\u001b[11G\u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97mtest_clamps_day_to_last_day_of_month_non_leap_year\u001b[38;5;236m():  \r\u001b[6C\u001b[1B\u001b[38;5;29m20\u001b[11G\u001b[38;5;236m    \u001b[38;5;24m\"\"\"Jan 31 + 1 month should clamp to Feb 28 in a non-lea\r\u001b[6C\u001b[1B\u001b[38;5;29m  \u001b[11G\u001b[38;5;24mp year.\"\"\"\u001b[38;5;236m                                                 \r\u001b[6C\u001b[1B\u001b[38;5;29m21\u001b[11G\u001b[38;5;236m    \u001b[38;5;125massert\u001b[22G\u001b[38;5;236madd_months(date(\u001b[38;5;31m2023\u001b[38;5;236m,\u001b[44G\u001b[38;5;31m1\u001b[38;5;236m,\u001b[47G\u001b[38;5;31m31\u001b[38;5;236m),\u001b[52G\u001b[38;5;31m1\u001b[38;5;236m)\u001b[55G==\u001b[58Gdate(\u001b[38;5;31m2023\u001b[38;5;236m,\u001b[69G\u001b[38;5;31m2\r\u001b[6C\u001b[1B\u001b[38;5;29m  \u001b[11G\u001b[38;5;236m,\u001b[13G\u001b