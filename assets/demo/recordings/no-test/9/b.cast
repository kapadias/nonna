[42.788489, "o", "\u001b[?25l\u001b[H\u001b[7G\u001b[38;5;236m\u001b[2m  \u001b[11G\u001b[22m\u001b[38;5;31m2\u001b[38;5;236m, \u001b[38;5;31m15\u001b[38;5;236m)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 12 +\u001b[38;5;236m                                                           \r\u001b[5C\u001b[1B\u001b[38;5;29m 13 +\u001b[38;5;236m                                                           \r\u001b[7C\u001b[1B\u001b[38;5;29m4\u001b[11G\u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97mtest_clamps_day_to_last_day_of_month_leap_year\u001b[38;5;236m():      \r\u001b[7C\u001b[1B\u001b[38;5;29m5\u001b[15G\u001b[38;5;24m\"\"\"Jan 31 + 1 month should clamp to Feb 29 in a leap ye\r\u001b[6C\u001b[1B\u001b[38;5;29m  \u001b[11G\u001b[38;5;24mar.\"\"\"\u001b[38;5;236m                                               \r\u001b[7C\u001b[1B\u001b[38;5;29m6\u001b[15G\u001b[38;5;125massert\u001b[38;5;236m add_months(date(\u001b[38;5;31m2024\u001b[38;5;236m, \u001b[38;5;31m1\u001b[38;5;236m, \u001b[38;5;31m31\u001b[38;5;236m), \u001b[38;5;31m1\u001b[38;5;236m) == date(\u001b[38;5;31m2024\u001b[38;5;236m, \u001b[38;5;31m2\r\u001b[10C\u001b[1B\u001b[38;5;236m, \u001b[38;5;31m29\u001b[38;5;236m) \r\u001b[7C\u001b[1B\u001b[38;5;29m7\u001b[15G\u001b[38;5;236m                                                       \r\u001b[6C\u001b[1B\u001b[38;5;29m18\u001b[11G\u001b[38;5;236m \u001b[13G                                                         \r\u001b[7C\u001b[1B\u001b[38;5;29m9\u001b[11G\u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97mtest_clamps_day_to_last_day_of_month_non_leap_year\u001b[38;5;236m():  \r\u001b[6C\u001b[1B\u001b[38;5;29m20\u001b[15G\u001b[38;5;24m\"\"\"Jan 31 + 1 month should clamp to Feb 28 in a non-lea\r\u001b[6C\u001b[1B\u001b[38;5;29m  \u001b[11G\u001b[38;5;24mp year.\"\"\"\u001b[38;5;236m                                               \r\u001b[7C\u001b[1B\u001b[38;5;29m1\u001b[15G\u001b[38;5;125massert\u001b[38;5;236m add_months(date(\u