[41.480929, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;5;236m\u001b[2m 10 \u001b[22m \u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97mtest_rolls_over_the_year\u001b[38;5;236m():\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;5;236m\u001b[2m 11 \u001b[22m     \u001b[38;5;125massert\u001b[38;5;236m add_months(date(\u001b[38;5;31m2024\u001b[38;5;236m, \u001b[38;5;31m11\u001b[38;5;236m, \u001b[38;5;31m15\u001b[38;5;236m), \u001b[38;5;31m3\u001b[38;5;236m) == date(\u001b[38;5;31m2025\u001b[38;5;236m, \r\u001b[5C\u001b[1B\u001b[2m    \u001b[22m \u001b[38;5;31m2\u001b[38;5;236m, \u001b[38;5;31m15\u001b[38;5;236m)\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;29m\u001b[48;5;194m 12 +\u001b[38;5;236m                                                           \u001b[71G\u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;29m\u001b[48;5;194m 13 +\u001b[38;5;236m                                                           \u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;29m\u001b[48;5;194m 14 +\u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97mtest_clamps_day_to_last_day_of_month_leap_year\u001b[38;5;236m():      \u001b[39m\u001b[49m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;29m\u001b[48;5;194m 15 +\u001b[38;5;236m    \u001b[38;5;24m\"\"\"Jan 31 + 1 month should clamp to Feb 29 in a leap ye\r\u001b[5C\u001b[1B\u001b[38;5;29m    +\u001b[38;5;24mar.\"\"\"\u001b[38;5;236m                                                     \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[38;5;29m\u001b[48;5;194m 16 +\u001b[38;5;236m    \u001b[38;5;125massert\u001b[38;5;236m add_months(date(\u001b[38;5;31m2024\u001b[38;5;236m, \u001b[38;5;31m1\u001b[38;5;236m, \u001b[38;5;31m31\u001b[38;5;236m), \u001b[38;5;31m1\u001b[38;5;236m) == date(\u001b[38;5;31m2024\u001b[38;5;236m, \u001b[38;5;31m2\r\u001b[2C\u001b[1B\u001b[39m\u001b[49m   \u001b[38;5;29m\u001b[48;5;194m    +\u001b[38;5;236m, \u001b[38;5;31m29\u001b[38;5;236m)                                                      \r\u001b