diff --git a/app/dates.py b/app/dates.py
index 7b72e74..8aede2e 100644
--- a/app/dates.py
+++ b/app/dates.py
@@ -1,9 +1,17 @@
 """Calendar helpers for billing renewals."""
 
+import calendar
 from datetime import date
 
 
 def add_months(d: date, months: int) -> date:
     """Return the date `months` calendar months after `d` (negative goes back), same day of month."""
     y, m = divmod(d.month - 1 + months, 12)
-    return d.replace(year=d.year + y, month=m + 1)
+    target_year = d.year + y
+    target_month = m + 1
+
+    # Clamp day to the last day of the target month
+    last_day = calendar.monthrange(target_year, target_month)[1]
+    target_day = min(d.day, last_day)
+
+    return date(target_year, target_month, target_day)
diff --git a/tests/test_dates.py b/tests/test_dates.py
index 0cd5fac..c78de02 100644
--- a/tests/test_dates.py
+++ b/tests/test_dates.py
@@ -9,3 +9,18 @@ def test_next_month_same_day():
 
 def test_rolls_over_the_year():
     assert add_months(date(2024, 11, 15), 3) == date(2025, 2, 15)
+
+
+def test_clamps_day_to_last_day_of_month_leap_year():
+    """Jan 31 + 1 month should clamp to Feb 29 in a leap year."""
+    assert add_months(date(2024, 1, 31), 1) == date(2024, 2, 29)
+
+
+def test_clamps_day_to_last_day_of_month_non_leap_year():
+    """Jan 31 + 1 month should clamp to Feb 28 in a non-leap year."""
+    assert add_months(date(2023, 1, 31), 1) == date(2023, 2, 28)
+
+
+def test_clamps_day_to_last_day_of_30_day_month():
+    """Mar 31 + 1 month should clamp to Apr 30."""
+    assert add_months(date(2024, 3, 31), 1) == date(2024, 4, 30)
