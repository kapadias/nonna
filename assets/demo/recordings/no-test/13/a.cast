[58.831791, "o", "\u001b[H\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mAdded \u001b[1m7\u001b[22m lines, removed \u001b[1m1\u001b[22m line\r\u001b[1B     \u001b[38;5;236m\u001b[2m  1 \u001b[22m \u001b[38;5;24m\"\"\"Calendar helpers for billing renewals.\"\"\"\u001b[39m\u001b[K\r\u001b[3C\u001b[1B  \u001b[38;5;236m\u001b[2m  2 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  3 +\u001b[38;5;125mfrom\u001b[38;5;236m calendar \u001b[38;5;125mimport\u001b[38;5;236m monthrange                            \r\u001b[3C\u001b[1B\u001b[39m\u001b[49m  \u001b[38;5;236m\u001b[2m  4 \u001b[22m \u001b[38;5;125mfrom\u001b[38;5;236m datetime \u001b[38;5;125mimport\u001b[38;5;236m date\r\u001b[5C\u001b[1B\u001b[2m  5 \u001b[22m \r\u001b[3C\u001b[1B\u001b[39m  \u001b[38;5;236m\u001b[2m  6 \u001b[22m \u001b[39m\u001b[K\r\u001b[3C\u001b[1B  \u001b[38;5;236m\u001b[2m  7 \u001b[22m \u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97madd_months\u001b[38;5;236m(\u001b[38;5;31md: date, months: int\u001b[38;5;236m) -> date:\r\u001b[3C\u001b[1B\u001b[39m  \u001b[38;5;236m\u001b[2m  8 \u001b[22m     \u001b[38;5;24m\"\"\"Return the date `months` calendar months after `d` (\r\u001b[3C\u001b[1B\u001b[39m  \u001b[38;5;236m\u001b[2m    \u001b[22m \u001b[38;5;24mnegative goes back), same day of month.\"\"\"\u001b[39m\u001b[K\r\u001b[3C\u001b[1B  \u001b[38;5;236m\u001b[2m  9 \u001b[22m     y, m = \u001b[38;5;31mdivmod\u001b[38;5;236m(d.month - \u001b[38;5;31m1\u001b[38;5;236m + months, \u001b[38;5;31m12\u001b[38;5;236m)\r\u001b[3C\u001b[1B\u001b[39m  \u001b[38;5;160m\u001b[48;5;224m  9 -\u001b[38;5;236m    return d.replace(year=d.year + y, month=m + 1)         \u001b[49m\u001b[39m\u001b[K\r\u001b[3C\u001b[1B  \u001b[38;5;29m\u001b[48;5;194m 10 +\u001b[38;5;236m    target_year = d.year + y                               \r\u001b[3C\u001b[1B\u001b[49m\u001b[39m  \u001b[38;5;29m\u001b[48;5;194m 11 +\u001b[38;5;236m    target_month = m + \u001b[38;5;31m1\u001b[38;5;236m                                   \u001b[39m\u001b[49m\u001b[K\r\u001b[3C\u001b[1B  \u001b[38;5;29m\u001b[48;5;194m 12 +\u001b[38;5;236m    \u001b[38;5;246m# Clamp day to the last valid day of the target month\u001b[38;5;236m  \r\u001b[5C\u001b[1B\u001b[38;5;29m 13 +\u001b[38;5;236m    last_day = monthrange(target_year, target_month)[\u001b[38;5;31m1\u001b[38;5;236m]    \r\u001b[3C\u001b[1B\u001b[39m\u001b[49m  \u001b[38;5;29m\u001b[48;5;194m 14 +\u001b[38;5;236m    target_day = \u001b[38;5;31mmin\u001b[38;5;236m(d.day, last_day)                      \r\u001b[5C\u001b[1B\u001b[38;5;29m 15 +\u001b[38;5;236m    \u001b[38;5;125mreturn\u001b[38;5;236m date(target_year, target_month, target_day)     \r\u001b[2B\u001b[49m\u001b[38;5;16m●\u001b[3G\u001b[39mFixed.\u001b[10GThe\u001b[14G\u001b[38;5;105madd_months\u001b[25G\u001b[39mfunction\u001b[34Gnow\u001b[38Gclamps\u001b[45Gthe\u001b[49Gday\u001b[53Gto\u001b[56Gthe\u001b[60Glast\u001b[65Gvalid\u001b[71Gday\u001b[75Gof\r\u001b[2C\u001b[1Bthe\u001b[7Gtarget\u001b[14Gmonth\u001b[20Gusing\u001b[26G\u001b[38;5;105mcalendar.monthrange()\u001b[39m.\u001b[49GSo\u001b[52G\u001b[38;5;105madd_months(date(2024, 1,\r\u001b[2C\u001b[1B31), 1)\u001b[11G\u001b[39mwill\u001b[16Gcorrectly\u001b[26Greturn\u001b[33G\u001b[38;5;105mdate(2024, 2, 29)\u001b[51G\u001b[39minstead\u001b[59Gof\u001b[62Gcrashing.\r\u001b[2B\u001b[38;5;241m✻\u001b[3GCrunched for 9s · done 6:16 PM\r\u001b[2B\u001b[38;5;246m────────────────────────────────────────────────────────────────────────────\r\u001b[1B\u001b[39m❯ \r\u001b[1B\u001b[38;5;246m────────────────────────────────────────────────────────────────────────────\r\u001b[2C\u001b[1B\u001b[38;5;129m⏵⏵ accept edits on\u001b[38;5;241m (shift+tab to cycle) · ← for agents\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
