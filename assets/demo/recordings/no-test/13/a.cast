       \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 10 +\u001b[38;5;236m    target_year = d.year + y                               \r\u001b[5C\u001b[1B\u001b[38;5;29m 11 +\u001b[38;5;236m    target_month = m + \u001b[38;5;31m1\u001b[38;5;236m                                   \r\u001b[5C\u001b[1B\u001b[38;5;29m 12 +\u001b[38;5;236m    \u001b[38;5;246m# Clamp day to the last valid day of the target month\u001b[38;5;236m  \r\u001b[5C\u001b[1B\u001b[38;5;29m 13 +\u001b[38;5;236m    last_day = monthrange(target_year, target_month)[\u001b[38;5;31m1\u001b[38;5;236m]    \r\u001b[5C\u001b[1B\u001b[38;5;29m 14 +\u001b[38;5;236m    target_day = \u001b[38;5;31mmin\u001b[38;5;236m(d.day, last_day)                      \r\u001b[5C\u001b[1B\u001b[38;5;29m 15 +\u001b[38;5;236m    \u001b[38;5;125mreturn\u001b[38;5;236m date(target_year, target_month, target_day)     \u001b[39m\u001b[49m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
