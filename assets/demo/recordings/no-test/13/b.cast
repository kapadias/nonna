[37.069805, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[22BDone!\u001b[9GI've\u001b[14Gfixed\u001b[20Gthe\u001b[24G\u001b[38;5;105madd_months\u001b[35G\u001b[39mfunction\u001b[44Gto\u001b[47Gclamp\u001b[53Gto\u001b[56Gthe\u001b[60Glast\u001b[65Gvalid\u001b[71Gday\u001b[75Gof\r\u001b[2C\u001b[1Bthe\u001b[7Gtarget\u001b[14Gmonth.\r\u001b[1B\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[37.18946, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[38;5;236m\u001b[2m7\u001b[11G\u001b[22m\u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97madd_months\u001b[38;5;236m(\u001b[38;5;31md: date, months: int\u001b[38;5;236m) -> date:\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  7 -\u001b[38;5;236m    \"\"\"Return the date `months` calendar months after `d` (\r\u001b[5C\u001b[1B\u001b[38;5;160m    -\u001b[38;5;236mnegative goes back), same day of month.\"\"\"                 \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  8 +\u001b[38;5;236m    \u001b[38;5;24m\"\"\"Return the date `months` calendar months after `d` (\r\u001b[5C\u001b[1B\u001b[38;5;29m    +\u001b[38;5;24mnegative goes back), same day of month.\u001b[38;5;236m                    \r\u001b[5C\u001b[1B\u001b[38;5;29m  9 +\u001b[38;5;236m                                                           \r\u001b[6C\u001b[1B\u001b[38;5;29m10\u001b[15G\u001b[38;5;236mIf the day doesn\u001b[38;5;24m't\u001b[34Gexis\u001b[39G in\u001b[43Gthe target month, clamps to\r\u001b[10C\u001b[1B the last day\u001b[25Gof that month.\u001b[38;5;236m           \r\u001b[6C\u001b[1B\u001b[38;5;29m11\u001b[15G\u001b[38;5;24m\"\"\"\u001b[38;5;236m                                                    \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 12 \u001b[22m     y, m = \u001b[38;5;31mdivmod\u001b[38;5;236m(d.month - \u001b[38;5;31m1\u001b[38;5;236m + months, \u001b[38;5;31m12\u001b[38;5;236m)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  9 -\u001b[38;5;236m    return d.replace(year=d.year + y, month=m + 1)         \r\u001b[7C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m3\u001b[15G\u001b[38;5;236mnew_year = d.year + y                                  \r\u001b[5C\u001b[1B\u001b[38;5;29m 14 +\u001b[38;5;236m    new_month = m + \u001b[38;5;31m1\u001b[38;5;236m                                      \r\u001b[5C\u001b[1B\u001b[38;5;29m 15 +\u001b[38;5;236m    max_day = calendar.monthrange(new_year, new_month)[\u001b[38;5;31m1\u001b[38;5;236m]  \r\u001b[7C\u001b[1B\u001b[38;5;29m6\u001b[19G\u001b[38;5;236mday = \u001b[38;5;31mmin\u001b[38;5;236m(d.day, max_day)                          \r\u001b[7C\u001b[1B\u001b[38;5;29m7\u001b[15G\u001b[38;5;125mreturn\u001b[38;5;236m date(new_year,\u001b[37Gnew_month,\u001b[48Gnew_day)\r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m3\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mDone!\u001b[9GI've\u001b[14Gfixed\u001b[20Gthe\u001b[24G\u001b[38;5;105madd_months\u001b[35G\u001b[39mfunction\u001b[44Gto\u001b[47Gclamp\u001b[53Gto\u001b[56Gthe\u001b[60Glast\u001b[65Gvalid\u001b[71Gday\u001b[75Gof\r\u001b[2C\u001b[1Bthe target month.\u001b[K\r\u001b[2B \u001b[3G\u001b[1mChanges made:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[37.295234, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;5;160m\u001b[48;5;224m  7 -\u001b[38;5;236m    \"\"\"Return the date `months` calendar months after `d` (\r\u001b[7C\u001b[1B\u001b[38;5;160m \u001b[11G\u001b[38;5;236mnegative goes\u001b[25Gback), same day of month.\"\"\"     \u001b[59G     \u001b[65G   \u001b[69G \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  8 +\u001b[38;5;236m    \u001b[38;5;24m\"\"\"Return the date `months` calendar months after `d` (\r\u001b[7C\u001b[1B\u001b[38;5;29m \u001b[11G\u001b[38;5;24mnegative goes back), same day of month.\u001b[38;5;236m                    \r\u001b[7C\u001b[1B\u001b[38;5;29m9\u001b[11G\u001b[38;5;236m                                                           \r\u001b[6C\u001b[1B\u001b[38;5;29m10\u001b[15G\u001b[38;5;236mIf\u001b[18Gthe\u001b[22Gday\u001b[26Gdoesn\u001b[38;5;24m't exist in the target month, clamps to\r\u001b[6C\u001b[1B\u001b[38;5;29m  \u001b[11G\u001b[38;5;24m the last day of that month.\u001b[38;5;236m                               \r\u001b[6C\u001b[1B\u001b[38;5;29m11\u001b[11G\u001b[38;5;236m    \u001b[38;5;24m\"\"\"\u001b[38;5;236m                     \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 12 \u001b[22m     y, m = \u001b[38;5;31mdivmod\u001b[38;5;236m(d.month - \u001b[38;5;31m1\u001b[38;5;236m + months, \u001b[38;5;31m12\u001b[38;5;236m)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  9 -\u001b[38;5;236m    return d.replace(year=d.year + y, month=m + 1)         \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 13 +\u001b[38;5;236m    new_year = d.year + y                                  \r\u001b[7C\u001b[1B\u001b[38;5;29m4\u001b[19G\u001b[38;5;236mmonth = m + \u001b[38;5;31m1\u001b[38;5;236m                                      \r\u001b[7C\u001b[1B\u001b[38;5;29m5\u001b[15G\u001b[38;5;236mmax\u001b[19Gday =\u001b[25Gcalendar.monthrange(new_year, new_month)[\u001b[38;5;31m1\u001b[38;5;236m]\r\u001b[7C\u001b[1B\u001b[38;5;29m6\u001b[15G\u001b[38;5;236mnew\u001b[25G\u001b[38;5;31mmin\u001b[38;5;236m(d.day, max_day)                        \r\u001b[7C\u001b[1B\u001b[38;5;29m7\u001b[15G\u001b[38;5;125mreturn\u001b[38;5;236m date(new_year, new_month,\u001b[48Gnew_day)\r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m3\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mDone!\u001b[9GI've\u001b[14Gfixed\u001b[20Gthe\u001b[24G\u001b[38;5;105madd_months\u001b[35G\u001b[39mfunction\u001b[44Gto\u001b[47Gclamp\u001b[53Gto\u001b[56Gthe\u001b[60Glast\u001b[65Gvalid\u001b[71Gday\u001b[75Gof\r\u001b[1B \u001b[3Gthe target\u001b[14Gmonth.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mChanges made:\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GAdded\u001b[11Ga\u001b[13Gtest\u001b[18Gcase\u001b[23Gthat\u001b[28Gfails\u001b[34Gbefore\u001b[41Gthe\u001b[45Gfix\u001b[49Gand\u001b[53Gpasses\u001b[60Gafter\u001b[30;1H\u001b[28;3H\u001b[?25h"]
