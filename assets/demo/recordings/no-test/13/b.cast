nds \u001b[39m\u001b[K\r\u001b[2B\u001b[38;5;16m●\u001b[3G\u001b[39mDone! I've fixed the \u001b[38;5;105madd_months\u001b[35G\u001b[39mfunction\u001b[44Gto\u001b[47Gclamp\u001b[53Gto\u001b[56Gthe\u001b[60Glast\u001b[65Gvalid\u001b[71Gday\u001b[75Gof\r\u001b[2C\u001b[1Bthe\u001b[7Gtarget\u001b[14Gmonth.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mChanges made:\u001b[22m\u001b[K\r\u001b[2C\u001b[2B- Added a test\u001b[18Gcase\u001b[23Gthat\u001b[28Gfails\u001b[34Gbefore\u001b[41Gthe\u001b[45Gfix\u001b[49Gand\u001b[53Gpasses\u001b[60Gafter\r\u001b[2C\u001b[1B-\u001b[5GFixed\u001b[11G\u001b[38;5;105madd_months()\u001b[24G\u001b[39mto\u001b[27Guse\u001b[31G\u001b[38;5;105mcalendar.monthrange()\u001b[53G\u001b[39mto\u001b[56Gget\u001b[60Gthe\u001b[64Gmax\u001b[68Gday\u001b[72Gin\r\u001b[2C\u001b[1B \u001b[5Gthe target month,\u001b[25Gen\u001b[28Gclamp\u001b[34Gthe day if\u001b[45Gneeded\u001b[K\r\u001b[4C\u001b[1B\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
