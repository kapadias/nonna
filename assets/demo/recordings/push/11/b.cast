[89.609051, "o", "\u001b[?25l\u001b[H\u001b[38;5;241m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m4\u001b[14G\u001b[22mlines\r\u001b[1B     \u001b[38;5;236m\u001b[2m 3 \u001b[22m \u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m4\u001b[10G\u001b[22m\u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97mtest_slugify_simple\u001b[38;5;236m():\r\u001b[6C\u001b[1B\u001b[2m5\u001b[10G\u001b[22m   \u001b[14G\u001b[38;5;125massert\u001b[38;5;236m slugify(\u001b[38;5;24m\"hello\"\u001b[38;5;236m) == \u001b[38;5;24m\"hello\"\r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 6 +\u001b[38;5;236m                                                            \r\u001b[6C\u001b[1B\u001b[38;5;29m7\r\u001b[6C\u001b[1B8\u001b[10G\u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97mtest_slugify_with_punctuation_and_spaces\u001b[38;5;236m():             \r\u001b[6C\u001b[1B\u001b[38;5;29m9\u001b[10G\u001b[38;5;236m    \u001b[38;5;125massert\u001b[38;5;236m slugify(\u001b[38;5;24m\"Hello, World!\"\u001b[38;5;236m) == \u001b[38;5;24m\"hello-world\"\r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mCommitted \u001b[1m050d8a3\u001b[22m, pushed to \u001b[1mfix/slugify-double-dashes\u001b[22m \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow\u001b[7GI'll\u001b[12Gverify\u001b[19Gall\u001b[23Gtests\u001b[29Gpass:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mPerfect!\u001b[12GAdded\u001b[18Ga\u001b[20Gtest\u001b[25Gthat\u001b[30Gverifies\u001b[39Gthe\u001b[43Gfix\u001b[47Ghandles\u001b[55Gpunctuation\u001b[67Gand\u001b[71Gspaces\r\u001b[1B \u001b[3Gco\u001b[6Gr\u001b[10Gly. The\u001b[18Gtest \u001b[38;5;105mtest_slugify_with_punctuation_and_spaces\u001b[39m would fail\u001b[K\r\u001b[2C\u001b[1Bwith the old implementation (returning \"hello--world-\") and passes\u001b[70Gwith\r\u001b[2C\u001b[1