[26.514249, "o", "\u001b[?25l\u001b[H\u001b[3Gch\u001b[6Gracter ind\u001b[17Gvidu\u001b[22Glly with a\u001b[33Gdash, creating\u001b[48Gconsecutive\u001b[60Gdashes\u001b[67Gand\r\u001b[2C\u001b[1Bleaving trailing da\u001b[23Ghes. I'll fix this to:\u001b[K\r\u001b[2C\u001b[1B1\u001b[6GReplace sequences\u001b[25Gf\u001b[27Gnon-alphanumeric\u001b[44Gcharacters\u001b[55Gwith\u001b[60Ga\u001b[62Gsingle\u001b[69Gdash\r\u001b[2C\u001b[1B2.\u001b[6GStrip\u001b[12Gany\u001b[16Gleading\u001b[24Gor\u001b[27Gtrailing\u001b[36Gdashes\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;65m●\u001b[39m \u001b[1mUpdate\u001b[22m(\u001b]8;id=whidul;file:///root/b/site/app/text.py\u0007app/text.py\u001b]8;;\u0007)\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m1\u001b[14G\u001b[22mline,\u001b[20Gremoved\u001b[28G\u001b[1m1\u001b[30G\u001b[22mline\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m5\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m6\u001b[10G\u001b[22m\u001b[38;5;125mdef\u001b[14G\u001b[38;5;97mslugify\u001b[38;5;236m(\u001b[38;5;31mtitle: str\u001b[38;5;236m) -> \u001b[38;5;31mstr\u001b[38;5;236m:\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m7\u001b[10G\u001b[22m    \u001b[38;5;24m\"\"\"Turn a title into a URL slug: 'Hello, World!' -> 'hel\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m   \u001b[22m \u001b[38;5;24mlo-world'.\"\"\"\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m 8 -\u001b[38;5;236m    return re.sub(r\"[^a-z0-9]\", \"-\", title.lower())         \r\u001b[6C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m8\u001b[10G\u001b[38;5;236m   \u001b[14G\u001b[38;5;125mreturn\u001b[38;5;236m re.sub(\u001b[38;5;24mr\"[^a-z0-9]\u001b[48;5;157m+\u001b[48;5;194m\"\u001b[38;5;236m, \u001b[38;5;24m\"-\"\u001b[38;5;236m, title.lower())\u001b[48;5;157m.strip(\u001b[38;5;24m\"\r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m   +\u001b[38;5;24m\u001b[48;5;157m-\"\u001b[38;5;236m)\u001b[48;5;194m           