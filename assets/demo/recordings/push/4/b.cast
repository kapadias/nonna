n\u001b[38;5;236m():                \u001b[39m\u001b[49m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;29m\u001b[48;5;194m 13 +\u001b[38;5;236m    \u001b[38;5;125massert\u001b[38;5;236m slugify(\u001b[38;5;24m\"Hello... World!!!\"\u001b[38;5;236m) == \u001b[38;5;24m\"hello-world\"\u001b[38;5;236m   \r\u001b[5C\u001b[1B\u001b[38;5;29m 14 +\u001b[38;5;236m                                                           \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;5;29m\u001b[48;5;194m 15 +\u001b[38;5;236m                                                           \r\u001b[5C\u001b[1B\u001b[38;5;29m 16 +\u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97mtest_slugify_leading_trailing_punctuation\u001b[38;5;236m():           \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[38;5;29m\u001b[48;5;194m 17 +\u001b[38;5;236m    \u001b[38;5;125massert\u001b[38;5;236m slugify(\u001b[38;5;24m\"...hello world...\"\u001b[38;5;236m) == \u001b[38;5;24m\"hello-world\"\u001b[38;5;236m   \r\u001b[31C\u001b[2B\u001b[49m\u001b[38;5;241m · \u001b[38;5;248mthinking\u001b[38;5;241m)\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
