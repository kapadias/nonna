[45.270961, "o", "\u001b[?25l\u001b[H\u001b[3G1\u001b[6GRep\u001b[11Gces non-alphanumeric charac\u001b[39Ger\u001b[42G with\u001b[48Ghyphens\r\u001b[2C\u001b[1B2\u001b[6GCollapses co\u001b[20Gecutive hyphen\u001b[36Ginto\u001b[41Gsingle\u001b[48Gones\r\u001b[2C\u001b[1B3.\u001b[6GStrips\u001b[13Ghyphens\u001b[21Gfrom\u001b[26Gboth\u001b[31Gends\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BVerification: \u001b[38;5;105ms\u001b[19Gugify(\"Hello, World!\")\u001b[39m now correctly returns \u001b[38;5;105m\"hello-world\"\r\u001b[2C\u001b[1B\u001b[39minstead of \u001b[38;5;105m\"hello--world-\"\u001b[39m. All tests\u001b[41Gpass,\u001b[47Gand\u001b[51Gthe\u001b[55Gchanges\u001b[63Gare\u001b[67Gpushed\u001b[74Gto\r\u001b[2C\u001b[1Bthe\u001b[7G\u001b[38;5;105mfix/slugify-function\u001b[28G\u001b[39mbranch.\r\u001b[1B\u001b[K\r\u001b[1B●\u001b[3GRan \u001b[1m1\u001b[22m stop hook\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241m⎿  \u001b[39mStop ho\u001b[14Gk \u001b[17Grror: ✗ Nonna:\u001b[32Gwhere's\u001b[40Gthe\u001b[44Gtest?\u001b[50G(stop:\u001b[57Gcode\r\u001b[2C\u001b[1Bchanged, no test changed)\u001b[K\r\u001b[2C\u001b[1BAdd a t\u001b[11Gst that fai\u001b[23Gs\u001b[26Githout your cha\u001b[42Gg\u001b[44G and passes\u001b[56Gwith\u001b[61Git,\u001b[65Gor\r\u001b[2C\u001b[1Btell\u001b[8Gthe\u001b[12Guser\u001b[17Gplainly\u001b[25Gwhy\u001b[29Gthis\u001b[34Gchange\u001b[41Gneeds\u001b[47Gnone.\r\u001b[2B\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mYou're right! I\u001b[19Gneed to\u001b[27Gadd a test that\u001b[43Gdemonstrates\u001b[56Gthe\u001b[60Gbug\u001b[64Gfix.\u001b[69GLet\u001b[73Gme\r\u001b[2C\u001b[1Badd\u001b[7Ga\u001b[9Gtest\u001b[14Gcase\u001b[19Gfor\u001b[23Gthe\u001b[27Gspecific\u001b[36Gissue:\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;5;241mRead \u001b[1m1\u001b[22m fil\u001b[14G \u001b[39m\u001b[K\r\u001b[2C\u001b[4B\u001b[38;5;216mMisting…\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
