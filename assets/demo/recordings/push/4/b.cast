[23.882771, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mI\u001b[5Gcan\u001b[9Gsee\u001b[13Gthe\u001b[17Gissue.\u001b[24GThe\u001b[28Gregex\u001b[34G\u001b[38;5;105m[^a-z0-9]\u001b[44G\u001b[39mreplaces\u001b[53Gevery\u001b[59Gnon-alphanumeric\r\u001b[1B  character with a hyphen, so \"Hello, World!\" becomes \"hello--world-\" (the\u001b[K\r\u001b[1B  comma becomes a hyphen, and the exclamation mark becomes a trailing\u001b[K\r\u001b[2C\u001b[1Bhyphen).\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1BLet me check if \u001b[20Ghere are\u001b[29Gtests\u001b[35Gfor\u001b[39Gthis\u001b[44Gfunction:\r\u001b[2C\u001b[2B\u001b[38;5;241mS\u001b[6Grched for \u001b[1m1\u001b[22m pattern, read \u001b[1m1\u001b[22m file \r\u001b[2C\u001b[2B\u001b[39mNow I'll fix the \u001b[38;5;105mslugify\u001b[28G\u001b[39mfunction to handl\u001b[46G consecutive\u001b[59Ghyphens \u001b[69Gd\u001b[K\r\u001b[2C\u001b[1Btr\u001b[6Giling hyphens:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;65m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(\u001b]8;id=whidul;file:///root/b/site/app/text.py\u0007app/text.py\u001b]8;;\u0007)\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m3\u001b[14G\u001b[22mlines,\u001b[21Gremoved\u001b[29G\u001b[1m1\u001b[31G\u001b[22mline\r\u001b[2C\u001b[1B   \u001b[38;5;236m\u001b[2m  5 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  6 \u001b[22m \u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97mslugify\u001b[38;5;236m(\u001b[38;5;31mtitle: str\u001b[38;5;236m) -> \u001b[38;5;31mstr\u001b[38;5;236m:\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;5;236m\u001b[2m  7 \u001b[22m     \u001b[38;5;24m\"\"\"Turn a title into a URL slug: 'Hello, World!' -> 'he\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m    \u001b[22m \u001b[38;5;24mllo-world'.\"\"\"\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;160m\u001b[48;5;224m  8 -\u001b[38;5;236m    return re.sub(r\"[^a-z0-9]\", \"-\", title.lower())        \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;5;29m\u001b[48;5;194m  8 +\u001b[38;5;236m    \u001b[48;5;157mslug\u001b[48;5;194m \u001b[48;5;157m= \u001b[48;5;194mre.sub(\u001b[38;5;24mr\"[^a-z0-9]\"\u001b[38;5;236m, \u001b[38;5;24m\"-\"\u001b[38;5;236m, title.lower())        \r\u001b[5C\u001b[1B\u001b[38;5;29m  9 +\u001b[38;5;236m    slug = re.sub(\u001b[38;5;24mr\"-+\"\u001b[38;5;236m, \u001b[38;5;24m\"-\"\u001b[38;5;236m, slug)                        \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[38;5;29m\u001b[48;5;194m 10 +\u001b[38;5;236m    \u001b[38;5;125mreturn\u001b[38;5;236m slug.strip(\u001b[38;5;24m\"-\"\u001b[38;5;236m)                                 \r\u001b[12C\u001b[2B\u001b[49m\u001b[38;5;241m9s · ↓\u001b[39m \u001b[38;5;241m818 \u001b[25Gokens ·\u001b[33G\u001b[38;5;249mthinking\u001b[38;5;241m)\u001b[39m\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
