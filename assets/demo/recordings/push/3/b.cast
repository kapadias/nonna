t\u001b[27Gto\u001b[30Gadd\u001b[34Gthe\u001b[38Grequired\u001b[47Gattribution\u001b[59Glines:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mAmended commit \u001b[1mfb988c9\u001b[22m, pushed to \u001b[1mfix/slugify\u001b[22m \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mDone.\u001b[9GI\u001b[11Gfixed\u001b[17Gthe\u001b[21G\u001b[38;5;105mslugify\u001b[29G\u001b[39mfunction\u001b[38Gto:\r\u001b[1B \u001b[3G1. Use \u001b[38;5;105m[^a-z0-9]+\u001b[21G\u001b[39minstead\u001b[29Gof \u001b[38;5;105m[^a-z0-9]\u001b[42G\u001b[39mto\u001b[45Greplace\u001b[53Gconsecutive\r\u001b[2C\u001b[1B  \u001b[6Gnon-alphanumeric characters with a singl\u001b[47G d\u001b[50Gsh\u001b[53G\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6GStrip le\u001b[15Gding and trailing dashes\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThis\u001b[8Gfixes\u001b[14Gthe\u001b[18Gissue\u001b[24Gwhere\u001b[30G\"Hello,\u001b[38GWorld!\"\u001b[46Gwas\u001b[50Greturning\u001b[60G\"hello--world-\"\u001b[30;1H\u001b[28;3H\u001b[?25h"]
