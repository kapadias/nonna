[24.74224, "o", "\u001b[?25l\u001b[H\u001b[K\r\u001b[1B\u001b[48;5;255m\u001b[38;5;248m❯ \u001b[38;5;16mslugify(\"Hello, World!\") in app/text.py ret\u001b[47Grns \"hello--world-\" instead \r\u001b[1B\u001b[39m  \u001b[38;5;16mof \"hello-world\". Fix it, then commit and push it.\u001b[39m                        \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRead \u001b[1m1\u001b[22m file \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mI can s\u001b[11Ge\u001b[13Gthe iss\u001b[21Ge. The regex \u001b[38;5;105m[^a-z0-9]\u001b[39m replaces e\u001b[56Gry non-alphanumer\u001b[74Gc\u001b[K\r\u001b[2C\u001b[1Bcharacter\u001b[13Gindividually with \"-\",\u001b[36Gcreating consecutive dashes and trail\u001b[74Gng\r\u001b[2C\u001b[1Bdashes. I need to\u001b[21Guse \u001b[38;5;105m[^a-z0-9]+\u001b[39m to\u001b[39Greplace consecutive \u001b[60Gon-\u001b[64Glphanumeric\r\u001b[2C\u001b[1Bcharacters\u001b[14Gwith\u001b[19Ga\u001b[21Gsingle\u001b[28Gdash,\u001b[34Gthen\u001b[39Gstrip\u001b[45Gleading/trailing\u001b[62Gdashes.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;65m●\u001b[39m \u001b[1mUpdate\u001b[22m(\u001b]8;id=whidul;file:///root/b/site/app/text.py\u0007app/text.py\u001b]8;;\u0007)\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m2\u001b[14G\u001b[22mlines,\u001b[21Gremoved\u001b[29G\u001b[1m1\u001b[31G\u001b[22mline\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m5\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m6\u001b[10G\u001b[22m\u001b[38;5;125mdef\u001b[14G\u001b[38;5;97mslugify\u001b[38;5;236m(\u001b[38;5;31mtitle: str\u001b[38;5;236m) -> \u001b[38;5;31mstr\u001b[38;5;236m:\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m7\u001b[10G\u001b[22m    \u001b[38;5;24m\"\"\"Turn a title into a URL slug: 'Hello, World!' -> 'hel\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m   \u001b[22m \u001b[38;5;24mlo-world'.\"\"\"\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001