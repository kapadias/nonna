\u001b[38;5;236m, title.lower())        \r\u001b[5C\u001b[1B\u001b[38;5;29m 9 +\u001b[38;5;236m    \u001b[38;5;125mreturn\u001b[38;5;236m slug.strip(\u001b[38;5;24m\"-\"\u001b[38;5;236m)                                  \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2B\u001b[38;5;16m●\u001b[3G\u001b[39mI need to work on a branch\u001b[30Ginstead\u001b[38Gof\u001b[41Gmain.\u001b[47GLet\u001b[51Gme\u001b[54Gcreate\u001b[61Gone.\r\u001b[2B\u001b[38;5;241m \u001b[3G\u001b[39mRunning\u001b[11G\u001b[1m1\u001b[13G\u001b[22mshell\u001b[19Gcommand…\u001b[30;1H\u001b[28;3H\u001b[?25h"]
