 -> 'hel\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m   \u001b[22m \u001b[38;5;24mlo-world'.\"\"\"\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m 8 -\u001b[38;5;236m    return re.sub(r\"[^a-z0-9]\", \"-\", title.lower())         \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 8 +\u001b[38;5;236m    \u001b[48;5;157mslug\u001b[48;5;194m \u001b[48;5;157m= \u001b[48;5;194mre.sub(\u001b[38;5;24mr\"[^a-z0-9]\u001b[48;5;157m+\u001b[48;5;194m\"\u001b[38;5;236m, \u001b[38;5;24m\"-\"\u001b[38;5;236m, title.lower())        \r\u001b[5C\u001b[1B\u001b[38;5;29m 9 +\u001b[38;5;236m    \u001b[38;5;125mreturn\u001b[38;5;236m slug.strip(\u001b[38;5;24m\"-\"\u001b[38;5;236m)                                  \r\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[1B\u001b[38;5;174m✢\u001b[3G\u001b[38;5;216mMeandering…\u001b[38;5;174m \u001b[38;5;241m(6s · ↓\u001b[23G559 tokens · thought for 3s)\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
