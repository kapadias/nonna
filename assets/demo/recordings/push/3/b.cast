[37.042891, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mI can see the issue.\u001b[24GThe\u001b[28Gregex\u001b[34G\u001b[38;5;105m[^a-z0-9]\u001b[44G\u001b[39mreplaces\u001b[53Gevery\u001b[59Gnon-alphanumeric\r\u001b[1B  character individually with\u001b[31G\"-\",\u001b[36Gcreating\u001b[45Gconsecutive\u001b[57Gdashes\u001b[64Gand\u001b[68Gtrailing\r\u001b[2C\u001b[1Bdashes.\u001b[11GI\u001b[13Gneed\u001b[18Gto\u001b[21Guse\u001b[25G\u001b[38;5;105m[^a-z0-9]+\u001b[36G\u001b[39mto\u001b[39Greplace\u001b[47Gconsecutive\u001b[59Gnon-alphanumeric\r\u001b[2C\u001b[1Bcharacters with a single dash, then strip\u001b[45Gleading/trailing\u001b[62Gdashes.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;65m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(\u001b]8;id=whidul;file:///root/b/site/app/text.py\u0007app/text.py\u001b]8;;\u0007)\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mAdded \u001b[1m2\u001b[22m lines, removed \u001b[1m1\u001b[22m line\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 5 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 6 \u001b[22m \u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97mslugify\u001b[38;5;236m(\u001b[38;5;31mtitle: str\u001b[38;5;236m) -> \u001b[38;5;31mstr\u001b[38;5;236m:\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m 7 \u001b[22m     \u001b[38;5;24m\"\"\"Turn a title into a URL slug: 'Hello, World!' -> 'hel\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;5;236m\u001b[2m   \u001b[22m \u001b[38;5;24mlo-world'.\"\"\"\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m 8 -\u001b[38;5;236m    return re.sub(r\"[^a-z0-9]\", \"-\", title.lower())         \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G \u001b[5G \u001b[38;5;29m\u001b[48;5;194m 8 +\u001b[38;5;236m    \u001b[48;5;157mslug\u001b[48;5;194m \u001b[48;5;157m= \u001b[48;5;194mre.sub(\u001b[38;5;24mr\"[^a-z0-9]\u001b[48;5;157m+\u001b[48;5;194m\"\u001b[38;5;236m, \u001b[38;5;24m\"-\"\u001b[38;5;236m, title.lower())        \r\u001b[5C\u001b[1B\u001b[38;5;29m 9 +\u001b[38;5;236m    \u001b[38;5;125mreturn\u001b[38;5;236m slug.strip(\u001b[38;5;24m\"-\"\u001b[38;5;236m)                                  \r\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[1B  \u001b[38;5;241mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mI\u001b[5Gneed to work on a branch instead of main. Let me create one.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mCommitted \u001b[1m42fc68c\u001b[22m, ran \u001b[1m1\u001b[22m \u001b[29Ghell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[6G\u001b[39m\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[37.11677, "o", "\u001b[?25l\u001b[H\u001b[3Gcharacter\u001b[13Gindividually\u001b[26Gwith\u001b[31G\"-\",\u001b[36Gcreating\u001b[45Gconsecutive\u001b[57Gdashes\u001b[64Gand\u001b[68Gtrailing\r\u001b[1B \u001b[3Gdashes. I\u001b[13Gne\u001b[16Gd to use \u001b[38;5;105m[^a-z0-9]+\u001b[39m to replac\u001b[46G consecutive\r\u001b[11C\u001b[1Bs with a single dash, then s\u001b[41Grip\u001b[45Gleading/trailing dashes.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;65m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(\u001b]8;id=whidul;file:///root/b/site/app/text.py\u0007app/text.py\u001b]8;;\u0007)\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m2\u001b[14G\u001b[22mlines,\u001b[21Gremoved\u001b[29G\u001b[1m1\u001b[31G\u001b[22mline\r\u001b[1B \u001b[3G   \u001b[38;5;236m\u001b[2m 5 \u001b[22m \u001b[39m\u001b[K\r\u001b[1B     \u001b[38;5;236m\u001b[2m 6 \u001b[22m \u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97mslugify\u001b[38;5;236m(\u001b[38;5;31mtitle: str\u001b[38;5;236m) -> \u001b[38;5;31mstr\u001b[38;5;236m:\r\u001b[6C\u001b[1B\u001b[2m7\u001b[10G\u001b[22m    \u001b[38;5;24m\"\"\"Turn a title into a URL slug: 'Hello, World!' -> 'hel\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m \u001b[10G\u001b[22m\u001b[38;5;24mlo-world'.\"\"\"\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m 8 -\u001b[38;5;236m    return re.sub(r\"[^a-z0-9]\", \"-\", title.lower())         \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 8 +\u001b[38;5;236m    \u001b[48;5;157mslug\u001b[48;5;194m \u001b[48;5;157m= \u001b[48;5;194mre.sub(\u001b[38;5;24mr\"[^a-z0-9]\u001b[48;5;157m+\u001b[48;5;194m\"\u001b[38;5;236m, \u001b[38;5;24m\"-\"\u001b[38;5;236m, title.lower())        \r\u001b[5C\u001b[1B\u001b[38;5;29m 9 +\u001b[38;5;236m    \u001b[38;5;125mreturn\u001b[38;5;236m slug.strip(\u001b[38;5;24m\"-\"\u001b[38;5;236m)                                  \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2B\u001b[38;5;16m●\u001b[3G\u001b[39mI need to work on a branch\u001b[30Ginstead\u001b[38Gof\u001b[41Gmain.\u001b[47GLet\u001b[51Gme\u001b[54Gcreate\u001b[61Gone.\r\u001b[2B \u001b[3G\u001b[38;5;241mCommitted \u001b[1m42fc68c\u001b[22m, ran \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;5;16m●\u001b[3G\u001b[39mLet me amend the commit to add the required\u001b[47Gattribution\u001b[59Glines:\r\u001b[2B\u001b[38;5;241m●\u001b[3G\u001b[39mRunning\u001b[11G\u001b[1m1\u001b[13G\u001b[22mshell\u001b[19Gcommand…\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[37.149764, "o", "\u001b[?25l\u001b[H\r\u001b[12C\u001b[24B\u001b[38;5;216m…\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[37.377367, "o", "\u001b[?25l\u001b[H\r\u001b[24B\u001b[38;5;174m✻\u001b[12G\u001b[38;5;216mg\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
