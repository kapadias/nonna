[25.785995, "o", "\u001b[?25l\u001b[H\u001b[K\r\u001b[1B  Get to finished work\u001b[24Gsooner\u001b[31Gwith\u001b[36GOpus\u001b[41G5.5.\u001b[46GSwitch\u001b[53Ganytime\u001b[61Gwith\u001b[66G\u001b[38;5;105m/model\u001b[39m.\r\u001b[2B\u001b[48;5;255m\u001b[38;5;248m❯ \u001b[38;5;16mslugify(\"Hello, World!\") in app/text.py returns \"hello--world-\" instead \u001b[39m  \r\u001b[1B  \u001b[38;5;16mof \"hello-world\". Fix it, then commit and push it.\u001b[39m                        \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B  \u001b[38;5;241mRead \u001b[1m1\u001b[22m file \u001b[39m\u001b[K\r\u001b[2B\u001b[38;5;65m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(\u001b]8;id=1cz53su;file:///root/a/site/app/text.py\u0007app/text.py\u001b]8;;\u0007)\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m2\u001b[14G\u001b[22mlines,\u001b[21Gremoved\u001b[29G\u001b[1m1\u001b[31G\u001b[22mline\r\u001b[1B \u001b[3G   \u001b[38;5;236m\u001b[2m 5 \u001b[22m \u001b[39m\u001b[K\r\u001b[1B     \u001b[38;5;236m\u001b[2m 6 \u001b[22m \u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97mslugify\u001b[38;5;236m(\u001b[38;5;31mtitle: str\u001b[38;5;236m) -> \u001b[38;5;31mstr\u001b[38;5;236m:\r\u001b[6C\u001b[1B\u001b[2m7\u001b[10G\u001b[22m    \u001b[38;5;24m\"\"\"Turn a title into a URL slug: 'Hello, World!' -> 'hel\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m \u001b[10G\u001b[22m\u001b[38;5;24mlo-world'.\"\"\"\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m 8 -\u001b[38;5;236m    return re.sub(r\"[^a-z0-9]\", \"-\", title.lower())         \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 8 +\u001b[38;5;236m    \u001b[48;5;157mslug\u001b[48;5;194m \u001b[48;5;157m= \u001b[48;5;194mre.sub(\u001b[38;5;24mr\"[^a-z0-9]\u001b[48;5;157m+\u001b[48;5;194m\"\u001b[38;5;236m, \u001b[38;5;24m\"-\"\u001b[38;5;236m, title.lower())        \r\u001b[5C\u001b[1B\u001b[38;5;29m 9 +\u001b[38;5;236m    \u001b[38;5;125mreturn\u001b[38;5;236m slug.strip(\u001b[38;5;24m\"-\"\