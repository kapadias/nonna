[51.009415, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;5;65m●\u001b[39m \u001b[1mUpdate\u001b[22m(\u001b]8;id=whidul;file:///root/b/site/app/text.py\u0007app/text.py\u001b]8;;\u0007)\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m1\u001b[14G\u001b[22mline,\u001b[20Gremoved\u001b[28G\u001b[1m1\u001b[30G\u001b[22mline\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m5\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m6\u001b[10G\u001b[22m\u001b[38;5;125mdef\u001b[14G\u001b[38;5;97mslugify\u001b[38;5;236m(\u001b[38;5;31mtitle: str\u001b[38;5;236m) -> \u001b[38;5;31mstr\u001b[38;5;236m:\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m7\u001b[10G\u001b[22m    \u001b[38;5;24m\"\"\"Turn a title into a URL slug: 'Hello, World!' -> 'hel\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m   \u001b[22m \u001b[38;5;24mlo-world'.\"\"\"\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m 8 -\u001b[38;5;236m    return re.sub(r\"[^a-z0-9]\", \"-\", title.lower())         \r\u001b[6C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m8\u001b[10G\u001b[38;5;236m   \u001b[14G\u001b[38;5;125mreturn\u001b[38;5;236m re.sub(\u001b[38;5;24mr\"[^a-z0-9]\u001b[48;5;157m+\u001b[48;5;194m\"\u001b[38;5;236m, \u001b[38;5;24m\"-\"\u001b[38;5;236m, title.lower())\u001b[48;5;157m.strip(\u001b[38;5;24m\"\r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m   +\u001b[38;5;24m\u001b[48;5;157m-\"\u001b[38;5;236m)\u001b[48;5;194m                                                         \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m5\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mI need\u001b[10Gto\u001b[13Gcreate\u001b[20Ga\u001b[22Gfeature\u001b[30Gbranch\u001b[37Gfirst\u001b[43Gper\u001b[47Gthe\u001b[51Ghouse\u001b[57Grules.\u001b[64GLet\u001b[68Gme\u001b[71Gdo\r\u001b[2C\u001b[1Bthat:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mC\u001b[7Gitted \u001b[1mb1d202c\u001b[22m, pushed to \u001b[1mfix/slugify-consecutive-chars\u001b[22m, ran \u001b[1m1\u001b[22m shell \r\u001b[2C\u001b[1Bcommand \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mDone! I've fi\u001b[17Ged the \u001b[38;5;105mslugify\u001b[39m function a\u001b[43Gd pushed th\u001b[55G changes. The\u001b[69Gbug\u001b[73Gwas\r\u001b[2C\u001b[1Bthat the regex \u001b[38;5;105m[^a-z0-9]\u001b[39m replaced each\u001b[42Gn\u001b[44Gn-\u001b[47Glphanumeric character\u001b[K\r\u001b[2C\u001b[1Bindividually.\u001b[17GFor\u001b[21G\"Hello,\u001b[29GWorld!\",\u001b[38Gthe\u001b[42Gcomma\u001b[48Gand\u001b[52Gspace\u001b[58Geach\u001b[63Gbecame\u001b[70G\"-\",\r\u001b[1B \u001b[3Gresulting in \"hello--world-\", and the trailing\u001b[50Gexclamation\u001b[62Gmark\u001b[67Gbecame\u001b[74Ga\r\u001b[1B  trailing \"-\".\u001b[K\r\u001b[5C\u001b[1B\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[51.215904, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mAdded \u001b[1m1\u001b[22m line, removed\u001b[28G\u001b[1m1\u001b[30G\u001b[22mline\r\u001b[1B     \u001b[38;5;236m\u001b[2m 5 \u001b[22m \u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m6\u001b[10G\u001b[22m\u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97mslugify\u001b[38;5;236m(\u001b[38;5;31mtitle: str\u001b[38;5;236m) -> \u001b[38;5;31mstr\u001b[38;5;236m:\r\u001b[6C\u001b[1B\u001b[2m7\u001b[10G\u001b[22m   \u001b[14G\u001b[38;5;24m\"\"\"Turn a title into a URL slug: 'Hello, World!' -> 'hel\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m \u001b[10G\u001b[22m\u001b[38;5;24mlo-world'.\"\"\"\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m 8 -\u001b[38;5;236m    return re.sub(r\"[^a-z0-9]\", \"-\", title.lower())         \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 8 +\u001b[38;5;236m    \u001b[38;5;125mreturn\u001b[38;5;236m re.sub(\u001b[38;5;24mr\"[^a-z0-9]\u001b[48;5;157m+\u001b[48;5;194m\"\u001b[38;5;236m, \u001b[38;5;24m\"-\"\u001b[38;5;236m, title.lower())\u001b[48;5;157m.strip(\u001b[38;5;24m\"\r\u001b[6C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m \u001b[10G\u001b[38;5;24m\u001b[48;5;157m-\"\u001b[38;5;236m)\u001b[14G\u001b[48;5;194m                                                        \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m5\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mI\u001b[5Gneed\u001b[10Gto\u001b[13Gcreate\u001b[20Ga\u001b[22Gfeature\u001b[30Gbranch\u001b[37Gfirst\u001b[43Gper\u001b[47Gthe\u001b[51Ghouse\u001b[57Grules.\u001b[64GLet\u001b[68Gme\u001b[71Gdo\r\u001b[1B \u001b[3Gthat:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mCommitted \u001b[1mb1d202c\u001b[22m, pushed to \u001b[1mfix/slugify-consecutive-chars\u001b[22m, ran \u001b[1m1\u001b[22m shell \r\u001b[2C\u001b[1Bc\u001b[7Gand \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mDone!\u001b[9GI've\u001b[14Gfixed\u001b[20Gthe\u001b[24G\u001b[38;5;105mslugify\u001b[32G\u001b[39mfunction\u001b[41Gand\u001b[45Gpushed\u001b[52Gthe\u001b[56Gchanges.\u001b[65GThe\u001b[69Gbug\u001b[73Gwas\r\u001b[1B \u001b[3Gthat the rege\u001b[17G \u001b[38;5;105m[^a-z0-9]\u001b[39m replaced each \u001b[43Gon-alphanum\u001b[55Gric character\u001b[69G\u001b[K\r\u001b[2C\u001b[1Bindividually. For \"Hello, World!\", the\u001b[42Gc\u001b[44Gmm\u001b[47G and space each became\u001b[70G\"-\",\r\u001b[2C\u001b[1Bresulting in \"hello--world-\", and the trailing excl\u001b[55Gmation mark b\u001b[69Gcame a\r\u001b[2C\u001b[1Btrai\u001b[8Ging \"-\".\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gfix\u001b[11Gchanges\u001b[19Gthe\u001b[23Gregex\u001b[29Gto\u001b[32G\u001b[38;5;105m[^a-z0-9]+\u001b[43G\u001b[39m(matching\u001b[53Gone\u001b[57Gor\u001b[60Gmore\u001b[65Gconsecutive\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[51.340305, "o", "\u001b[?25l\u001b[H\u001b[38;5;241m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m1\u001b[14G\u001b[22mline,\u001b[20Gremoved\u001b[28G\u001b[1m1\u001b[30G\u001b[22mline\r\u001b[1B     \u001b[38;5;236m\u001b[2m 5 \u001b[22m \u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m6\u001b[10G\u001b[22m\u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97mslugify\u001b[38;5;236m(\u001b[38;5;31mtitle: str\u001b[38;5;236m) -> \u001b[38;5;31mstr\u001b[38;5;236m:\r\u001b[6C\u001b[1B\u001b[2m7\u001b[10G\u001b[22m   \u001b[14G\u001b[38;5;24m\"\"\"Turn a title into a URL slug: 'Hello, World!' -> 'hel\r\u001b[6C\u001b[1B\u001b[38;5;236m\u001b[2m \u001b[10G\u001b[22m\u001b[38;5;24mlo-world'.\"\"\"\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m 8 -\u001b[38;5;236m    return re.sub(r\"[^a-z0-9]\", \"-\", title.lower())         \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 8 +\u001b[38;5;236m    \u001b[38;5;125mreturn\u001b[38;5;236m re.sub(\u001b[38;5;24mr\"[^a-z0-9]\u001b[48;5;157m+\u001b[48;5;194m\"\u001b[38;5;236m, \u001b[38;5;24m\"-\"\u001b[38;5;236m, title.lower())\u001b[48;5;157m.strip(\u001b[38;5;24m\"\r\u001b[6C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m \u001b[10G\u001b[38;5;24m\u001b[48;5;157m-\"\u001b[38;5;236m)\u001b[14G\u001b[48;5;194m                                                        \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m5\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mI\u001b[5Gneed\u001b[10Gto\u001b[13Gcreate\u001b[20Ga\u001b[22Gfeature\u001b[30Gbranch\u001b[37Gfirst\u001b[43Gper\u001b[47Gthe\u001b[51Ghouse\u001b[57Grules.\u001b[64GLet\u001b[68Gme\u001b[71Gdo\r\u001b[1B \u001b[3Gthat:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mCommitted \u001b[1mb1d202c\u001b[22m, pushed to \u001b[1mfix/slugify-consecutive-chars\u001b[22m, ran \u001b[1m1\u001b[22m shell \r\u001b[2C\u001b[1B