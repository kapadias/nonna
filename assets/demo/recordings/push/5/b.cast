 \u001b[1mb1d202c\u001b[22m, pushed to \u001b[1mfix/slugify-consecutive-chars\u001b[22m, ran \u001b[1m1\u001b[22m shell \r\u001b[2C\u001b[1Bc\u001b[7Gand \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mDone!\u001b[9GI've\u001b[14Gfixed\u001b[20Gthe\u001b[24G\u001b[38;5;105mslugify\u001b[32G\u001b[39mfunction\u001b[41Gand\u001b[45Gpushed\u001b[52Gthe\u001b[56Gchanges.\u001b[65GThe\u001b[69Gbug\u001b[73Gwas\r\u001b[1B \u001b[3Gthat\u001b[8Gthe\u001b[12Gregex\u001b[18G\u001b[38;5;105m[^a-z0-9]\u001b[28G\u001b[39mreplaced\u001b[37Geach\u001b[42Gnon-alphanumeric\u001b[59Gcharacter\u001b[30;1H\u001b[28;3H\u001b[?25h"]
