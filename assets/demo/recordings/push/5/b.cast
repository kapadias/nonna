[56.253961, "o", "\u001b[?25l\u001b[H\u001b[3Gtra\u001b[7Gl\u001b[9Gng \"-\"\u001b[17G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe f\u001b[9Gx changes\u001b[19Gthe\u001b[23Gregex\u001b[29Gto\u001b[32G\u001b[38;5;105m[^a-z0-9]+\u001b[43G\u001b[39m(matching\u001b[53Gone\u001b[57Gor\u001b[60Gmore\u001b[65Gconsecutive\r\u001b[2C\u001b[1Bnon-alphanumeric\u001b[20Gcharacters)\u001b[32Gand\u001b[36Gadds\u001b[41G\u001b[38;5;105m.strip(\"-\")\u001b[53G\u001b[39mto\u001b[56Gremove\r\u001b[2C\u001b[1Bleading/tr\u001b[14Giling \u001b[21Gyph\u001b[25Gns.\u001b[29GN\u001b[31Gw \u001b[38;5;105mslugify(\"Hello, World!\")\u001b[39m correctly r\u001b[70Gt\u001b[72Grns\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;105m\"hello-world\"\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe full test suite\u001b[23Gpasses,\u001b[31Gand\u001b[35Gthe\u001b[39Gchanges\u001b[47Ghave\u001b[52Gbeen\u001b[57Gcommitted\u001b[67Gto\u001b[70Gthe\r\u001b[2C\u001b[1B\u001b[38;5;105mfix/slugify-consecutive-chars\u001b[33G\u001b[39mbranch\u001b[40Gand\u001b[44Gpushed.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B●\u001b[3GRan \u001b[1m1\u001b[22m stop hook\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241m⎿  \u001b[39mStop\u001b[11Ghook\u001b[16Gerror:\u001b[23G✗\u001b[25GNonna:\u001b[32Gwhere's\u001b[40Gthe\u001b[44Gtest?\u001b[50G(stop:\u001b[57Gcode\r\u001b[1B \u001b[3Gchanged, no test\u001b[20Gchanged)\r\u001b[2C\u001b[1BAdd a test that fails\u001b[25Gwithout your change and pa\u001b[52Gses with it,\u001b[65Gor\r\u001b[2C\u001b[1Btell the\u001b[12Guser plainly why\u001b[29Gthis\u001b[34Gchange\u001b[41Gneeds\u001b[47Gnone.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mI\u001b[5Gneed\u001b[10Gto\u001b[13Gadd\u001b[17Ga\u001b[19Gtest\u001b[24Gthat\u001b[29Gdemonstrates\u001b[42Gthe\u001b[46Gfix.\u001b[51GLet\u001b[55Gme\u001b[58Gadd\u001b[62Ga\u001b[64Gtest\u001b[69Gcase\u001b[74Gfor\r\u001b[2C\u001b[1Bthe\u001b[7Gbug:\r\u001b[1B\u001b