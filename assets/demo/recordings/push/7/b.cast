1b[39mDone!\u001b[9GI've\u001b[14Gadded\u001b[20Ga\u001b[22Gtest\u001b[27G\u001b[38;5;105mtest_slugify_with_special_chars\u001b[59G\u001b[39mthat\u001b[64Gverifies\r\u001b[1B \u001b[3G\u001b[38;5;105mslugify(\"Hello, World!\")\u001b[39m returns \u001b[38;5;105m\"hello-world\"\u001b[39m. The test covers the exact\u001b[30;1H\u001b[28;3H\u001b[?25h"]
