[81.766651, "o", "\u001b[?25l\u001b[H\u001b[38;5;241m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m4\u001b[14G\u001b[22mlines\r\u001b[1B \u001b[3G   \u001b[38;5;236m\u001b[2m 3 \u001b[22m \u001b[39m\u001b[K\r\u001b[1B     \u001b[38;5;236m\u001b[2m 4 \u001b[22m \u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97mtest_slugify_simple\u001b[38;5;236m():\r\u001b[6C\u001b[1B\u001b[2m5\u001b[10G\u001b[22m    \u001b[38;5;125massert\u001b[38;5;236m slugify(\u001b[38;5;24m\"hello\"\u001b[38;5;236m) == \u001b[38;5;24m\"hello\"\r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 6 +\u001b[38;5;236m                                                            \r\u001b[5C\u001b[1B\u001b[38;5;29m 7 +\u001b[38;5;236m                                                            \r\u001b[6C\u001b[1B\u001b[38;5;29m8\u001b[10G\u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97mtest_slugify_with_special_chars\u001b[38;5;236m():                      \r\u001b[6C\u001b[1B\u001b[38;5;29m9\u001b[14G\u001b[38;5;125massert\u001b[38;5;236m slugify(\u001b[38;5;24m\"Hello, World!\"\u001b[38;5;236m) == \u001b[38;5;24m\"hello-world\"\u001b[38;5;236m        \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m4\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2B\u001b[38;5;16m●\u001b[3G\u001b[39mNow let me update the\u001b[25Gcommit\u001b[32Gto\u001b[35Ginclude\u001b[43Gthe\u001b[47Gtest:\r\u001b[2B \u001b[3G\u001b[38;5;241mAmended commit \u001b[1m00072e4\u001b[22m, ran \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;5;16m●\u001b[3G\u001b[39mI can't force push. Let me create a new commit\u001b[50Gfor\u001b[54Gthe\u001b[58Gtest\u001b[63Ginstead:\r\u001b[2B \u001b[3G\u001b[38;5;241mCommitted \u001b[1m5c53aba, 6dfebf4\u001b[22m, pushed to \u001b[1mfix/slugify-bug\u001b[22m, ran \u001b[1m4\u001b[22m shell \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mcommands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[39m\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
