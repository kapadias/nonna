dles consecutive\u001b[63Gdashes\u001b[70Gand\r\u001b[2C\u001b[1Btrailing\u001b[12Gdashes.\u001b[20GThe\u001b[24Gfix:\r\u001b[2C\u001b[1B- Collapses multiple\u001b[24Gconsecutive\u001b[36Gdashes\u001b[43Ginto\u001b[48Ga\u001b[50Gsingle\u001b[57Gdash\u001b[62Gusing\r\u001b[4C\u001b[1B\u001b[38;5;105mre.sub(r\"-+\", \"-\", slug)\r\u001b[2C\u001b[1B\u001b[39m-\u001b[5GStrips\u001b[12Gleading/trailing\u001b[29Gdashes\u001b[36Gusing\u001b[42G\u001b[38;5;105mstrip(\"-\")\r\u001b[2C\u001b[2B\u001b[39mNow\u001b[7G\u001b[38;5;105mslugify(\"Hello, World!\")\u001b[32G\u001b[39mcorrectly\u001b[42Greturns\u001b[50G\u001b[38;5;105m\"hello-world\"\u001b[39m.\u001b[65GCommitted\r\u001b[2C\u001b[1Band\u001b[7Gpushed.\r\u001b[2B\u001b[38;5;241m✻\u001b[3GCogitated for 12s · done 6:04 PM\r\u001b[2B\u001b[38;5;246m────────────────────────────────────────────────────────────────────────────\r\u001b[1B\u001b[39m❯ \r\u001b[1B\u001b[38;5;246m────────────────────────────────────────────────────────────────────────────\r\u001b[2C\u001b[1B\u001b[38;5;129m⏵⏵ accept edits on\u001b[38;5;241m (shift+tab to cycle) · ← for agents\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
