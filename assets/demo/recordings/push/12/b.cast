o-world\"\u001b[38;5;236m       \r\u001b[7C\u001b[1B\u001b[38;5;29m4\u001b[11G\u001b[38;5;236m                                                           \r\u001b[7C\u001b[1B\u001b[38;5;29m5\u001b[15G\u001b[38;5;236m                                                       \r\u001b[7C\u001b[1B\u001b[38;5;29m6\u001b[11G\u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97mtest_slugify_trailing_punctuation\u001b[38;5;236m():                   \r\u001b[7C\u001b[1B\u001b[38;5;29m7\u001b[15G\u001b[38;5;125massert\u001b[38;5;236m slugify(\u001b[38;5;24m\"Hello World!\"\u001b[38;5;236m) == \u001b[38;5;24m\"hello-world\"\u001b[38;5;236m        \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[1B\u001b[38;5;174m·\u001b[3GPuzzling… \u001b[38;5;241m(30s · ↓\u001b[39m \u001b[38;5;241m2.6k tokens · \u001b[38;5;247mthinking\u001b[38;5;241m)\u001b[3"]
