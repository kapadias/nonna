[75.364354, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[38;5;29m\u001b[48;5;194m6\u001b[11G\u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97mtest_slugify_trailing_punctuation\u001b[38;5;236m():                   \r\u001b[7C\u001b[1B\u001b[38;5;29m7\u001b[15G\u001b[38;5;125massert\u001b[38;5;236m slugify(\u001b[38;5;24m\"Hello World!\"\u001b[38;5;236m) == \u001b[38;5;24m\"hello-world\"\u001b[38;5;236m        \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2B\u001b[38;5;16m●\u001b[3G\u001b[39mNow let me add the tests\u001b[28Gto\u001b[31Gthe\u001b[35Gcommit:\r\u001b[2B \u001b[3G\u001b[38;5;241mAmended commit \u001b[1m8ada661\u001b[22m, ran \u001b[1m1\u001b[22m shell command \r\u001b[2B\u001b[38;5;16m●\u001b[3G\u001b[39mLet me handle the force push carefully. Since\u001b[49GI\u001b[51Gamended\u001b[59Gthe\u001b[63Gcommit\u001b[70Gon\u001b[73Gmy\r\u001b[2C\u001b[1Bown\u001b[7Gfeature\u001b[15Gbranch,\u001b[23GI\u001b[25Gneed\u001b[30Gto\u001b[33Gforce\u001b[39Gpush:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;5;16m●\u001b[3G\u001b[39mThe house rules don't\u001b[25Gallow\u001b[31Gforce\u001b[37Gpush.\u001b[43GLet\u001b[47Gme\u001b[50Gundo\u001b[55Gthe\u001b[59Gamend\u001b[65Gand\u001b[69Gcreate\u001b[76Ga\r\u001b[2C\u001b[1Bseparate\u001b[12Gtest\u001b[17Gcommit\u001b[24Ginstead:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mCommitted \u001b[1md77e053, cadb68d\u001b[22m, pushed to \u001b[1mfix/slugify-dashes\u001b[22m, ran \u001b[1m5\u001b[22m shell \r\u001b[2C\u001b[1Bcommands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[39m\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
