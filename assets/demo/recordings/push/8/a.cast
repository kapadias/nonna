[28.084119, "o", "\u001b[?25l\u001b[H \u001b[3Gwith a dash, which creates multiple \u001b[40Gons\u001b[44Gcutive d\u001b[53Gshes and trailing\u001b[K\r\u001b[2C\u001b[1Bdas\u001b[7Ges. I need to coll\u001b[26Gpse\u001b[39Gdash\u001b[44Gs and strip le\u001b[59Gding/tra\u001b[68Gling\r\u001b[10C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;65m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(\u001b]8;id=1cz53su;file:///root/a/site/app/text.py\u0007app/text.py\u001b]8;;\u0007)\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mAdded \u001b[1m3\u001b[22m lines, removed\u001b[29G\u001b[1m1\u001b[31G\u001b[22mline\r\u001b[1B     \u001b[38;5;236m\u001b[2m  5 \u001b[22m \u001b[12G\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m6\u001b[11G\u001b[22m\u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97mslugify\u001b[38;5;236m(\u001b[38;5;31mtitle: str\u001b[38;5;236m) -> \u001b[38;5;31mstr\u001b[38;5;236m:\r\u001b[7C\u001b[1B\u001b[2m7\u001b[11G\u001b[22m   \u001b[15G\u001b[38;5;24m\"\"\"Turn a title into a URL slug: 'Hello, World!' -> 'he\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m \u001b[11G\u001b[22m\u001b[38;5;24mllo-world'.\"\"\"\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  8 -\u001b[38;5;236m    return re.sub(r\"[^a-z0-9]\", \"-\", title.lower())        \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  8 +\u001b[38;5;236m    \u001b[48;5;157mslug\u001b[48;5;194m \u001b[48;5;157m= \u001b[48;5;194mre.sub(\u001b[38;5;24mr\"[^a-z0-9]\"\u001b[38;5;236m, \u001b[38;5;24m\"-\"\u001b[38;5;236m, title.lower())        \r\u001b[7C\u001b[1B\u001b[38;5;29m9\u001b[15G\u001b[38;5;236mslug\u001b[20G= \u001b[31G\u001b[38;5;24m-+\"\u001b[38;5;236m, \u001b[38;5;24m\"\u001b[38G\"\u001b[38;5;236m, slug) \u001b[48G              \r\u001b[6C\u001b[1B\u001b[38;5;29m10\u001b[15G\u001b[38;5;125mreturn\u001b[38;5;236m slug.strip(\u001b[34G\u001b[38;5;24m-\"\u001b[38;5;236m)   \u001b[41G     \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[2C\