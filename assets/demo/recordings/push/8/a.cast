u001b[38;5;24m\"-\"\u001b[38;5;236m, title.lower())        \r\u001b[5C\u001b[1B\u001b[38;5;29m  9 +\u001b[38;5;236m    slug = re.sub(\u001b[38;5;24mr\"-+\"\u001b[38;5;236m, \u001b[38;5;24m\"-\"\u001b[38;5;236m, slug)                        \r\u001b[6C\u001b[1B\u001b[38;5;29m10\u001b[15G\u001b[38;5;125mreturn\u001b[38;5;236m slug.strip(\u001b[38;5;24m\"\u001b[35G\"\u001b[38;5;236m)     \u001b[43G    \u001b[48G              \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[1B\u001b[38;5;241m●\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command…\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
