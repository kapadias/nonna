[30.82671, "o", "\u001b[?25l\u001b[H\u001b[7G\u001b[38;5;236m\u001b[2m5\u001b[10G\u001b[22m    \u001b[38;5;125massert\u001b[38;5;236m slugify(\u001b[38;5;24m\"hello\"\u001b[38;5;236m) == \u001b[38;5;24m\"hello\"\r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m 6 +\u001b[38;5;236m                                                            \r\u001b[5C\u001b[1B\u001b[38;5;29m 7 +\u001b[38;5;236m                                                            \r\u001b[6C\u001b[1B\u001b[38;5;29m8\u001b[10G\u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97mtest_slugify_with_punctuation\u001b[38;5;236m():                        \r\u001b[6C\u001b[1B\u001b[38;5;29m9\u001b[14G\u001b[38;5;125massert\u001b[38;5;236m slugify(\u001b[38;5;24m\"Hello, World!\"\u001b[38;5;236m) == \u001b[38;5;24m\"hello-world\"\u001b[38;5;236m        \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;5;16m●\u001b[3G\u001b[39mNow I'll fix the \u001b[38;5;105mslugify\u001b[28G\u001b[39mfunction\u001b[37Gto\u001b[40Ghandle\u001b[47Gconsecutive\u001b[59Ghyphens\u001b[67Gand\r\u001b[2C\u001b[1Btrailing\u001b[12Ghyphens:\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;65m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(\u001b]8;id=whidul;file:///root/b/site/app/text.py\u0007app/text.py\u001b]8;;\u0007)\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m3\u001b[14G\u001b[22mlines,\u001b[21Gremoved\u001b[29G\u001b[1m1\u001b[31G\u001b[22mline\r\u001b[1B \u001b[3G   \u001b[38;5;236m\u001b[2m  5 \u001b[22m \u001b[39m\u001b[K\r\u001b[1B     \u001b[38;5;236m\u001b[2m  6 \u001b[22m \u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97mslugify\u001b[38;5;236m(\u001b[38;5;31mtitle: str\u001b[38;5;236m) -> \u001b[38;5;31mstr\u001b[38;5;236m:\r\u001b[7C\u001b[1B\u001b[2m7\u001b[11G\u001b[22m    \u001b[38;5;24m\"\"\"Turn a title into a URL slug: 'Hello, World!' -> 'he\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m \u001b[11G\u001b[22m\u001b[38;5;24mllo-world'.\"\"\"\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  8 -\u001b[38;5;236m    return re.sub(r\"[^a-z0-9]\", \"-\", title.lower())        \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  8 +\u001b[38;5;236m    \u001b[48;5;157mslug\u001b[48;5;194m \u001b[48;5;157m= \u001b[48;5;194mre.sub(\u001b[38;5;24mr\"[^a-z0-9]\"\u001b[38;5;236m, \u001b[38;5;24m\"-\"\u001b[38;5;236m, title.lower())        \r\u001b[5C\u001b[1B\u001b[38;5;29m  9 +\u001b[38;5;236m    slug = re.sub(\u001b[38;5;24mr\"-+\"\u001b[38;5;236m, \u001b[38;5;24m\"-\"\u001b[38;5;236m, slug)                        \r\u001b[6C\u001b[1B\u001b[38;5;29m10\u001b[15G\u001b[38;5;125mreturn\u001b[38;5;236m slug.strip(\u001b[38;5;24m\"\u001b[35G\"\u001b[38;5;236m)     \u001b[43G    \u001b[48G              \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[1B\u001b[38;5;241m●\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command…\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
