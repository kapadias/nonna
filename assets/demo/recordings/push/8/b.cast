[47.553051, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;5;65m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(\u001b]8;id=whidul;file:///root/b/site/app/text.py\u0007app/text.py\u001b]8;;\u0007)\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m3\u001b[22m line\u001b[19G,\u001b[21Gremoved\u001b[29G\u001b[1m1\u001b[31G\u001b[22mline\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  5 \u001b[22m \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;236m\u001b[2m  6 \u001b[22m \u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97mslugify\u001b[38;5;236m(\u001b[38;5;31mtitle: str\u001b[38;5;236m) -> \u001b[38;5;31mstr\u001b[38;5;236m:\r\u001b[1B\u001b[39m     \u001b[38;5;236m\u001b[2m  7 \u001b[22m     \u001b[38;5;24m\"\"\"Turn a title into a URL slug: 'Hello, World!' -> 'he\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m \u001b[11G\u001b[22m\u001b[38;5;24mllo-world'.\"\"\"\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  8 -\u001b[38;5;236m    return re.sub(r\"[^a-z0-9]\", \"-\", title.lower())        \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  8 +\u001b[38;5;236m    \u001b[48;5;157mslug\u001b[48;5;194m \u001b[48;5;157m= \u001b[48;5;194mre.sub(\u001b[38;5;24mr\"[^a-z0-9]\"\u001b[38;5;236m, \u001b[38;5;24m\"-\"\u001b[38;5;236m, title.lower())        \r\u001b[5C\u001b[1B\u001b[38;5;29m  9 +\u001b[38;5;236m    slug = re.sub(\u001b[38;5;24mr\"-+\"\u001b[38;5;236m, \u001b[38;5;24m\"-\"\u001b[38;5;236m, slug)                        \r\u001b[5C\u001b[1B\u001b[38;5;29m 10 +\u001b[38;5;236m    \u001b[38;5;125mreturn\u001b[38;5;236m slug.strip(\u001b[38;5;24m\"-\"\u001b[38;5;236m)                                 \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mAll\u001b[7Gtests\u001b[13Gpass.\u001b[19GNow\u001b[23GI'll\u001b[28Gcommit\u001b[35Gand\u001b[39Gpush\u001b[44Gthe\u001b[48Gfix.\r\u001b[2C