n\u001b[38;5;236m():                        \r\u001b[6C\u001b[1B\u001b[38;5;29m9\u001b[14G\u001b[38;5;125massert\u001b[38;5;236m slugify(\u001b[38;5;24m\"Hello, World!\"\u001b[38;5;236m) == \u001b[38;5;24m\"hello-world\"\u001b[38;5;236m        \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[1B\u001b[38;5;241m●\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command…\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  $ python3 -m pytest tests/test_text.py::test_slugify_with_punctuation \r\u001b[5C\u001b[1B-v\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;174m✶\u001b[3GPonder\u001b[38;5;216ming\u001b[38;5;174m… \u001b[38;5;241m(running PreToolUse hooks… 0/2 · 11s · ↓\u001b[55G1.0k tokens · \u001b[38;5;246mthinking\r\u001b[1B\u001b[38;5;241m)\u001b[3G\u001b[39m\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
