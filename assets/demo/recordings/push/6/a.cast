ip(\u001b[38;5;24m\"\r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m   +\u001b[38;5;24m\u001b[48;5;157m-\"\u001b[38;5;236m)\u001b[48;5;194m                                                         \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow I'll commit and push the fix.\u001b[K\r\u001b[2B \u001b[3G\u001b[38;5;241mCommitted \u001b[1m34ffdae\u001b[22m, pushed to \u001b[1mmain\u001b[22m, ran \u001b[1m1\u001b[22m shell command \r\u001b[2B\u001b[38;5;16m●\u001b[3G\u001b[39mDone! Fixed the \u001b[38;5;105mslugify\u001b[39m function by changing the regex to\u001b[61Gmatch\r\u001b[2C\u001b[1Bconsecutive\u001b[15Gnon-alphanumeric\u001b[32Gcharacters\u001b[43Gas\u001b[46Ga\u001b[48Gsingle\u001b[55Gdash\u001b[60G(\u001b[38;5;105m[^a-z0-9]+\u001b[39m)\u001b[73Gand\r\u001b[1B \u001b[3Gadd\u001b[7Gd\u001b[9G\u001b[38;5;105m.strip(\"-\")\u001b[39m to remove leading/tr\u001b[42Gil\u001b[48Gdashes. Now `slugify(\"Hello,\u001b[30;1H\u001b[28;3H\u001b[?25h"]
