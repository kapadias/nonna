[53.32638, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[24B\u001b[38;5;105mslugify(\"Hello, World!\")\u001b[30G\u001b[39mnow\u001b[34Gcorrectly\u001b[44Greturns\u001b[52G\u001b[38;5;105m\"hello-world\"\u001b[66G\u001b[39minstead\u001b[74Gof\u001b[30;1H\u001b[28;3H\u001b[?25h"]
