[26.936062, "o", "\u001b[?25l\u001b[H\u001b[7G\u001b[38;5;29m\u001b[48;5;194m6\r\u001b[6C\u001b[1B7\u001b[10G\u001b[38;5;236m                                                            \r\u001b[6C\u001b[1B\u001b[38;5;29m8\u001b[10G\u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97mtest_slugify_with_punctuation\u001b[38;5;236m(\u001b[45G:  \u001b[49G             \r\u001b[5C\u001b[1B\u001b[38;5;29m 9 +\u001b[38;5;236m    \u001b[38;5;125massert\u001b[38;5;236m slugify(\u001b[38;5;24m\"Hello, World!\"\u001b[38;5;236m) == \u001b[38;5;24m\"hello-world\"\u001b[38;5;236m        \r\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow I'll fix the \u001b[38;5;105mslugify\u001b[39m function\u001b[37Gto\u001b[40Ghandle\u001b[47Gconsecutive\u001b[59Gnon-alphanumeric\r\u001b[2C\u001b[1Bcharacters\u001b[14Gand\u001b[18Gtrim\u001b[23Gedges:\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;65m●\u001b[39m \u001b[1mUpdate\u001b[22m(\u001b]8;id=whidul;file:///root/b/site/app/text.py\u0007app/text.py\u001b]8;;\u0007)\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m3\u001b[14G\u001b[22mlines,\u001b[21Gremoved\u001b[29G\u001b[1m1\u001b[31G\u001b[22mline\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m5\u001b[11G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m6\u001b[11G\u001b[22m\u001b[38;5;125mdef\u001b[15G\u001b[38;5;97mslugify\u001b[38;5;236m(\u001b[38;5;31mtitle: str\u001b[38;5;236m) -> \u001b[38;5;31mstr\u001b[38;5;236m:\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m7\u001b[11G\u001b[22m    \u001b[38;5;24m\"\"\"Turn a title into a URL slug: 'Hello, World!' -> 'he\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m    \u001b[22m \u001b[38;5;24mllo-world'.\"\"\"\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  8 -\u001b[38;5;236m    return re.sub(r\"[^a-z0-9]\", \"-\", title.lower())        \r\u001b[7C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m8\u001b[15G\u001b[38;5;236m\u001b[48;5;157mslug\u001b[20G= \u001b[31G\u001b[48;5;194m\u001b[38;5;24m[^a-z0\u001b[38G9]\"\u001b[38;5;236m, \u001b[38;5;24m\"-\"\u001b[38;5;236m,\u001b[48Gtitle.lower())\r\u001b[6C\u001b[1B\u001b[38;5;29m 9\u001b[15G\u001b[38;5;236mslug = re.sub(\u001b[38;5;24mr\"-+\u001b[34G\u001b[38;5;236m, \u001b[38;5;24m\"-\"\u001b[38;5;236m,\u001b[41Gslug)\r\u001b[5C\u001b[1B\u001b[38;5;29m 10 +\u001b[38;5;236m    \u001b[38;5;125mreturn\u001b[38;5;236m slug.strip(\u001b[38;5;24m\"-\"\u001b[38;5;236m)                                 \r\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mLet\u001b[7Gme\u001b[10Gverify\u001b[17Gthe\u001b[21Gfix\u001b[25Gworks\u001b[31Gby\u001b[34Grunning\u001b[42Gthe\u001b[46Gtests:\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B Running \u001b[1m1\u001b[22m shell command…\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  $ python3 -m pytest tests/test_text.py -v\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;174m✻\u001b[3G\u001b[38;5;216mTinkering…\u001b[38;5;174m \u001b[38;5;241m(13s · ↓\u001b[23G1.2k tokens)\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
