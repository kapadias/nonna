[25.9733, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mFound the issue.\u001b[20GThe\u001b[24Gregex\u001b[30Greplaces\u001b[39Gevery\u001b[45Gnon-alphanumeric\u001b[62Gcharacter\u001b[72Gwith\r\u001b[2C\u001b[1Ba\u001b[5Ghyphen,\u001b[13Gcreating\u001b[22Gconsecutive\u001b[34Ghyphens\u001b[42Gand\u001b[46Gtrailing\u001b[55Ghyphens.\u001b[64GI\u001b[66Gneed\u001b[71Gto\r\u001b[1B \u001b[3Gc\u001b[5Gllapse multiple \u001b[22Gyph\u001b[26Gns and strip\u001b[39Gtraili\u001b[46Gg ones.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;65m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(\u001b]8;id=1cz53su;file:///root/a/site/app/text.py\u0007app/text.py\u001b]8;;\u0007)\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m3\u001b[14G\u001b[22mlines,\u001b[21Gremoved\u001b[29G\u001b[1m1\u001b[31G\u001b[22mline\r\u001b[1B \u001b[3G   \u001b[38;5;236m\u001b[2m  5 \u001b[22m \u001b[39m\u001b[K\r\u001b[1B     \u001b[38;5;236m\u001b[2m  6 \u001b[22m \u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97mslugify\u001b[38;5;236m(\u001b[38;5;31mtitle: str\u001b[38;5;236m) -> \u001b[38;5;31mstr\u001b[38;5;236m:\r\u001b[7C\u001b[1B\u001b[2m7\u001b[11G\u001b[22m    \u001b[38;5;24m\"\"\"Turn a title into a URL slug: 'Hello, World!' -> 'he\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m \u001b[11G\u001b[22m\u001b[38;5;24mllo-world'.\"\"\"\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  8 -\u001b[38;5;236m    return re.sub(r\"[^a-z0-9]\", \"-\", title.lower())        \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  8 +\u001b[38;5;236m    \u001b[48;5;157mslug\u001b[48;5;194m \u001b[48;5;157m= \u001b[48;5;194mre.sub(\u001b[38;5;24mr\"[^a-z0-9]\"\u001b[38;5;236m, \u001b[38;5;24m\"-\"\u001b[38;5;236m, title.lower())        \r\u001b[5C\u001b[1B\u001b[38;5;29m  9 +\u001b[38;5;236m    slug = re.sub(\u001b[38;5;24mr\"-+\"\u001b[38;5;236m, \u001b[38;5;24m\"-\"\u001b[38;5;236m, slug)                        \r\u001b[6C\u001b[1