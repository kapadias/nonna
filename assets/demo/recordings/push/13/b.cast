[29.352245, "o", "\u001b[?25l\u001b[H\u001b[3Gwith\u001b[8Ga\u001b[10Gdash,\u001b[16Gcreating\u001b[25Gconsecutive\u001b[37Gdashes\u001b[44Gand\u001b[48Gtrailing\u001b[57Gdashes.\u001b[65GLet\u001b[69Gme\u001b[72Gfix\r\u001b[2C\u001b[1Bthis\u001b[8Gby\u001b[11Gcollapsing\u001b[22Gconsecutive\u001b[34Gdashes\u001b[41Gand\u001b[45Gremoving\u001b[54Gleading/trailing\u001b[71Gones.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;65m●\u001b[39m \u001b[1mUpdate\u001b[22m(\u001b]8;id=whidul;file:///root/b/site/app/text.py\u0007app/text.py\u001b]8;;\u0007)\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m3\u001b[14G\u001b[22mlines,\u001b[21Gremoved\u001b[29G\u001b[1m1\u001b[31G\u001b[22mline\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m5\u001b[11G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m6\u001b[11G\u001b[22m\u001b[38;5;125mdef\u001b[15G\u001b[38;5;97mslugify\u001b[38;5;236m(\u001b[38;5;31mtitle: str\u001b[38;5;236m) -> \u001b[38;5;31mstr\u001b[38;5;236m:\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m7\u001b[11G\u001b[22m    \u001b[38;5;24m\"\"\"Turn a title into a URL slug: 'Hello, World!' -> 'he\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m    \u001b[22m \u001b[38;5;24mllo-world'.\"\"\"\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  8 -\u001b[38;5;236m    return re.sub(r\"[^a-z0-9]\", \"-\", title.lower())        \r\u001b[7C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m8\u001b[15G\u001b[38;5;236m\u001b[48;5;157mslug\u001b[20G= \u001b[31G\u001b[48;5;194m\u001b[38;5;24m[^a-z0\u001b[38G9]\"\u001b[38;5;236m, \u001b[38;5;24m\"-\"\u001b[38;5;236m,\u001b[48Gtitle.lower())\r\u001b[6C\u001b[1B\u001b[38;5;29m 9\u001b[15G\u001b[38;5;236mslug = re.sub(\u001b[38;5;24mr\"-+\u001b[34G\u001b[38;5;236m, \u001b[38;5;24m\"-\"\u001b[38;5;236m,\u001b[41Gslug)\r\u001b[5C\u001b[1B\u001b[38;5;29m 10 +\u001b[38;5;236m    \u001b[38;5;125mreturn\u001b[38;5;236m slug.strip(\u001b[38;5;24m\"-\"\u001b[38;5;236m)           