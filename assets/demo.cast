[56.087182, "o", "\u001b[?25l\u001b[H\u001b[38;5;16m●\u001b[3G\u001b[39mThe\u001b[7Gissue\u001b[13Gis\u001b[16Gthat\u001b[21G\u001b[38;5;105msplit_bill\u001b[32G\u001b[39muses\u001b[37G\u001b[38;5;105mdiv_cents()\u001b[39m,\u001b[50Gbut\u001b[54Git\u001b[57Gneeds\u001b[63Gfloor\u001b[69Gdivision\u001b[78Gto\u001b[81Gproperly\u001b[90Ghandle\u001b[97Gthe\r\u001b[2C\u001b[1Bleftover\u001b[12Gcents\u001b[18Gdistribution.\u001b[32GLet\u001b[36Gme\u001b[39Gfix\u001b[43G\u001b[38;5;105msplit_bill\u001b[54G\u001b[39mto\u001b[57Guse\u001b[61Gfloor\u001b[67Gdivision\u001b[76Gdirectly:\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;65m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(\u001b]8;id=1m1rwwu;file:///root/my-app/app/split.py\u0007app/split.py\u001b]8;;\u0007)\u001b[K\r\u001b[1B\u001b[38;5;241m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m1\u001b[14G\u001b[22mline,\u001b[20Gremoved\u001b[28G\u001b[1m3\u001b[30G\u001b[22mlines\r\u001b[1B \u001b[3G   \u001b[38;5;236m\u001b[2m  1 \u001b[22m \u001b[38;5;24m\"\"\"Splitting a bill between people.\"\"\"\r\u001b[1B\u001b[39m     \u001b[38;5;236m\u001b[2m  2 \u001b[22m \u001b[12G\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  3 -\u001b[38;5;236mfrom app.money import div_cents                                                    \r\u001b[7C\u001b[1B\u001b[49m\u001b[2m3\r\u001b[7C\u001b[1B\u001b[22m\u001b[38;5;160m\u001b[48;5;224m5\u001b[11G\u001b[38;5;236m    \u001b[16G         \u001b[26G      \u001b[33G         \r\u001b[7C\u001b[1B\u001b[49m\u001b[2m4\u001b[11G\u001b[22m\u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97msplit_bill\u001b[38;5;236m(\u001b[38;5;31mtotal_cents: int, people: int\u001b[38;5;236m) -> \u001b[38;5;31mlist\u001b[38;5;236m[\u001b[38;5;31mint\u001b[38;5;236m]:\r\u001b[5C\u001b[1B\u001b[2m  5 \u001b[22m     \u001b[38;5;24m\"\"\"Split a bill evenly; the first person pays the leftover cents so the shares \r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m \u001b[11G\u001b[22m\u001b[38;5;24msum to the total.\"\"\"\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  8 -\u001b[38;5;236m    share = div_cents(total_cents, people)                                         \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  6 +\u001b[38;5;236m    share = total_cents \u001b[48;5;157m// \u001b[48;5;194mpeople                                                  \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m  7 \u001b[22m     shares = [share] * people\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;236m\u001b[2m  8 \u001b[22m     shares[\u001b[38;5;31m0\u001b[38;5;236m] += total_cents - share * people\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m9\u001b[15G\u001b[22m\u001b[38;5;125mreturn\u001b[22G\u001b[38;5;236mshares\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[6G\u001b[39m\u001b[K\u001b[28;1H\u001b[26;3H\u001b[?25h"]
