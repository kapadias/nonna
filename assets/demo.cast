[59.774261, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;5;160m\u001b[48;5;224m  3 -\u001b[38;5;236mfrom app.money import div_cents                                                    \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m  3 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  5 -\u001b[38;5;236m                                                                                   \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m  4 \u001b[22m \u001b[38;5;125mdef\u001b[38;5;236m \u001b[38;5;97msplit_bill\u001b[38;5;236m(\u001b[38;5;31mtotal_cents: int, people: int\u001b[38;5;236m) -> \u001b[38;5;31mlist\u001b[38;5;236m[\u001b[38;5;31mint\u001b[38;5;236m]:\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m5\u001b[11G\u001b[22m   \u001b[15G\u001b[38;5;24m\"\"\"Split a bill evenly; the first person pays the leftover cents so the shares \r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m \u001b[11G\u001b[22m\u001b[38;5;24msum to the \u001b[23Gotal.\"\"\"\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;160m\u001b[48;5;224m  8 -\u001b[38;5;236m    share = div_cents(total_cents, people)                                         \r\u001b[5C\u001b[1B\u001b[38;5;29m\u001b[48;5;194m  6 +\u001b[38;5;236m    share = total_cents \u001b[48;5;157m// \u001b[48;5;194mpeople                                                  \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m  7 \u001b[22m     shares = [share] * people\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;236m\u001b[2m8\u001b[21G\u001b[22m[\u001b[38;5;31m0\u001b[38;5;236m] += total_c\u001b[36Gnts - share * people\r\u001b[7C\u001b[1B\u001b[2m9\u001b[15G\u001b[22m\u001b[38;5;125mreturn\u001b[38;5;236m shares\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mNow\u001b[7Glet\u001b[11Gme\u001b[14Grun\u001b[18Gthe\u001b[22Gfull\u001b[27Gtest\u001b[32Gsuite:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;241mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;16m●\u001b[3G\u001b[39mDone!\u001b[9GAll\u001b[13Gtests\u001b[19Gpass.\u001b[25GThe\u001b[29Gfix\u001b[33Ginvolved\u001b[42Gtwo\u001b[46Gchanges:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mUpdated \u001b[38;5;105mdiv_cents()\u001b[26G\u001b[22m\u001b[39mto\u001b[29Ground\u001b[35Ghalf-up\u001b[43Ginstead\u001b[51Gof\u001b[54Gflooring:\u001b[64G\u001b[38;5;105m(total_cents + divisor // 2) // \r\u001b[2C\u001b[1B\u001b[39m  \u001b[6G\u001b[38;5;105mdivisor\u001b[39m. Now \u001b[38;5;105mdiv_cents(7350, 100)\u001b[39m correc\u001b[47Gly returns 74 (instead of 73), making tax calculations\r\u001b[5C\u001b[1Blike 7% on 1050 cents return 74 cents as required.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mUpdated \u001b[38;5;105msplit_bill()\u001b[22m\u001b[39m to use floor division directly\u001b[58Ginstead\u001b[66Gof\u001b[69Gcalling\u001b[77G\u001b[38;5;105mdiv_cents()\u001b[39m.\u001b[90GThis\r\u001b[2C\u001b[1B  \u001b[6Gpreserves the correct bill-sp\u001b[36Gitting behavior where\u001b[58Glef\u001b[62Gover cents are\u001b[77Ghandled separately\u001b[96Gand\u001b[28;1H\u001b[26;3H\u001b[?25h"]
